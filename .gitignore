### Generated / local output ###
# maven-publish test repository (build.gradle publishes to ./repo)
/repo/
!**/src/**/repo/
# datagen cache
**/src/generated/**/.cache/
# the GitHub Pages wiki is built by CI (.github/workflows/pages.yml) from tools/ + docs/wiki/img
docs/site/
# the PDF wikis are ~85 MB each: too big for git history; attach them to a GitHub Release instead
docs/*.pdf
# the old one-page wiki (tools/make_wiki.py) still has the internal 'New in 2.x' history; the public wiki is docs/site
docs/wiki/index.html

