{
  "multipart": [
    {
      "apply": {
        "model": "guhs:block/eiken_balk_kern"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "guhs:block/eiken_balk_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "guhs:block/eiken_balk_south"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "guhs:block/eiken_balk_east"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "guhs:block/eiken_balk_west"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "guhs:block/eiken_balk_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "guhs:block/eiken_balk_down"
      }
    }
  ]
}
