{
  "chapter.4755488C63E04B2F.title": "&cDe Guhmaag",
  "chapter.4755488C63E04B2F.chapter_subtitle": [
    "5. NJEG... HAP! Welkom in de buik",
  ],
  "quest.475548B3399FAB18.title": "Hoe kom je hier?",
  "quest.475548B3399FAB18.quest_desc": [
    "Dit hoofdstuk komt na &dWelkom in de Guhmensie!&r in &dDe Guhmensie&r.",
    "",
    "Zoek daar het &dVadsig-heiligdom&r (het heiligdomkompas wijst de weg) en help Moeder Vadsig haar kleine Guhbert terug te vinden. Als dank slikt ze je in: HAP!",
    "",
    "Dit is het enige hoofdstuk met een slotje: de maaggroottes (64 tot 128) komen echt na elkaar. Eerst smullen, dan groeien!",
  ],
  "quest.475548DFA0DC3DDF.title": "Het Vadsig-heiligdom",
  "quest.475548DFA0DC3DDF.quest_desc": [
    "Ergens in de Guhmensie woont &dMoeder Vadsig&r. Het heiligdomkompas (vadstemmer) wijst de weg.",
  ],
  "quest.475548ACA430C796.title": "Moeder Vadsig",
  "quest.475548ACA430C796.quest_desc": [
    "Praat met Moeder Vadsig. Haar kleine Guhbert is ontvoerd door de Mika's!",
  ],
  "quest.475548EB96E41B8A.title": "Bevrijd Guhbert",
  "quest.475548EB96E41B8A.quest_desc": [
    "Volg het Mika-spoorkompas naar het Mika-kamp en win steen-papier-schaar van de Mika-baas. Drie keer op rij...",
  ],
  "quest.475548A1B8585122.title": "De verloren taart",
  "quest.475548A1B8585122.quest_desc": [
    "Volg de taartkruimels naar een guh-picknick en vind de taart. Vergeet de 3 guh-ballonnen niet!",
  ],
  "quest.47554871B3B7E4D9.title": "NJEG... HAP!",
  "quest.47554871B3B7E4D9.quest_desc": [
    "Het feest bij Moeder Vadsig: ze slikt je in! Welkom in je eigen guhmaag, in haar buik. Buikfluitje of G om te reizen.",
  ],
  "quest.47554892BD9A2BCF.title": "Maagkrampjes (64x64)",
  "quest.47554892BD9A2BCF.quest_desc": [
    "Help de Tandarts-guh in haar mond: 64 kaasknabbels, 16 vadsstaven en 8 guhkristallen.",
  ],
  "quest.4755484136B113AA.title": "De Mika-geur (80x80)",
  "quest.4755484136B113AA.quest_desc": [
    "Versla een Grote Mika en breng 16 guhkristallen naar de tandarts.",
  ],
  "quest.4755480407F0DCF8.title": "Gouden visite (96x96)",
  "quest.4755480407F0DCF8.quest_desc": [
    "Neem een tamme Gouden Guh mee naar de tandarts, met 32 guhkristallen.",
  ],
  "quest.47554880B493F6FB.title": "Zachte maagwand (112x112)",
  "quest.47554880B493F6FB.quest_desc": [
    "32 guhslijmballen en 8 kaashoning maken haar maagwand zacht.",
  ],
  "quest.4755482253748309.title": "Een tuin in haar buik (128x128)",
  "quest.4755482253748309.quest_desc": [
    "16 guhbloesemboompjes, 48 kristallen en een volle Guhdex: de allergrootste maag!",
  ],
}
