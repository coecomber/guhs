{
  "chapter.4755488C63E04B2F.title": "&cThe Guhbelly",
  "chapter.4755488C63E04B2F.chapter_subtitle": [
    "5. NYEG... GULP! Welcome to the tummy",
  ],
  "quest.475548B3399FAB18.title": "How Do You Get Here?",
  "quest.475548B3399FAB18.quest_desc": [
    "This chapter comes after &dWelcome to the Guhmension!&r in &dThe Guhmension&r.",
    "",
    "Look there for the &dChonky Shrine&r (the Shrine Compass shows the way) and help Mother Chonky find her little Guhbert. As a thank-you, she swallows you: GULP!",
    "",
    "This is the only chapter with a lock: the belly sizes (64 to 128) really do come one after another. First feast, then grow!",
  ],
  "quest.475548DFA0DC3DDF.title": "The Chonky Shrine",
  "quest.475548DFA0DC3DDF.quest_desc": [
    "Somewhere in the Guhmension lives &dMother Chonky&r. The Shrine Compass (Chonk Tamer) shows the way.",
  ],
  "quest.475548ACA430C796.title": "Mother Chonky",
  "quest.475548ACA430C796.quest_desc": [
    "Talk to Mother Chonky. Her little Guhbert has been guhnapped by the Mikas!",
  ],
  "quest.475548EB96E41B8A.title": "Free Guhbert",
  "quest.475548EB96E41B8A.quest_desc": [
    "Follow the Mika Tracker Compass to the Mika Camp and beat the Mika Boss at rock-paper-scissors. Three times in a row...",
  ],
  "quest.475548A1B8585122.title": "The Lost Cake",
  "quest.475548A1B8585122.quest_desc": [
    "Follow the Cake Crumbs to a Guh Picnic and find the cake. Don't forget the 3 Guh Balloons!",
  ],
  "quest.47554871B3B7E4D9.title": "NYEG... GULP!",
  "quest.47554871B3B7E4D9.quest_desc": [
    "The party at Mother Chonky's: she swallows you! Welcome to your very own guhbelly, inside her tummy. Belly Whistle or G to travel.",
  ],
  "quest.47554892BD9A2BCF.title": "Tummy Aches (64x64)",
  "quest.47554892BD9A2BCF.quest_desc": [
    "Help the Dentist Guh in her mouth: 64 cheese nibbles, 16 Wahoog Chonk Ingots and 8 Guh Crystals.",
  ],
  "quest.4755484136B113AA.title": "That Mika Smell (80x80)",
  "quest.4755484136B113AA.quest_desc": [
    "Defeat a Big Mika and bring 16 Guh Crystals to the dentist.",
  ],
  "quest.4755480407F0DCF8.title": "A Golden Visit (96x96)",
  "quest.4755480407F0DCF8.quest_desc": [
    "Bring a tame Golden Guh along to the dentist, with 32 Guh Crystals.",
  ],
  "quest.47554880B493F6FB.title": "A Soft Belly Wall (112x112)",
  "quest.47554880B493F6FB.quest_desc": [
    "32 guh slimeballs and 8 Cheese Honey make her belly wall nice and soft.",
  ],
  "quest.4755482253748309.title": "A Garden in Her Tummy (128x128)",
  "quest.4755482253748309.quest_desc": [
    "16 Guh Blossom saplings, 48 crystals and a full Guhdex: the biggest belly of all!",
  ],
  "quest.4755488EDE0040A8.title": "Nibble Stomach",
  "quest.4755488EDE0040A8.quest_desc": [
    "Open your inventory: on the left hangs the &dGuh Tongue&r with your guh cells. Hover over it to see what you may eat and what is still locked. Vads that is too vadsy ends in a BURP. You lose nothing! Eat 100 cheese nibbles, satay or cheese chunks and your stomach grows more resistant.",
  ],
  "quest.475548B203273FBF.title": "Fryer Stomach",
  "quest.475548B203273FBF.quest_desc": [
    "Fried cheese nibbles, baked guh fish and cheese buns: eat 64 of them and your vads fills you better from now on.",
  ],
  "quest.475548C7298C0CB7.title": "Sauce-Tough Stomach",
  "quest.475548C7298C0CB7.quest_desc": [
    "Even vadsier: 48 times double fried, grilled satay or a portion of fries. After that, no more hunger cramps from rotten vads.",
  ],
  "quest.475548604AECEB61.title": "Indestructible Vads Stomach",
  "quest.475548604AECEB61.quest_desc": [
    "The heaviest of all: 32 times triple fried, cheese croquette or Frikandel Guhspeciaal. Then you may eat everything, your burp pushes mobs away and you wear the &6Vadsaura&r. VAHOEG!",
  ],
}
