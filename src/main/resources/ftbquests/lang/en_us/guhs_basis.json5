{
  "chapter_group.475548DB0F6F37EB.title": "&dGuhs",
  "chapter.475548D4D6AC1372.title": "&dGuhs \\& Basics",
  "chapter.475548D4D6AC1372.chapter_subtitle": [
    "1. Tame, dress and cuddle your guh. WAHOOG!",
  ],
  "quest.475548077F9CDE38.title": "How Do You Get Here?",
  "quest.475548077F9CDE38.quest_desc": [
    "You're already here! This is the very first chapter: every guh adventure starts here, with a handful of &6cheese nibbles&r.",
    "",
    "Read the chapters from top to bottom: &dGuhs \\& Basics&r > &dThe Guhmension&r > &6Minigames \\& Special Places&r > &9Underwater&r > &cThe Guhbelly&r > &5The Guh End&r > &6The Guhbarbecuether&r > &eCaves, Swamp \\& Woods&r > &dSnuggledale&r > &dSqueak!&r > &dSweet Chonkies&r > &dGuh Tales&r > &aCritters&r.",
    "",
    "At the top of every chapter there's a &dHow Do You Get Here?&r quest like this one, with a link to the quest in another chapter where it all starts.",
    "",
    "Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work! (Only the belly sizes in The Guhbelly really come one after another.)",
  ],
  "quest.4755481164F1D771.title": "Fry Chonk",
  "quest.4755481164F1D771.quest_desc": [
    "Fill the Guh Frying Pan with Mika's Grease and fry some cheese nibbles. Fried cheese nibbles make a tame guh all better in one go.",
  ],
  "quest.475548EA2B2676C2.title": "Guh!",
  "quest.475548EA2B2676C2.quest_desc": [
    "Welcome to the &dGuhs&r! Chubby pink plushie mice that wander around everywhere. It all starts with &6cheese nibbles&r: that's how you tame, heal and breed guhs.",
  ],
  "quest.475548789D9A06CA.title": "A Chonky Buddy",
  "quest.475548789D9A06CA.quest_desc": [
    "Feed a wild guh cheese nibbles until it's tame (1 in 3 chance per nibble). A tame guh gets 1000 health! Tap it with a short right-click to &dpet&r it; hold right-click for its menu (sit, emotes, clothes and more).",
  ],
  "quest.475548E1C8AC3399.title": "Dress Up!",
  "quest.475548E1C8AC3399.quest_desc": [
    "Clothes are now an &dunlock&r: hold right-click with a piece of clothing and all your guhs can wear it. Right-click your tame guh and pick &dWardrobe&r: try on everything you have, spin your guh around and click &6Dress Up!&r. A guh also has an armor slot and (with the Guh Backpack, craft it yourself) 18 extra slots.",
  ],
  "quest.475548059763450F.title": "Giddy-Up, Guh!",
  "quest.475548059763450F.quest_desc": [
    "You can ride a big guh (at least ~1.7 blocks) with a saddle.",
  ],
  "quest.475548E655785894.title": "WAHOOG, Launch!",
  "quest.475548E655785894.quest_desc": [
    "Ride your own guh with an empty hand and right-click: it sucks in air and... whoosh, off it shoots! Right-click again to lock the distance.",
  ],
  "quest.475548E81EBD2AE5.title": "Common Guh",
  "quest.475548E81EBD2AE5.quest_desc": [
    "Get close to a &dCommon Guh&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.47554885C5DA9678.title": "Mint Guh",
  "quest.47554885C5DA9678.quest_desc": [
    "Get close to a &dMint Guh&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.475548B26992642F.title": "Choco Guh",
  "quest.475548B26992642F.quest_desc": [
    "Get close to a &dChoco Guh&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.475548D5686D7169.title": "Snow Guh",
  "quest.475548D5686D7169.quest_desc": [
    "Get close to a &dSnow Guh&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.475548780D32D11B.title": "Brontosaurus Guh",
  "quest.475548780D32D11B.quest_desc": [
    "Get close to a &dBrontosaurus Guh&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.4755484D7AC1CC31.title": "Dachshund Guh",
  "quest.4755484D7AC1CC31.quest_desc": [
    "Get close to a &dDachshund Guh&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.475548449E1F51A4.title": "Ghost Guh",
  "quest.475548449E1F51A4.quest_desc": [
    "Get close to a &dGhost Guh&r (within 3 blocks) so it goes into your Guhdex. Only at night!",
  ],
  "quest.4755483728B39997.title": "Star Guh",
  "quest.4755483728B39997.quest_desc": [
    "Get close to a &dStar Guh&r (within 3 blocks) so it goes into your Guhdex. Only comes with a star shower!",
  ],
  "quest.475548C626196F38.title": "Rainbow Guh",
  "quest.475548C626196F38.quest_desc": [
    "Get close to a &dRainbow Guh&r (within 3 blocks) so it goes into your Guhdex. Very rare!",
  ],
  "quest.4755487B05630BA3.title": "King Guh",
  "quest.4755487B05630BA3.quest_desc": [
    "Get close to a &dKing Guh&r (within 3 blocks) so it goes into your Guhdex. It sits on its throne in the legendary Guh Castle.",
  ],
  "quest.47554802FBC05DBB.title": "Golden Guh",
  "quest.47554802FBC05DBB.quest_desc": [
    "Get close to a &dGolden Guh&r (within 3 blocks) so it goes into your Guhdex. Very rare!",
  ],
  "quest.475548A9A60F432E.title": "broccocutie",
  "quest.475548A9A60F432E.quest_desc": [
    "Get close to a &dbroccocutie&r (within 3 blocks) so it goes into your Guhdex. A mysterious guh with a little note...",
  ],
  "quest.475548B724855F37.title": "Travel Guh",
  "quest.475548B724855F37.quest_desc": [
    "Get close to a &dTravel Guh&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.4755480BC93832DB.title": "Gatekeeper",
  "quest.4755480BC93832DB.quest_desc": [
    "Get close to a &dGatekeeper&r (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.475548814D674562.title": "Guhdex Complete!",
  "quest.475548814D674562.quest_desc": [
    "You've seen every kind of guh. A true wahoog guh expert!",
  ],
  "quest.475548426B645689.title": "Guh Cake",
  "quest.475548426B645689.quest_desc": [
    "A pink cake with guh eyes, 7 bites.",
  ],
  "quest.4755482C6BBCCFA2.title": "Guhcarons",
  "quest.4755482C6BBCCFA2.quest_desc": [
    "All four Guhcarons!",
  ],
  "quest.47554898254AE1BC.title": "Cheese Fondguh",
  "quest.47554898254AE1BC.quest_desc": [
    "A warm bowl of Cheese Fondguh.",
  ],
  "quest.4755485FFC7D46CF.title": "Wahoog Cheese Nibble Shake",
  "quest.4755485FFC7D46CF.quest_desc": [
    "Clears all your effects, just like milk.",
  ],
  "quest.475548FD87F5969E.title": "Guh Furniture",
  "quest.475548FD87F5969E.quest_desc": [
    "A Guh Chair and a Chonk Couch: take a comfy seat.",
  ],
  "quest.475548286E402328.title": "Chonkbag",
  "quest.475548286E402328.quest_desc": [
    "A Chonkbag in your favorite color.",
  ],
  "quest.475548F986391308.title": "Languhtern",
  "quest.475548F986391308.quest_desc": [
    "Light for the guh garden.",
  ],
  "quest.4755485EDA0EA987.title": "Guh Wheel",
  "quest.4755485EDA0EA987.quest_desc": [
    "Put your tame guh in a Guh Wheel: full redstone power!",
  ],
  "quest.4755485299AA59F1.title": "Baking on Guh Power",
  "quest.4755485299AA59F1.quest_desc": [
    "A &dGuh Oven&r (8 cobblestone around a cheese nibble) needs no coal: it bakes on guh power! Put it next to a running &dGuh Wheel&r, or hook it up with &dGuh Wire&r. It doesn't care for plain redstone. The little guh runs, the oven bakes. Nyeg!",
  ],
  "quest.47554803591FB2A0.title": "Look What I Can Do!",
  "quest.47554803591FB2A0.quest_desc": [
    "Hold right-click on your tame guh, pick &dEmotes&r and have it do something: wave, dance, sleep, a &6WAHOOG&r jump, roll, munch or act shy.",
  ],
  "quest.475548AC4FE25CAA.title": "Its Favorite Emote",
  "quest.475548AC4FE25CAA.quest_desc": [
    "Give your guh a &dfavorite emote&r (the little star in the Emotes menu). From then on it does it every now and then all by itself.",
  ],
  "quest.4755489FD1CAF372.title": "Guh's Got Talent",
  "quest.4755489FD1CAF372.quest_desc": [
    "Have your guhs do every emote once (yawning, singing, cuddling and the sniffles too). The heart emotes don't count: you unlock those with hearts. It can do more than just be chonky!",
  ],
  "quest.475548C7B2AFF898.title": "Guh Disco",
  "quest.475548C7B2AFF898.quest_desc": [
    "Play some music in a jukebox. Guhs nearby just can't help it: they start to &ddance&r! (Wait around for a bit, tame or wild.)",
  ],
  "quest.4755486B4BBD3C64.title": "Hiya!",
  "quest.4755486B4BBD3C64.quest_desc": [
    "Walk up to a &dwild&r guh. With a bit of luck it waves at you! (Shy guhs would rather act shy.)",
  ],
  "quest.475548F8EC553ED3.title": "Unlocked!",
  "quest.475548F8EC553ED3.quest_desc": [
    "Buy a piece of clothing (from the &dGuh Tailor&r in a guh village, or in one of the minigames) and &dhold right-click&r. Pop! Now all your tame guhs can wear it, as often as you like.",
  ],
  "quest.475548A791E693C6.title": "All Ears",
  "quest.475548A791E693C6.quest_desc": [
    "Guhs now have a spot for their &dears&r! The tailor sells pink, mint and yellow Ear Bows. Unlock one and put it on in the wardrobe.",
  ],
  "quest.47554820558D9EA6.title": "My Favorite Outfit",
  "quest.47554820558D9EA6.quest_desc": [
    "Put together a cute outfit in the wardrobe (or click &eRoll the Dice!&r) and &eshift-click&r a little number: that saves it as a fave. One click on the number and your guh tries it on again.",
  ],
  "quest.475548C45FC7C462.title": "From Head to Toe",
  "quest.475548C45FC7C462.quest_desc": [
    "Unlock every piece of a set: everything from the tailor, or a minigame's whole outfit. In the Guhdex (Clothes tab) you can see per place what you're still missing.",
  ],
  "quest.47554815132E332B.title": "A Chonky Wardrobe",
  "quest.47554815132E332B.quest_desc": [
    "Unlock &e25 pieces of clothing&r. Every minigame has its own outfit, and treasure chests hold lots more!",
  ],
  "quest.475548EC8DC6CA2E.title": "The Snazziest Guh in the Guhmension",
  "quest.475548EC8DC6CA2E.quest_desc": [
    "Unlock &660 pieces of clothing&r. So many clothes, your guhs don't know what to wear anymore. WAHOOG!",
  ],
}
