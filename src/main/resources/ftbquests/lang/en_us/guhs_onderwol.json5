{
  "chapter.4755488927D41F42.title": "&dOnder de Wol",
  "chapter.4755488927D41F42.chapter_subtitle": [
    "16. Mijnen, grotten en glinsters onder de Guhmensie",
  ],
  "quest.475548E2E5895B46.title": "Hoe kom je hier?",
  "quest.475548E2E5895B46.quest_desc": [
    "Dit hoofdstuk komt na &dWelkom in de Guhmensie!&r in &dDe Guhmensie&r: pak een houweel en graaf naar beneden.",
    "",
    "Onder de roze wol liggen lagen &dviltsteen&r, &dknuffelsteen&r en &dguhkristalsteen&r, met ertsen in elke laag, grotten met hun eigen sfeer (en een vrolijk muziekje), sausmeren, wezens en tientallen gebouwen. Het &6superkompas&r (tab &6Ondergrond&r) wijst de weg naar de gebouwen, en de grot-minigames staan bij &6Minigames&r.",
    "",
    "Alles hier vind je alleen in nieuwe stukken wereld. Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.475548C06561D026.title": "Onder de wol",
  "quest.475548C06561D026.quest_desc": [
    "Graaf door de roze wol naar beneden. Een eindje onder het oppervlak houdt de wol op en begint de &dviltsteen&r: zacht, snel te hakken en de eerste laag van de Guhmensie-ondergrond. Hak er 16!",
  ],
  "quest.4755485207448E5F.title": "Vilt in alle vormen",
  "quest.4755485207448E5F.quest_desc": [
    "Viltsteen is ook een mooi bouwblok: gepolijst, als bakstenen, tegels of gebeiteld, met trapjes, plaatjes en muurtjes. Maak ze aan de werkbank of op de steenzaag. Begin met viltsteen bakstenen.",
  ],
  "quest.4755488508CB5B71.title": "Knuffelsteen in bulk",
  "quest.4755488508CB5B71.quest_desc": [
    "Dieper wordt de steen harder: de &dknuffelsteen&r. Vroeger was die duur, nu hak je hem gewoon uit de grond. Onder bergen begint hij hoger, onder dalen en zee lager.",
  ],
  "quest.475548BE98526A69.title": "Roze aders",
  "quest.475548BE98526A69.quest_desc": [
    "Door de knuffelsteen lopen roze aders van &droze knuffelsteen&r, met hier en daar belletjes roze wol en rozenkwarts-druppels aan de wanden.",
  ],
  "quest.475548744358EB41.title": "De diepe laag",
  "quest.475548744358EB41.quest_desc": [
    "Nog dieper, waar de grotten gigantisch worden: de &dguhkristalsteen&r. Daaronder ligt alleen nog de &5knuffelnaad&r: daar kom je niet doorheen, njeg.",
  ],
  "quest.475548460D12F18C.title": "Guhklei",
  "quest.475548460D12F18C.quest_desc": [
    "In de viltsteen en de knuffelsteen zitten grote klodders &dguhklei&r. Hak je ze gewoon, dan krijg je kleiballetjes (voor bakstenen). Met Zijdezacht houd je het blok heel, en dat bak je tot roze terracotta. De Mijnwerker in het Vadsmijnstadje verkoopt het ook.",
  ],
  "quest.475548E6FFA6D000.title": "Viltkiezel",
  "quest.475548E6FFA6D000.quest_desc": [
    "Langs beekjes en oevers ligt &dviltkiezel&r: zacht grind van viltbolletjes. Het valt net als grind.",
  ],
  "quest.4755483AC2433ECA.title": "IJzer in de viltsteen",
  "quest.4755483AC2433ECA.quest_desc": [
    "Elke laag heeft zijn eigen ertsen: kolen, koper, ijzer, goud, lapis, redstone, diamant en smaragd, net als in de overworld, maar dan in viltsteen, knuffelsteen of kristalsteen. IJzer zit het meest rond de grens van viltsteen en knuffelsteen.",
  ],
  "quest.475548BBB33321A2.title": "Vads uit de steen",
  "quest.475548BBB33321A2.quest_desc": [
    "Vads-erts zit in de knuffelsteen en de kristalsteen, het meest diep beneden. Dieper is rijker!",
  ],
  "quest.4755480C6A8F5ABA.title": "Kaaskorrels",
  "quest.4755480C6A8F5ABA.quest_desc": [
    "Rond de sausmeren zit kaaskorrelerts. Hak het en je krijgt kaaskorrels.",
  ],
  "quest.47554814C85ED327.title": "Pastel uit de steen",
  "quest.47554814C85ED327.quest_desc": [
    "Pigmenterts in de knuffelsteen geeft pastelkleurstof, en dieper zitten de zeldzamere kleuren. Precies goed voor pastelbakstenen en pleister! Begin met roze.",
  ],
  "quest.475548B0FC9E29E4.title": "Diamant in de kristalsteen",
  "quest.475548B0FC9E29E4.quest_desc": [
    "Diamanterts zit vooral diep in de guhkristalsteen. Neem een goede houweel mee!",
  ],
  "quest.4755489643C5D067.title": "VAHOEGIET!",
  "quest.4755489643C5D067.quest_desc": [
    "Het zeldzaamste erts: &5Vahoegiet&r. Alleen in de guhkristalsteen, heel diep, en in de knuffelhart-geodes. Je hebt het nodig voor het Glinsteraltaar, het rugzakzadel, super vahoege vads en het mijn-guhhuisje.",
  ],
  "quest.475548DD3F28574D.title": "De Pluisgrot",
  "quest.475548DD3F28574D.quest_desc": [
    "Een zachte grot in de viltsteen: pluiswol, pluisgras, pluisbolletjes en pluiskussens waarop je zacht landt (met een stuitertje).",
  ],
  "quest.47554840854191D9.title": "De Slaapgrot",
  "quest.47554840854191D9.quest_desc": [
    "Een grot vol pluiskussens en wol, met nachtlampjes. Er liggen wilde guhs te slapen: zzz... Aai er een en hij wordt wakker.",
  ],
  "quest.475548BA15916DE8.title": "De Knuffelwortelgrot",
  "quest.475548BA15916DE8.quest_desc": [
    "Alleen onder bossen: hangende knuffelboomwortels, mos en zachte knuffelwortelaarde.",
  ],
  "quest.475548BAFFF723D3.title": "De Glitterspelonk",
  "quest.475548BAFFF723D3.quest_desc": [
    "Roze lichtmos, glitterranken met glitterbessen, glinsterpaddenstoeltjes en wilde glimwormpjes. Het glinstert alle kanten op!",
  ],
  "quest.47554869EDD3B162.title": "De Belletjesgrot",
  "quest.47554869EDD3B162.quest_desc": [
    "Kristallen die een toontje spelen als je erop stapt of ertegen tikt. Elke plek heeft zijn eigen toon: speel een liedje!",
  ],
  "quest.4755487F50CAC044.title": "De Kristalpegelgrot",
  "quest.4755487F50CAC044.quest_desc": [
    "Roze guhkristal-pegels aan het plafond en op de vloer, met druppeltjes kaassaus. Pas op je hoofd: een vallende pegel doet au!",
  ],
  "quest.475548D099F17C9A.title": "Glitterbessen",
  "quest.475548D099F17C9A.quest_desc": [
    "Pluk een glitterbes van een glitterrank in de Glitterspelonk (rechtsklik). Lekker glinsterig!",
  ],
  "quest.4755484F490023B0.title": "Ding dong guh",
  "quest.4755484F490023B0.quest_desc": [
    "Neem een belletjeskristal mee uit de Belletjesgrot en bouw thuis je eigen guh-xylofoon.",
  ],
  "quest.4755482971DBC4D2.title": "De Grotguh",
  "quest.4755482971DBC4D2.quest_desc": [
    "In de grotten wonen vooral gewone wilde guhs, maar heel soms zie je een &dGrotguh&r: donkerroze, met kristalspikkels die in het donker zacht oplichten. In de Glitterspelonk iets vaker. Kom dichtbij voor je Guhdex.",
  ],
  "quest.4755486EE34554A2.title": "Kopje!",
  "quest.4755486EE34554A2.quest_desc": [
    "In de viltsteen- en knuffelsteengrotten steekt soms een &dMolguh&r met een brilletje zijn kopje uit de grond. Hij laat wel eens wat achter: guhklei, kleurstof of (heel soms) Vahoegiet. Kom dichtbij voor je Guhdex.",
  ],
  "quest.475548E834B2AC9A.title": "De verlaten guhmijn",
  "quest.475548E834B2AC9A.quest_desc": [
    "Een oud gangennet van de mijnguhs, net een mineshaft: kistsleetjes, een schaftkantine, een sleedepot en hier en daar een ingestort stuk. Kijk in de sleetjes! (Superkompas: Ondergrond.)",
  ],
  "quest.47554884F7F36C5E.title": "Grotschilderingen",
  "quest.47554884F7F36C5E.quest_desc": [
    "Een hoge zaal met een groot fresco rondom: hoe alles roze werd, en het Knuffelhart. Lees de bordjes bij elk tafereel. (Superkompas: Ondergrond.)",
  ],
  "quest.4755487E4EFDA62A.title": "Het sausmeer-vissershutje",
  "quest.4755487E4EFDA62A.quest_desc": [
    "Een hutje op palen aan een warm kaassausmeer. De vissen bijten niet, de kaas wel. (Superkompas: Ondergrond.)",
  ],
  "quest.475548F8A6E01E87.title": "Het verlaten sledestation",
  "quest.475548F8A6E01E87.quest_desc": [
    "Perrons, sleetjes en een loket, diep onder de grond. Vertrek: nooit. (Superkompas: Ondergrond.)",
  ],
  "quest.475548A31EB03FE3.title": "Kaasmakerij De Gouden Saus",
  "quest.475548A31EB03FE3.quest_desc": [
    "Sauspompen, kaasvaten en reuzenkaaswielen aan een warm sausmeer. Niet in het vat duiken! (Superkompas: Ondergrond.)",
  ],
  "quest.475548E43C921496.title": "Het verzonken guhhuisje",
  "quest.475548E43C921496.quest_desc": [
    "Huize Pluis zakte ooit door de wol. Scheef, bemost, en er woont nog steeds iemand. (Superkompas: Ondergrond.)",
  ],
  "quest.475548BEEA704CE6.title": "Het reuzenguh-fossiel",
  "quest.475548BEEA704CE6.quest_desc": [
    "Het skelet van een oer-guh, diep in de kristalsteen. Ja, de oren waren echt zo groot. (Superkompas: Ondergrond.)",
  ],
  "quest.4755485D4FD81C35.title": "De kristalkwekerij",
  "quest.4755485D4FD81C35.quest_desc": [
    "Kweekbedden vol guhkristallen in vier groeistadia. Niet aankomen, ze groeien nog! (Superkompas: Ondergrond.)",
  ],
  "quest.47554814EE68D972.title": "De verdwaalde bouwploeg",
  "quest.47554814EE68D972.quest_desc": [
    "Een achtergelaten bouwplaats: een halve gang, een kraantje en stapels bouwstoffen. Waar zijn de bouwguhs gebleven? (Superkompas: Ondergrond.)",
  ],
  "quest.4755487C3776AE7E.title": "De Grotguh-holen",
  "quest.4755487C3776AE7E.quest_desc": [
    "Het knusse thuis van de Grotguhs: slaapholletjes, een kampvuur en een knabbelvoorraad. (Superkompas: Ondergrond.)",
  ],
  "quest.4755485369CA2E0B.title": "Badhuis De Warme Knabbel",
  "quest.4755485369CA2E0B.quest_desc": [
    "Een Romeins badhuis onder de wol: drie badzalen, knabbelbadjes en kaasshakes. Niet rennen, wel vadsen! In de kisten liggen soms een &dbadjasje&r en een &dhanddoek-tulband&r. (Superkompas: Ondergrond.)",
  ],
  "quest.47554840B53ECE83.title": "De Grotdisco",
  "quest.47554840B53ECE83.quest_desc": [
    "Een geheime disco in een kristalgeode. DJ Njeg draait, de guhs dansen vadskracht bij elkaar. (Superkompas: Ondergrond.)",
  ],
  "quest.475548A308D151F2.title": "De oude wolspinnerij",
  "quest.475548A308D151F2.quest_desc": [
    "De Wolclub: guhs spinnen gezellig wol rond theetafeltjes, en een waterrad geeft vadskracht. Pauze is om de vijf minuten. (Superkompas: Ondergrond.)",
  ],
  "quest.475548E9A8ECC5D4.title": "De Sterrengrot",
  "quest.475548E9A8ECC5D4.quest_desc": [
    "Een stille koepelgrot met een sterrenplafond, een picknick en een sterrenvijvertje. Wens iets bij een vallende ster (liefst kaasknabbels). (Superkompas: Ondergrond.)",
  ],
  "quest.475548BB2A548A7E.title": "De Knuffelslaapzaal",
  "quest.475548BB2A548A7E.quest_desc": [
    "Een ondergrondse slaapzaal vol hemelbedjes en slapende guhs. Sssst! In de kisten ligt soms een &dslaapmutsje&r. (Superkompas: Ondergrond.)",
  ],
  "quest.4755481A6712783B.title": "Het Paddenstoelendorpje",
  "quest.4755481A6712783B.quest_desc": [
    "Reuzenpaddenstoelen met een huisje in de hoed: ga door het deurtje in de steel naar boven. Met lampjes aan touwtjes en een glinsterbeekje. (Superkompas: Ondergrond.)",
  ],
  "quest.475548CC9AE67554.title": "De Knuffelkuil",
  "quest.475548CC9AE67554.quest_desc": [
    "Een ballenbak vol knuffelblokken. Zes guhtjes spelen verstoppertje: vind ze allemaal! Schoenen uit. (Superkompas: Ondergrond.)",
  ],
  "quest.47554879E81F60D6.title": "Het Verrassingsfeestje",
  "quest.47554879E81F60D6.quest_desc": [
    "Een verborgen grot waar guhs een verjaardagsfeestje voorbereiden, met een reuzentaart. Sssst, niks verklappen! In de kisten liggen soms een &dfeesthoedje&r en een &dslinger-sjaaltje&r. (Superkompas: Ondergrond.)",
  ],
  "quest.47554816ECE7CB9E.title": "De oude guhtempel",
  "quest.47554816ECE7CB9E.quest_desc": [
    "Heel zeldzaam: het enorme tempelcomplex van de oude guhs, half ingegraven, met De Grote Guh en de Gouden Kaasknabbel. Pas op voor de lieve valkuiltjes, en zoek het lichtpad naar de geheime kamer. (Superkompas: Ondergrond.)",
  ],
  "quest.4755487C966424D3.title": "De oude bankkluis",
  "quest.4755487C966424D3.quest_desc": [
    "Heel zeldzaam: de oude kluis van de Bank Guh. Iemand heeft geprobeerd in te breken. Iemand met een snor... (Superkompas: Ondergrond.)",
  ],
  "quest.47554807ED2DDCEC.title": "Een super sjabloon",
  "quest.47554807ED2DDCEC.quest_desc": [
    "In de kisten van de oude guhtempel en de oude bankkluis ligt soms een &5super-vads-sjabloon&r. Zuinig op zijn! Kopiëren kan: 7 Vahoegiet en een guhkristalsteen.",
  ],
  "quest.47554877F6655F21.title": "Het mijningang-hutje",
  "quest.47554877F6655F21.quest_desc": [
    "Boven de grond staat soms een hutje met een &dwolkenliftje&r: spring erop en je zweeft naar beneden. Hier begint je mijn! (Superkompas: Ondergrond.)",
  ],
  "quest.475548AC74050099.title": "Het Mijnguhdorp",
  "quest.475548AC74050099.quest_desc": [
    "Onder de grond ligt het dorp van de &dMijnguh&r (er ligt er altijd een niet al te ver van het midden van de wereld), rond een warm sausmeer, met een wolkenlift naar boven. Hij heeft een klusje voor je: zie &6Mijnguh-hulpje&r bij de kaasmijn. (Superkompas: Ondergrond.)",
  ],
  "quest.47554836F9048A00.title": "Een rugzak vol grond",
  "quest.47554836F9048A00.quest_desc": [
    "Maak een &6rugzakzadel&r (een zadel, een kist, roze wol en een Vahoegiet) en doe het je tamme guh om. Hij loopt met je mee en raapt alle gewone grondblokken op die je weghakt: wol, de laagstenen, aarde, zand... In zijn rugzak past eindeloos veel. In het schermpje haal je het eruit, of je stuurt alles naar je Bank Guh.",
  ],
  "quest.47554834F6C3EDE9.title": "Het Vadsmijnstadje",
  "quest.47554834F6C3EDE9.quest_desc": [
    "In een grote grotzaal ligt een heel stadje vol guh-villagers, met een Guhrad-centrale op het plein die het dorp van vadskracht voorziet. Er wonen vier nieuwe beroepen: de Toverguh, de Vadsmonteur, de Mijnwerker en de Kristalslijper. En de IJzerguhlem past op, net als een ijzergolem. (Superkompas: Ondergrond.)",
  ],
  "quest.47554808207E5C87.title": "Even oppakken",
  "quest.47554808207E5C87.quest_desc": [
    "Sluip en klik met een lege hand op een villager (een guh-villager of een gewone): je pakt hem op, met zijn naam, beroep en ruilaanbiedingen. Klik op een blok om hem weer neer te zetten. Handig bij het verhuizen!",
  ],
  "quest.475548B819CCDAC3.title": "Een nieuw beroep",
  "quest.475548B819CCDAC3.quest_desc": [
    "Maak de werkplek van een van de nieuwe beroepen: de Toverguh-boekenstandaard, de Guhrad-werkbank, de Ertsenkist of de Kristalslijpsteen. Zet hem bij een villager zonder werk en hij krijgt dat beroep. Begin met de Guhrad-werkbank van de Vadsmonteur.",
  ],
  "quest.4755487C6CC95ACA.title": "Het Glinsteraltaar",
  "quest.4755487C6CC95ACA.quest_desc": [
    "Het guh-betoveraltaar: een boek, twee Vahoegiet, een guhkristal en drie guhkristalsteen. Net als een betoveringstafel kost het lapis en levels. Je krijgt de nuttige vanilla-betoveringen, en guh-spreuken die alleen hier te krijgen zijn: &dMika-mepper&r, &dPluisval&r, &dGlitterzicht&r, &dVadsvlijt&r en &dBakvads&r. De Toverguh verkoopt Spreukjesboekjes met nog meer: &dSpaarguhtje&r, &dAaizacht&r en &dKaasknabbelgeur&r.",
  ],
  "quest.475548A12E2F162C.title": "Knuffelboekenkasten",
  "quest.475548A12E2F162C.quest_desc": [
    "Het Glinsteraltaar wordt sterker van &dknuffelboekenkasten&r om hem heen (gewone boekenkasten tellen niet mee). Je ziet hartjes van de kasten naar het altaar vliegen. Maak er een paar van guhbloesemplanken, roze wol en boeken.",
  ],
  "quest.47554851D66A5CDF.title": "De Vahoege Vadsknakker",
  "quest.47554851D66A5CDF.quest_desc": [
    "Gooi een vahoege vadspaxel, een vahoege vadsschaar en een vahoege vads-schoffel samen aan de werkbank: houweel, bijl, schep, schoffel en schaar in één! Hun betoveringen gaan mee. Rechtsklik doet slim: gras wordt een akkertje, stammen worden gestript, een schaap wordt geknipt. Sluipen en rechtsklik op gras: een paadje.",
  ],
  "quest.4755484747A594CD.title": "De Vahoegietstaaf",
  "quest.4755484747A594CD.quest_desc": [
    "Vier Vahoegiet en vier vahoege vads-staven worden een &5Vahoegietstaaf&r.",
  ],
  "quest.475548973E8AE280.title": "Super vahoege vads",
  "quest.475548973E8AE280.quest_desc": [
    "Op de smidstafel: het super-vads-sjabloon, een stuk vahoege vads en een Vahoegietstaaf. Zo maak je je vads-spullen super, zo sterk als netherite. Begin met een super vahoege vads-houweel.",
  ],
  "quest.47554898D0F31280.title": "Het wolkenliftje",
  "quest.47554898D0F31280.quest_desc": [
    "Zet een wolkenliftje onderin je mijn en een recht erboven op de grond. Spring erop en je zweeft omhoog naar het volgende; sluip en je gaat omlaag.",
  ],
  "quest.475548A8239B7775.title": "De pluisladder",
  "quest.475548A8239B7775.quest_desc": [
    "Zet een pluisladder tegen de wand aan de rand van een gat: hij rolt vanzelf uit tot de bodem.",
  ],
  "quest.475548FDFFFCF0C0.title": "Een lampje voor je guh",
  "quest.475548FDFFFCF0C0.quest_desc": [
    "Een roze helmpje met een lampje (lantaarn en roze wol). Zet het je guh op: hij geeft licht in het donker, waar hij ook loopt. Een lopend lampje!",
  ],
  "quest.475548130C0384F6.title": "Een groter terrarium",
  "quest.475548130C0384F6.quest_desc": [
    "Terraria zijn nu zo groot als je wilt: alles wat met terrariumglas en terrariumbodem aan elkaar vast zit is één leefruimte, ook met gangetjes en in elke vorm. Maak terrariumbodem van terrariumglas, zand en gestripte eik.",
  ],
  "quest.475548BE092F7DCE.title": "De Bloemenvallei",
  "quest.475548BE092F7DCE.quest_desc": [
    "Een kleine, zeldzame vallei vol bloemen in alle guh-kleuren, met bijtjes, vlindertjes en pluisjes in de lucht.",
  ],
  "quest.4755486F44BFD227.title": "Van bron naar bron",
  "quest.4755486F44BFD227.quest_desc": [
    "De Guhmensie heeft nu beekjes: ze kronkelen van het ene bronnetje naar het andere, met roze glinsters boven het water en glinsterriet langs de kant. Neem een bronnetje mee voor je eigen vijver.",
  ],
  "quest.475548F97C102D7B.title": "Een roze strandje",
  "quest.475548F97C102D7B.quest_desc": [
    "Naast de gewone stranden liggen nu ook roze strandjes, met schelpjes. Schep wat roze zand.",
  ],
  "quest.475548419B888EB9.title": "Hartjesmeertjes",
  "quest.475548419B888EB9.quest_desc": [
    "Van boven zie je het pas: sommige meertjes hebben de vorm van een hartje, met een bloemenrand. Pluk een hartjeslelie.",
  ],
  "quest.47554832468B854A.title": "Schatgraven",
  "quest.47554832468B854A.quest_desc": [
    "Boven de grond staat een hutje met een wolkenliftje naar beneden. In de grot daaronder wacht &6Kapitein Schepsnuit&r met &6Snuffie&r (Superkompas: Minigames).",
  ],
  "quest.475548728B5CFC06.title": "Koud, warm, HEET!",
  "quest.475548728B5CFC06.quest_desc": [
    "Graaf schatten op met het zachte schepje. Snuffie piept koud, warm of HEET en springt als je er bijna bent. Een gouden kaasje is een bonus, een piepkaas kost tijd. Je verdient &6schatmuntjes&r.",
  ],
  "quest.475548FF86794E52.title": "Ahoi, piraatje!",
  "quest.475548FF86794E52.quest_desc": [
    "Koop het piratenhoedje en het oogklepje bij Kapitein Schepsnuit, voor schatmuntjes.",
  ],
  "quest.475548250C3E6B6B.title": "Glimwormvangen",
  "quest.475548250C3E6B6B.quest_desc": [
    "Onder een hutje met een wolkenliftje ligt een donkere zaal vol glimwormpjes. Daar woont &6Juf Glimmie&r (Superkompas: Minigames).",
  ],
  "quest.47554881F9BCE516.title": "Vang ze met je netje",
  "quest.47554881F9BCE516.quest_desc": [
    "Vang zoveel glimwormpjes als je kunt. Het potje op je rug gaat gloeien en de zaal wordt steeds lichter. Een gouden glimworm telt extra! Je verdient &6glimmertjes&r.",
  ],
  "quest.475548A437653A6F.title": "Zelf een glimwormpje",
  "quest.475548A437653A6F.quest_desc": [
    "Koop de glimworm-antennetjes en het vlindernetje bij Juf Glimmie, voor glimmertjes.",
  ],
  "quest.47554832CEE0E7B8.title": "De Lichtjespuzzel",
  "quest.47554832CEE0E7B8.quest_desc": [
    "Onder een hutje met een wolkenliftje ligt een grot met een groot raster van paddenstoellampjes. &6Meester Knipperlicht&r legt het uit (Superkompas: Minigames).",
  ],
  "quest.4755481F558E3C0F.title": "Alle lampjes aan!",
  "quest.4755481F558E3C0F.quest_desc": [
    "Een lampje springt om, samen met zijn vier buren. Krijg ze allemaal aan voor de tijd om is. Elk potje een nieuwe puzzel! Je verdient &6lampjesmunten&r.",
  ],
  "quest.475548A59772AB66.title": "Een gloeiend hoedje",
  "quest.475548A59772AB66.quest_desc": [
    "Koop het gloeiende paddenstoelhoedje bij Meester Knipperlicht, voor lampjesmunten.",
  ],
  "quest.475548D1185FF884.title": "De Wisselgrot",
  "quest.475548D1185FF884.quest_desc": [
    "Onder een hutje met een wolkenliftje ligt een grot vol mijnsporen. &6Conducteur Piepwiel&r zoekt een wisselwachter (Superkompas: Minigames).",
  ],
  "quest.4755487F34EB4DEE.title": "Wissels om!",
  "quest.4755487F34EB4DEE.quest_desc": [
    "Sta op het balkon en zet de wissels met de hendels, zodat elk ertskarretje in de bak van zijn eigen kleur rolt. Drie karretjes kwijt en het is klaar. Je verdient &6ertsbonnetjes&r.",
  ],
  "quest.4755489ADDC2EC9F.title": "Op tijd, op het spoor",
  "quest.4755489ADDC2EC9F.quest_desc": [
    "Breng 25 karretjes goed aan in een dienst.",
  ],
  "quest.475548B5198CD2CE.title": "Hoofdwisselwachter",
  "quest.475548B5198CD2CE.quest_desc": [
    "Breng 40 karretjes goed aan op het lastige net.",
  ],
  "quest.475548E53122893B.title": "Conducteur!",
  "quest.475548E53122893B.quest_desc": [
    "Koop het conducteurspetje bij Conducteur Piepwiel, voor ertsbonnetjes.",
  ],
  "quest.475548AD62B7D655.title": "De Kegelgrot",
  "quest.475548AD62B7D655.quest_desc": [
    "Onder een hutje met een grote kegel op het dak ligt een bowlingbaan in de grot. &6De Guhde&r leent je een wolbal (Superkompas: Minigames).",
  ],
  "quest.475548DD1B815C39.title": "Tien frames",
  "quest.475548DD1B815C39.quest_desc": [
    "Speel een hele partij: kijk waar de bal heen moet, houd rechtsklik vast voor kracht en laat los. Sta wat opzij voor een beetje effect. Je verdient &6kegelknopen&r.",
  ],
  "quest.475548E32E032C41.title": "STRIKE!",
  "quest.475548E32E032C41.quest_desc": [
    "Gooi alle tien de pluchen guh-kegeltjes in een keer om. Piep piep piep!",
  ],
  "quest.475548882DF00EC3.title": "Honderdvijftig",
  "quest.475548882DF00EC3.quest_desc": [
    "Gooi 150 punten of meer in een partij.",
  ],
  "quest.475548F75AE7E0B9.title": "De perfecte partij",
  "quest.475548F75AE7E0B9.quest_desc": [
    "300 punten: twaalf strikes op rij. The Guhde abides.",
  ],
  "quest.475548CF4C312BA9.title": "Bowlingkampioen",
  "quest.475548CF4C312BA9.quest_desc": [
    "Koop het bowlingshirtje en het kegelzweetbandje bij De Guhde, voor kegelknopen.",
  ],
}
