{
  "chapter.47554801AB930A56.title": "&9Underwater",
  "chapter.47554801AB930A56.chapter_subtitle": [
    "4. Blub blub guh: the Deep Guh Sea",
  ],
  "quest.475548505846658B.title": "How Do You Get Here?",
  "quest.475548505846658B.quest_desc": [
    "This chapter comes after &6The Super Compass&r in &dThe Guhmension&r (Wonders category).",
    "",
    "Somewhere in the Guhmension lies the &9Deep Guh Sea&r, and in the middle of it, on the bottom: &bThe Guh Bubble&r. Walk into the Dive Post through its mouth and take the spiral stairs down.",
    "",
    "Don't forget to gulp some bubbles now and then! Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work!",
  ],
  "quest.4755482F37984F1D.title": "The Deep Guh Sea",
  "quest.4755482F37984F1D.quest_desc": [
    "Somewhere in the Guhmension lies a big, deep pink sea with little sandy beaches: the &9Deep Guh Sea&r. Cheese Coral grows on the bottom, little Guhfish swim around, and sometimes a Merguh. And in the middle of every Deep Guh Sea lies The Guh Bubble!",
  ],
  "quest.475548285CE1D90B.title": "Blub Blub Guh",
  "quest.475548285CE1D90B.quest_desc": [
    "In the middle of every &9Deep Guh Sea&r, on the seabed, lies a giant glass bubble shaped like a guh head: &bThe Guh Bubble&r! Look for the little island with the Dive Post (a guh head wearing diving goggles), walk in through its mouth and take the spiral stairs down. The Super Compass (Wonders) shows the way.",
  ],
  "quest.475548F4D5ADEAF7.title": "Pearls from the Clam",
  "quest.475548F4D5ADEAF7.quest_desc": [
    "Right-click an open &dGiant Clam&r: sometimes there's a pearl inside! A closed clam opens up again by itself after a while. Pearls are the Merguh's money.",
  ],
  "quest.47554801FC127186.title": "Gulp Some Bubbles",
  "quest.47554801FC127186.quest_desc": [
    "Swim outside through a dive door. Almost out of air? Swim to the yellow &6Cheese Coral&r: it blows air bubbles and you can breathe again. WAHOOG!",
  ],
  "quest.47554883CCC13E99.title": "The Sunken Guh Ship",
  "quest.47554883CCC13E99.quest_desc": [
    "Just north of the bubble lies a sunken guh ship with a guh head on its bow. In the cabin at the back there's a treasure chest... Nyeg, how exciting!",
  ],
  "quest.475548F911332414.title": "Deep-Sea Guh",
  "quest.475548F911332414.quest_desc": [
    "Buy a diving helmet from the &bMerguh&r: with it you can breathe underwater for as long as you like.",
  ],
  "quest.475548DD8C2075F6.title": "A Fish with Paws",
  "quest.475548DD8C2075F6.quest_desc": [
    "Every once in a while a wild &dMerguh&r swims in the Guh Sea and the Deep Guh Sea: a guh with a fish tail! Tame it with cheese nibbles.",
  ],
  "quest.4755483D62F2D4D0.title": "Underwater Ride",
  "quest.4755483D62F2D4D0.quest_desc": [
    "Saddle your Merguh and ride underwater: look where you want to go, jump is up. It swims super fast and gives you air. Blub!",
  ],
  "quest.47554833A813976A.title": "Ready to Dive",
  "quest.47554833A813976A.quest_desc": [
    "Buy the diving goggles, the snorkel and the swim ring from the Merguh (only she sells them) and put them on your guh. WAHOOG, what a water guh!",
  ],
  "quest.475548D59AA75088.title": "Poopshelly",
  "quest.475548D59AA75088.quest_desc": [
    "Off the coast of the Guh Sea swims &2Poopshelly&r, a plushie sea turtle. Find it and tame it with seagrass (or a cheese nibble).",
  ],
  "quest.475548EBCDA0CA1E.title": "Fresh Inside",
  "quest.475548EBCDA0CA1E.quest_desc": [
    "Right-click your Poopshelly (empty hand) and pick &dPolish a Tushie!&r. Then right-click one of your tame guhs: Poopshelly waddles over, crawls into its little tushie and polishes everything clean from the inside! It tickles... pop! After that your guh is &bFresh Inside&r.",
  ],
  "quest.4755484408C60CAF.title": "Shelly (Not Poopshelly!)",
  "quest.4755484408C60CAF.quest_desc": [
    "On the same coast lives &2Shelly&r too: almost the same, but with a teeny tiny head, and it never scrubs. Find and tame Shelly.",
  ],
  "quest.475548A2F6307A9E.title": "Besties",
  "quest.475548A2F6307A9E.quest_desc": [
    "Right-click your tame Shelly, pick &dBestie Moment!&r and then right-click one of your guhs: true besties!",
  ],
  "quest.4755481A2B80A73F.title": "Beef... Still Besties",
  "quest.4755481A2B80A73F.quest_desc": [
    "Sometimes Shelly and a guh have beef (teeny tiny head!). Just wait: they always make up again. Watch a beef get squashed.",
  ],
}
