{
  "chapter.475548CD6A6AD1BE.title": "&dGuh Dreamland",
  "chapter.475548CD6A6AD1BE.chapter_subtitle": [
    "17. Tuck your guh in, and dream along",
  ],
  "quest.4755484CD48193E6.title": "How do you get here?",
  "quest.4755484CD48193E6.quest_desc": [
    "This chapter can start right away, as soon as you have a tamed guh (&dGuh!&r in &dGuhs \\& basics&r).",
    "",
    "Guhs get sleepy in the evening. Tuck your guh into a &6box of nibbles&r (or a kitty house, little bed or nest), go to sleep in a bed next to it, and you dream along: &dGuh Dreamland&r, floating islands above a lavender sea.",
    "",
    "There the story of &dSnoes&r is waiting, the guh who can't sleep. Help him, and the wild &bBlub-guhs&r show themselves to you. Also: the &dWeather Vadser&r, sleepy things for at home and The Singing Meadow. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headers show what logically comes next. Tick this off and get vadsing!",
  ],
  "quest.475548268FDC2408.title": "A Blub as a friend",
  "quest.475548268FDC2408.quest_desc": [
    "After Snoes' story you see wild &bBlub-guhs&r everywhere (mostly in the Singing Meadow). Tame one with a cheese nibble and pick it up: sneak + click. Every Blub has its own Blub-Guh-Meter!",
  ],
  "quest.475548060B79CABD.title": "Bubble bath",
  "quest.475548060B79CABD.quest_desc": [
    "Make a &dBlub bubble bath&r. A Blub goes bathing in it by itself, and with the chore Bubble Bath Master your guhs get fresh and happy.",
  ],
  "quest.475548B803C624E3.title": "Not empty yet!",
  "quest.475548B803C624E3.quest_desc": [
    "Clutter Guh leaves glasses with a little bit left everywhere. Make a few yourself too: three glass panes in a V.",
  ],
  "quest.47554856E53B814D.title": "From Blub to Guh",
  "quest.47554856E53B814D.quest_desc": [
    "Fill a whole row of one kind on your &dBlub meter map&r (Guhdex, Blub-guh page): a Blub with meter 0-9, 10-19... up to 90-100. Taming and breeding both count.",
  ],
  "quest.475548C58A6F0B16.title": "Gold!",
  "quest.475548C58A6F0B16.quest_desc": [
    "A &6golden box&r on your meter map: tame or breed a &dPure Blub&r (meter exactly 0) or a &dVolle Guh&r (meter exactly 100). Very rare!",
  ],
  "quest.475548BAF91EFC68.title": "Weather vadsing",
  "quest.475548BAF91EFC68.quest_desc": [
    "Make a &dWeather Vadser&r and set the weather within 60 blocks: sun, rain, snow or thunder. It wants 20 vadskracht while another weather is on. Then it even rains in the Guhmension!",
  ],
  "quest.475548B877F8B6A9.title": "Bubble shower",
  "quest.475548B877F8B6A9.quest_desc": [
    "Find a &bweather jar: bubble shower&r (in the chests of the Guh Bubble and Bikini Bottom, or in the Cloud Bath of Guh Dreamland). Use it and switch it on in your Weather Vadser.",
  ],
  "quest.475548F107C7F493.title": "Rainbow weather",
  "quest.475548F107C7F493.quest_desc": [
    "The &drainbow weather&r: open the souvenir 'Rainbow in a jar', get gold on the Guh Circuit, or help Snoes sleep.",
  ],
  "quest.475548EFD3D45CBE.title": "Dream Weather",
  "quest.475548EFD3D45CBE.quest_desc": [
    "Bounce all the way up the Star Cushion Field, to the big star. The &ddream chest&r there gives you the &dweather jar: dream weather&r the first time: Guh Dreamland at home!",
  ],
  "quest.475548828F687C5B.title": "A guh always picks the box",
  "quest.475548828F687C5B.quest_desc": [
    "Make a &6box of nibbles&r. In the evening you tuck your guh into it (right-click), and at night guhs crawl in by themselves.",
  ],
  "quest.475548F95A13908F.title": "Kitty house",
  "quest.475548F95A13908F.quest_desc": [
    "A &dkitty house&r in pink, white, lavender or mint. Very pretty. (The box wins anyway.)",
  ],
  "quest.475548659D14DB1B.title": "Lullaby",
  "quest.475548659D14DB1B.quest_desc": [
    "With a &dmusic box&r you softly sing the guhs nearby to sleep.",
  ],
  "quest.4755487ABD92D0CB.title": "Spin, mobile, spin",
  "quest.4755487ABD92D0CB.quest_desc": [
    "Hang a &dmobile&r above the guh bed: it spins and plays a song.",
  ],
  "quest.475548B02B6504B0.title": "Night light",
  "quest.475548B02B6504B0.quest_desc": [
    "A &dmoon night light&r for the guh room: click on, click off.",
  ],
  "quest.4755487E2B6A72C5.title": "Scratching post",
  "quest.4755487E2B6A72C5.quest_desc": [
    "Tamed guhs hop onto a &dscratching post&r in the daytime and sit there proudly.",
  ],
  "quest.475548D53271A68D.title": "Guh Dreamland",
  "quest.475548D53271A68D.quest_desc": [
    "In the evening tuck your guh in (box, kitty house, little bed or nest) and go to sleep in a bed next to it. What you give it decides on which island you start. Waking up: your &ddream pillow&r or the Alarm Guh.",
  ],
  "quest.4755488F24E99C8A.title": "Dream sand",
  "quest.4755488F24E99C8A.quest_desc": [
    "In Guh Dreamland you find &ddream sand&r. You make dream blocks with it.",
  ],
  "quest.475548B8ACEB19D8.title": "Bubble glass",
  "quest.475548B8ACEB19D8.quest_desc": [
    "Glass with shifting rainbow colours: 8 glass and 1 dream sand.",
  ],
  "quest.475548BC8F1C53DF.title": "Humming grass",
  "quest.475548BC8F1C53DF.quest_desc": [
    "&dLullaby grass&r hums softly when you walk over it.",
  ],
  "quest.475548021EB6ACF9.title": "Who is sitting by your bed?",
  "quest.475548021EB6ACF9.quest_desc": [
    "Do you have a tamed guh? Then click your bed in the evening. Somebody is sitting next to it... Talk to him, tuck him in, and go to sleep yourself.",
  ],
  "quest.475548759B63BE1A.title": "The song",
  "quest.475548759B63BE1A.quest_desc": [
    "On the &dLullaby Hills&r the wild Blubs are shy. Bring them to their bell hill, and together they squeak Snoes' lullaby.",
  ],
  "quest.4755485ACF95347D.title": "The falling star",
  "quest.4755485ACF95347D.quest_desc": [
    "Bounce over the giant pillows of the &eStar Cushion Field&r, higher and higher, and catch the falling star. Watch out for the pillow fight guhs!",
  ],
  "quest.475548F3EF5FF035.title": "The memory",
  "quest.475548F3EF5FF035.quest_desc": [
    "On &6Memory Island&r touch the memory bubbles. What happened on the Guh family day? And who was sitting in the bushes?",
  ],
  "quest.47554852AFFDA1C4.title": "The bath",
  "quest.47554852AFFDA1C4.quest_desc": [
    "Float in soap bubbles past the clouds of the &bCloud Bath&r and fetch the bath things. Snoes' first bubble bath ever!",
  ],
  "quest.475548C7DE216EF7.title": "The dream sand",
  "quest.475548C7DE216EF7.quest_desc": [
    "The mill of the &7Moon Mill&r stands still. Blow the sails round with the Blubs and set the little cogs right, then the Sand Guh grinds dream sand.",
  ],
  "quest.47554856B807A963.title": "Good night, Snoes",
  "quest.47554856B807A963.quest_desc": [
    "With all five pieces: back to the &dDream Square&r. Everybody comes to watch. Afterwards the wild Blub-guhs show themselves to you, and Bubbels comes home with you.",
  ],
  "quest.4755480696D5EE9F.title": "The Singing Meadow",
  "quest.4755480696D5EE9F.quest_desc": [
    "Somewhere in the Guhmension lies a rare salmon-pink meadow with tall rock pillars, cloud trees and pools of bubble sap. The wild Blub-guhs live here. At dusk they sing together in the Choir Bowl.",
  ],
}
