{
  "chapter.4755486A3E24121B.title": "&6On Safari!",
  "chapter.4755486A3E24121B.chapter_subtitle": [
    "14. Safaripark Vadse Bergen: spotting, photographing and sniffing out secrets",
  ],
  "quest.475548780A582533.title": "How do you get here?",
  "quest.475548780A582533.quest_desc": [
    "This chapter comes after &dWelcome to the Guhmension!&r in &dThe Guhmension&r.",
    "",
    "Somewhere in the Guhmension stands a safari bus station. Hop on the &6Guh safari bus&r and it takes you to &6Safaripark Vadse Bergen&r: a big park with 46 sweet animals in eight zones.",
    "",
    "Spot them, photograph them for your &dSafari Dex&r, find the secrets and help the rangers. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it before. The headings show what logically comes next. Tick this off and get chonking!",
  ],
  "quest.475548BB24B5BA99.title": "Click!",
  "quest.475548BB24B5BA99.quest_desc": [
    "Take your first photo of an animal in Safaripark Vadse Bergen. It goes straight into your Safari Dex.",
  ],
  "quest.475548174D26C1D7.title": "Three stars!",
  "quest.475548174D26C1D7.quest_desc": [
    "Take a three-star photo: close up, nicely centred, and preferably while the animal does something funny (sleeping, eating, playing...).",
  ],
  "quest.4755481DCDDF52C9.title": "Ten animals",
  "quest.4755481DCDDF52C9.quest_desc": [
    "Photograph ten different animals.",
  ],
  "quest.475548D28F06B055.title": "Twenty-five animals",
  "quest.475548D28F06B055.quest_desc": [
    "Photograph twenty-five different animals. You're half a ranger already!",
  ],
  "quest.475548246548F7DC.title": "A whole zone",
  "quest.475548246548F7DC.quest_desc": [
    "Photograph all the animals of one zone. Then pick up your zone badge from the expert guh in the expert pavilion.",
  ],
  "quest.475548B2A168B47B.title": "Tracker",
  "quest.475548B2A168B47B.quest_desc": [
    "Some animals hide really well. Follow the paw prints (they light up through a spyglass) and photograph a hider, like the okapi, the badger or the beaver.",
  ],
  "quest.475548B969EAD2F7.title": "Safari King",
  "quest.475548B969EAD2F7.quest_desc": [
    "Photograph every animal in the park: all 46! You get the golden safari camera, the golden animal statue and the voucher for the Golden Dik-dik's enclosure sign.",
  ],
  "quest.4755481736717BEB.title": "Psst, a secret",
  "quest.4755481736717BEB.quest_desc": [
    "A secret is hidden in every zone of the park. Find one!",
  ],
  "quest.475548FD3C08F646.title": "Sniffer",
  "quest.475548FD3C08F646.quest_desc": [
    "Find all eight secrets. Then you get the secrets trophy and the title Sniffer.",
  ],
  "quest.475548D4CE0B5125.title": "A zebra with ears?",
  "quest.475548D4CE0B5125.quest_desc": [
    "According to the head ranger, a guh in a homemade zebra suit is walking around the park. Find him, three times! Afterwards he comes home with you.",
  ],
  "quest.4755488A3766AA63.title": "The too vah elephant",
  "quest.4755488A3766AA63.quest_desc": [
    "Dikkie the elephant no longer fits through his gate. Help him with a healthy diet and a run on the elephant treadmill.",
  ],
  "quest.475548692580E122.title": "Petting time!",
  "quest.475548692580E122.quest_desc": [
    "Do a chore in the petting corner of the entrance village: feeding, brushing or walking the alpaca.",
  ],
}
