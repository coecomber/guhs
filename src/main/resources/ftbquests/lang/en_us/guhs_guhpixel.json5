{
  "chapter.475548C263636219.title": "&dGuhpixel",
  "chapter.475548C263636219.chapter_subtitle": [
    "14. The minigame server of the guhs. /lobby, Nyeg!",
  ],
  "quest.47554813E081AD7B.title": "How Do You Get Here?",
  "quest.47554813E081AD7B.quest_desc": [
    "This chapter comes after &6The Super Compass&r in &dThe Guhmension&r: in the &dMinigames&r tab there, pick the &dGuh Internet Café \"The Slow Connection\"&r.",
    "",
    "In the café guhs are asleep behind old beige computers. Walk through the big screen and you're standing in the lobby of &dGuhpixel&r: the minigame server of the guhs. After that &6/lobby&r, &6/hub&r and &6/l&r work everywhere.",
    "",
    "Play the joke games, earn &6Guhpixel Coins&r (not an item: they are on your name) and buy things for your home with them: the Guhcade, the Guh Office and the Guh Cinema. The &dTravel Agency&r and the &dGuh Parkour&r are simply in the Guhmension. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it before. The headings show what logically comes next. Tick this off and get chonking!",
  ],
  "quest.47554895BB596105.title": "The Practice Round",
  "quest.47554895BB596105.quest_desc": [
    "Talk to &bCaptain Guh&r in the lobby of &dGuhpixel&r and fly a practice round on &dThe Chonkfarer&r. Do your task, see what the rest of the crew is up to and find the Mika. There is said to be one on board, Nyeg. The first time you get 100 coins and a keepsake, and after that you may join the real game.",
  ],
  "quest.4755486551019EA3.title": "Aboard The Chonkfarer",
  "quest.4755486551019EA3.quest_desc": [
    "Talk to &bCaptain Guh&r in the Guhpixel lobby and play a whole round of &dAmong Guhs&r. Crew: do your tasks and vote the Mika out. Mika: push everybody asleep without anybody seeing it. Empty places are filled with guhs in space suits. Nobody gets hurt: whoever sleeps simply dreams on.",
  ],
  "quest.47554876EC1B2EC8.title": "Tasks Done, Mika Gone",
  "quest.47554876EC1B2EC8.quest_desc": [
    "Win a round as &bcrew&r: finish all tasks together, or vote the Mika out in a meeting. Listen well to what the guhs say: they tell what they really saw. Mostly, Nyeg.",
  ],
  "quest.475548A3D794F646.title": "Secretly a Mika",
  "quest.475548A3D794F646.quest_desc": [
    "Win a round as the &cMika&r. Only push when nobody is looking, crawl through the vents, put the lights out and say in the meeting with a straight snout that you were in the Cafeteria.",
  ],
  "quest.4755483F60762104.title": "Two Mikas on Board",
  "quest.4755483F60762104.quest_desc": [
    "Play a round on &6Hard&r: ten participants, two Mikas and one and a half times the coins. The leader of the queue picks the level.",
  ],
}
