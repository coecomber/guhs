{
  "chapter.47554886C6FA7C81.title": "&eCaves, Swamp \\& Woods",
  "chapter.47554886C6FA7C81.chapter_subtitle": [
    "7. Holey cheese, swamp, woods and guh families",
  ],
  "quest.4755486B4E6BCAF7.title": "How Do You Get Here?",
  "quest.4755486B4E6BCAF7.quest_desc": [
    "This chapter comes after &dWelcome to the Guhmension!&r in &dThe Guhmension&r.",
    "",
    "Deep under the Guhmension lie the &eHoley Cheese Caves&r. Somewhere else, a yellow mist hangs over the &eCheese Swamp&r, and a mint-green mist fills the &aChonkwood Forest&r, where the guh families live.",
    "",
    "Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work!",
  ],
  "quest.47554882C7FA8DDE.title": "Full of Holes!",
  "quest.47554882C7FA8DDE.quest_desc": [
    "Deep under the Guhmension (below y 40), in some places the ground is one big &6holey cheese&r: round hollows, Cheese Stalactites, dripping cheese sauce and Glowing Cheese Moss. Dig down and find the &eHoley Cheese Caves&r!",
  ],
  "quest.475548BDB1268F37.title": "Glowing Cheese Moss",
  "quest.475548BDB1268F37.quest_desc": [
    "The cheese moss in the caves glows softly. Collect some cheese moss: handy as a little lamp, and for making &dSilent Nibbles&r.",
  ],
  "quest.4755486C27EED7D7.title": "Crunchy!",
  "quest.4755486C27EED7D7.quest_desc": [
    "Here and there in the holey cheese there's &fCheese Crumb Ore&r: crunchy cheese crystals, just like in aged cheese. Mine a few.",
  ],
  "quest.475548D16B0420F9.title": "Crunch-Free Nibbling",
  "quest.475548D16B0420F9.quest_desc": [
    "Make a &dSilent Nibble&r (Cheese Crumb + cheese nibbles + cheese moss) and eat it. For a minute and a half you're &7Hushed&r: nobody hears your steps, mining or chewing. Not even the Chonk Warden!",
  ],
  "quest.47554833A41E871D.title": "Shaft 7: Closed!",
  "quest.47554833A41E871D.quest_desc": [
    "Somewhere in the holey cheese lies an &eOld Cheese Mineshaft&r, with a minecart full of loot. The Super Compass (Underground) knows the way.",
  ],
  "quest.475548B1A1335FC5.title": "Shhh... No Nibbling!",
  "quest.475548B1A1335FC5.quest_desc": [
    "Deep in the Holey Cheese Caves, the Mikas hide all their stolen cheese nibbles: the &cSilent Pantry&r. Careful: &eNibble Sensors&r hear you walking, eating and mining, and then &eNibble Shriekers&r yell NYEEEG! &6Sneaking&r is safe.",
  ],
  "quest.475548DA54F61F26.title": "The Secret of the Pantry",
  "quest.475548DA54F61F26.quest_desc": [
    "In the middle of the pantry stands the Mika storehouse: a giant Mika head full of stolen nibbles. Inside lies the &dPantry Mika's diary&r. Take it with you (for the library too!).",
  ],
  "quest.475548EBCF21ED38.title": "Who's Nibbling There?",
  "quest.475548EBCF21ED38.quest_desc": [
    "Three times NYEEEG... and the &cChonk Warden&r crawls out of the cheese: a giant Mika with a sleep mask. It's blind, but it hears you &6chewing&r. Get close once (from a safe distance!) for your Guhdex. Run away or sneak, WAHOOG!",
  ],
  "quest.4755483017D15B15.title": "Chonk Warden? Chonk Snoozer!",
  "quest.4755483017D15B15.quest_desc": [
    "Dare you? Defeat the Chonk Warden. It's really strong, so this is totally optional. A true guh just sneaks away.",
  ],
  "quest.475548BB714ECD15.title": "The Cheese Swamp",
  "quest.475548BB714ECD15.quest_desc": [
    "Somewhere in the Guhmension a yellow mist hangs over a soggy swamp full of bubbling cheese sauce: the &eCheese Swamp&r. Step in (boots on!).",
  ],
  "quest.475548087C391F07.title": "Boing, Nyeg!",
  "quest.475548087C391F07.quest_desc": [
    "Step on &6Bubbling Cheese Sauce&r and you bounce up! Sneak to wade through it calmly. Falling in there never hurts.",
  ],
  "quest.47554862A9A9F35D.title": "Ahoy, Nibbles!",
  "quest.47554862A9A9F35D.quest_desc": [
    "On big swamp pools a &enibble raft&r with a little pink flag sometimes bobs around. Climb aboard and open the barrel!",
  ],
  "quest.4755484301565311.title": "Ribbit-Guh!",
  "quest.4755484301565311.quest_desc": [
    "Stand right next to a &aFrogguh&r for your Guhdex. They come in pink, mint and yellow!",
  ],
  "quest.475548CAAA7670FD.title": "Mika Moths",
  "quest.475548CAAA7670FD.quest_desc": [
    "In the evening, &dCheese Moths&r flutter around cheese and lamps, and they snatch cheese nibbles lying on the ground. Find one for your Guhdex.",
  ],
  "quest.475548774374C1E6.title": "Snap, Gulp, Glow!",
  "quest.475548774374C1E6.quest_desc": [
    "A Frogguh snaps up Cheese Moths with its long tongue and then spits out a glowing &eMoth Nibble&r, in its own color.",
  ],
  "quest.4755488288C45FFD.title": "Every Frog Color",
  "quest.4755488288C45FFD.quest_desc": [
    "Have a pink, a mint and a yellow Moth Nibble in your pockets at the same time.",
  ],
  "quest.47554884A4D88DE4.title": "Little Mud Guh",
  "quest.47554884A4D88DE4.quest_desc": [
    "Wild guhs in the Cheese Swamp are often green-and-yellow spotted: the &aCheese Swamp Guh&r! Find one and tame it with cheese nibbles.",
  ],
  "quest.4755480BF232E809.title": "A Hut on Legs",
  "quest.4755480BF232E809.quest_desc": [
    "In the middle of the swamp stands a stilt hut with a giant witch's hat: the head of &5Swamp Witch Mika&r herself! The Super Compass (Adventure) shows the way.",
  ],
  "quest.47554874776259C0.title": "Bleh, Unwahoog",
  "quest.47554874776259C0.quest_desc": [
    "Swamp Witch Mika throws &2Chonk-Be-Gone Potions&r. Get hit by one once (it only lasts a little while, nyeg).",
  ],
  "quest.4755483E4F64A315.title": "Begone, Witch!",
  "quest.4755483E4F64A315.quest_desc": [
    "Defeat Swamp Witch Mika. She nibbles her own Swamp Cheese when she's hurt, so be quick!",
  ],
  "quest.4755489E35B813D9.title": "Stinkin' Delicious",
  "quest.4755489E35B813D9.quest_desc": [
    "Collect &eSwamp Cheese&r from Swamp Witch Mika (or from her chest). Great for the Guh Brewing Cauldron!",
  ],
  "quest.4755487322B1BF6E.title": "Witch Page",
  "quest.4755487322B1BF6E.quest_desc": [
    "Stand right next to Swamp Witch Mika (dare you?) for her Guhdex page.",
  ],
  "quest.4755482EDC0E46F3.title": "The Chonkwood Forest",
  "quest.4755482EDC0E46F3.quest_desc": [
    "Somewhere in the Guhmension stands a misty, mint-green forest full of &agiant guh trees&r: the &dChonkwood Forest&r. Take a walk through it and look closely at the bark... can you see the little guh faces?",
  ],
  "quest.4755482A2FA8AAF9.title": "High in the Trees",
  "quest.4755482A2FA8AAF9.quest_desc": [
    "In the Chonkwood Forest, a village of guhs lives in &atreehouses&r, high up in the giant guh trees. Climb the spiral stairs and walk across the rope bridges! The Super Compass (Homes) shows the way.",
  ],
  "quest.47554850E161BDC9.title": "The Ranger Guh",
  "quest.47554850E161BDC9.quest_desc": [
    "In the ranger station, high up in the Mother Tree, sits the &2Ranger Guh&r. He knows all about guh families and sells chonkwood, saplings and Guh Nests.",
  ],
  "quest.47554899AB0F03C8.title": "The Nibble Picker",
  "quest.47554899AB0F03C8.quest_desc": [
    "Next to the berry garden in the Treehouse Village lives the &6Nibble Picker&r. She trades Nibbleberries for tarts, nests and her picking outfit.",
  ],
  "quest.4755489CC8161A33.title": "Picking Nibbleberries",
  "quest.4755489CC8161A33.quest_desc": [
    "Nibbleberry bushes don't prickle! Right-click a bush with yellow berries to pick them. Collect 32.",
  ],
  "quest.475548A69A6C5ACC.title": "Chonky Tart",
  "quest.475548A69A6C5ACC.quest_desc": [
    "Three Nibbleberries, sugar and a cheese nibble: bake a &6Nibbleberry Tart&r.",
  ],
  "quest.4755483AF996ED33.title": "Chonkwood",
  "quest.4755483AF996ED33.quest_desc": [
    "Chop down a giant guh tree (or buy wood from the Ranger Guh) and make Chonkwood Planks, a Chonkwood Door and a Chonkwood Fence.",
  ],
  "quest.475548DD60221923.title": "One Big Guh of a Tree",
  "quest.475548DD60221923.quest_desc": [
    "Plant four Chonkwood Saplings in a square and give them some time (or bone meal). Then a real &agiant guh tree&r grows!",
  ],
  "quest.47554801DE28443D.title": "Guh Family",
  "quest.47554801DE28443D.quest_desc": [
    "Wild guhs live in little families: one or two parents with baby guhs trotting behind them in a row. Find a guh family and walk along with them.",
  ],
  "quest.475548362DCDB875.title": "Small but Chonky",
  "quest.475548362DCDB875.quest_desc": [
    "Baby guhs are much easier to tame than big guhs. Give a wild baby guh &eNibbleberries&r or cheese nibbles.",
  ],
  "quest.4755489F338F2956.title": "A Guh Nest of Your Own",
  "quest.4755489F338F2956.quest_desc": [
    "Make a &6Guh Nest&r (sticks, wool and a cheese nibble) or buy one from the Ranger Guh.",
  ],
  "quest.475548B416E3723B.title": "Good Night, Guh",
  "quest.475548B416E3723B.quest_desc": [
    "Put your Guh Nest down near your tame guhs. When night falls, they crawl in to sleep. Zzz... WAHOOG!",
  ],
  "quest.47554823813278AE.title": "Ranger in Training",
  "quest.47554823813278AE.quest_desc": [
    "Buy the &2ranger hat&r and the &2ranger coat&r from the Ranger Guh and put them on your guh.",
  ],
  "quest.47554892B8E217FF.title": "Picker of the Year",
  "quest.47554892B8E217FF.quest_desc": [
    "Trade for the &6picker's cap&r and the &6picking basket&r at the Nibble Picker. With the basket on its back, your guh looks seriously chonky!",
  ],
  "quest.4755483626C731A2.title": "The Palewood",
  "quest.4755483626C731A2.quest_desc": [
    "Very rare, somewhere far away in the Guhmension, lies a forest where all the pink has drained away: the &7Palewood&r. White trunks, gray moss, and it is quiet as a mouse: not a single guh lives there. Go and find it!",
  ],
  "quest.47554824FD22EF7C.title": "Pale Guhwood",
  "quest.47554824FD22EF7C.quest_desc": [
    "Chop down a pale tree and make &7pale guhwood planks&r, a pale guhwood door and a pale guhwood sign. One sapling grows a little tree, four in a square a thick one.",
  ],
  "quest.4755489AFD61169A.title": "Eye Open",
  "quest.4755489AFD61169A.quest_desc": [
    "By day the &7guh eyeblossoms&r are asleep. At night they open their eyes one by one and turn &6orange&r. Pick one while it is open!",
  ],
  "quest.4755484AA57EEFE3.title": "Creak... Creak...",
  "quest.4755484AA57EEFE3.quest_desc": [
    "Some trees have a &6Creaking Guh Heart&r inside. At night it wakes up and calls its &7Creakguh&r: a guh made of wood. It only moves when you are NOT looking. Find one (within 8 blocks) for your Guhdex.",
  ],
  "quest.4755487A66D41494.title": "A Wooden Hug",
  "quest.4755487A66D41494.quest_desc": [
    "The Creakguh is a guh, so it is sweet: all it wants is to hug you. Turn around, wait a moment... &6Creak!&r It makes you slow for a few seconds, nothing more.",
  ],
  "quest.475548063551719C.title": "Cheese Resin",
  "quest.475548063551719C.quest_desc": [
    "Give a Creakguh a tap: it doesn't feel a thing, but &6cheese resin&r drips from the trunk around its heart. Scrape it off the tree. Nine make a block, and smelted it becomes a &6cheese resin brick&r.",
  ],
  "quest.47554860713665DF.title": "Cheese Resin Bricks",
  "quest.47554860713665DF.quest_desc": [
    "Smelt cheese resin in a furnace into cheese resin bricks and build &6Cheese Resin Bricks&r with them: warm cheese yellow, with stairs, slabs and little walls.",
  ],
  "quest.4755483D4C727EE1.title": "Heartbreaker",
  "quest.4755483D4C727EE1.quest_desc": [
    "Want to get rid of a Creakguh? Find the tree where the sparkle trail leads and chop out the &6Creaking Guh Heart&r. With Silk Touch you can take the heart with you and put it between two pale guhwood logs at home.",
  ],
  "quest.475548A7B0D47F51.title": "The Pale Clearing",
  "quest.475548A7B0D47F51.quest_desc": [
    "In the middle of the Palewood lies a round clearing full of guh eyeblossoms, with an ancient tree. High up in its trunk a little heart is beating... The Super Compass (Adventure) shows the way.",
  ],
  "quest.47554847F98AB392.title": "The Woodcutter's Hut",
  "quest.47554847F98AB392.quest_desc": [
    "Somebody used to live here: the &7Woodcutter Guh&r. His axe is still stuck in the stump. Where did he go? The Super Compass (Adventure) shows the way.",
  ],
  "quest.475548025CB77A47.title": "The Diary",
  "quest.475548025CB77A47.quest_desc": [
    "On the lectern in the hut lies the &dWoodcutter Guh's diary&r. Click the lectern: everybody gets a copy of their own.",
  ],
  "quest.475548CB5AF13CE7.title": "Sour Heart, Sour Mika",
  "quest.475548CB5AF13CE7.quest_desc": [
    "One in five hearts is &asoured&r (yellow-green). No Creakguh comes out of those, but a &cCreak Mika&r: it comes to shove you when you're not looking. NYEG! After a few whacks it crawls back into its tree.",
  ],
}
