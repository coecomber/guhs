{
  "chapter.475548EA09F4D736.title": "&6Minigames \\& Special Places",
  "chapter.475548EA09F4D736.chapter_subtitle": [
    "3. Play, win and dress up chonky",
  ],
  "quest.47554867D43B4C54.title": "How Do You Get Here?",
  "quest.47554867D43B4C54.quest_desc": [
    "This chapter comes after &6The Super Compass&r in &dThe Guhmension&r.",
    "",
    "All the minigame buildings and the rare places (hide-and-guh house, library, cheese mine, floating islets, fair...) can be found with the Super Compass (Minigames or Wonders). Each row below starts at one of those buildings.",
    "",
    "Play them in any order you like. Nyeg, so many choices! Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes next. Tick this off and get chonky to work!",
  ],
  "quest.4755480AD7564B03.title": "Showtime!",
  "quest.4755480AD7564B03.quest_desc": [
    "Find the &dGuh Beauty Theater&r (Super Compass: Minigames). You'll know it by its front: a giant guh, and the door is its mouth!",
  ],
  "quest.47554809997CE611.title": "On the Catwalk",
  "quest.47554809997CE611.quest_desc": [
    "Talk to the &dShow Guh&r on the stage and enter the Chonk Pageant. You don't have to bring anything: you borrow a model and clothes (or bring your own tame guh)! The jury holds up score cards, and above the Show Guh floats the world's &6top 3&r.",
  ],
  "quest.475548BE4AF124F4.title": "Wahoog Stylist",
  "quest.475548BE4AF124F4.quest_desc": [
    "Score at least &665 out of 90&r points in one show. Tip: Miss Chonksley wants the theme, Mr. Glitterguh wants a complete look (head, eyes, neck and body).",
  ],
  "quest.475548CDA367444A.title": "The Jury Goes Wild",
  "quest.475548CDA367444A.quest_desc": [
    "Score &628 points or more&r in one round. The jury is standing on their cushions, clapping!",
  ],
  "quest.4755484C3824C902.title": "My Guh Is a Star",
  "quest.4755484C3824C902.quest_desc": [
    "Let your &down tame guh&r walk the catwalk (pick 'With ...' at the Show Guh). After the show it gets its own clothes back.",
  ],
  "quest.475548964A1CF7F7.title": "Rosette Collector",
  "quest.475548964A1CF7F7.quest_desc": [
    "Save up 16 Show Rosettes: enough for the Showstar Tiara!",
  ],
  "quest.475548134B4D81D6.title": "Glitter!",
  "quest.475548134B4D81D6.quest_desc": [
    "Buy the &dGlitter Bow&r from the Show Guh (Show Rosettes).",
  ],
  "quest.4755485E61E6B92E.title": "Miss Chonky",
  "quest.4755485E61E6B92E.quest_desc": [
    "Buy the whole Showstar outfit: the Glitter Bow, the Miss Chonky Sash and the Showstar Tiara.",
  ],
  "quest.475548C77E559F04.title": "On Your Marks, Chonk!",
  "quest.475548C77E559F04.quest_desc": [
    "Find the &dGuh Racetrack&r (Super Compass: Minigames > Guh Racetrack). In the pit stop, the Race Guh is waiting with a Rental Racing Guh for you.",
  ],
  "quest.475548C70D03D857.title": "VROOM VROOM!",
  "quest.475548C70D03D857.quest_desc": [
    "Ride your first guh race: 3 laps through all the glowing rings. You don't have to bring anything: the Race Guh lends you a racing guh.",
  ],
  "quest.47554884FAF99C6F.title": "Bronze!",
  "quest.47554884FAF99C6F.quest_desc": [
    "Finish the race within 1:45. Tip: the &6WAHOOG pads&r give you a big boost!",
  ],
  "quest.475548C547DDEABC.title": "GOLD! WAHOOG!",
  "quest.475548C547DDEABC.quest_desc": [
    "Finish the race within 1:12. Take the inside corners and don't miss a single pad!",
  ],
  "quest.475548414C185225.title": "Ghost Rider",
  "quest.475548414C185225.quest_desc": [
    "Beat your own record while your see-through &bghost&r races along. Who's faster: you or you?",
  ],
  "quest.47554882BC287843.title": "Trophy Cabinet",
  "quest.47554882BC287843.quest_desc": [
    "Save up 10 Race Prizes.",
  ],
  "quest.47554808EED9E448.title": "Wahoog Racing Goggles",
  "quest.47554808EED9E448.quest_desc": [
    "Buy &dWahoog Racing Goggles&r for your guh from the Race Guh (Race Prizes).",
  ],
  "quest.4755488D62BDFC72.title": "Racing on Hard",
  "quest.4755488D62BDFC72.quest_desc": [
    "The Guh Racetrack now has &aeasy&r, &emedium&r and &chard&r. Finish it on hard: a super fast but stubborn racing guh, Mika Snatchers along the track, and the silver WAHOOG pads don't work!",
  ],
  "quest.4755486EA41E47D7.title": "Vroom Vroom, Guh!",
  "quest.4755486EA41E47D7.quest_desc": [
    "Buy the whole jockey outfit: Jockey Cap, Striped Silk Jockey Jacket and Wahoog Racing Goggles. Only at the Race Guh!",
  ],
  "quest.475548A1A68FC9C9.title": "Who's Popping Up There?",
  "quest.475548A1A68FC9C9.quest_desc": [
    "Find the rare &dWhack-a-Mika Hall&r (Super Compass: Minigames > Whack-a-Mika Hall). Behind the front with the giant guh face lives the Whack Guh.",
  ],
  "quest.475548858F8683C1.title": "WHACK!",
  "quest.475548858F8683C1.quest_desc": [
    "Talk to the Whack Guh and play a round of &dWhack-a-Mika&r: 60 seconds of whacking Mikas back down with the borrowed whacking hammer. Don't whack the guh!",
  ],
  "quest.47554887DD3CD755.title": "Golden Whack",
  "quest.47554887DD3CD755.quest_desc": [
    "Whack a &6golden Mika&r: 50 points times your combo!",
  ],
  "quest.475548A275EF2BFD.title": "Whacker",
  "quest.475548A275EF2BFD.quest_desc": [
    "Score 500 points in a round of Whack-a-Mika. Tip: 5 in a row = higher combo.",
  ],
  "quest.475548794B077971.title": "Mika Master",
  "quest.475548794B077971.quest_desc": [
    "Score 1500 points in a round of Whack-a-Mika. Don't let a single Mika escape!",
  ],
  "quest.4755485EDC3F9C64.title": "WAHOOG WHACKER",
  "quest.4755485EDC3F9C64.quest_desc": [
    "2500 points! The Whack Guh has never seen anyone whack that fast. Are you in the &6top 3&r on the scoreboard wall yet? WAHOOG!",
  ],
  "quest.4755486273D32EB2.title": "Mika Whacker Medal",
  "quest.4755486273D32EB2.quest_desc": [
    "Buy the Mika Whacker Medal from the Whack Guh (4 Whack Coins). It looks so good on your guh!",
  ],
  "quest.4755481AFEA42383.title": "Mika Hunter",
  "quest.4755481AFEA42383.quest_desc": [
    "Buy the whole Mika Hunter outfit for your guh: the Mika Hunter Hat, the Whacking Vest with Pockets and the Mika Whacker Medal. Only for sale at the Whack Guh!",
  ],
  "quest.47554831B31C88BD.title": "Saturday Night Guh Fever",
  "quest.47554831B31C88BD.quest_desc": [
    "Find the &dGuh Disco&r in the Guhmension (Super Compass: Minigames > Guh Disco). Follow the beat to the pink club with a guh face!",
  ],
  "quest.475548D170EB50FA.title": "First Dance",
  "quest.475548D170EB50FA.quest_desc": [
    "Talk to the &5DJ Guh&r in the mouth of the big guh head and dance your first 'Simon says'. You don't need anything: just your dancing feet!",
  ],
  "quest.475548B401E1CFDD.title": "Dancing Feet",
  "quest.475548B401E1CFDD.quest_desc": [
    "Dance a row of &e5 colors&r without a single mistake.",
  ],
  "quest.475548DE11721740.title": "Disco Guh",
  "quest.475548DE11721740.quest_desc": [
    "Dance a row of &e10 colors&r without a single mistake. Listen to the tones, that helps!",
  ],
  "quest.47554813D09D8206.title": "Wahoog Dance Machine",
  "quest.47554813D09D8206.quest_desc": [
    "Dance a row of &e15 colors&r without a single mistake. Only the chonkiest dancers make it! Whoever gets furthest gets their name up in the &etop 3&r above the stage.",
  ],
  "quest.475548B99F404A30.title": "Glitter!",
  "quest.475548B99F404A30.quest_desc": [
    "Buy a piece of the disco outfit from the DJ Guh (with Disco Coins).",
  ],
  "quest.4755488ADCA90DB9.title": "Stayin' Chonky",
  "quest.4755488ADCA90DB9.quest_desc": [
    "The whole disco outfit: Glitter Chonk Suit, Wahoog Afro Wig and Star Disco Glasses. Dress up your guh and swing!",
  ],
  "quest.47554814388B3357.title": "Mika Mambo Master",
  "quest.47554814388B3357.quest_desc": [
    "Pick the hardest song at the &5DJ Guh&r, the &cMika Mambo&r, and dance &e10 colors&r in a row correctly. Watch out: soon the colors come on double beats!",
  ],
  "quest.4755489B7E01E06D.title": "The Whole Record",
  "quest.4755489B7E01E06D.quest_desc": [
    "Dance at least &e3 colors&r correctly to all four of the DJ Guh's songs: the &eChonky Tango&r, &dThey Hang On My Chonk&r, the &cMika Mambo&r and the &bNyeg-Nyeg Boogie&r.",
  ],
  "quest.4755488D45FC94DF.title": "Beats on Your Ears",
  "quest.4755488D45FC94DF.quest_desc": [
    "Buy the &dDisco Headphones&r from the DJ Guh and put them on your guh's ears. Now it hears the beat everywhere!",
  ],
  "quest.47554801DC55D50B.title": "Fore, Guh!",
  "quest.47554801DC55D50B.quest_desc": [
    "Find the rare &dGuh Mini Golf&r (Super Compass: Minigames > Guh Mini Golf). The &aGolf Guh&r lives in the clubhouse with the guh face.",
  ],
  "quest.4755482D2C782B35.title": "Nine Holes of Chonk",
  "quest.4755482D2C782B35.quest_desc": [
    "Play a whole round of guh golf: the Golf Guh lends you a club. Hold right-click to charge the power bar, look where the ball needs to go and let go! With a good round, you'll float in the top 3 above the Golf Guh.",
  ],
  "quest.475548D8550E6CED.title": "Par-Guh",
  "quest.475548D8550E6CED.quest_desc": [
    "Play a round on medium (par 27) or hard (par 36) at par or better. Tip: the cheese sauce costs you a penalty stroke!",
  ],
  "quest.475548F79B78331F.title": "WAHOOG! Hole-in-One!",
  "quest.475548F79B78331F.quest_desc": [
    "Sink a ball in one stroke. The Guh Path is long, but who knows...",
  ],
  "quest.4755488CFB09D297.title": "Ball Chonker",
  "quest.4755488CFB09D297.quest_desc": [
    "Save up 20 golf balls (the fewer strokes, the more balls).",
  ],
  "quest.4755480683244EED.title": "Cap On!",
  "quest.4755480683244EED.quest_desc": [
    "Buy the Chonky Golf Cap from the Golf Guh (10 golf balls).",
  ],
  "quest.4755488568F1A1B6.title": "Guh on the Green",
  "quest.4755488568F1A1B6.quest_desc": [
    "Buy the whole golf outfit: the Chonky Golf Cap, the Guh Sun Visor and the Argyle Chonk Sweater.",
  ],
  "quest.475548D451A39DEE.title": "From the Red Tee",
  "quest.475548D451A39DEE.quest_desc": [
    "Play a round on &chard&r at par (36) or better: from the red tee mats all the way at the back, past the extra slime bumpers and under the turbo guh windmill. Now that's wahoog golfing, nyeg!",
  ],
  "quest.4755483F8C9960F8.title": "The Chonky Food Fest",
  "quest.4755483F8C9960F8.quest_desc": [
    "Find the &dChonky Food Fest&r (Super Compass: Minigames > Chonky Food Fest): a giant tent with a guh face, full of food. The &dMunch Guh&r is waiting inside.",
  ],
  "quest.475548F79EE534C8.title": "Dig In!",
  "quest.475548F79EE534C8.quest_desc": [
    "Talk to the Munch Guh and play a round: one whole minute of catching food with her borrowed munch bowl. You don't have to bring anything!",
  ],
  "quest.4755482346B33A76.title": "Worth Its Weight in Gold",
  "quest.4755482346B33A76.quest_desc": [
    "Catch a &6golden munch nibble&r: 10 points and double points for a while. WAHOOG!",
  ],
  "quest.47554825DBAE8AC2.title": "A Chonky Catch",
  "quest.47554825DBAE8AC2.quest_desc": [
    "Score 100 points in one round. Tip: five in a row is combo x2, ten in a row x3. And stay away from the Mika's Grease!",
  ],
  "quest.4755484DF22E88D8.title": "Munch Champion",
  "quest.4755484DF22E88D8.quest_desc": [
    "Score 200 points in one round. The Munch Guh has never seen anything so chonky! Will you make the world's &6top 3&r? It floats above her head. WAHOOG!",
  ],
  "quest.47554886DD856496.title": "Bib First",
  "quest.47554886DD856496.quest_desc": [
    "Buy the Munch Bib for your guh from the Munch Guh (Munch Coins). Messy eating allowed!",
  ],
  "quest.475548FC391BB9C3.title": "All Set to Munch",
  "quest.475548FC391BB9C3.quest_desc": [
    "Buy the whole munch outfit: the Munch Bib, the Chonky Baker's Hat and the Pink Munch Apron. Only for sale at the food fest!",
  ],
  "quest.475548C8AE2C49A8.title": "Something Chonky's Swimming",
  "quest.475548C8AE2C49A8.quest_desc": [
    "Find the &bGuhfish Pond&r (Super Compass: Minigames > Guhfish Pond). A pond with a jetty shaped like a guh face: that's where the &bFishing Guh&r lives.",
  ],
  "quest.475548EA1E272B40.title": "A Bite!",
  "quest.475548EA1E272B40.quest_desc": [
    "Join a Guhfish Contest at the Fishing Guh. You get to borrow a fishing rod: three minutes of fishing, and you can keep every fish!",
  ],
  "quest.475548733B9F6D96.title": "A Chonk of a Catch",
  "quest.475548733B9F6D96.quest_desc": [
    "Score 300 points in a contest. Tip: heavy fish and rare nyeg trout are worth the most, the Mika Catfish costs points!",
  ],
  "quest.475548C3A4654C21.title": "The Fish Book",
  "quest.475548C3A4654C21.quest_desc": [
    "Catch every kind of fish from the Guhfish Pond once: Cheesefish, Chonky Bass, Guhpuffer, Pink Nyeg Trout, Mika Catfish and the Golden Guhfish.",
  ],
  "quest.475548FE596B266C.title": "Pure Gold",
  "quest.475548FE596B266C.quest_desc": [
    "Catch a &6Golden Guhfish&r: legendarily rare. It's yours: every golden fish gets your name, its weight and a number. A real collector's item!",
  ],
  "quest.475548BC4DD0D389.title": "A Chonky Little Hat",
  "quest.475548BC4DD0D389.quest_desc": [
    "Buy the Chonky Fishing Hat at the Fishing Guh's stall, for Fishing Tickets.",
  ],
  "quest.4755482DE66BB2E8.title": "Master Fishing Guh",
  "quest.4755482DE66BB2E8.quest_desc": [
    "Buy the whole fishing outfit for your guh: the Chonky Fishing Hat, the Guhfish Vest and the Fish-on-a-Hook.",
  ],
  "quest.475548FFE82FCC33.title": "Who's Hiding There?",
  "quest.475548FFE82FCC33.quest_desc": [
    "Find the rare &dHide-and-Guh House&r (Super Compass: Minigames > Hide-and-Guh House). Hidey Guh lives on the glass roof.",
  ],
  "quest.475548E1558765BB.title": "Hide-and-Guh: Easy",
  "quest.475548E1558765BB.quest_desc": [
    "Find all 5 hidden guhs on easy. Right-click a guh when you find it; listen for their soft little noises!",
  ],
  "quest.475548B620B532CB.title": "Hide-and-Guh: Medium",
  "quest.475548B620B532CB.quest_desc": [
    "Find all 8 hidden guhs on medium. Right-click a guh when you find it; listen for their soft little noises!",
  ],
  "quest.4755482E4B3CD864.title": "Hide-and-Guh: Hard",
  "quest.4755482E4B3CD864.quest_desc": [
    "Find all 12 hidden guhs on hard. Right-click a guh when you find it; listen for their soft little noises!",
  ],
  "quest.475548DD93693B17.title": "Guhlock Holmes",
  "quest.475548DD93693B17.quest_desc": [
    "Buy the Guhlock Cap, the Magnifying Chonk Glass and the Detective Coat from Hidey Guh (hide-and-guh tickets).",
  ],
  "quest.4755481BEE683328.title": "The Fair!",
  "quest.4755481BEE683328.quest_desc": [
    "Somewhere in the Guhmension stands the rare &dGuh Fair&r with a real roller coaster. The &6Guhmension Super Compass&r (Minigames > Guh Fair) shows the way.",
  ],
  "quest.475548B01243317A.title": "WHEEEEE!",
  "quest.475548B01243317A.quest_desc": [
    "Hop into a sled at the station, click the buttons and start. Every lap over the finish = a &6Fair Ticket&r. Your first lap gives a prize bag!",
  ],
  "quest.475548CBC79ACBDC.title": "Ticket Chonker",
  "quest.475548CBC79ACBDC.quest_desc": [
    "Save up 12 Fair Tickets (ride those laps!).",
  ],
  "quest.475548E71950231C.title": "Wahoog at the Fair",
  "quest.475548E71950231C.quest_desc": [
    "Buy the Wahoog Fair Hat, the Fair Jacket and the Guh Fair Bow for your guh from the Fair Guh.",
  ],
  "quest.475548C05F697ED8.title": "Shhhhh!",
  "quest.475548C05F697ED8.quest_desc": [
    "Somewhere in the Guhmension stands the very rare &dGuh Library&r: three floors full of books under a glass dome with guh ears. The &6Guhmension Super Compass&r (Wonders > Guh Library) shows the way.",
  ],
  "quest.47554826548264E3.title": "Reading Is Chonky",
  "quest.47554826548264E3.quest_desc": [
    "All the guh books lie open on the &dlecterns&r in the reading room: read them right away! You may take &6one&r copy of each book (button &eTake a copy&r). Take your first guh book.",
  ],
  "quest.475548E140372C86.title": "Half a Bookcase",
  "quest.475548E140372C86.quest_desc": [
    "Collect 6 different guh books from the lecterns. Sometimes there are a few in the archive chests upstairs too!",
  ],
  "quest.4755480051F584D6.title": "Behind the Bookcase",
  "quest.4755480051F584D6.quest_desc": [
    "Somewhere on the first floor, a pink book sticks out of a bookcase a little... Find the secret room and &5The Secret Guh Book&r.",
  ],
  "quest.4755488731A53619.title": "Bookworm Guh",
  "quest.4755488731A53619.quest_desc": [
    "Collect all 14 guh books, the secret one too (and the diary from the Silent Pantry). WAHOOG!",
  ],
  "quest.4755483923BA6B04.title": "Guh Quiz",
  "quest.4755483923BA6B04.quest_desc": [
    "Answer one of The Librarian's quiz questions correctly. He only asks about books you've read or collected, so read them carefully! Every correct answer (the first time) = a &6Book Token&r.",
  ],
  "quest.47554881E62C2B2D.title": "Guh Quizmaster",
  "quest.47554881E62C2B2D.quest_desc": [
    "Answer all 28 quiz questions correctly.",
  ],
  "quest.4755484A4F087146.title": "Professor Guh",
  "quest.4755484A4F087146.quest_desc": [
    "Buy the scholar outfit for your guh from The Librarian (only for sale there!): the Scholar's Specs, the Bookworm Vest and the Scholar's Beret, with Book Tokens.",
  ],
  "quest.475548F69974F1D7.title": "Mind Your Head!",
  "quest.475548F69974F1D7.quest_desc": [
    "Somewhere deep in the Guhmension stands a giant guh head wearing a yellow hard hat. Walk in through its mouth: that's the &6Cheese Mine&r! Very rare: use the Super Compass (Adventure).",
  ],
  "quest.475548121F90D993.title": "A Borrowed Pickaxe",
  "quest.475548121F90D993.quest_desc": [
    "Talk to the &dMiner Guh&r inside the head. He lends you a pickaxe, so you don't have to bring anything. Nyeg, do give it back though!",
  ],
  "quest.475548720CC0F282.title": "Cheese from the Rocks",
  "quest.475548720CC0F282.quest_desc": [
    "Mine the yellow &6Cheese Veins&r in the cheese tunnels: you won't find them anywhere but here in the Cheese Mine! Mined-out veins grow back all by themselves.",
  ],
  "quest.475548C779F6C560.title": "The Cheese Express",
  "quest.475548C779F6C560.quest_desc": [
    "Press a minecart dispenser, hop in and ride laps through the cheese tunnels for half a minute. WAHOOG!",
  ],
  "quest.475548E1FFF8F502.title": "Gouda as Gold",
  "quest.475548E1FFF8F502.quest_desc": [
    "Deep in the mine, in the dark deepslate, a &6Golden Cheese Vein&r sometimes glitters. Take the WAHOOG Jump down!",
  ],
  "quest.475548FEA8FD3A8E.title": "Click-Clack, the Cheese Vault",
  "quest.475548FEA8FD3A8E.quest_desc": [
    "In the treasure room, the Cheese Vault sits in the mouth of a golden guh. For 2 Gold Cheese it opens up...",
  ],
  "quest.4755485F616FBA04.title": "A Real Miner Guh",
  "quest.4755485F616FBA04.quest_desc": [
    "Buy the Miner Guh Helmet (with a little lamp!), the Cheese Mine Overalls and the Dusty Hanky from the Miner Guh (only he sells them) and put them on your guh. WAHOOG, what a pro!",
  ],
  "quest.475548F2C3072206.title": "Floating Guh Islets",
  "quest.475548F2C3072206.quest_desc": [
    "High up in the sky of the Guhmension float the &bFloating Guh Islets&r. Very rare! The &dGuhmension Super Compass&r (Wonders > Floating Guh Islets) shows the way.",
  ],
  "quest.47554840008A6FF3.title": "WAHOOG, Up We Go!",
  "quest.47554840008A6FF3.quest_desc": [
    "Under the islets lies a square with a guh face. Stand on the &bCloud Lift&r (the nose!): it blows you up into the sky. To get down, float on the blue Cloud Lift at the end of the gangplank.",
  ],
  "quest.475548D052D4B8AB.title": "What a Little Cloud!",
  "quest.475548D052D4B8AB.quest_desc": [
    "On the big island, in a nest of wool, lives the &bCloud Guh&r: the only one in the whole Guhmension. Stand next to it for its Guhdex page.",
  ],
  "quest.4755485C556227A0.title": "Chonky Little Cloud",
  "quest.4755485C556227A0.quest_desc": [
    "The Cloud Guh only trusts you once it's chonky enough: feed it at least &68 cheese nibbles&r.",
  ],
  "quest.4755482436815DDB.title": "On Cloud Nine",
  "quest.4755482436815DDB.quest_desc": [
    "Keep feeding the Cloud Guh until it's yours. A tamed Cloud Guh catches you when you fall!",
  ],
  "quest.475548C77995F676.title": "Head in the Clouds",
  "quest.475548C77995F676.quest_desc": [
    "Undress your tamed Cloud Guh in its wardrobe: the &bCloud Hat&r and the &bCloud Collar&r are now yours (and your other guhs').",
  ],
  "quest.475548D0F3606F95.title": "Soft Landing",
  "quest.475548D0F3606F95.quest_desc": [
    "Jump off something (at least 6 blocks) while your tamed Cloud Guh is nearby. Poof: it catches you!",
  ],
  "quest.475548D9B78F7425.title": "Cloud Cotton Candy",
  "quest.475548D9B78F7425.quest_desc": [
    "In the mouth of the Guh Rock (the giant guh head drooling cheese sauce) and on the highest little cloud there's a treasure chest. Look for &bCloud Cotton Candy&r: with it you float gently down anywhere.",
  ],
  "quest.475548980F989F11.title": "Easy, Medium or Hard?",
  "quest.475548980F989F11.quest_desc": [
    "At the &dChonk Pageant&r, &dWhack-a-Mika&r, &dguh golf&r, the &dChonky Food Fest&r and the &dGuhfish Contest&r you now pick how hard it is yourself: three buttons above the play button. &aEasy&r is nice and relaxed, &emedium&r is like always and &chard&r... is really hard, but you get half again as much reward! Every level has its own scoreboard.",
  ],
  "quest.4755480F6DE2695F.title": "Strict but Chonky",
  "quest.4755480F6DE2695F.quest_desc": [
    "Walk a whole show on &chard&r: only 30 seconds to dress your model, and a strict jury. Tip: pick pieces that really fit the theme, and preferably a set!",
  ],
  "quest.475548ADF917CFA5.title": "Lightning Whacker",
  "quest.475548ADF917CFA5.quest_desc": [
    "Play Whack-a-Mika on &chard&r: the Mikas are lightning fast and there are lots of guhs in between. Don't whack the guhs, okay!",
  ],
  "quest.475548E2A93DF110.title": "From the Red Tee",
  "quest.475548E2A93DF110.quest_desc": [
    "Play all 9 holes on &chard&r: 6 strokes per hole and penalty strokes, from the red tee mats all the way at the back, past extra slime bumpers and under a turbo guh windmill.",
  ],
  "quest.47554898DEA11A70.title": "Greasy and Chonky",
  "quest.47554898DEA11A70.quest_desc": [
    "Score points at the food fest on &chard&r: the food drops like a rocket and it's raining Mika's Grease. Will your guh still be wahoog?",
  ],
  "quest.475548438842EB9D.title": "Quick Rod",
  "quest.475548438842EB9D.quest_desc": [
    "Fish a whole contest on &chard&r: when you get a bite you only have half a second, and heavy fish sometimes wriggle off your hook.",
  ],
  "quest.475548688C77BE65.title": "Classics Champion",
  "quest.475548688C77BE65.quest_desc": [
    "Play all five classics on &chard&r. Then you're the most wahoog guh in the Guhmension! WAHOOG!",
  ],
  "quest.47554896A47CFE51.title": "The Shuffle House",
  "quest.47554896A47CFE51.quest_desc": [
    "In the &dGuh Meadows&r there's sometimes a wooden house with a giant shuffleboard for a roof and a guh face on the front: the &6Shuffle House&r (Super Compass: Minigames). &6Granny Nyegshuffle&r lives inside.",
  ],
  "quest.475548520EDD79D2.title": "Twenty Pucks",
  "quest.475548520EDD79D2.quest_desc": [
    "Talk to Granny Nyegshuffle and shuffle a whole turn. Hold right-click: the power bar goes up and down, and between Granny's two little lines is just right. Look where the puck needs to go and let go!",
  ],
  "quest.47554867E7BBADAD.title": "Granny Is Proud",
  "quest.47554867E7BBADAD.quest_desc": [
    "Shuffle 60 points or more. Tip: try to get the same number of pucks in every gate, because every set (2-3-4-1) is twenty points!",
  ],
  "quest.475548FBBC98B405.title": "A Hundred! WAHOOG!",
  "quest.475548FBBC98B405.quest_desc": [
    "The full 100 points: five pucks in every gate. Granny Nyegshuffle has only seen that once before...",
  ],
  "quest.47554809D3FF4C66.title": "Cap On!",
  "quest.47554809D3FF4C66.quest_desc": [
    "Buy the Shuffle Cap from Granny Nyegshuffle (4 Shuffle Pucks): a flat little cap, just like a shuffle puck.",
  ],
  "quest.4755488DCA9CB4D9.title": "Knitted by Granny",
  "quest.4755488DCA9CB4D9.quest_desc": [
    "Collect the whole shuffle outfit: the Shuffle Cap, the warm Shuffle Vest and the Shuffle Brooch.",
  ],
  "quest.475548480C804919.title": "A Cup of Tea with Granny",
  "quest.475548480C804919.quest_desc": [
    "Add Granny Nyegshuffle to your Guhdex (get close enough).",
  ],
  "quest.47554825ECEE7473.title": "The Guh Maze",
  "quest.47554825ECEE7473.quest_desc": [
    "In the &dGuh Fields&r stands an enormous hedge maze with a lookout guh in the middle. The Super Compass (Minigames) shows the way. Say hello to &aMr. Chonkwiggle&r at his kiosk on the square.",
  ],
  "quest.47554836B1695B5F.title": "A Little Maze",
  "quest.47554836B1695B5F.quest_desc": [
    "Pick &aeasy&r: Mr. Chonkwiggle grows a new maze. Find the eight stolen cheese nibbles (they float, glittering, above the hedges, and at the bottom of your screen you can see how many are still hidden) and run to the exit in the north. Watch out for the slow Hedge Mika!",
  ],
  "quest.4755485630613F2B.title": "Twelve Nibbles",
  "quest.4755485630613F2B.quest_desc": [
    "Beat the &emedium&r maze: twelve nibbles and two Hedge Mikas that snatch one back if they tag you.",
  ],
  "quest.4755485AFDCE02D4.title": "Maze Master",
  "quest.4755485AFDCE02D4.quest_desc": [
    "The &chard&r maze: the whole hedge field, sixteen nibbles, three fast Mikas and fake nibbles in the dead ends (those cost time!). Real nibbles glitter a little...",
  ],
  "quest.47554843C2A6AE40.title": "Can't Catch Me!",
  "quest.47554843C2A6AE40.quest_desc": [
    "Beat a medium or hard maze without a Mika snatching even one nibble.",
  ],
  "quest.4755484C80F1DA28.title": "Off Exploring",
  "quest.4755484C80F1DA28.quest_desc": [
    "Buy the Explorer's Hat, the Little Maze Compass and the Explorer's Backpack from Mr. Chonkwiggle (maze nibbles) and unlock them for your guhs.",
  ],
  "quest.475548A68B4F7834.title": "The Nibble Catapult",
  "quest.475548A68B4F7834.quest_desc": [
    "On the &dChonk Cliffs&r there's sometimes a cheerful guh castle with a catapult on the wall, facing a wonky Mika Fort (Super Compass: Minigames). &6Captain Floopguh&r stands on the wall.",
  ],
  "quest.47554855AD08DBA4.title": "Twelve Forts",
  "quest.47554855AD08DBA4.quest_desc": [
    "Pick a level at the Captain and knock twelve Mika Forts flat. Aim, hold right-click and let go: FLOOP! Mikas run off giggling (nobody gets hurt) and the stolen cheese nibbles are free again.",
  ],
  "quest.47554832B053900E.title": "Three Stars!",
  "quest.47554832B053900E.quest_desc": [
    "Get three stars on one fort: all Mikas gone, all nibble chests open, and a fluffball left over. Tip: hit the thin posts at the bottom!",
  ],
  "quest.475548D077B2AF10.title": "Against the Wind",
  "quest.475548D077B2AF10.quest_desc": [
    "Play a whole round on &chard&r: three fluffballs per fort, and it's windy. Keep an eye on the wind arrows at the bottom of your screen!",
  ],
  "quest.475548504EE48A0E.title": "Thirty-Six Stars",
  "quest.475548504EE48A0E.quest_desc": [
    "Get all 36 stars in one round. That'll leave Captain Floopguh totally speechless.",
  ],
  "quest.475548C8CF61517D.title": "Ready to Floop",
  "quest.475548C8CF61517D.quest_desc": [
    "Collect the whole catapult outfit from the Captain: the Catapult Helmet, the Catapult Belt and the Fluffball Earrings.",
  ],
  "quest.475548DF92FE2A41.title": "Ahoy, Captain!",
  "quest.475548DF92FE2A41.quest_desc": [
    "Add Captain Floopguh to your Guhdex (get close enough).",
  ],
  "quest.475548A8968EEAD5.title": "Ladies and Guhtlemen!",
  "quest.475548A8968EEAD5.quest_desc": [
    "In the &dGuh Meadows&r and the &dPink Puffs&r there's sometimes a big circus tent with two guh ears for tent peaks: &6The Nibble Games&r. Say hello to &aCoach Wahoogaroo&r in the middle of the ring.",
  ],
  "quest.4755489903674232.title": "On Your Marks...",
  "quest.4755489903674232.quest_desc": [
    "Pick an event at Coach Wahoogaroo and join in. Bring your friends: up to four guhs play at once, each in their own lane!",
  ],
  "quest.4755484E1C6CEE78.title": "Right on the Bum!",
  "quest.4755484E1C6CEE78.quest_desc": [
    "Pin the Tail on the Guh: blindfold on, spin around three times, then put the little tail in the right spot. Score 950 points or more!",
  ],
  "quest.4755488B1D88004B.title": "WAHOOG Together",
  "quest.4755488B1D88004B.quest_desc": [
    "Play The Nibble Games with at least one friend at the same time. Whoever opens it waits a moment for the others.",
  ],
  "quest.47554850E5891FAD.title": "The Great Hexathlon",
  "quest.47554850E5891FAD.quest_desc": [
    "All six events in a row: Nibble Bobbing, Sack Race, Mika Can Toss, Egg-and-Spoon Race, Nail Plopping and Pin the Tail on the Guh. Every event is 0 to 1000 points!",
  ],
  "quest.4755488C4566D5E9.title": "Wahoogest of the Hexathlon",
  "quest.4755488C4566D5E9.quest_desc": [
    "Score 5000 points or more in The Great Hexathlon. The score table at Coach Wahoogaroo tells you how it counts.",
  ],
  "quest.475548E9294953E1.title": "Dressed for Sport",
  "quest.475548E9294953E1.quest_desc": [
    "Buy the Sports Sweatband, the Referee Whistle and the Nibble Games Jersey from Coach Wahoogaroo (Games Ribbons) and unlock them for your guhs.",
  ],
  "quest.4755485ED0EC891E.title": "A Frozen Canal",
  "quest.4755485ED0EC891E.quest_desc": [
    "Somewhere in an ice-cold &bGuh Polder&r lies a frozen canal past eleven villages: the &6Eleven Guhtowns Tour&r! The Super Compass (Minigames tab) shows you the way.",
  ],
  "quest.475548B8E9048CAF.title": "It giet oan!",
  "quest.475548B8E9048CAF.quest_desc": [
    "Talk to &6Skate Master Guhglide&r in Guhwarden and start the tour. Hold on to the guh skates: on the ice you glide super wahoog!",
  ],
  "quest.4755489FFC48ABFE.title": "Eleven Guhtowns Cross",
  "quest.4755489FFC48ABFE.quest_desc": [
    "Get a stamp from every &6Stamp Guh&r, in the right order (Snuh first, Guhwarden last), and skate the whole tour to the end. Every tour gives &612 Town Stamps&r (up to 8 extra if you're fast), and your first time you get the &6Eleven Guhtowns Cross&r and 5 extra Town Stamps!",
  ],
  "quest.4755482190718286.title": "Super Wahoog",
  "quest.4755482190718286.quest_desc": [
    "Skate the Eleven Guhtowns Tour in under 3:40. Tip: Hot Chocochonk and pea soup give a boost, and sprinting on the ice is fastest! That fast, you get 8 extra Town Stamps.",
  ],
  "quest.4755488F88435451.title": "All Bundled Up",
  "quest.4755488F88435451.quest_desc": [
    "Buy the Pom-Pom Skating Hat, the Woolly Skating Sweater, the Orange Skating Scarf and the Fluffy Earmuffs from Skate Master Guhglide, and unlock them for your guhs.",
  ],
  "quest.4755485C0B23A2AC.title": "Welcome to the Circuit!",
  "quest.4755485C0B23A2AC.quest_desc": [
    "Find &dThe Guh Circuit&r in the Guh Fields or the Cheese Flats (Super Compass: Minigames > Guh Circuit). In the Pit Palace, Coach Wahoog-Vroom is waiting with a Rental Racing Guh for you.",
  ],
  "quest.475548BBF4BDE6D4.title": "Vrrrm, WAHOOG!",
  "quest.475548BBF4BDE6D4.quest_desc": [
    "Ride your first race on the Guh Circuit. Pick a track and a level at Coach Wahoog-Vroom: you don't have to bring anything.",
  ],
  "quest.4755487BE18E6E5A.title": "Above the Clouds",
  "quest.4755487BE18E6E5A.quest_desc": [
    "Finish &dRainbow Road&r. Ride through the rainbow rings for a WAHOOG boost and jump over the gaps in the road!",
  ],
  "quest.4755489CBED89ABD.title": "Wheeee, the Loop!",
  "quest.4755489CBED89ABD.quest_desc": [
    "Finish the &6Chonk Track&r: slippery cheese sauce, bouncy mushrooms and the Chonk Loop. Just keep running!",
  ],
  "quest.475548AE4014FB23.title": "On Top of Cheese Mountain",
  "quest.475548AE4014FB23.quest_desc": [
    "Finish the &bCheese Mountain Track&r. Dodge the Mikas' rolling cheese nibbles on the Nibble Slope!",
  ],
  "quest.475548BD11AF5B98.title": "Circuit Champion",
  "quest.475548BD11AF5B98.quest_desc": [
    "Finish all three tracks of the Guh Circuit.",
  ],
  "quest.4755481B1D6B040E.title": "Stubborn Racing Guh",
  "quest.4755481B1D6B040E.quest_desc": [
    "Ride a race on &chard&r: a super fast but stubborn racing guh, lots of Mika Snatchers, and the silver WAHOOG pads don't work.",
  ],
  "quest.4755482A459EBE73.title": "Faster Than the Legend",
  "quest.4755482A459EBE73.quest_desc": [
    "Beat the &6golden ghost&r (the world's track record rides along with you) or race a &6gold-medal time&r on a track of the Guh Circuit. Are you as fast as the legend?",
  ],
  "quest.47554876D1608B59.title": "A Real Racer",
  "quest.47554876D1608B59.quest_desc": [
    "Buy the whole circuit outfit from Coach Wahoog-Vroom: Circuit Helmet, Wahoog Racing Suit and Checkered Flag Cape. Only there!",
  ],
  "quest.475548CB65F2E24D.title": "Off Exploring!",
  "quest.475548CB65F2E24D.quest_desc": [
    "Six brand-new buildings full of games: the &6Shuffle House&r, the &2Guh Maze&r, the &cNibble Catapult&r, the &9Nibble Games&r, the &bEleven Guhtowns Tour&r and the &dGuh Circuit&r. Pick them in your Super Compass (Minigames tab) and take a peek inside. Your Guhdex (Minigames tab) shows which ones you've found already!",
  ],
  "quest.475548E0CAC848B5.title": "Wahoog Globetrotter",
  "quest.475548E0CAC848B5.quest_desc": [
    "A real guh tourist visits ALL the minigame buildings: the classics, Snuggledale and The Great Guh Games. The Guhdex (Minigames tab) shows with a tick where you've been. Still missing one? Nyeg! The Super Compass will help you.",
  ],
  "quest.475548E006EB2DD7.title": "The Guh Polder",
  "quest.475548E006EB2DD7.quest_desc": [
    "Somewhere in the Guhmension lies an ice-cold, flat &bGuh Polder&r: frosty grass, pollard willows, frozen ditches and little snow guhs. This is where the &bEleven Guhtowns Tour&r is skated! Bring a warm scarf, nyeg.",
  ],
  "quest.47554817273F1C11.title": "A Chonky Pinguh",
  "quest.47554817273F1C11.quest_desc": [
    "A third of the wild guhs in the polder are &bPinguhs&r: classic, emperor or a gray fluffy chick. Tame one with cheese nibbles. It slides on its tummy over the ice, and during the Eleven Guhtowns Tour it slides right along with you!",
  ],
  "quest.475548AF7C757117.title": "Ice Flowers",
  "quest.475548AF7C757117.quest_desc": [
    "Pick three &bguh ice flowers&r: see-through blue flowers with a teeny tiny guh face. They give light blue dye!",
  ],
  "quest.475548321705AC6B.title": "A Guh Windmill",
  "quest.475548321705AC6B.quest_desc": [
    "Find a &bGuh Windmill&r in the polder or make one yourself (wool, sticks, a cheese nibble and planks). Its sails turn all day long, and even faster when it snows!",
  ],
  "quest.475548FCF35677EC.title": "Freshly Ground",
  "quest.475548FCF35677EC.quest_desc": [
    "Put Nibble Grain in a Guh Windmill (right-click) and get &eNibble Flour&r out of it. In the baker's Nibble Oven, Nibble Flour bakes twice as much. WAHOOG!",
  ],
}
