  "quest.475548A2537EFEEF.title": "Crystal Clear",
  "quest.475548A2537EFEEF.quest_desc": [
    "Build a &dSand Pit&r and a &dGlassworks&r.",
  ],
  "quest.475548765EA37757.title": "A Splash of Color",
  "quest.475548765EA37757.quest_desc": [
    "Pick a &dcolor&r for your candles at the Candle Maker's. Making color costs chonk power!",
  ],
  "quest.4755480011896D4D.title": "Pick Your Blocks",
  "quest.4755480011896D4D.quest_desc": [
    "Pick which Site Shed blocks the &dBuilding Block Workshop&r makes (something other than just the pink pastel brick).",
  ],
  "quest.4755483E2F965BF5.title": "A Delivery Chest",
  "quest.4755483E2F965BF5.quest_desc": [
    "You get a &dDelivery Chest&r when you buy the farm, and you can make more. That's where the mail from your village arrives.",
  ],
  "quest.475548C070E33CE1.title": "Send It Home",
  "quest.475548C070E33CE1.quest_desc": [
    "Send stuff from your village to your &dDelivery Chest&r (button &eSend Home&r).",
  ],
  "task.4755488116209183.title": "Building stuff sent home",
  "quest.475548A6FC3B9098.title": "Flat-Pack Delivery",
  "quest.475548A6FC3B9098.quest_desc": [
    "Send &e5,000&r logs, clay, sand, glass shards and Site Shed blocks home.",
  ],
  "quest.475548CF672C8A04.title": "At the Counter",
  "quest.475548CF672C8A04.quest_desc": [
    "Hand in something from your pockets at the &dBuilding Supplies Counter&r. Big upgrades need stuff from the real world.",
  ],
  "quest.475548C6D588723D.title": "Splash, Color Comes Back",
  "quest.475548C6D588723D.quest_desc": [
    "Dye white wool from your village at home (Dye Bath, Color Mill) and hand in the &dcolored wool&r at the counter.",
  ],
  "quest.475548984996E84F.title": "The Village Transmitter",
  "quest.475548984996E84F.quest_desc": [
    "Make a &dVillage Transmitter&r (a Chonk Transmitter with crystals and a block of cheese nibbles) and put it on your chonk power net.",
  ],
  "quest.475548ACDEF2317E.title": "Sparks in the Village",
  "quest.475548ACDEF2317E.quest_desc": [
    "Build the &dChonk Mast&r and get &e40 chonk power&r to arrive from your Village Transmitter.",
  ],
  "task.4755486E80F993EF.title": "Residents in your village",
  "quest.47554864BA40718A.title": "A Cozy Little Street",
  "quest.47554864BA40718A.quest_desc": [
    "&e10 residents&r in your village.",
  ],
  "task.4755486218D7F3F2.title": "Residents in your village",
  "quest.475548E7E560C177.title": "A Real Village",
  "quest.475548E7E560C177.quest_desc": [
    "&e50 residents&r! A real village.",
  ],
  "quest.475548FA80DC2AE4.title": "Who Wants a Swing?",
  "quest.475548FA80DC2AE4.quest_desc": [
    "Build a &dPlayground&r: even more residents will come for that.",
  ],
  "quest.4755482AAF27F5C7.title": "Sleepover!",
  "quest.4755482AAF27F5C7.quest_desc": [
    "Build a &dGuh Guesthouse&r and let one of your own guhs stay over.",
  ],
  "quest.4755489AAA4A29A5.title": "Coffee at The Chonky Cow",
  "quest.4755489AAA4A29A5.quest_desc": [
    "Build the &dVillage Café&r: everyone works a little harder with coffee.",
  ],
  "quest.475548C66A4F7229.title": "Village Party!",
  "quest.475548C66A4F7229.quest_desc": [
