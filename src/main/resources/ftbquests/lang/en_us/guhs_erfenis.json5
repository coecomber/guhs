  ],
  "quest.47554892730F8A6D.title": "For the Big Neighbors",
  "quest.47554892730F8A6D.quest_desc": [
    "Deliver an order to a village that is &ehigher&r than yours.",
  ],
  "quest.475548CED2C3B28D.title": "The Golden Cart",
  "quest.475548CED2C3B28D.quest_desc": [
    "Every day there's one &6golden star&r order. Deliver one!",
  ],
  "quest.475548923498020F.title": "Lend a Hand",
  "quest.475548923498020F.quest_desc": [
    "On the world map, click &eLend a Hand&r at another player's village.",
