  ],
  "quest.4755486C4799BD63.title": "Your Very Own Sniffing Agency",
  "quest.4755486C4799BD63.quest_desc": [
    "Build a &dDetective Agency&r. Sherlock Guh and Doctor Chonkson move in, and you get a magnifying glass!",
  ],
  "quest.4755487AE7953237.title": "Case 1: The Vanished Eggs",
  "quest.4755487AE7953237.quest_desc": [
    "Solve the case &dThe Vanished Eggs&r. It starts when the Detective Agency is built (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.475548A7B8050518.title": "Case 2: The Trail of Crumbs",
  "quest.475548A7B8050518.quest_desc": [
    "Solve the case &dThe Trail of Crumbs&r. It starts when you build a Bakery (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.47554800F8B4812F.title": "Case 3: The Ghost in the Shed",
  "quest.47554800F8B4812F.quest_desc": [
    "Solve the case &dThe Ghost in the Shed&r. It starts when your Homestead reaches level 4 (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.475548B57104DC98.title": "Case 4: The Vanished Wool",
  "quest.475548B57104DC98.quest_desc": [
    "Solve the case &dThe Vanished Wool&r. It starts with a Weaving Mill and 10 orders (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.4755484B9A85D2ED.title": "Case 5: Grandpa Nibble's Cellar",
  "quest.4755484B9A85D2ED.quest_desc": [
    "Solve the case &dGrandpa Nibble's Cellar&r. It starts when your Homestead reaches level 5 (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.4755482E620238A8.title": "Case 6: The Stolen Cowbell",
  "quest.4755482E620238A8.quest_desc": [
    "Solve the case &dThe Stolen Cowbell&r. It starts when you build a Bandstand (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.4755488E1BAB3B8C.title": "Case 7: The Moved Posts",
  "quest.4755488E1BAB3B8C.quest_desc": [
    "Solve the case &dThe Moved Posts&r. It starts when your Homestead reaches level 7 (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.47554852B62CB271.title": "Case 8: Light in the Cellar",
  "quest.47554852B62CB271.quest_desc": [
