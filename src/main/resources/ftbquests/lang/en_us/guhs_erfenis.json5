  ],
  "quest.47554820BDB0A33C.title": "On the Map",
  "quest.47554820BDB0A33C.quest_desc": [
    "Press &eF10&r: the &dworld map&r with all the villages and carts.",
  ],
  "quest.47554897132AD5FC.title": "Peeking at the Neighbors",
  "quest.47554897132AD5FC.quest_desc": [
    "Go visit another village.",
  ],
