  ],
  "quest.4755483FB5B171D4.title": "Case 9: The Tin Under the Little Tree",
  "quest.4755483FB5B171D4.quest_desc": [
    "Solve the case &dThe Tin Under the Little Tree&r. It starts when your Homestead reaches level 8 (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.475548F5E86E2D80.title": "Case 10: The Preparation",
  "quest.475548F5E86E2D80.quest_desc": [
    "Solve the case &dThe Preparation&r. It starts right after the can (and the case before it is solved). Sniff around, hear witnesses, string up clues: whodunit?",
  ],
  "quest.475548645504E796.title": "OBJECTION, NYEG!",
  "quest.475548645504E796.quest_desc": [
    "&dThe Great Nibble Case&r: the trial against Morris-Mika (Homestead 9 and The Preparation). Pick the right evidence and shout: OBJECTION, NYEG!",
  ],
  "quest.475548B61FCF3093.title": "A Touch of Cozy",
  "quest.475548B61FCF3093.quest_desc": [
    "Place your first &ddeco piece&r.",
  ],
  "quest.4755484889948732.title": "What's This Doing Here?",
  "quest.4755484889948732.quest_desc": [
    "Find an old &ddeco piece&r while clearing up (or the old tractor).",
