  "quest.475548E6F6A8337D.title": "Thanks from the Neighbors",
  "quest.475548E6F6A8337D.quest_desc": [
    "Sometimes a neighboring village sends a &ddeco piece&r as a thank-you after an order. Get one!",
  ],
  "task.475548DE74DDBDF4.title": "Postcards from the realtor",
  "quest.475548F9EE742E3C.title": "Greetings from the Realtor",
  "quest.475548F9EE742E3C.quest_desc": [
    "Collect all &e8 postcards&r from realtor Guhrrit: 3 under the clumps, 5 he sends by Postguh from his vacation (Homestead 3 to 7). They go on the postcard board.",
  ],
  "quest.475548002F6ED636.title": "Squirtguh",
  "quest.475548002F6ED636.quest_desc": [
