{
  "chapter.47554813E71C5365.title": "&6A Fixer-Upper!",
  "chapter.47554813E71C5365.chapter_subtitle": [
    "18. Structural report: chonky",
  ],
  "quest.4755489F77A1DB10.title": "How Do You Get Here?",
  "quest.4755489F77A1DB10.quest_desc": [
    "This chapter comes after &dWelcome to the Guhmension!&r in &dThe Guhmension&r: half an hour later the &dPostguh&r brings you a letter from realtor &dGuhrrit&r.",
    "",
    "Grandpa Nibble's old farm is for sale, for &eone cheese nibble&r! A bit of a fixer-upper... Clear it up, build your Homestead up to level 10, let residents move in, deliver orders to the neighbors, send stuff home and solve the mystery of the farm with &dSherlock Guh&r.",
    "",
    "The quests about your village tick themselves off as soon as your village gets that far. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonkily to work!",
  ],
  "quest.4755489D39449FD0.title": "Guh've Got Mail!",
  "quest.4755489D39449FD0.quest_desc": [
    "About half an hour of playtime after your first visit to the Guhmension, the &dPostguh&r drops by with a letter from realtor &dGuhrrit&r. For you? Nyeg!",
  ],
  "quest.475548922B21064B.title": "One Nibble, What a Bargain",
  "quest.475548922B21064B.quest_desc": [
    "Read the letter and click &eBuy for 1 cheese nibble&r. A whole farm for one cheese nibble! Structural report: chonky. Emotional report: very chonky.",
  ],
  "quest.4755480279263F5C.title": "A Gate to Your Farm",
  "quest.4755480279263F5C.quest_desc": [
    "When you buy it you get a &dInheritance Gate&r (and a Delivery Chest). Put the gate in your base: that's your little door to your very own farm.",
  ],
  "quest.475548158B81D04C.title": "Structural report: chonky",
  "quest.475548158B81D04C.quest_desc": [
    "Walk through the Inheritance Gate. Well... it's a bit of a fixer-upper. Bushes, nettles, molehills. But the &dHomestead&r is still standing!",
  ],
  "quest.475548D8F3358F02.title": "From Up Above",
  "quest.475548D8F3358F02.quest_desc": [
    "Press &eF9&r: the &dtop view&r of your farm. That's where you build, clear and arrange everything.",
  ],
  "task.4755480D9C585961.title": "Clumps cleared",
  "quest.47554884D8F77E33.title": "Weed It and Reap",
  "quest.47554884D8F77E33.quest_desc": [
    "Clear a &dclump&r in the top view: a bush, a boulder, an old cart. Sometimes there's something fun underneath!",
  ],
  "quest.47554803435EE390.title": "Cluck Cluck, Guh",
  "quest.47554803435EE390.quest_desc": [
    "Build your first &dChicken Coop&r. The first one is free!",
  ],
  "task.475548CA43C8AD71.title": "Residents in your village",
  "quest.4755489068172224.title": "A New Neighguhr",
  "quest.4755489068172224.quest_desc": [
    "Build a &dGuh Hut&r: a resident will move in all by themselves. Residents work in your buildings.",
  ],
  "task.47554883BD825C9A.title": "Orders delivered",
  "quest.4755484F79611921.title": "Cart on the Road",
  "quest.4755484F79611921.quest_desc": [
    "Deliver a first order to a neighboring village (the &dMarket Square&r, or click a cart on the world map).",
  ],
  "task.4755483FD216E15F.title": "Level of your Homestead",
  "quest.4755488C00D6520E.title": "Bye-Bye, Realtor!",
  "quest.4755488C00D6520E.quest_desc": [
    "Your Homestead at &elevel 2&r. Realtor Guhrrit thinks it looks fine like this and goes on vacation. With a sombrero.",
  ],
  "task.475548CB2BED4AF6.title": "Level of your Homestead",
  "quest.475548B5AEE5988F.title": "Pink Roof Tiles",
  "quest.475548B5AEE5988F.quest_desc": [
    "Your Homestead at &elevel 3&r: pink roof tiles! Don't forget your &dStorage Barn&r: more room for all your stuff.",
  ],
  "task.47554896CD6663F7.title": "Level of your Homestead",
  "quest.4755484BA4DA0E49.title": "A Real Little Farm",
  "quest.4755484BA4DA0E49.quest_desc": [
    "Your Homestead at &elevel 4&r. It's starting to look like something, guh.",
  ],
  "task.475548A54B7792B7.title": "Level of your Homestead",
  "quest.475548A39E757ACE.title": "Half-Timbered and Huggable",
  "quest.475548A39E757ACE.quest_desc": [
    "Your Homestead at &elevel 5&r: half-timbering, and plushies everywhere. So cozy!",
  ],
  "task.475548B9B730BD1D.title": "Level of your Homestead",
  "quest.475548DE2235302C.title": "A Homestead with Flair",
  "quest.475548DE2235302C.quest_desc": [
    "Your Homestead at &elevel 6&r. The neighbors are looking a little jealous.",
  ],
  "task.475548D82D456962.title": "Level of your Homestead",
  "quest.475548B45711DFE6.title": "A Touch of Chonk",
  "quest.475548B45711DFE6.quest_desc": [
    "Your Homestead at &elevel 7&r: gold and chonk. Very wahoog.",
  ],
  "task.475548EB5ED9E794.title": "Level of your Homestead",
  "quest.47554898F359A686.title": "Lord of the Manor",
  "quest.47554898F359A686.quest_desc": [
    "Your Homestead at &elevel 8&r. A real manor farm, with a guh as lord of the manor.",
  ],
  "task.475548FCA258886D.title": "Level of your Homestead",
  "quest.475548E439332F19.title": "Pastels and Twinkles",
  "quest.475548E439332F19.quest_desc": [
    "Your Homestead at &elevel 9&r: pastel colors and twinkly lights everywhere.",
  ],
  "task.4755484F45A63379.title": "Level of your Homestead",
  "quest.475548CA085912AB.title": "The Great Snuggle Homestead",
  "quest.475548CA085912AB.quest_desc": [
    "Your Homestead at &elevel 10&r: the Great Snuggle Homestead! Grandpa Nibble would be so proud.",
  ],
  "quest.4755482840CDBF70.title": "Two Extra Pairs of Paws",
  "quest.4755482840CDBF70.quest_desc": [
    "Build a &dCarpentry Barn&r: a second builder! At level 7 a third one joins too (with a coffee break).",
  ],
  "task.4755487D31985ACE.title": "Clumps cleared",
  "quest.4755480B4560C04F.title": "Neat and Tidy",
  "quest.4755480B4560C04F.quest_desc": [
    "Clear &e16 clumps&r: the whole inner ring is clean.",
  ],
  "task.4755484B3DF21A2B.title": "Clumps cleared",
  "quest.47554865B5523166.title": "All the Way to the Woods",
  "quest.47554865B5523166.quest_desc": [
    "Clear &e40 clumps&r.",
  ],
  "task.4755483B76F23B80.title": "Clumps cleared",
  "quest.4755484679B454B1.title": "Nettle-Free Zone",
  "quest.4755484679B454B1.quest_desc": [
    "Clear &eall 72 clumps&r. Not a nettle in sight!",
  ],
  "task.475548FCCC562D36.title": "Plots bought",
  "quest.47554809B055B075.title": "More Land!",
  "quest.47554809B055B075.quest_desc": [
    "Buy a first extra &dplot&r of land in the top view.",
  ],
  "task.475548AB46C01C88.title": "Plots bought",
  "quest.4755489D022FBF66.title": "Land Baron Guh",
  "quest.4755489D022FBF66.quest_desc": [
    "Buy &eall 16 plots&r. As far as the eye can see: all yours!",
  ],
  "quest.475548DDBE0DFE26.title": "Baa Baa Guhsheep",
  "quest.475548DDBE0DFE26.quest_desc": [
    "Build a &dSheepfold&r: wool!",
  ],
  "quest.47554878A3D82DE1.title": "Fluffy Little Ears",
  "quest.47554878A3D82DE1.quest_desc": [
    "Build a &dBunny Run&r: bunny fluff.",
  ],
  "quest.4755484D9C0E8CCF.title": "Quack, Guh",
  "quest.4755484D9C0E8CCF.quest_desc": [
    "Build a &dDuck Pond&r: down and little duck eggs.",
  ],
  "quest.4755480C8D50C8FB.title": "Moo-Guh",
  "quest.4755480C8D50C8FB.quest_desc": [
    "Build a &dCow Barn&r: milk!",
  ],
  "quest.475548C993CD9E75.title": "Buzzguhs",
  "quest.475548C993CD9E75.quest_desc": [
    "Build a &dBee Yard&r: honey and wax.",
