  "quest.47554885B8E5F5B9.title": "Little Clouds in the Meadow",
  "quest.47554885B8E5F5B9.quest_desc": [
    "A &dSheepfold at level 7&r (and your Homestead at 7 too): then the &dcloud lambs&r come, with extra fluff.",
  ],
  "quest.4755483E6CD83C8C.title": "A Very Woolly Surprise",
  "quest.4755483E6CD83C8C.quest_desc": [
    "Build the &dMammoth Meadow&r. With enough chonk power the little mammoths don't sleep, and they make mountains of giant wool.",
  ],
  "quest.475548E4013DA144.title": "Sow It Begins",
  "quest.475548E4013DA144.quest_desc": [
    "Build a &dField&r and pick a crop: grain, pink grain, carrots, flowers or fluffballs.",
  ],
  "quest.475548F2E70FE050.title": "Berry Picking",
  "quest.475548F2E70FE050.quest_desc": [
    "Build an &dOrchard&r: nibbleberries and fruit.",
  ],
  "quest.47554870D84B4934.title": "The Mill Keeps Turning",
  "quest.47554870D84B4934.quest_desc": [
    "Grind your first &dflour&r in the &dWindmill&r.",
  ],
  "quest.475548C1A90CB9CC.title": "Fresh from the Baker",
  "quest.475548C1A90CB9CC.quest_desc": [
    "Bake your first &dbread&r in the &dBakery&r.",
  ],
  "quest.4755482428E1549E.title": "A Cookie with Your Coffee",
  "quest.4755482428E1549E.quest_desc": [
    "Bake your first &dcake&r in the Bakery.",
  ],
  "quest.475548FF39C376B8.title": "Weave, Weave",
  "quest.475548FF39C376B8.quest_desc": [
    "Weave your first &dfabric&r at the &dWeaving Mill&r.",
  ],
  "quest.4755482E3148DC41.title": "Cheesemaker Guh",
  "quest.4755482E3148DC41.quest_desc": [
    "Make your first &dcheese&r at the &dCreamery&r.",
