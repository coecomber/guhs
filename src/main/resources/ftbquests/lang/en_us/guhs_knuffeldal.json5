{
  "chapter.4755483088298F15.title": "&dSnuggledale",
  "chapter.4755483088298F15.chapter_subtitle": [
    "8. The Great Cozyfest is coming!",
  ],
  "quest.475548D5EB5E04C8.title": "How Do You Get Here?",
  "quest.475548D5EB5E04C8.quest_desc": [
    "This chapter comes after &6The Super Compass&r in &dThe Guhmension&r: pick the &dCozy&r category and it points you to &dSnuggledale&r.",
    "",
    "Help Mayor Chonkworth with the Great Cozyfest. Every building on the square (and beyond) has its own row below. And go look up &dCoco&r some time!",
    "",
    "Everything is cozy. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes next. Tick this off and get chonky to work!",
  ],
  "quest.475548C42A97D413.title": "Snuggledale",
  "quest.475548C42A97D413.quest_desc": [
    "Somewhere in the Guhmension lies a small, soft pink valley full of &dSnuggle Grass&r, Fluffy Trees and Guh Mushrooms: &dSnuggledale&r. The Super Compass (Cozy category) shows the way to the town in the middle.",
  ],
  "quest.475548DDC2435574.title": "The Town",
  "quest.475548DDC2435574.quest_desc": [
    "In the middle of every Snuggledale lies a cozy town: a square with a big guh fountain, guh houses with residents, Grandpa Guh by the campfire and the party buffet. WAHOOG!",
  ],
  "quest.4755481683BBB137.title": "Mayor Chonkworth",
  "quest.4755481683BBB137.quest_desc": [
    "Talk to &dMayor Chonkworth&r on his front steps. The Great Cozyfest is coming... but nothing's ready, nyeg! He gives you a list of six party chores.",
  ],
  "quest.475548898C72D4D5.title": "Party Cake",
  "quest.475548898C72D4D5.quest_desc": [
    "Party chore: Party Cake. Baker Crusty bakes it in the Nibble Bakery, on the north side of the square. Then bring it to the mayor.",
  ],
  "quest.4755483945F1E1B0.title": "Tea Set",
  "quest.4755483945F1E1B0.quest_desc": [
    "Party chore: tea set. Mrs. Teaspoon lends it out after a snug tea party in the Nibble Tea House (east side). Then bring it to the mayor.",
  ],
  "quest.47554828119D9038.title": "Party Hairdos",
  "quest.47554828119D9038.quest_desc": [
    "Party chore: party hairdos. Curly the Barber cuts them during a festive Salon Show in Snip \\& Chonk (south side). Then bring them to the mayor.",
  ],
  "quest.4755484570D22E85.title": "Party Garlands",
  "quest.4755484570D22E85.quest_desc": [
    "Party chore: party garlands. Miss Snuggles' baby guhs craft them in the Snuggle Daycare (west side). Then bring them to the mayor.",
  ],
  "quest.4755482F1147BBDF.title": "Party Flowers",
  "quest.4755482F1147BBDF.quest_desc": [
    "Party chore: party flowers. Grow little guh flowers in your own garden and make a party bouquet out of them. Then bring it to the mayor.",
  ],
  "quest.4755481BA8B2BBC7.title": "Star Lanterns",
  "quest.4755481BA8B2BBC7.quest_desc": [
    "Party chore: Star Lanterns. Professor Twinkle gives them to you when you connect a constellation in the Guh Observatory. Then bring them to the mayor.",
  ],
  "quest.475548F8AEDDE49A.title": "Crumb Thief!",
  "quest.475548F8AEDDE49A.quest_desc": [
    "On the way to the mayor, a &6Crumb Mika&r snatches the Party Cake, the tea set or the garlands! Follow the trail of crumbs and lure it away with a treat (cheese nibbles or pastries). It never fights: it only giggles.",
  ],
  "quest.475548B2FCEF10E7.title": "The Great Cozyfest",
  "quest.475548B2FCEF10E7.quest_desc": [
    "Bring all six party chores to Mayor Chonkworth. Then the Great Cozyfest begins at the party buffet, and all your tame guhs come to munch! You become &dSnuggle Mayor&r and get the Cozy Certificate and the Mayor's Sash.",
  ],
  "quest.475548CF47D545DB.title": "A Party Every Season",
  "quest.475548CF47D545DB.quest_desc": [
    "After the Great Cozyfest, the mayor throws a season party every season with a few new party chores. Celebrate one!",
  ],
  "quest.4755484600BCA7C7.title": "Super Fluffy",
  "quest.4755484600BCA7C7.quest_desc": [
    "&dFluffguhs&r live in Snuggledale: extra fluffy pink guhs with a little quiff. Tame one with cheese nibbles!",
  ],
  "quest.475548F308BD5595.title": "Cozy All Year Round",
  "quest.475548F308BD5595.quest_desc": [
    "Every season there's something different to do in Snuggledale: braiding blossom wreaths (spring), wearing sun hats (summer), jumping in Leaf Piles (fall) and building Snowman Guhs (winter). Fill the Season Scrapbook in your Guhdex!",
  ],
  "quest.475548AB1D9B3CBF.title": "Coco",
  "quest.475548AB1D9B3CBF.quest_desc": [
    "&dCoco&r lives in a little house with long droopy ears. She's lost a few things... Do you know where they are?",
  ],
  "quest.475548A5AA6946E0.title": "Snuggle Friends",
  "quest.475548A5AA6946E0.quest_desc": [
    "Talk to all six residents of the guh houses in the town (right-click with an empty hand). They're in your Guhdex under Cozy!",
  ],
  "quest.475548207D919934.title": "New Faces",
  "quest.475548207D919934.quest_desc": [
    "Add Mayor Chonkworth, Coco, a Crumb Mika and a Fluffguh to your Guhdex.",
  ],
  "quest.47554866969CDE50.title": "Baker Crusty",
  "quest.47554866969CDE50.quest_desc": [
    "On the north side of the square in Snuggledale stands an enormous cheese nibble loaf with a guh face: the &6Nibble Bakery&r! Say hello to &6Baker Crusty&r (he's in your Guhdex too).",
  ],
  "quest.475548D8F146A0F1.title": "Aprons On!",
  "quest.475548D8F146A0F1.quest_desc": [
    "Talk to Baker Crusty and press &6Bake!&r For two whole minutes, you're the baker: customers come in with a little thought cloud above their heads, and that's what they want.",
  ],
  "quest.475548988627F627.title": "Fresh Buns!",
  "quest.475548988627F627.quest_desc": [
    "Click a Nibble Oven, pick dough, shape and topping, slide it into the oven and take it out when the needle is in the orange. Then right-click the customer. WAHOOG!",
  ],
  "quest.475548B5D04A660B.title": "Combo!",
  "quest.475548B5D04A660B.quest_desc": [
    "Make six customers in a row happy without burning anything or keeping anyone waiting.",
  ],
  "quest.4755481667F8F983.title": "Little Baker",
  "quest.4755481667F8F983.quest_desc": [
    "Score 100 points in one baking round.",
  ],
  "quest.4755482BCE7F70D0.title": "Big Baker",
  "quest.4755482BCE7F70D0.quest_desc": [
    "Score 250 points in one baking round. You'll surely be in the High Scores of your Guhdex!",
  ],
  "quest.4755485E4780918F.title": "Perfect!",
  "quest.4755485E4780918F.quest_desc": [
    "Take something out of the oven exactly when the needle is right in the middle of the orange.",
  ],
  "quest.475548112AD27100.title": "Your Own Nibble Oven",
  "quest.475548112AD27100.quest_desc": [
    "Buy a &6Nibble Oven&r from Crusty (or make one) and bake yourself: grain or wheat, milk, eggs, sugar... With goodies from the Guh Farm and your gardens you bake an extra one!",
  ],
  "quest.4755481C954760E9.title": "The Recipe Book",
  "quest.4755481C954760E9.quest_desc": [
    "Bake all twelve recipes good or perfect: they go into the Recipe Book in your Guhdex (Cozy tab).",
  ],
  "quest.475548885AB3E16E.title": "A Baker Through and Through",
  "quest.475548885AB3E16E.quest_desc": [
    "Buy the Little Baker's Hat, the Little Baker's Apron and the Flour Bow in Crusty's shop.",
  ],
  "quest.475548FED7A3F1F2.title": "Bake Coins",
  "quest.475548FED7A3F1F2.quest_desc": [
    "Save up 10 Bake Coins. You can also use them for a go on the Claw Machine!",
  ],
  "quest.475548E04F3E1675.title": "Miss Snuggles",
  "quest.475548E04F3E1675.quest_desc": [
    "On the west side of the Snuggledale square sits a giant baby guh with a pacifier: the &dSnuggle Daycare&r. Walk in between its little feet and talk to &dMiss Snuggles&r.",
  ],
  "quest.4755484A6CB2E577.title": "Hush, Little Baby Guh",
  "quest.4755484A6CB2E577.quest_desc": [
    "Do the care round: give three baby guhs a baby bottle and a clean diaper, tuck them in with a Snuggle Blankie and sing a lullaby (tap along to the beat!).",
  ],
  "quest.4755481A6450864D.title": "Crawl Crawl Crawl!",
  "quest.4755481A6450864D.quest_desc": [
    "Play the game: the baby guhs crawl out of their cradles. Right-click one to pick it up and bring it back to an empty cradle. The faster, the more points!",
  ],
  "quest.4755486BFE16185B.title": "Nobody Escapes!",
  "quest.4755486BFE16185B.quest_desc": [
    "Bring back at least 8 baby guhs in one game without Miss Snuggles having to fetch a single one herself.",
  ],
  "quest.475548A19D0E703B.title": "The Whole Songbook",
  "quest.475548A19D0E703B.quest_desc": [
    "Learn all four of Miss Snuggles' lullabies (every care round she teaches you a new song). They're in your Guhdex, Cozy tab.",
  ],
  "quest.4755485F1F836465.title": "Baby Clothes",
  "quest.4755485F1F836465.quest_desc": [
    "Buy a Baby Romper for your tame guh from Miss Snuggles. So cute, WAHOOG!",
  ],
  "quest.47554836A37935D8.title": "A Cradle for Home",
  "quest.47554836A37935D8.quest_desc": [
    "Make or buy a Guh Cradle. Rock it (right-click) and your baby guhs grow up a little.",
  ],
  "quest.47554867A3EA6702.title": "Miss Snuggles in Your Guhdex",
  "quest.47554867A3EA6702.quest_desc": [
    "Stand right next to Miss Snuggles, and she'll be in your Guhdex.",
  ],
  "quest.475548368A6491E4.title": "Mrs. Teaspoon",
  "quest.475548368A6491E4.quest_desc": [
    "On the east side of the Snuggledale square stands a giant teapot with a guh head for a lid: the &dNibble Tea House&r. Talk to &dMrs. Teaspoon&r.",
  ],
  "quest.47554824EC3A95B9.title": "Making Tea",
  "quest.47554824EC3A95B9.quest_desc": [
    "Put something tasty in a little teapot (right-click): cheese nibbles make Nibble Tea. With Cheese Milk, Tea Herb or little guh flowers you get other kinds of tea.",
  ],
  "quest.475548AA6E466BE1.title": "So Snug!",
  "quest.475548AA6E466BE1.quest_desc": [
    "Bring your tame guhs and hold a tea party. They sit down at the tea table and chat; pour tea and serve something tasty when they want it. A snug table makes everyone &dSnug&r!",
  ],
  "quest.4755483E8F806E71.title": "Homemade!",
  "quest.4755483E8F806E71.quest_desc": [
    "Serve pastries from the Nibble Bakery at a tea party. That makes guhs extra happy!",
  ],
  "quest.475548B48A636925.title": "Tea Taster",
  "quest.475548B48A636925.quest_desc": [
    "Make or drink all four kinds of tea: Nibble Tea, Cheese Milk Tea, Herb Tea and Guh Flower Tea. They're in your Guhdex (Cozy tab).",
  ],
  "quest.4755487982923E94.title": "A Tea Cozy Hat",
  "quest.4755487982923E94.quest_desc": [
    "After your first snug tea party, Mrs. Teaspoon gives you a Tea Cozy Hat. Put it on your guh!",
  ],
  "quest.475548FEE15C9DA2.title": "Mrs. Teaspoon in Your Guhdex",
  "quest.475548FEE15C9DA2.quest_desc": [
    "Stand right next to Mrs. Teaspoon, and she'll be in your Guhdex.",
  ],
  "quest.47554856123C8AE2.title": "Snip \\& Chonk",
  "quest.47554856123C8AE2.quest_desc": [
    "On the square of Snuggledale town there's a hair salon with a huge pink mop of curls for a roof: &dSnip \\& Chonk&r. Talk to &dCurly the Barber&r: he lends you a pair of Barber Scissors.",
  ],
  "quest.475548CA805F00AD.title": "Snip Snip!",
  "quest.475548CA805F00AD.quest_desc": [
    "Give a customer in the Salon Show the right hairstyle. First wash 3x, then cut, dye and blow-dry!",
  ],
  "quest.475548F0938CA51D.title": "The Show Must Go On",
  "quest.475548F0938CA51D.quest_desc": [
    "Finish a whole Salon Show (or stop whenever you like). You get Curl Coins for your points.",
  ],
  "quest.475548E8D02B969F.title": "Wahoog Salon Show",
  "quest.475548E8D02B969F.quest_desc": [
    "Score at least &e120 points&r in a Salon Show. Cutting fast and precisely, and perfect hairstyles in a row, give you a combo! The best barbers are in the &etop 3&r above the show chair.",
  ],
  "quest.4755480563F27C68.title": "My Guh Goes to the Barber",
  "quest.4755480563F27C68.quest_desc": [
    "Buy a hairstyle from Curly the Barber (or win one) and right-click your own tame guh: a new hairstyle that stays! With a hairstyle on, you can dye it too.",
  ],
  "quest.475548DA0EB96DCC.title": "A Splash of Color",
  "quest.475548DA0EB96DCC.quest_desc": [
    "Dye your tame guh's hair with Hair Dye (make it with a glass bottle, a dye and a cheese nibble).",
  ],
  "quest.475548D7606FBCF4.title": "Barber Cape",
  "quest.475548D7606FBCF4.quest_desc": [
    "Buy the Barber Cape from Curly the Barber (for Curl Coins). Buying it is enough; you may put it on, it makes your guh extra chonky chic.",
  ],
  "quest.4755486A1CB92396.title": "Hairstyle Collection",
  "quest.4755486A1CB92396.quest_desc": [
    "Fill the whole Hairstyle Collection in the Guhdex (Cozy): all 8 hairstyles and all 8 hair dyes. They count when you give them to your own guh, or when you cut a customer's hair perfectly.",
  ],
  "quest.4755480430F451F5.title": "Curly Top",
  "quest.4755480430F451F5.quest_desc": [
    "Add Curly the Barber to your Guhdex.",
  ],
  "quest.47554889A4F4EF20.title": "30 Happy Customers",
  "quest.47554889A4F4EF20.quest_desc": [
    "Send &e30 customers&r home happy from Curly the Barber's Salon Shows. Every guh that waddles out of the salon with a wahoog hairdo counts. So chonky, so fresh!",
  ],
  "quest.475548FDF67C2BEC.title": "The Guh Farm",
  "quest.475548FDF67C2BEC.quest_desc": [
    "Somewhere in the Guh Meadows or the Cheese Flats stands a farm with barns shaped like giant animals: the &dGuh Farm&r. The Super Compass (Cozy category) shows the way.",
  ],
  "quest.475548729069E7D5.title": "Farmer Haybale",
  "quest.475548729069E7D5.quest_desc": [
    "Talk to &dFarmer Haybale&r in the cow barn (the giant cow!). She has a little chore for you every day.",
  ],
  "quest.47554850010D29F3.title": "Farm Friends",
  "quest.47554850010D29F3.quest_desc": [
    "Add the Guh Lamb, the Nibble Chick, the Guh Cow and Farmer Haybale to your Guhdex: stand right next to them.",
  ],
  "quest.47554894710C29E0.title": "Happy Critter",
  "quest.47554894710C29E0.quest_desc": [
    "Pet a farm animal (empty hand), brush it (Guh Brush) or feed it (Nibble Feed). Two out of three in one day and it's &dsuper happy&r!",
  ],
  "quest.4755481C88BB29A3.title": "Fluff Wool",
  "quest.4755481C88BB29A3.quest_desc": [
    "A happy Guh Lamb drops a tuft of &fFluff Wool&r.",
  ],
  "quest.4755480552A5C482.title": "Nibble Egg",
  "quest.4755480552A5C482.quest_desc": [
    "A happy Nibble Chick lays a &eNibble Egg&r in the nearest chicken nest. Grab it!",
  ],
  "quest.4755486042B450AE.title": "Cheese Milk",
  "quest.4755486042B450AE.quest_desc": [
    "Make a Guh Cow happy and hold an empty bottle next to it: &eCheese Milk&r! Moo!",
  ],
  "quest.475548E9A9DDDE89.title": "Wool, Egg and Milk",
  "quest.475548E9A9DDDE89.quest_desc": [
    "Get all three farm products from your own happy animals. The baker and the tea house love them!",
  ],
  "quest.4755484FF7B6C1AB.title": "Feeding Itself",
  "quest.4755484FF7B6C1AB.quest_desc": [
    "Make a &dGuh Feeding Trough&r and put Nibble Feed in it. Hungry animals nearby will eat from it all by themselves.",
  ],
  "quest.475548DE803658F6.title": "Farmhand",
  "quest.475548DE803658F6.quest_desc": [
    "Do the chore of the day for Farmer Haybale.",
  ],
  "quest.47554829680B6435.title": "Trusty Farmhand",
  "quest.47554829680B6435.quest_desc": [
    "Do seven chores for Farmer Haybale (one per day). Then you get her Farm Hat in your Guhdex (Cozy)!",
  ],
  "quest.475548F8A444137D.title": "A Garden of Your Own",
  "quest.475548F8A444137D.quest_desc": [
    "Make a &dGuh Flower Pot&r (three terracotta) or a &dGuh Veggie Planter&r, or buy one from Farmer Haybale.",
  ],
  "quest.475548B3C3DE010F.title": "Seeds",
  "quest.475548B3C3DE010F.quest_desc": [
    "You get seeds from Farmer Haybale, in her farm chest, or from your own harvest. You can also make Nibble Seeds from cheese nibbles and wheat seeds.",
  ],
  "quest.4755484C0F4C2DD9.title": "Guh Watering Can",
  "quest.4755484C0F4C2DD9.quest_desc": [
    "With a &bGuh Watering Can&r you water your gardens (3 x 3 at once). Watered plants grow much faster! Empty? Right-click on water.",
  ],
  "quest.475548DABFFAC001.title": "Home-Grown",
  "quest.475548DABFFAC001.quest_desc": [
    "Right-click a ripe plant to harvest it. The plant stays put and grows back!",
  ],
  "quest.475548A9457AA6B9.title": "Nibble Grain",
  "quest.475548A9457AA6B9.quest_desc": [
    "Harvest Nibble Grain: for the baker's dough (and for Nibble Feed).",
  ],
  "quest.475548A0C3DEF150.title": "Tea Herb",
  "quest.475548A0C3DEF150.quest_desc": [
    "Harvest Tea Herb: Mrs. Teaspoon makes tea with it.",
  ],
  "quest.475548FB56CB13A4.title": "Little Guh Flowers",
  "quest.475548FB56CB13A4.quest_desc": [
    "Harvest little guh flowers: pink flowers with a little face.",
  ],
  "quest.4755482723E182D8.title": "Guhs Lend a Paw",
  "quest.4755482723E182D8.quest_desc": [
    "Tame guhs that wander around near your gardens water them all by themselves (just look at the little droplets!). Let your tame guhs water a plant 10 times together: WAHOOG, those watering guhs!",
  ],
  "quest.475548AB06EB5D6E.title": "Singing Garden",
  "quest.475548AB06EB5D6E.quest_desc": [
    "Plants grow from music! Let a guh sing (the Sing emote, or the choir) right next to your gardens, until a plant has grown from it 5 times. After a song, a plant does need a little rest: keep watering too!",
  ],
  "quest.47554850A016AC13.title": "Party Bouquet",
  "quest.47554850A016AC13.quest_desc": [
    "Make a party bouquet out of five little guh flowers. Mayor Chonkworth wants one for the Great Cozyfest!",
  ],
  "quest.4755488FC40D26A9.title": "Green Guh Thumbs",
  "quest.4755488FC40D26A9.quest_desc": [
    "Fill the Garden Book in your Guhdex (Cozy tab): plant and harvest all three guh plants.",
  ],
  "quest.4755482D3D202B99.title": "The Guh Observatory",
  "quest.4755482D3D202B99.quest_desc": [
    "High up on the &dGuh Peaks&r and the &dChonk Cliffs&r stands an observatory with a dome that looks like a guh head, and a giant telescope. The Super Compass (Cozy category) shows the way.",
  ],
  "quest.475548E13360BDA2.title": "Professor Twinkle",
  "quest.475548E13360BDA2.quest_desc": [
    "Talk to &dProfessor Twinkle&r in the observatory. He knows everything about the guh constellations.",
  ],
  "quest.4755483A13413741.title": "Connect the Stars",
  "quest.4755483A13413741.quest_desc": [
    "Look through a &dGuh Telescope&r at night. Somewhere among the stars hides a guh constellation: click a star and then the next one to draw the lines. Found it? Wishing Stars!",
  ],
  "quest.4755489580F4B31F.title": "Half an Atlas",
  "quest.4755489580F4B31F.quest_desc": [
    "Put six guh constellations in your Star Atlas (Guhdex, Cozy tab). You can find at most three per night.",
  ],
  "quest.47554869CD3756BA.title": "Star Shower!",
  "quest.47554869CD3756BA.quest_desc": [
    "During a &bStar Shower&r you can see three rare constellations: The Golden Guh, The Falling Nibble and The Guh Crown. Find one!",
  ],
  "quest.475548C179B96139.title": "The Whole Star Atlas",
  "quest.475548C179B96139.quest_desc": [
    "Find all fifteen guh constellations. WAHOOG, a real stargazer!",
  ],
  "quest.475548B177EB100A.title": "Make a Wish",
  "quest.475548B177EB100A.quest_desc": [
    "Hold a &dWishing Star&r and right-click: your wish comes true! (Usually cheese nibbles, nyeg.)",
  ],
  "quest.475548C77965162A.title": "Stargazer Outfit",
  "quest.475548C77965162A.quest_desc": [
    "Buy the Stargazer Hat and the Star Cape from Professor Twinkle (for Wishing Stars) and put them on your guh.",
  ],
  "quest.4755483B85D3C077.title": "A Starry Face",
  "quest.4755483B85D3C077.quest_desc": [
    "Add Professor Twinkle to your Guhdex (get close enough).",
  ],
  "quest.475548CB46C93723.title": "The Balloon Festival",
  "quest.475548CB46C93723.quest_desc": [
    "On the &dGuh Fields&r and the &dPink Puffs&r there's sometimes a Balloon Festival, full of hot-air balloons shaped like guh heads. The Super Compass (Cozy category) shows the way.",
  ],
  "quest.475548DECA2BDD0E.title": "Captain Cloudy",
  "quest.475548DECA2BDD0E.quest_desc": [
    "Talk to &dCaptain Cloudy&r at his kiosk next to the balloon dock. He'll take you up into the sky right away!",
  ],
  "quest.4755485566106E61.title": "High, Higher, WAHOOG!",
  "quest.4755485566106E61.quest_desc": [
    "Take a balloon flight. You don't have to steer: look around and listen to the Captain. After landing you get stamps and Balloon Coins.",
  ],
  "quest.4755482212D4171E.title": "Full Stamp Card",
  "quest.4755482212D4171E.quest_desc": [
    "There are four routes with two views each. Collect all eight stamps on your Balloon Stamp Card (Guhdex, Cozy tab).",
  ],
  "quest.4755487E696620AF.title": "Ready for the Sky",
  "quest.4755487E696620AF.quest_desc": [
    "Buy the Balloon Cap and the Balloon Goggles from Captain Cloudy (sneak + talk: his little shop) and put them on your guh.",
  ],
  "quest.475548F0DB8935B3.title": "A Little Balloon for Home",
  "quest.475548F0DB8935B3.quest_desc": [
    "A Mini Hot-Air Balloon for your house: buy one from the Captain or make it yourself from wool, paper and string.",
  ],
  "quest.475548A28245DCE9.title": "An Airy Face",
  "quest.475548A28245DCE9.quest_desc": [
    "Add Captain Cloudy to your Guhdex (get close enough).",
  ],
  "quest.475548ED101B7BC0.title": "A Campsite",
  "quest.475548ED101B7BC0.quest_desc": [
    "In &dSnuggledale&r and on the &dGuh Meadows&r there are little campsites: a campfire, little guh tents and Grandpa Guh. The Super Compass (Cozy category) shows the way.",
  ],
  "quest.4755485E109D1548.title": "Grandpa Guh",
  "quest.4755485E109D1548.quest_desc": [
    "Talk to &dGrandpa Guh&r, at a campsite or on his bench in Snuggledale.",
  ],
  "quest.475548C12A1D53AD.title": "Once Upon a Time...",
  "quest.475548C12A1D53AD.quest_desc": [
    "Come to the campfire in the evening or at night and talk to Grandpa Guh: he'll tell a story. Stay close until it's over!",
  ],
  "quest.475548C87FE94849.title": "The Whole Story Collection",
  "quest.475548C87FE94849.quest_desc": [
    "Grandpa Guh knows twelve stories and tells one per night. Collect them all in your Story Collection (Guhdex, Cozy tab).",
  ],
  "quest.475548F58148807B.title": "A Good Night's Sleep",
  "quest.475548F58148807B.quest_desc": [
    "Sleep a whole night in a &dGuh Sleeping Bag&r (no bed needed!). You wake up well-rested.",
  ],
  "quest.475548CA8B863A2D.title": "Pajama Party",
  "quest.475548CA8B863A2D.quest_desc": [
    "At night, guhs wear their pajamas by the campfire. Listen to a story with at least five guhs in pajamas around you!",
  ],
  "quest.4755485EAD3BF459.title": "A Wise Old Face",
  "quest.4755485EAD3BF459.quest_desc": [
    "Add Grandpa Guh to your Guhdex (get close enough).",
  ],
  "quest.47554871C8AB1B48.title": "Sticky and Yummy",
  "quest.47554871C8AB1B48.quest_desc": [
    "In the evening, roast a &dMarshmallow Nibble&r over a burning campfire (right-click the fire with the marshmallow in your hand). Mmm! The guhs nearby come and sit with you, all snug.",
  ],
  "quest.47554833D6A95F54.title": "The Snuggle Pool",
  "quest.47554833D6A95F54.quest_desc": [
    "By the Guh Sea stands a big bathhouse shaped like a guh head, with three big slides: the &bSnuggle Pool&r. The Super Compass (Cozy category) shows the way.",
  ],
  "quest.47554860C01C5A25.title": "Lifeguard Bubbles",
  "quest.47554860C01C5A25.quest_desc": [
    "In the pool hall, inside the guh head, sits &bLifeguard Bubbles&r with his whistle. Tweeet! Talk to him and add him to your Guhdex.",
  ],
  "quest.47554846D025DB7D.title": "Bath Time, Guh!",
  "quest.47554846D025DB7D.quest_desc": [
    "Wash your own tame guh in a &dGuh Washtub&r: Guh Shampoo on, scrub until it foams, shower and blow-dry. Then it shines for a whole day! (Lifeguard Bubbles gives you your first shampoo and hair dryer.)",
  ],
  "quest.47554874F59DCE0A.title": "The Pink Funnel",
  "quest.47554874F59DCE0A.quest_desc": [
    "Slide through the two funnels with a guh face: spin round and round, and then FLOMP into the pink foam.",
  ],
  "quest.475548E09A94503C.title": "The Glow Tunnel",
  "quest.475548E09A94503C.quest_desc": [
    "Slide through the dark tube full of glowing little stars, round and round the Star Guh's tower.",
  ],
  "quest.4755487895FF27EB.title": "The Big Splash",
  "quest.4755487895FF27EB.quest_desc": [
    "Out of the Giant Guh's mouth, down its tongue and then through the air into the pool. SPLASH!",
  ],
  "quest.4755482336C22F5F.title": "Slide Champion",
  "quest.4755482336C22F5F.quest_desc": [
    "Go down all three slides of the Snuggle Pool.",
  ],
  "quest.475548F35C53E0DE.title": "Ducky Catcher",
  "quest.475548F35C53E0DE.quest_desc": [
    "Grab 100 Rubber Duckies in total on the slides (steer with A and D).",
  ],
  "quest.47554817C77FBFC7.title": "All the Rubber Duckies",
  "quest.47554817C77FBFC7.quest_desc": [
    "Twelve special Rubber Duckies float on the slides, from the Fluff Ducky to the Golden Ducky. Find them all (they're in your Guhdex, under Cozy).",
  ],
  "quest.475548D1AD1DF841.title": "Ready for a Dip",
  "quest.475548D1AD1DF841.quest_desc": [
    "Buy the &bSwim Cap&r and the &dBathrobe&r from Lifeguard Bubbles. Buying them is enough; put them on your guh and it waddles to the pool extra cozy and wahoog.",
  ],
  "quest.475548224ED035F6.title": "Top Slider",
  "quest.475548224ED035F6.quest_desc": [
    "Score 250 points on one slide (duckies in a combo count extra!).",
  ],
  "quest.47554808B8C4A510.title": "Good Morning, Guh!",
  "quest.47554808B8C4A510.quest_desc": [
    "In the guh villages and Snuggledale, the guhs live a real guh day. In the morning: a great big yawn and a stretchy-stretch. Have a look early in the morning!",
  ],
  "quest.475548340D0608A0.title": "Hi Hi!",
  "quest.475548340D0608A0.quest_desc": [
    "During the day, guhs wave at you when you walk by, your own tame guhs too (when they're roaming free).",
  ],
  "quest.4755488AD0667641.title": "Nap Time",
  "quest.4755488AD0667641.quest_desc": [
    "In the afternoon the guhs take a nap: in a Guh Nest, or curled up on the spot in a little nest. Zzz... don't wake them up, nyeg!",
  ],
  "quest.475548FC124503FB.title": "Marshmallows by the Campfire",
  "quest.475548FC124503FB.quest_desc": [
    "In the evening the guhs sit around the campfire. Give one a &dMarshmallow Nibble&r (stick + sugar + cheese nibble): it roasts it and munches it right up!",
  ],
  "quest.475548E1A74339EB.title": "Ding-a-ling!",
  "quest.475548E1A74339EB.quest_desc": [
    "Hear a little bell? That's &dJingles the Ice Cream Guh&r on his ice cream bike! He swings by every now and then in the Guhmension (on the Snuggledale square too) and the guhs run after him.",
  ],
  "quest.475548C9172A609F.title": "A Cheese Ice Cream!",
  "quest.475548C9172A609F.quest_desc": [
    "Buy a Cheese Ice Cream from Jingles the Ice Cream Guh and eat it, or give it to a guh: it gets an ice cream hat, blushies or starts floating!",
  ],
  "quest.47554847A93A1225.title": "Every Flavor",
  "quest.47554847A93A1225.quest_desc": [
    "Taste all seven Cheese Ice Creams. Four of them are only around in their own season: blossom (spring), sunshine (summer), apple pie (fall) and snow (winter).",
  ],
  "quest.475548C44514F8C4.title": "Ice Cream Guh in the Guhdex",
  "quest.475548C44514F8C4.quest_desc": [
    "Stand close to Jingles the Ice Cream Guh: then he goes into your Guhdex.",
  ],
  "quest.47554885A8944EE2.title": "Guh Xylophone",
  "quest.47554885A8944EE2.quest_desc": [
    "Make a &dGuh Xylophone&r: eight colored bars, from do to do.",
  ],
  "quest.475548214E50D9FB.title": "The Choir",
  "quest.475548214E50D9FB.quest_desc": [
    "Play a song from the Songbook on the Guh Xylophone while there are guhs nearby: they all sing along! (Gardens nearby grow from it too.)",
  ],
  "quest.4755481204710A02.title": "Whistle Along",
  "quest.4755481204710A02.quest_desc": [
    "With the &dGuh Whistle&r you whistle your last song wherever you like, and the guhs sing along.",
  ],
  "quest.4755486B9377AEAF.title": "The Whole Songbook",
  "quest.4755486B9377AEAF.quest_desc": [
    "Play all six songs: then you get the Choir Bow! WAHOOG!",
  ],
  "quest.475548CA0F661806.title": "Grab Away!",
  "quest.475548CA0F661806.quest_desc": [
    "At the Guh Fair and under the arcade of Snuggledale stands a &dClaw Machine&r. One ticket (a Fair Ticket or a coin from a minigame), and you steer the claw yourself! Every plushie also gives you a Fair Ticket back.",
  ],
  "quest.4755482FC2C219DF.title": "Cuddle Time",
  "quest.4755482FC2C219DF.quest_desc": [
    "Put down a Guh Plushie: your tame guhs (the ones roaming free) come over now and then to give it a big cuddle.",
  ],
  "quest.475548C1258D153A.title": "The Full Plushie Shelf",
  "quest.475548C1258D153A.quest_desc": [
    "Collect all 22 Guh Plushies, the rare Glitter Guh Plushie too. Your Plushie Shelf is in your Guhdex (Cozy tab).",
  ],
  "quest.47554819DD379957.title": "Career Street",
  "quest.47554819DD379957.quest_desc": [
    "On the east side of &dSnuggledale town&r runs &6Career Street&r: the Fire Station (with a roof like a fire helmet), the little Police Station (with a roof like a police cap) and the little Pharmacy (with a green cross). Say hello to Fire Chief Splashguh!",
  ],
  "quest.475548BAE36C1391.title": "Nee-naw Nee-naw!",
  "quest.475548BAE36C1391.quest_desc": [
    "Help &6Fire Chief Splashguh&r: hose out all the way-too-chonky marshmallow fires on the training ground with the guh fire hose (hold right-click), and then get Climby down from the tall tree (using the ladder). You get the Firefighter Helmet and the Firefighter Jacket.",
  ],
  "quest.47554843C464BD5E.title": "Inspector Wahoogsby",
  "quest.47554843C464BD5E.quest_desc": [
    "The little Police Station stands in the middle of Career Street, with a blue lamp by the door. Say hello to &6Inspector Wahoogsby&r.",
  ],
  "quest.4755480CF5FF89B6.title": "The Case of the Nibble Thief",
  "quest.4755480CF5FF89B6.quest_desc": [
    "The town's nibble vault is empty! Follow the pink paw prints from the vault, find the bag of cheese nibbles (the Nibble Thief runs off giggling) and tell Wahoogsby. You get the Police Cap and the Police Uniform.",
  ],
  "quest.4755485968BFB205.title": "Doctor Sniffleguh",
  "quest.4755485968BFB205.quest_desc": [
    "In the little Pharmacy with the green cross, &6Doctor Sniffleguh&r stands behind the counter. Achoo!",
  ],
  "quest.475548CED033B7F9.title": "Achoo... WAHOOG!",
  "quest.475548CED033B7F9.quest_desc": [
    "Pick 3 sniffle herbs in the herb garden, mix them with Cheese Milk in the mixing cauldron and give the Cheese Milk Potion to Sniffles. You get the Doctor's Coat and the Stethoscope.",
  ],
  "quest.4755483EE68DA6CB.title": "Bob the Guhbuilder",
  "quest.4755483EE68DA6CB.quest_desc": [
    "In some &dguh villages&r (Super Compass: Homes) stands a half-built house with a little crane next to it. That's where &6Bob the Guhbuilder&r works. Can we fix it?",
  ],
  "quest.475548FF4FC62A79.title": "Topping Out!",
  "quest.475548FF4FC62A79.quest_desc": [
    "Bring Bob 16 planks and 8 cheese nibbles (his lunch), then climb onto the roof and lay the roof tiles on all the see-through roof spots. You get the Hard Hat and the Safety Vest.",
  ],
  "quest.4755488EC9C4D13F.title": "Guh of All Trades",
  "quest.4755488EC9C4D13F.quest_desc": [
    "Learn all four careers. Which hat will you wear today?",
  ],
}
