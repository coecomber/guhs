{
  "chapter.4755484752399400.title": "&eSpongeguh",
  "chapter.4755484752399400.chapter_subtitle": [
    "3.3. Deep below the void: Bikini Bottom and Shell City",
  ],
  "quest.475548A98B4F231A.title": "How Do You Get Here?",
  "quest.475548A98B4F231A.quest_desc": [
    "This chapter belongs to &5Tales of the Guh End&r and comes after &dThrough the Nibble Gate&r: deep below the outer islands, on the bottom of the void, lies &eBikini Bottom&r.",
    "",
    "Here is everything about &eSpongeguh Cheesepants&r and his friends, and the places in and around Bikini Bottom. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work!",
  ],
  "quest.475548B9CAAAD17A.title": "The Bubble Letter",
  "quest.475548B9CAAAD17A.quest_desc": [
    "Whoever has finished the Guhvatar story gets mail in the Guh End: a &bsoap bubble&r with a letter inside floats up to you. Click it!",
  ],
  "quest.475548591008C816.title": "To Bikini Bottom",
  "quest.475548591008C816.quest_desc": [
    "Blow for &dAppa&r and fly to &bBikini Bottom&r. Land on the little island on top of the big soap bubble.",
  ],
  "quest.475548416FE9C723.title": "The Bubble Stream",
  "quest.475548416FE9C723.quest_desc": [
    "Step into the &bbubble stream&r: it sets you down gently on the square of Bikini Bottom, where someone very square is waiting for you.",
  ],
  "quest.475548A64F91417D.title": "A Job",
  "quest.475548A64F91417D.quest_desc": [
    "Apply with &6Mr. Krabguh&r at &6The Krusty Nibble&r. Don't bring money: he keeps it.",
  ],
  "quest.47554893B0F6518C.title": "Baking Nibble Patties",
  "quest.47554893B0F6518C.quest_desc": [
    "Spongeguh teaches you the trade. Bake &6five Nibble Patties&r in the order on the ticket. Nobody hurries you.",
  ],
  "quest.475548AEB55150D9.title": "Jellyfishing",
  "quest.475548AEB55150D9.quest_desc": [
    "Patguh knows everything about jellies. Almost everything. Help him catch eight &dcrumb jellies&r for the jelly jam of The Krusty Nibble.",
  ],
  "quest.475548B519B8E134.title": "The boating exam",
  "quest.475548B519B8E134.quest_desc": [
    "Spongeguh is taking his boating exam. For the thirty-eighth time. You are his &ddriving buddy&r: steer Mrs. Puffguh's practice boat around the pylon course.",
  ],
  "quest.475548B2F33AB9DC.title": "Plan Z",
  "quest.475548B2F33AB9DC.quest_desc": [
    "The alarm bell of &6The Krusty Nibble&r is ringing! Run to the office of &dMr. Krabguh&r, at the back of the restaurant. Something is up with his safe...",
  ],
  "quest.47554834560B5CC9.title": "Breaking into The Grease Bucket",
  "quest.47554834560B5CC9.quest_desc": [
    "&dPlankmika&r has the secret recipe! Sneak through his lab in &6The Grease Bucket&r, past &dKaren&r's cameras and lasers. Being seen only puts you back at the last rest point.",
  ],
  "quest.4755480098D1FEC8.title": "The recipe back",
  "quest.4755480098D1FEC8.quest_desc": [
    "Bring the secret recipe back to &dMr. Krabguh&r. We won't give away the secret ingredient. (It is a cheese nibble.)",
  ],
  "quest.47554867FA4451C9.title": "Sweet Nibble Victory",
  "quest.47554867FA4451C9.quest_desc": [
    "Party in the &6Bubble Bowl&r! &dSquidmika&r has to perform against Squilliam and has no band. You grab the drum, the whole town sings along.",
  ],
  "quest.47554869C384F7D1.title": "The new manager",
  "quest.47554869C384F7D1.quest_desc": [
    "Mr. Krabguh is opening a second restaurant and needs a manager. Spongeguh is sure of it: that'll be him. Right?",
  ],
  "quest.4755480760ED0A5D.title": "An ice cream at the Guhfy Guhber",
  "quest.4755480760ED0A5D.quest_desc": [
    "Patguh knows what helps against sadness: the biggest sundae in the whole bubble. Although something is missing...",
  ],
  "quest.475548156E8CE6EE.title": "The crown is gone!",
  "quest.475548156E8CE6EE.quest_desc": [
    "King Neptuguh is furious: his crown has been stolen, and Mr. Krabguh gets the blame. Brrr.",
  ],
  "quest.475548F726BC6227.title": "The Patty Wagon",
  "quest.475548F726BC6227.quest_desc": [
    "Drive out of the town gate with Spongeguh and Patguh, along the road to The Thug Tug. You're behind the wheel!",
  ],
  "quest.475548DF620FD5F0.title": "The Thug Tug",
  "quest.475548DF620FD5F0.quest_desc": [
    "A tough Mika has your little key. Sneak up to it, and freeze as soon as the Mikas look up. Who was the baby?",
  ],
  "quest.4755487F7B812C94.title": "Men with a Moustache",
  "quest.4755487F7B812C94.quest_desc": [
    "The Patty Wagon can't cross the Trench. Walk with Spongeguh and Patguh to the west rim: Princess Mindy Guh is waiting there with something hairy.",
  ],
  "quest.475548683662C1B1.title": "The Monsters of the Trench",
  "quest.475548683662C1B1.quest_desc": [
    "Down, across the dark bottom and up again. Are the monsters roaring? Or... singing?",
  ],
  "quest.475548BF5B675EDC.title": "Dennis and the Moustache",
  "quest.475548BF5B675EDC.quest_desc": [
    "Dennis Mika is looking for a square and a star. Luckily you are two respectable gentlemen with a moustache. Right?",
  ],
  "quest.47554804282E51F2.title": "The Cyclops",
  "quest.47554804282E51F2.quest_desc": [
    "King Neptuguh's crown is in the souvenir shop of Shell City. And the drying lamp is already on...",
  ],
  "quest.4755485F1E8DE6D9.title": "A Lift Home",
  "quest.4755485F1E8DE6D9.quest_desc": [
    "The crown is back, but the bubble sun is about to set! Princess Mindy Guh calls a very big friend on Shell City's pier.",
  ],
  "quest.47554811D49FC409.title": "Plankmika's Bucket Helmets",
  "quest.47554811D49FC409.quest_desc": [
    "All of Bikini Bottom is walking around with a bucket on its head. Blow them off with your bubble blaster and walk your parade to the Bubble Bowl.",
  ],
  "quest.475548CBC1ACC4D9.title": "I'm a Guhfy Guhber",
  "quest.475548CBC1ACC4D9.quest_desc": [
    "Climb onto the stage of the Bubble Bowl and rock so hard that every bucket flies off. King Neptuguh gets his crown, Mr. Krabguh thaws, and Spongeguh... becomes manager!",
  ],
  "quest.4755489DD367E445.title": "Visiting Sandy Guh",
  "quest.4755489DD367E445.quest_desc": [
    "Go to the glass tree dome in the east of town (south of the rest home), step in through the airlock on its west side and walk up to Sandy Guh.",
  ],
  "quest.47554889D996207A.title": "Karate on the Mat",
  "quest.47554889D996207A.quest_desc": [
    "Step onto the karate mat in the dome. Sandy Guh shoves: when she shouts HAI, step aside or jump. Dodge her ten times. If she gets you, that one simply doesn't count.",
  ],
  "quest.4755483E3A63CE60.title": "Three Rocket Parts",
  "quest.4755483E3A63CE60.quest_desc": [
    "With the last KABOOM three parts of Sandy's rocket flew into town: the nose cone (by the Jelly Field in the northeast), the exhaust pipe (behind the little houses on the West Ring) and the antenna (between the houses of Conch Street). Walk over them to pick them up.",
  ],
  "quest.47554893212F0CC8.title": "The Rocket",
  "quest.47554893212F0CC8.quest_desc": [
    "Bring the three parts to Sandy's broken rocket, in the tree dome next to the tree.",
  ],
  "quest.47554849CCF3BD71.title": "Waiting for the Ghost Ship",
  "quest.47554849CCF3BD71.quest_desc": [
    "Go to the mooring of The Flying Guhchman: the ring of stones with the little sign, east of Patguh's rock on Conch Street. Stay on the stones until the ship comes: ten counts, shown above your hotbar.",
  ],
  "quest.475548AF8F540F3F.title": "All Aboard",
  "quest.475548AF8F540F3F.quest_desc": [
    "Step into the bubble stream at the mooring: it takes you up to the deck. Walk over to the ghost captain there.",
  ],
  "quest.475548E202833828.title": "Three Ghost Lanterns",
  "quest.475548E202833828.quest_desc": [
    "The captain's three lanterns blew away: one among the Crumb Jellies in the field east of the mooring, one behind The Grease Bucket (north of the mooring) and one by Spongeguh's Nibble Chorus Fruit house, in the west. Walk over them.",
  ],
  "quest.4755485229766082.title": "Back Aboard",
  "quest.4755485229766082.quest_desc": [
    "Go back to the mooring. The ship comes again (five counts): take the bubble stream up and bring the captain his lanterns.",
  ],
  "quest.475548E30AD037B2.title": "The Old Heroes",
  "quest.475548E30AD037B2.quest_desc": [
    "Go to the rest home in the east (north of the tree dome; the door is on the west side) and walk up to Mermaid Guh and Barnacle Guh.",
  ],
  "quest.475548262E102DBF.title": "The Lost Belt",
  "quest.475548262E102DBF.quest_desc": [
    "Mermaid Guh's belt is in the invisible boatmobile, on the car park on the south side of the rest home. Search nothing for something and pick up the belt.",
  ],
  "quest.4755480A7F185FD1.title": "The Belt Back",
  "quest.4755480A7F185FD1.quest_desc": [
    "Bring the belt back to Mermaid Guh, inside the rest home.",
  ],
  "quest.4755482FCA3FD97B.title": "A Heroic Deed",
  "quest.4755482FCA3FD97B.quest_desc": [
    "Drive the invisible boatmobile to the front door of The Krusty Nibble (west of the rest home, on Main Street) and pick up the heroes' lunch.",
  ],
  "quest.475548DCC194C801.title": "Bikini Bottom Under the Void",
  "quest.475548DCC194C801.quest_desc": [
    "Deep between the outer islands of the Guh End lies a dish of cheese rind under a gigantic &dsoap bubble&r: &6Bikini Bottom&r. The Super Compass (the end tab) points the way. Land on the little island above it and step into the &bbubble stream&r: it sets you down neatly on the square. The purple mist is not water, so just keep breathing. Who lives there? You will notice soon enough. Somebody there laughs very loudly, nyeg.",
  ],
  "quest.475548B44B8692E1.title": "The Road to Shell City",
  "quest.475548B44B8692E1.quest_desc": [
    "A road runs from the gate of &dBikini Bottom&r into the void. Follow it: past &6The Thug Tug&r (a tugboat full of tough Mikas, and don't you dare blow bubbles in there), straight through &8the Trench&r (deep, dark, full of monsters, have fun) and then down the hill to &bShell City&r on the Void Sea. That is where the Cyclops has his gift shop. Everything in it is dried, nyeg.",
  ],
}
