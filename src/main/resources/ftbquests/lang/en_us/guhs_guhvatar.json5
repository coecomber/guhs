{
  "chapter.475548BDEF1269EC.title": "&5Guheinde: Guhvatar",
  "chapter.475548BDEF1269EC.chapter_subtitle": [
    "3.1. The Legend of Guh: air, water, earth and fire",
  ],
  "quest.4755489ACAE0D18E.title": "How Do You Get Here?",
  "quest.4755489ACAE0D18E.quest_desc": [
    "This chapter belongs to &5Guheinde: general&r and comes after &dOVER-CHONKED!&r: once you've beaten Overlord Mika, a glowing &6cheese ball&r is waiting for you in the Guh End.",
    "",
    "Below is the big story of the &5Guhvatar&r, from top to bottom: air, water, earth, fire and the comet. These quests &creally come one after another&r.",
    "",
    "Everything you can do beside it and after it (the Spirit World, the White Lotus, the side paths, Appa and the whale) is in &5Guheinde: Guhvatar extras&r.",
  ],
  "quest.475548C7558482E0.title": "The Cheese Ball",
  "quest.475548C7558482E0.quest_desc": [
    "Whoever has beaten Overlord Mika sees a &6glowing cheese ball&r wash up at the Nibble Mountain. Tap it open and see who was inside.",
  ],
  "quest.475548A9701734ED.title": "Yip Yip!",
  "quest.475548A9701734ED.quest_desc": [
    "Fly on &dAppa Guh&r to the &bSouthern Air Temple&r. No need to search: he knows the way.",
  ],
  "quest.4755481AEA21FDF5.title": "The Hall of the Guhvatars",
  "quest.4755481AEA21FDF5.quest_desc": [
    "The hall holds the statues of every Guhvatar before you. Two of them have something to tell you.",
  ],
  "quest.47554839AA2D25C8.title": "Airball",
  "quest.47554839AA2D25C8.quest_desc": [
    "Play airball against &dAang Guh&r on the poles. Guhatso is the referee. First to three!",
  ],
  "quest.4755482D09C7C42F.title": "The Air Scooter Track",
  "quest.4755482D09C7C42F.quest_desc": [
    "Step on the line under the start arch and race all the way round the track on an air scooter before the time runs out. Whoooosh!",
  ],
  "quest.475548BD32FFB82C.title": "Gliding",
  "quest.475548BD32FFB82C.quest_desc": [
    "Jump off the south balcony at the top of the Great Tower and glide through the six rings. You may miss one.",
  ],
  "quest.47554888BF921F00.title": "After Momo",
  "quest.47554888BF921F00.quest_desc": [
    "A glowing lemur guh snatches your nibble. Follow him and his trail of little clouds through the temple, up the towers and over the bridges.",
  ],
  "quest.475548BCD2AA528A.title": "Appa's Stable",
  "quest.475548BCD2AA528A.quest_desc": [
    "Take the saddle in Appa's stable, put it on Appa and feed him three apples. A happy Appa is a flying Appa.",
  ],
  "quest.4755480446808BF8.title": "Not Finished Yet",
  "quest.4755480446808BF8.quest_desc": [
    "Behind a closed door someone is tinkering. Who? You'll hear. Or rather: you won't hear yet.",
  ],
  "quest.475548B7ECBA1C3E.title": "Finally, the Guhvatar",
  "quest.475548B7ECBA1C3E.quest_desc": [
    "A Fire Nation ship rams the jetty. Escape on Appa and learn airbending: the first of the four elements!",
  ],
  "quest.47554818784F7192.title": "The Northern Water Tribe",
  "quest.47554818784F7192.quest_desc": [
    "Fly with &dAppa&r to the &6Northern Water Tribe&r: a city of ice and canals behind a giant ice wall. The gate guard guh is strict, but very friendly once you wipe your paws.",
  ],
  "quest.47554882EDE700F2.title": "A Moustache, Please",
  "quest.47554882EDE700F2.quest_desc": [
    "Talk to &dMaster Pakguh&r on the training square. He only teaches guhs with a moustache. Luckily &dKatara Guh&r is there too.",
  ],
  "quest.475548053FBAF427.title": "The Water Whip",
  "quest.475548053FBAF427.quest_desc": [
    "Hit the &6five targets&r on the training square with your power &bWater Whip&r (the power key).",
  ],
  "quest.475548C3DDB96B7A.title": "Waves, Not Splashes",
  "quest.475548C3DDB96B7A.quest_desc": [
    "Make &6three waves&r in the wave pool next to the square with &bWater Wave&r.",
  ],
  "quest.475548352E8F0A9E.title": "The Ice Bridge",
  "quest.475548352E8F0A9E.quest_desc": [
    "Stand at the end of the jetty, look at the islet and freeze a bridge with &bIce Bridge&r. Then walk across.",
  ],
  "quest.475548377CF07D17.title": "Otter Surfing",
  "quest.475548377CF07D17.quest_desc": [
    "Climb the ice wall west of the gate. Step onto the &dotter-penguin guh&r at the Slide Pulpit with an empty paw and slide down.",
  ],
  "quest.4755484FD8C1D113.title": "The Gondola",
  "quest.4755484FD8C1D113.quest_desc": [
    "Tonight is the &6Moon Festival&r. Get into the gondola in the basin below the grand stairs and use &bWater Current&r to take the moon lanterns to the &6three stops&r.",
  ],
  "quest.475548CD0DCFB668.title": "Princess Yue Guh",
  "quest.475548CD0DCFB668.quest_desc": [
    "Pay &dPrincess Yue Guh&r a visit in the palace. &dSokka Guh&r comes along. By coincidence.",
  ],
  "quest.47554876D9117935.title": "Smoke Above the Sea",
  "quest.47554876D9117935.quest_desc": [
    "Chief Arnook Guh sends you to the harbor: see what &cZhao Mika&r is up to with his ship. Watch out for nets.",
  ],
  "quest.47554858C3983DE7.title": "The Blue Spirit",
  "quest.47554858C3983DE7.quest_desc": [
    "Someone in a blue mask untied you. Sneak off the ship. Stay out of the guards' light.",
  ],
  "quest.47554834E0FDC094.title": "The Moon Fish",
  "quest.47554834E0FDC094.quest_desc": [
    "Go to the &6spirit oasis&r behind the palace, through the little door in the ice.",
  ],
  "quest.47554877FCB1E593.title": "Meditation",
  "quest.47554877FCB1E593.quest_desc": [
    "Sit down by the pond (sneak) and meditate with &dAang Guh&r. Beware of wrong dimensions.",
  ],
  "quest.475548C4C3942FDD.title": "Show No Emotion",
  "quest.475548C4C3942FDD.quest_desc": [
    "Find &dKoh the Face Stealer&r in the Spirit World: the path without pink mist leads to him. When he looks at you: don't move, don't jump, don't click anything.",
  ],
  "quest.4755481C5436C7EC.title": "The Sky Pond",
  "quest.4755481C5436C7EC.quest_desc": [
    "Go to the &6Sky Pond&r, where Tui and La should be swimming. Only one of them is.",
  ],
  "quest.475548A06C4A2DF3.title": "Bringing Tui Back",
  "quest.475548A06C4A2DF3.quest_desc": [
    "&6Tui, the moon fish&r, is in a cage aboard &cZhao Mika&r's ship. Sneak aboard and steal him back.",
  ],
  "quest.47554824937D9A6D.title": "The Moon",
  "quest.47554824937D9A6D.quest_desc": [
    "Bring the moon fish back to the pond in the oasis. &dYue Guh&r is waiting there.",
  ],
  "quest.475548284C705674.title": "The Great Wave",
  "quest.475548284C705674.quest_desc": [
    "Climb to the &6Wave Pulpit&r above the gate. The ocean is waiting. Gently, right?",
  ],
  "quest.475548C02FD04BE1.title": "The Blizzard",
  "quest.475548C02FD04BE1.quest_desc": [
    "Follow the little light through the storm. Listen for &dAppa&r. Then chapter 2 is done: &dKatara Guh&r and &dSokka Guh&r travel with you.",
  ],
  "quest.47554889B2CF7719.title": "Ba Sing Guh",
  "quest.47554889B2CF7719.quest_desc": [
    "After the Water Tribe, Appa Guh flies you to the Earth Kingdom. Land on the landing lobe in front of the enormous outer wall of &6Ba Sing Guh&r. The story starts by itself.",
  ],
  "quest.475548705EE469FC.title": "Passport, please",
  "quest.475548705EE469FC.quest_desc": [
    "Nobody gets in without a stamp. Talk to the &dstrict desk guh&r in the gate building and answer his questions. Every answer is fine. Really.",
  ],
  "quest.4755480E121C1882.title": "The Earth Rumble",
  "quest.4755480E121C1882.quest_desc": [
    "There's fighting in the Lower Ring. Nobody gets hurt, just a little pebbled. Go to the arena in the southwest.",
  ],
  "quest.475548551324C288.title": "Seeing with your feet",
  "quest.475548551324C288.quest_desc": [
    "&dToph Guh&r, The Blind Bandit, teaches you earthbending: with your eyes closed. Find the six earth coins in her training course. Crouching is stomping.",
  ],
  "quest.475548C1090ADAB6.title": "The monorail",
  "quest.475548C1090ADAB6.quest_desc": [
    "Take the monorail from the outer wall to the Middle Ring. Every jump is a push with earthbending.",
  ],
  "quest.475548312D6883B4.title": "The Jasmine Dragon",
  "quest.475548312D6883B4.quest_desc": [
    "Somewhere in the Middle Ring it smells of jasmine. Find &dUncle Miroh&r's tea house. The waiter is... grumpy.",
  ],
  "quest.4755486207C044D9.title": "Patience in a cup",
  "quest.4755486207C044D9.quest_desc": [
    "Make tea at the big kettle: water, leaves, pouring. Each time click right on time.",
  ],
  "quest.475548BA2CF7E327.title": "A game of Pai Sho",
  "quest.475548BA2CF7E327.quest_desc": [
    "Take turns laying a tile. Whoever lays a lotus first wins. Win or not: Uncle Miroh has something to say.",
  ],
  "quest.47554869E62D4E81.title": "No nibble shortage",
  "quest.47554869E62D4E81.quest_desc": [
    "&dJoo Dee Guh&r shows you the city. She smiles a lot.",
  ],
  "quest.475548A1AFBC1C26.title": "Appa's Lost Days",
  "quest.475548A1AFBC1C26.quest_desc": [
    "Go back to the camp. Something isn't right.",
  ],
  "quest.475548E5D95592E9.title": "The Earth King",
  "quest.475548E5D95592E9.quest_desc": [
    "Maybe the &dEarth King Guh&r knows something. Or his bear Bosco.",
  ],
  "quest.47554821B209F985.title": "Lake Laogai",
  "quest.47554821B209F985.quest_desc": [
    "Sneak into the base under the lake. Getting seen = back to the hall, nothing else. Crouching helps.",
  ],
  "quest.475548725E4BDD62.title": "A Song for Lu Ten",
  "quest.475548725E4BDD62.quest_desc": [
    "Uncle Miroh is in danger. Warn him: he went to the hill with the cherry tree.",
  ],
  "quest.475548CF40A57A51.title": "The Fall of Ba Sing Guh",
  "quest.475548CF40A57A51.quest_desc": [
    "The Dai Li took Katara Guh and Zuka to the crystal catacombs under the palace.",
  ],
  "quest.4755489691C7FA24.title": "The Escape",
  "quest.4755489691C7FA24.quest_desc": [
    "Ba Sing Guh falls. On Appa's back you flee... and at the camp someone else jumps on. Then: on to the Fire Nation.",
  ],
  "quest.475548835D6D9A9D.title": "In disguise in the Fire Nation",
  "quest.475548835D6D9A9D.quest_desc": [
    "Appa-guh carries the team to the capital of the Fire Nation. Red clothes on, ears under a headband: nobody may know who you are.",
  ],
  "quest.4755482FC8904FAA.title": "The little school",
  "quest.4755482FC8904FAA.quest_desc": [
    "Take a seat in a Fire Nation classroom. Who is the best Fire Lord? You already know the answer, nyeg.",
  ],
  "quest.475548D68D3B9409.title": "The secret dance party",
  "quest.475548D68D3B9409.quest_desc": [
    "Dancing is forbidden in the Fire Nation. In the cave behind the school they do it anyway. Stand on the square that lights up!",
  ],
  "quest.475548371940A5C5.title": "The turtle-duck guhs",
  "quest.475548371940A5C5.quest_desc": [
    "Feed the turtle-duck guhs in the palace pond. They nibble gently. Out of love.",
  ],
  "quest.475548F643FFE2C0.title": "The Day of Black Sun",
  "quest.475548F643FFE2C0.quest_desc": [
    "Eight minutes without fire. The throne room is empty, and deep under the palace Zuka finally says what he thinks.",
  ],
  "quest.475548C1114AC00C.title": "The cell under the palace",
  "quest.475548C1114AC00C.quest_desc": [
    "Follow Zuka to his uncle. Miroh says nothing. But he does do push-ups.",
  ],
  "quest.4755481DEF87598E.title": "A guest in the camp",
  "quest.4755481DEF87598E.quest_desc": [
    "Zuka stands at the edge of the campfire. Nobody trusts him. Toph-guh least of all.",
  ],
  "quest.475548A4E9C6BA06.title": "Making up",
  "quest.475548A4E9C6BA06.quest_desc": [
    "Help Zuka find the right words, for Toph-guh and for Katara-guh.",
  ],
  "quest.475548FB6DD13D31.title": "The Boiling Rock",
  "quest.475548FB6DD13D31.quest_desc": [
    "With Sokka-guh and Zuka to the prison in the boiling lake. Sneak past the guards and free Suki-guh.",
  ],
  "quest.4755489278ED0186.title": "The Dancing Dragon",
  "quest.4755489278ED0186.quest_desc": [
    "Dance for the dragon guhs of the Sun Warriors, step by step. Then you learn what fire really is.",
  ],
  "quest.475548398C88BE7E.title": "The Boy in the Cheese Ball",
  "quest.475548398C88BE7E.quest_desc": [
    "A play about your adventure. It's wrong from start to finish. Watch it anyway.",
  ],
  "quest.4755481FA42DC90A.title": "The tent of the White Lotus",
  "quest.4755481FA42DC90A.quest_desc": [
    "Zuka and Uncle Miroh. A tent, a pot of tea, and a sentence everybody has been waiting for.",
  ],
  "quest.4755483042E6095D.title": "The Peak of the Predecessors",
  "quest.4755483042E6095D.quest_desc": [
    "Fang flies you through the Spirit World to the Guhvatars before you. They have advice. And a few jokes.",
  ],
  "quest.475548A9BBA4973D.title": "The Lion Turtle Guh",
  "quest.475548A9BBA4973D.quest_desc": [
    "You wake up at night on the back of an island. That island has little ears.",
  ],
  "quest.4755485759E156A0.title": "The airship fleet",
  "quest.4755485759E156A0.quest_desc": [
    "Fly on Appa-guh through Mikai's burning airships. The team takes them down, you steer.",
  ],
  "quest.475548BFADB59513.title": "Agni Kai",
  "quest.475548BFADB59513.quest_desc": [
    "Zuka and Azula-Mika on the palace forecourt. Blue fire against red.",
  ],
  "quest.47554894CE5BF026.title": "The duel",
  "quest.47554894CE5BF026.quest_desc": [
    "Four rounds on the rock pillars, one for each element. And then the rock touches your old scar...",
  ],
  "quest.475548756C242427.title": "The coronation",
  "quest.475548756C242427.quest_desc": [
    "A new Fire Lord. Fireworks. Tea.",
  ],
  "quest.47554851C0E1AD79.title": "The Guhvatar",
  "quest.47554851C0E1AD79.quest_desc": [
    "The story has been told. You get your own statue, with glowing eyes.",
  ],
}
