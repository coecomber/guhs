{
  "chapter.475548F3FBADFB6E.title": "&6The Guhbarbecuether",
  "chapter.475548F3FBADFB6E.chapter_subtitle": [
    "7. Hot, hotter, nyeg! Help the Grill Guh",
  ],
  "quest.475548E99A05234B.title": "How Do You Get Here?",
  "quest.475548E99A05234B.quest_desc": [
    "This chapter comes after &dWelcome to the Guhmension!&r in &dThe Guhmension&r.",
    "",
    "There you'll find broken barbecues: the &6Barbecue Pits&r (Super Compass: Barbecue > Barbecue Pit). The &dGrill Guh&r sits in the big pit: the Mikas swiped his Fire Starter Cubes!",
    "",
    "Fix his barbecue, then light a Grill Coal frame yourself and step into the &6Guhbarbecuether&r. That's where the Skewer Keeps are. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work!",
  ],
  "quest.475548903D2CC46B.title": "Who's Been Barbecuing Here?",
  "quest.475548903D2CC46B.quest_desc": [
    "Somewhere in the Guhmension there are broken barbecues with half a Grill Coal frame: the &6Barbecue Pits&r. The Super Compass (Barbecue > Barbecue Pit) shows the way.",
  ],
  "quest.475548109CF14ED4.title": "NYEG, My Barbecue!",
  "quest.475548109CF14ED4.quest_desc": [
    "The &dGrill Guh&r sits in the big Barbecue Pit. The Mikas swiped his Fire Starter Cubes! Talk to him.",
  ],
  "quest.475548617D7DEE71.title": "Black as Charcoal",
  "quest.475548617D7DEE71.quest_desc": [
    "Let &6Cheese Sauce&r flow over a &8Block of Coal&r: tssss... &8Grill Coal&r! Make a few.",
  ],
  "quest.4755486661FEB05F.title": "Fixing the Frame",
  "quest.4755486661FEB05F.quest_desc": [
    "Put Grill Coal in the gaps of the Grill Guh's frame (the cracked stones have to come out) and tell him.",
  ],
  "quest.475548D75B55D4F7.title": "Swiped Fire Starter Cubes",
  "quest.475548D75B55D4F7.quest_desc": [
    "Go to a &cMika Camp&r. While you're helping the Grill Guh, every Mika you defeat there drops a Fire Starter Cube. Bring one back!",
  ],
  "quest.475548854F353678.title": "WAHOOG, It's Burning Again!",
  "quest.475548854F353678.quest_desc": [
    "Click the Grill Guh's Grill Coal frame with a Fire Starter Cube. His barbecue is burning again, and you get his secret grill recipe!",
  ],
  "quest.4755489650471B98.title": "Chef Guh",
  "quest.4755489650471B98.quest_desc": [
    "Buy the Grill Guh Chef's Hat, the Barbecue Apron and the Chef's Neckerchief from the Grill Guh and put them on your guh.",
  ],
  "quest.47554878051705A4.title": "Grill Guh in the Guhdex",
  "quest.47554878051705A4.quest_desc": [
    "Stand right next to the Grill Guh: then he goes into your Guhdex.",
  ],
  "quest.475548DC058D6F1D.title": "It's Hot in Here, Nyeg!",
  "quest.475548DC058D6F1D.quest_desc": [
    "Light a Grill Coal frame (4x5 up to 23x23) in the Guhmension with a Fire Starter Cube and step into the &6Guhbarbecuether&r. One step there is eight steps in the Guhmension!",
  ],
  "quest.475548252EBF83A7.title": "Charcoal Flats",
  "quest.475548252EBF83A7.quest_desc": [
    "Visit the &6Charcoal Flats&r biome in the Guhbarbecuether.",
  ],
  "quest.475548C0D817235B.title": "Satay Grove",
  "quest.475548C0D817235B.quest_desc": [
    "Visit the &6Satay Grove&r biome in the Guhbarbecuether.",
  ],
  "quest.47554844A84A0EAC.title": "Sausage Woods",
  "quest.47554844A84A0EAC.quest_desc": [
    "Visit the &6Sausage Woods&r biome in the Guhbarbecuether.",
  ],
  "quest.475548D57BAAA244.title": "Ash Vale",
  "quest.475548D57BAAA244.quest_desc": [
    "Visit the &6Ash Vale&r biome in the Guhbarbecuether.",
  ],
  "quest.475548C208FE09FF.title": "Smoke Delta",
  "quest.475548C208FE09FF.quest_desc": [
    "Visit the &6Smoke Delta&r biome in the Guhbarbecuether.",
  ],
  "quest.475548A0B5993233.title": "Fry Chonk in a Bucket",
  "quest.475548A0B5993233.quest_desc": [
    "Scoop a bucket of &6Cheese Frying Sauce&r out of a sauce sea. Hot!",
  ],
  "quest.475548E8E057443F.title": "Nice Warm Light",
  "quest.475548E8E057443F.quest_desc": [
    "Mine &6Glowcoal&r off the ceiling of the Barbecuether (with Silk Touch, or collect 4 glowcoal dust).",
  ],
  "quest.4755482B1A2684B8.title": "Too Hot to Sleep",
  "quest.4755482B1A2684B8.quest_desc": [
    "Try going to bed in the Barbecuether. What does your guh say?",
  ],
  "quest.4755482C2809F860.title": "Barbecue Builder",
  "quest.4755482C2809F860.quest_desc": [
    "Make Charcoal Stone bricks, Grill Iron bars and a Smoke Vent: build your own barbecue!",
  ],
  "quest.4755480991155DDC.title": "A Keep Full of Skewers",
  "quest.4755480991155DDC.quest_desc": [
    "Deep in the Barbecuether stand &6Skewer Keeps&r: keeps of Charcoal Stone with long bridges. The Super Compass (Barbecue > Skewer Keep) knows where one is.",
  ],
  "quest.4755483F45BF1559.title": "Snatched off the Grill",
  "quest.4755483F45BF1559.quest_desc": [
    "Defeat a &6Spark Mika&r (at its spawner in the Skewer Keep) and grab its &6Grill Skewer&r.",
  ],
  "quest.4755482BC240D32B.title": "Skelly Mikas",
  "quest.4755482BC240D32B.quest_desc": [
    "Defeat 5 &8Skelly Mikas&r. They live in the Skewer Keep and in Ash Vale.",
  ],
  "quest.475548270CB71A9A.title": "The Guh Brewing Cauldron",
  "quest.475548270CB71A9A.quest_desc": [
    "Make a &6Guh Brewing Cauldron&r (iron, Grill Iron bars and a Grill Skewer) and fire it up with grill skewer powder.",
  ],
  "quest.475548C0720DC8CC.title": "Guh Alchemist",
  "quest.475548C0720DC8CC.quest_desc": [
    "Cheese Sauce in the pot, stir in an ingredient (nibbles, glowcoal dust, Swamp Cheese or Mika's Grease, guh slime) and fill 'er up: brew a Guh Potion.",
  ],
  "quest.4755485659A76DFD.title": "Every Guh Potion",
  "quest.4755485659A76DFD.quest_desc": [
    "Brew them all: Wahoogness, Smokewalk, Sneaky Nibble and Guh Jump.",
  ],
  "quest.4755480ED23B2480.title": "Getting a Head",
  "quest.4755480ED23B2480.quest_desc": [
    "Skelly Mikas very rarely drop a &8Charred Mika Head&r. Collect three.",
  ],
  "quest.4755480E84F66AAD.title": "Well Done!",
  "quest.4755480E84F66AAD.quest_desc": [
    "Put 4 ash blocks in a T with three Charred Mika Heads on top: &cBurnt Mika&r wakes up! Defeat him for the &6Glowstar&r.",
  ],
  "quest.47554814EA49F152.title": "A Beacon of Nibbles",
  "quest.47554814EA49F152.quest_desc": [
    "Make a &6Nibble Beacon&r (glass, the Glowstar, Grill Coal), put it on a pyramid of nibble or chonk blocks and pick a guh effect. Your guhs get it too!",
  ],
  "quest.47554893F38A1AE3.title": "Wahoog Home",
  "quest.47554893F38A1AE3.quest_desc": [
    "A pitiful &7Smoke Guh&r floats around the Smoke Delta. Feed it cheese nibbles (or toss them at it) until it floats wahoog-ly home.",
  ],
  "quest.475548624E51A122.title": "Smoke Guh Rescuer",
  "quest.475548624E51A122.quest_desc": [
    "Rescue 10 Smoke Guhs. Your Guhdex keeps count of how many you've saved.",
  ],
  "quest.47554804C59A212D.title": "Who's Got Our Nibbles?",
  "quest.47554804C59A212D.quest_desc": [
    "Find the &cMika Grill Palace&r: a palace of Grill Iron above the Cheese Frying Sauce, full of stolen cheese nibbles.",
  ],
  "quest.47554896CDEC0CA4.title": "Chonk for Loot",
  "quest.47554896CDEC0CA4.quest_desc": [
    "Wear something made of Wahoog Chonk, and the Nether Mikas leave you alone. Give one of them a Wahoog Chonk Ingot: it tosses you something back!",
  ],
  "quest.475548FF71E8F8E7.title": "Glowing Cheeks",
  "quest.475548FF71E8F8E7.quest_desc": [
    "The &7Ash Guh&r lives in Ash Vale: gray and sooty, with glowing cheeks. Fire doesn't bother it. Tame one!",
  ],
  "quest.475548A195F9CEA0.title": "The Barbecuether in the Guhdex",
  "quest.475548A195F9CEA0.quest_desc": [
    "Stand right next to a Smoke Guh, a Spark Mika, a Skelly Mika and an Ash Guh.",
  ],
  "quest.475548D9FEBA099D.title": "Ash Guh Hug",
  "quest.475548D9FEBA099D.quest_desc": [
    "Give an Ash Guh a cheese nibble and watch it glow with happiness.",
  ],
  "quest.475548D585541FDC.title": "Quiet as a Nibble",
  "quest.475548D585541FDC.quest_desc": [
    "Drink a Guh Potion. Give Sneaky Nibble a try: then nobody can hear you anymore.",
  ],
  "quest.475548E775826A98.title": "De Sausloper-stal",
  "quest.475548E775826A98.quest_desc": [
    "Ergens langs de frituursauszee staat een stal met een koperen dak en twee roze guh-oren. Daar woont de &6Verzorger-guh&r met zijn &6Sauslopers&r. Je &dSuperkompas&r wijst de weg (tab Barbecue).",
  ],
  "quest.4755482B76DE0A2D.title": "Pindasaus aan een stok",
  "quest.4755482B76DE0A2D.quest_desc": [
    "Praat met de &6Verzorger-guh&r. Hij geeft je &6pindasaus aan een stok&r: daar loopt elke Sausloper vahoeg achteraan.",
  ],
  "quest.475548B992D25437.title": "Kom maar, langpoot!",
  "quest.475548B992D25437.quest_desc": [
    "Houd de stok vast en lok een Sausloper uit de sausbak naar de Verzorger-guh. Zie je hem bibberen op het droge? Koude pootjes, njeg.",
  ],
  "quest.4755482084D701C7.title": "Vriendschap gaat door de maag",
  "quest.4755482084D701C7.quest_desc": [
    "Voer een Sausloper van de stal drie &6pindascheutjes&r. De Verzorger-guh geeft je de eerste drie. Daarna vertrouwt hij je.",
  ],
  "quest.4755482D8D8CD6BC.title": "Het proefrondje",
  "quest.4755482D8D8CD6BC.quest_desc": [
    "Vraag om je proefrit. Er komt een gezadelde Sausloper naar de steiger, speciaal voor jou. Stap op, houd de stok vast en rijd door de vier poortjes. Hij loopt waar jij heen kijkt.",
  ],
  "quest.4755487B0C1FBF6F.title": "Sausloper-vriend",
  "quest.4755487B0C1FBF6F.quest_desc": [
    "Haal je &6zadel&r op bij de Verzorger-guh. Vanaf nu durven de wilde Sauslopers op de sauszee ook naar je toe.",
  ],
  "quest.4755487431B4A064.title": "Lange poten, klein hartje",
  "quest.4755487431B4A064.quest_desc": [
    "Zoek een wilde &6Sausloper&r op de frituursauszee en voer hem pindascheutjes tot hij hartjes geeft. Zadel erop, stok in je hand: nu steek je de sauszee zo over. Sluip en klik om hem te laten wachten.",
  ],
  "quest.47554897AEE84717.title": "Wie stapt daar door de saus?",
  "quest.47554897AEE84717.quest_desc": [
    "Kijk een &6Sausloper&r van dichtbij aan: dan staat hij in je &dGuhdex&r.",
  ],
  "quest.47554827284D9EF9.title": "Sausracer",
  "quest.47554827284D9EF9.quest_desc": [
    "Na de les klokt de Verzorger-guh elk rondje. Haal de finish in &6dertig seconden&r of minder. Tip: rechtsklik met de stok voor een sprintje.",
  ],
  "quest.4755487AF7CC9383.title": "Blub?",
  "quest.4755487AF7CC9383.quest_desc": [
    "In de Guhbarbecuether stuiteren &6Sausblubjes&r rond: blubjes saus met een korstje en een snoet. Kijk er een van dichtbij aan voor je &dGuhdex&r. Ze doen niks, ze blubben alleen.",
  ],
  "quest.475548FE8754A46C.title": "Een knuffel te veel",
  "quest.475548FE8754A46C.quest_desc": [
    "Geef een groot Sausblubje een knuffel (rechtsklik met een lege hand) of een kaasknabbel. Het splitst van blijdschap in twee kleinere blubjes.",
  ],
  "quest.4755486F7A2C9E25.title": "Blubroom",
  "quest.4755486F7A2C9E25.quest_desc": [
    "Elke keer dat een Sausblubje splitst blijft er een klodder &6blubroom&r liggen. Een klein blubje groeit van drie knabbels weer een maatje, dus een hokje blubjes blijft blubben.",
  ],
  "quest.475548C9E8FC5632.title": "Blubje to go",
  "quest.475548C9E8FC5632.quest_desc": [
    "Een &6klein&r Sausblubje past precies in een glazen flesje (rechtsklik). Zo neem je het mee naar huis. De uitvinder-guh weet er vast ook raad mee...",
  ],
  "quest.475548A2793D82AC.title": "Boing!",
  "quest.475548A2793D82AC.quest_desc": [
    "Roer blubroom door een pan kaasbouillon in de &6Guhbrouwketel&r en tap een &6Stuiterdrankje&r. Drie minuten lang val je niet meer: je stuitert. Sluipen is landen.",
  ],
}
