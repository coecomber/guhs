{
  "chapter.475548F3FBADFB6E.title": "&6The Guhbarbecuether",
  "chapter.475548F3FBADFB6E.chapter_subtitle": [
    "6. Hot, hotter, nyeg! Help the Grill Guh",
  ],
  "quest.475548E99A05234B.title": "How Do You Get Here?",
  "quest.475548E99A05234B.quest_desc": [
    "This chapter comes after &dWelcome to the Guhmension!&r in &dThe Guhmension&r.",
    "",
    "There you'll find broken barbecues: the &6Barbecue Pits&r (Super Compass: Barbecue > Barbecue Pit). The &dGrill Guh&r sits in the big pit: the Mikas swiped his Fire Starter Cubes!",
    "",
    "Fix his barbecue, then light a Grill Coal frame yourself and step into the &6Guhbarbecuether&r. That's where the Skewer Keeps are. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work!",
  ],
  "quest.475548903D2CC46B.title": "Who's Been Barbecuing Here?",
  "quest.475548903D2CC46B.quest_desc": [
    "Somewhere in the Guhmension there are broken barbecues with half a Grill Coal frame: the &6Barbecue Pits&r. The Super Compass (Barbecue > Barbecue Pit) shows the way. The big one, the Grill Guh's, sits in new land in the middle of a &6Nibble Shire&r (Barbecue > Nibble Shire).",
  ],
  "quest.475548109CF14ED4.title": "NYEG, My Barbecue!",
  "quest.475548109CF14ED4.quest_desc": [
    "The &dGrill Guh&r sits in the &6big Barbecue Pit&r. In new land that pit lies in the middle of a &6Nibble Shire&r: the Super Compass (Barbecue > Nibble Shire) shows the way. The Mikas swiped his Fire Starter Cubes! Talk to him.",
  ],
  "quest.475548617D7DEE71.title": "Black as Charcoal",
  "quest.475548617D7DEE71.quest_desc": [
    "Let &6Cheese Sauce&r flow over a &8Block of Coal&r: tssss... &8Grill Coal&r! Make a few.",
  ],
  "quest.4755486661FEB05F.title": "Fixing the Frame",
  "quest.4755486661FEB05F.quest_desc": [
    "Put Grill Coal in the gaps of the Grill Guh's frame (the cracked stones have to come out) and tell him.",
  ],
  "quest.475548D75B55D4F7.title": "Swiped Fire Starter Cubes",
  "quest.475548D75B55D4F7.quest_desc": [
    "Go to a &cMika Camp&r. While you're helping the Grill Guh, every Mika you defeat there drops a Fire Starter Cube. Bring one back!",
  ],
  "quest.475548854F353678.title": "WAHOOG, It's Burning Again!",
  "quest.475548854F353678.quest_desc": [
    "Click the Grill Guh's Grill Coal frame with a Fire Starter Cube. His barbecue is burning again, and you get his secret grill recipe!",
  ],
  "quest.4755489650471B98.title": "Chef Guh",
  "quest.4755489650471B98.quest_desc": [
    "Buy the Grill Guh Chef's Hat, the Barbecue Apron and the Chef's Neckerchief from the Grill Guh and put them on your guh.",
  ],
  "quest.47554878051705A4.title": "Grill Guh in the Guhdex",
  "quest.47554878051705A4.quest_desc": [
    "Stand right next to the Grill Guh: then he goes into your Guhdex.",
  ],
  "quest.475548DC058D6F1D.title": "It's Hot in Here, Nyeg!",
  "quest.475548DC058D6F1D.quest_desc": [
    "Light a Grill Coal frame (4x5 up to 23x23) in the Guhmension with a Fire Starter Cube and step into the &6Guhbarbecuether&r. One step there is eight steps in the Guhmension!",
  ],
  "quest.475548252EBF83A7.title": "Charcoal Flats",
  "quest.475548252EBF83A7.quest_desc": [
    "Visit the &6Charcoal Flats&r biome in the Guhbarbecuether.",
  ],
  "quest.475548C0D817235B.title": "Satay Grove",
  "quest.475548C0D817235B.quest_desc": [
    "Visit the &6Satay Grove&r biome in the Guhbarbecuether.",
  ],
  "quest.47554844A84A0EAC.title": "Sausage Woods",
  "quest.47554844A84A0EAC.quest_desc": [
    "Visit the &6Sausage Woods&r biome in the Guhbarbecuether.",
  ],
  "quest.475548D57BAAA244.title": "Ash Vale",
  "quest.475548D57BAAA244.quest_desc": [
    "Visit the &6Ash Vale&r biome in the Guhbarbecuether.",
  ],
  "quest.475548C208FE09FF.title": "Smoke Delta",
  "quest.475548C208FE09FF.quest_desc": [
    "Visit the &6Smoke Delta&r biome in the Guhbarbecuether.",
  ],
  "quest.475548A0B5993233.title": "Fry Chonk in a Bucket",
  "quest.475548A0B5993233.quest_desc": [
    "Scoop a bucket of &6Cheese Frying Sauce&r out of a sauce sea. Hot!",
  ],
  "quest.475548E8E057443F.title": "Nice Warm Light",
  "quest.475548E8E057443F.quest_desc": [
    "Mine &6Glowcoal&r off the ceiling of the Barbecuether (with Silk Touch, or collect 4 glowcoal dust).",
  ],
  "quest.4755482B1A2684B8.title": "Too Hot to Sleep",
  "quest.4755482B1A2684B8.quest_desc": [
    "Try going to bed in the Barbecuether. What does your guh say?",
  ],
  "quest.4755482C2809F860.title": "Barbecue Builder",
  "quest.4755482C2809F860.quest_desc": [
    "Make Charcoal Stone bricks, Grill Iron bars and a Smoke Vent: build your own barbecue!",
  ],
  "quest.4755480991155DDC.title": "A Keep Full of Skewers",
  "quest.4755480991155DDC.quest_desc": [
    "Deep in the Barbecuether stand &6Skewer Keeps&r: keeps of Charcoal Stone with long bridges. The Super Compass (Barbecue > Skewer Keep) knows where one is.",
  ],
  "quest.4755483F45BF1559.title": "Snatched off the Grill",
  "quest.4755483F45BF1559.quest_desc": [
    "Defeat a &6Spark Mika&r (at its spawner in the Skewer Keep) and grab its &6Grill Skewer&r.",
  ],
  "quest.4755482BC240D32B.title": "Skelly Mikas",
  "quest.4755482BC240D32B.quest_desc": [
    "Defeat 5 &8Skelly Mikas&r. They live in the Skewer Keep and in Ash Vale.",
  ],
  "quest.475548270CB71A9A.title": "The Guh Brewing Cauldron",
  "quest.475548270CB71A9A.quest_desc": [
    "Make a &6Guh Brewing Cauldron&r (iron, Grill Iron bars and a Grill Skewer) and fire it up with grill skewer powder.",
  ],
  "quest.475548C0720DC8CC.title": "Guh Alchemist",
  "quest.475548C0720DC8CC.quest_desc": [
    "Cheese Sauce in the pot, stir in an ingredient (nibbles, glowcoal dust, Swamp Cheese or Mika's Grease, guh slime) and fill 'er up: brew a Guh Potion.",
  ],
  "quest.4755485659A76DFD.title": "Every Guh Potion",
  "quest.4755485659A76DFD.quest_desc": [
    "Brew them all: Wahoogness, Smokewalk, Sneaky Nibble and Guh Jump.",
  ],
  "quest.4755480ED23B2480.title": "Getting a Head",
  "quest.4755480ED23B2480.quest_desc": [
    "Skelly Mikas very rarely drop a &8Charred Mika Head&r. Collect three.",
  ],
  "quest.4755480E84F66AAD.title": "Well Done!",
  "quest.4755480E84F66AAD.quest_desc": [
    "Put 4 ash blocks in a T with three Charred Mika Heads on top: &cBurnt Mika&r wakes up! Defeat him for the &6Glowstar&r.",
  ],
  "quest.47554814EA49F152.title": "A Beacon of Nibbles",
  "quest.47554814EA49F152.quest_desc": [
    "Make a &6Nibble Beacon&r (glass, the Glowstar, Grill Coal), put it on a pyramid of &dBlocks of Wahoog Chonk&r (nine chonk ingots per block) and pick a guh effect. Your guhs get it too!",
  ],
  "quest.47554893F38A1AE3.title": "Wahoog Home",
  "quest.47554893F38A1AE3.quest_desc": [
    "A pitiful &7Smoke Guh&r floats around the Smoke Delta. Feed it cheese nibbles (or toss them at it) until it floats wahoog-ly home.",
  ],
  "quest.475548624E51A122.title": "Smoke Guh Rescuer",
  "quest.475548624E51A122.quest_desc": [
    "Rescue 10 Smoke Guhs. Your Guhdex keeps count of how many you've saved.",
  ],
  "quest.47554804C59A212D.title": "Who's Got Our Nibbles?",
  "quest.47554804C59A212D.quest_desc": [
    "Find the &cMika Grill Palace&r: a palace of Grill Iron above the Cheese Frying Sauce, full of stolen cheese nibbles.",
  ],
  "quest.47554896CDEC0CA4.title": "Chonk for Loot",
  "quest.47554896CDEC0CA4.quest_desc": [
    "Wear something made of Wahoog Chonk, and the Nether Mikas leave you alone. Give one of them a Wahoog Chonk Ingot: it tosses you something back!",
  ],
  "quest.475548FF71E8F8E7.title": "Glowing Cheeks",
  "quest.475548FF71E8F8E7.quest_desc": [
    "The &7Ash Guh&r lives in Ash Vale: gray and sooty, with glowing cheeks. Fire doesn't bother it. Tame one!",
  ],
  "quest.475548A195F9CEA0.title": "The Barbecuether in the Guhdex",
  "quest.475548A195F9CEA0.quest_desc": [
    "Stand right next to a Smoke Guh, a Spark Mika, a Skelly Mika and an Ash Guh.",
  ],
  "quest.475548D9FEBA099D.title": "Ash Guh Hug",
  "quest.475548D9FEBA099D.quest_desc": [
    "Give an Ash Guh a cheese nibble and watch it glow with happiness.",
  ],
  "quest.475548D585541FDC.title": "Quiet as a Nibble",
  "quest.475548D585541FDC.quest_desc": [
    "Drink a Guh Potion. Give Sneaky Nibble a try: then nobody can hear you anymore.",
  ],
  "quest.475548E29569B020.title": "At Home with the Mikas",
  "quest.475548E29569B020.quest_desc": [
    "Somewhere in the Guhbarbecuether stand the &6Mika Apartments&r: apartment blocks of grill iron with walkways, clotheslines and a smoking boiler house. The Super Compass (Barbecue > Mika Apartments) points the way. No monsters spawn there.",
  ],
  "quest.4755480E981B93E9.title": "Granny Mika",
  "quest.4755480E981B93E9.quest_desc": [
    "On the &dtop walkway&r of the tall block lives &6Granny Mika&r. She doesn't swipe nibbles: she knits and cooks sausage soup. Take the stairs in the west tower and say hello.",
  ],
  "quest.47554848F6F3F5A6.title": "Soup for the Grumps",
  "quest.47554848F6F3F5A6.quest_desc": [
    "Bring a little bowl of soup to &cGrumble Mika&r (west block, ground floor), &cWhiny Mika&r (east block, two floors up) and &cSnore Mika&r (tall block, two floors up). Right-click them with the soup.",
  ],
  "quest.4755489D05449468.title": "Blown Away!",
  "quest.4755489D05449468.quest_desc": [
    "Granny Mika's knitting has blown off the walkway. It's on the &droof garden&r of the low east block: take the stairs in the east tower. Right-click the knitting basket.",
  ],
  "quest.47554842CE2D8485.title": "Granny's Soup",
  "quest.47554842CE2D8485.quest_desc": [
    "Bring the knitting back to Granny Mika. She knits it into a cap right away, and from now on the Nether Mikas give you a &6discount&r: every third trade you get your ingot back.",
  ],
  "quest.475548754EA6DF87.title": "Knitted Mika Cap",
  "quest.475548754EA6DF87.quest_desc": [
    "A dark red cap with a cream-colored trim and two little knitted horns. Hold it (hold right-click) to unlock it, then put it on your guh in the wardrobe!",
  ],
  "quest.475548D610A39960.title": "Granny Says So!",
  "quest.475548D610A39960.quest_desc": [
    "After Granny Mika's soup, trade three times with a &cNether Mika&r (give him a Wahoog Chonk Ingot): the third time he tosses your ingot back.",
  ],
  "quest.47554848A3BC41B1.title": "Oink!",
  "quest.47554848A3BC41B1.quest_desc": [
    "The &6Mika Stable&r: a red barn with a muddy paddock, where the Mikas keep their &dSausage Piglets&r. The Super Compass (Barbecue > Mika Stable) knows one.",
  ],
  "quest.4755485C5A893339.title": "The Stable Hand Guh",
  "quest.4755485C5A893339.quest_desc": [
    "In front of the big stable door stands the &6Stable Hand Guh&r. A guh, working for the Mikas! Talk to him.",
  ],
  "quest.4755483581F2EC9C.title": "Easy Now, Nyeg",
  "quest.4755483581F2EC9C.quest_desc": [
    "The Sausage Piglets are bouncing with nerves. &dPet&r three of them calm: right-click with an empty hand, three pets per piglet.",
  ],
  "quest.47554840E6F01578.title": "Munch Away!",
  "quest.47554840E6F01578.quest_desc": [
    "Empty the Stable Hand Guh's sack of &6piglet feed&r into the feeding trough, at the back of the stable aisle.",
  ],
  "quest.475548CA389C1BAC.title": "Oinky Is Missing!",
  "quest.475548CA389C1BAC.quest_desc": [
    "Oinky has escaped. Look for him near the paddock (behind the hay bales, by the cart or up in the hayloft), &dsneak&r up to him and pick him up. Bring him to the Stable Hand Guh: you get two Sausage Piglets in a basket!",
  ],
  "quest.475548ACDA684EE8.title": "The Sausage Piglet in the Guhdex",
  "quest.475548ACDA684EE8.quest_desc": [
    "Stand right next to a &dSausage Piglet&r: a little bratwurst on legs with a stripe of mustard down its back. It goes into your Guhdex.",
  ],
  "quest.475548114698B411.title": "Two New Housemates",
  "quest.475548114698B411.quest_desc": [
    "Put the baskets down at home: your Sausage Piglets are farm critters. Petting, brushing (Guh Brush) and feeding (Nibble Feed or a filled feeding trough) makes them happy. With Nibble Feed they have little ones.",
  ],
  "quest.475548ED05E89A3B.title": "Sniff Sniff",
  "quest.475548ED05E89A3B.quest_desc": [
    "A &dhappy&r Sausage Piglet (two kinds of care in one day) sniffs something out for you every day: nibbles, little mushrooms, sometimes even something rare from the Barbecuether.",
  ],
  "quest.475548C2A7837F36.title": "Through the Mika's Mouth",
  "quest.475548C2A7837F36.quest_desc": [
    "The &6Mika Bridge Palace&r is a long toll bridge high above the sauce. You walk in through the open mouth of a gigantic Mika. The Super Compass (Barbecue > Mika Bridge Palace) points the way.",
  ],
  "quest.47554806AFF8F02D.title": "HALT! Toll!",
  "quest.47554806AFF8F02D.quest_desc": [
    "In the mouth sits the &cToll Keeper Mika&r. Talk to him.",
  ],
  "quest.47554857146896BE.title": "Nibbles or Riddles",
  "quest.47554857146896BE.quest_desc": [
    "Pay a toll of &68 cheese nibbles&r, or get &dthree riddles&r right. Guessed wrong? Then you simply get another riddle.",
  ],
  "quest.47554829770D6716.title": "Mika Quality",
  "quest.47554829770D6716.quest_desc": [
    "The bridge is broken (again). Lay the Toll Keeper's five planks in the gap: right-click with a plank, right by the gap. Fell in? Under the gap hangs a scaffold with a ladder.",
  ],
  "quest.4755482D35B8984C.title": "DONG!",
  "quest.4755482D35B8984C.quest_desc": [
    "Walk across the mended bridge to the bell tower and ring the &6toll bell&r. Hurry up: after a minute or so the planks drop out again.",
  ],
  "quest.475548302ECD859C.title": "Toll-Free!",
  "quest.475548302ECD859C.quest_desc": [
    "Go back to the Toll Keeper Mika. From now on you always cross for free, and you get the &6blueprint&r of the bridge with planks and rope railing.",
  ],
  "quest.47554836074C3471.title": "Riddle King",
  "quest.47554836074C3471.quest_desc": [
    "Get three of the Toll Keeper Mika's riddles right (instead of paying the toll). Nyeg nyeg nyeg!",
  ],
  "quest.47554835793D89AE.title": "Your Own Mika Bridge",
  "quest.47554835793D89AE.quest_desc": [
    "With the &6blueprint&r in your crafting table you make &dMika Bridge Planks&r (planks and string) and &dRope Railing&r (sticks and string). The blueprint simply stays put.",
  ],
  "quest.475548E113A26CC7.title": "The Guard Guh",
  "quest.475548E113A26CC7.quest_desc": [
    "In the hall of every &6Skewer Keep&r there is a sentry box next to the statue. In it stands the &6Guard Guh&r: helmet on, skewer in his paw. Say hello (it startles him a little).",
  ],
  "quest.47554844AE89E0DE.title": "Four Bridge Fires",
  "quest.47554844AE89E0DE.quest_desc": [
    "The Spark Mikas have blown out the bridge fires! On every bridge there is a brazier on a pedestal. Right-click all four with the Guard Guh's &6lighting skewer&r. Your fires keep burning for you.",
  ],
  "quest.475548C5396CF11A.title": "Report to the Guard",
  "quest.475548C5396CF11A.quest_desc": [
    "All four fires are burning. Go tell the Guard Guh: he has one more little job.",
  ],
  "quest.4755481E36D9CF22.title": "Weeding Mika Weed",
  "quest.4755481E36D9CF22.quest_desc": [
    "The &dpeanut sauce garden&r (one staircase up, in the middle of the keep) is full of purple, prickly &5Mika Weed&r. Click each clump to pull it out.",
  ],
  "quest.47554839B8470EF2.title": "Honorary Guard",
  "quest.47554839B8470EF2.quest_desc": [
    "Fires lit, garden tidy. Pick up your reward from the Guard Guh: the &blantern recipe&r, two Sad Little Lanterns and the guard outfit for your guh.",
  ],
  "quest.475548259C13240D.title": "Sad Little Lantern",
  "quest.475548259C13240D.quest_desc": [
    "With the &blantern recipe&r in your crafting table (it stays put): 6 iron nuggets, glowcoal dust and light blue dye. The little lantern looks sad, until you pet it (right-click).",
  ],
  "quest.4755489119B72063.title": "The Guard Outfit",
  "quest.4755489119B72063.quest_desc": [
    "An iron helmet with a satay plume and a soot-black cloak with a glowing hem. Hold them (hold right-click) to unlock them for the wardrobe.",
  ],
  "quest.47554864BA1D32C2.title": "The Captured Plushie Maker Guh",
  "quest.47554864BA1D32C2.quest_desc": [
    "One floor up in every &cMika Grill Palace&r, next to the cages of stolen guh plushies, sits the &dPlushie Maker Guh&r in his sewing corner. He has to darn Mika socks. Talk to him (quietly).",
  ],
  "quest.4755482872EF2618.title": "Freeing Three Plushies",
  "quest.4755482872EF2618.quest_desc": [
    "Open the three cages. The ransom is &6one wahoog chonk&r per plushie (right-click the cage with it). Or &7sneak&r (crouch) and pick the lock while no Nether Mika is looking: three clicks. Caught? Then all you get is a shove. A Sneaky Nibble Potion helps!",
  ],
  "quest.47554888DF61782F.title": "String for the Seams",
  "quest.47554888DF61782F.quest_desc": [
    "The Mikas have been tugging at the plushies. Bring the Plushie Maker Guh &f4 string&r: you get three plushies and his &dplushie pattern&r.",
  ],
  "quest.4755486D305224B5.title": "A Bed Full of Plushies",
  "quest.4755486D305224B5.quest_desc": [
    "With the &dplushie pattern&r in your crafting table you sew them yourself: 5 wool (pink, black or light gray) and a string. Collect the Plush Guh, the Plush Mika and the Plush Smoke Guh. Go on, give them a squeeze!",
  ],
  "quest.4755488BA52C1D52.title": "On Tiptoe",
  "quest.4755488BA52C1D52.quest_desc": [
    "Pick a plushie cage open &7without paying&r and without a Nether Mika seeing you.",
  ],
  "quest.475548FE7F1B4205.title": "Bones in the Ash",
  "quest.475548FE7F1B4205.quest_desc": [
    "Somewhere in the Guhbarbecuether the &dArchaeologist Guh&r is digging up the skeleton of a giant guh: the &6Fossil Dig&r. The Super Compass (Barbecue > Fossil Dig) points the way.",
  ],
  "quest.47554801C0717267.title": "The Find of the Century",
  "quest.47554801C0717267.quest_desc": [
    "Talk to the &dArchaeologist Guh&r by his tent. He gives you a &6Guh Dusting Brush&r.",
  ],
  "quest.47554885828EBD37.title": "Get Dusting!",
  "quest.47554885828EBD37.quest_desc": [
    "With the Guh Dusting Brush, hold right-click on the &6bone sand&r in the pit (where a little tip of bone pokes out of the ash). Each spot gives you one bone; you need five bones. Everyone finds their own bones, even if someone has already dusted there.",
  ],
  "quest.47554833DED29961.title": "Bone by Bone",
  "quest.47554833DED29961.quest_desc": [
    "Click the &6rack&r under the little roof with the bones. Only you see your skeleton grow.",
  ],
  "quest.4755486A24815FA9.title": "Tyrannoguhrus Nyex",
  "quest.4755486A24815FA9.quest_desc": [
    "Tell the Archaeologist Guh that it's standing! You get a &6Tyrannoguhrus Statuette&r and you may keep the brush.",
  ],
  "quest.475548D733D0BB61.title": "A Little Bone Every Day",
  "quest.475548D733D0BB61.quest_desc": [
    "After the skeleton, every spot of bone sand holds something new for you each day: a little bone, some nibbles, sometimes a salt crystal. Dust one loose!",
  ],
  "quest.475548F85974C742.title": "Nyex on the Shelf",
  "quest.475548F85974C742.quest_desc": [
    "Put your Tyrannoguhrus Statuette down somewhere everyone can see it.",
  ],
  "quest.4755486B3D981C48.title": "A Mountain of Salt",
  "quest.4755486B3D981C48.quest_desc": [
    "A white mountain full of crystals at the bottom of a cave: the &6Salt Crystal Mine&r. The Super Compass (Barbecue > Salt Crystal Mine) points the way.",
  ],
  "quest.475548BC4D60E9A3.title": "What a Load of Rubble",
  "quest.475548BC4D60E9A3.quest_desc": [
    "Talk to the &dMineworker Guh&r by his little shed in front of the mine.",
  ],
  "quest.4755484C252239FB.title": "Clear the Track",
  "quest.4755484C252239FB.quest_desc": [
    "Chip five chunks of &6rubble&r off the cart track in the tunnels. (The rubble drops back after a minute or so for the next player: your five simply count.)",
  ],
  "quest.475548C65C9CFFDD.title": "The Crystal Vein",
  "quest.475548C65C9CFFDD.quest_desc": [
    "Follow the track all the way into the cave and chip at the pink &6crystal vein&r with a pickaxe.",
  ],
  "quest.475548E47950336A.title": "Salt on Your Sandwich",
  "quest.475548E47950336A.quest_desc": [
    "Bring three salt crystals to the Mineworker Guh. You get his &6Salt Crystal Pickaxe&r: with it the vein gives twice as much.",
  ],
  "quest.4755485ABE20F56A.title": "A Sack of Salt",
  "quest.4755485ABE20F56A.quest_desc": [
    "The crystal vein belongs a little bit to everyone: every player has their own supply in it, which grows back all by itself. Collect 16 &6salt crystals&r: Guh Technology with salt starts with those.",
  ],
  "quest.475548A25A7F35A4.title": "Salty Building Blocks",
  "quest.475548A25A7F35A4.quest_desc": [
    "Four salt crystals make a &6Salt Crystal Block&r: it gives off a soft light. Make a few.",
  ],
  "quest.475548E775826A98.title": "The Sauce Strider Stable",
  "quest.475548E775826A98.quest_desc": [
    "Somewhere along the frying sauce sea stands a stable with a copper roof and two pink guh ears. That's where the &6Caretaker Guh&r lives with his &6Sauce Striders&r. Your &dSuper Compass&r points the way (Barbecue tab).",
  ],
  "quest.4755482B76DE0A2D.title": "Peanut Sauce on a Stick",
  "quest.4755482B76DE0A2D.quest_desc": [
    "Talk to the &6Caretaker Guh&r. He gives you &6Peanut Sauce on a Stick&r: every Sauce Strider goes wahoog chasing after that.",
  ],
  "quest.475548B992D25437.title": "Come On, Longlegs!",
  "quest.475548B992D25437.quest_desc": [
    "Hold the stick and lure a Sauce Strider out of the sauce basin to the Caretaker Guh. See him shiver on dry land? Cold little feet, nyeg.",
  ],
  "quest.4755482084D701C7.title": "Friendship Goes Through the Tummy",
  "quest.4755482084D701C7.quest_desc": [
    "Feed one of the stable's Sauce Striders three &6peanut sprouts&r. The Caretaker Guh gives you the first three. After that it trusts you.",
  ],
  "quest.4755482D8D8CD6BC.title": "The Test Lap",
  "quest.4755482D8D8CD6BC.quest_desc": [
    "Ask for your test ride. A saddled Sauce Strider comes to the dock, just for you. Hop on, hold the stick and ride through the four little gates. He walks wherever you look.",
  ],
  "quest.4755487B0C1FBF6F.title": "Sauce Strider Friend",
  "quest.4755487B0C1FBF6F.quest_desc": [
    "Pick up your &6saddle&r from the Caretaker Guh. From now on the wild Sauce Striders on the sauce sea dare to come up to you too.",
  ],
  "quest.4755487431B4A064.title": "Long Legs, Little Heart",
  "quest.4755487431B4A064.quest_desc": [
    "Find a wild &6Sauce Strider&r on the frying sauce sea and feed him peanut sprouts until he gives hearts. Saddle on, stick in your hand: now you cross the sauce sea just like that. Sneak and click to make him wait.",
  ],
  "quest.47554897AEE84717.title": "Who's Striding Through the Sauce?",
  "quest.47554897AEE84717.quest_desc": [
    "Look at a &6Sauce Strider&r from up close: then he's in your &dGuhdex&r.",
  ],
  "quest.47554827284D9EF9.title": "Sauce Racer",
  "quest.47554827284D9EF9.quest_desc": [
    "After the lesson the Caretaker Guh times every lap. Reach the finish in &6thirty seconds&r or less. Tip: right-click with the stick for a little sprint.",
  ],
  "quest.4755487AF7CC9383.title": "Blub?",
  "quest.4755487AF7CC9383.quest_desc": [
    "&6Sauce Blubbies&r bounce around the Guhbarbecuether: blobs of sauce with a little crust and a snoot. Look at one from up close for your &dGuhdex&r. They don't do a thing, they just blub.",
  ],
  "quest.475548FE8754A46C.title": "One Cuddle Too Many",
  "quest.475548FE8754A46C.quest_desc": [
    "Give a big Sauce Blubby a cuddle (right-click with an empty hand) or a cheese nibble. It's so happy it splits into two smaller blubbies.",
  ],
  "quest.4755486F7A2C9E25.title": "Blub Cream",
  "quest.4755486F7A2C9E25.quest_desc": [
    "Every time a Sauce Blubby splits, it leaves a dollop of &6blub cream&r behind. Three nibbles make a small blubby grow a size again, so a pen of blubbies keeps on blubbing. Can't find a blubby? The &6Caretaker Guh&r of the Sauce Strider Stable sends his students home with one in a jar every day.",
  ],
  "quest.475548C9E8FC5632.title": "Blubby to Go",
  "quest.475548C9E8FC5632.quest_desc": [
    "A &6small&r Sauce Blubby fits exactly into a glass bottle (right-click). That's how you take it home. The Inventor Guh surely knows what to do with it too...",
  ],
  "quest.475548A2793D82AC.title": "Boing!",
  "quest.475548A2793D82AC.quest_desc": [
    "Stir blub cream into a pot of cheese broth in the &6Guh Brewing Cauldron&r and tap a &6Bouncy Potion&r. For three minutes you don't fall anymore: you bounce. Sneaking is landing.",
  ],
  "quest.47554884D886C06F.title": "Little Tents in the Ash",
  "quest.47554884D886C06F.quest_desc": [
    "Somewhere in the Guhbarbecuether there's a whole village of little tents around a big campfire: the &6Grill Campground&r. The Super Compass (Barbecue > Grill Campground) points the way.",
  ],
  "quest.475548531B556A4C.title": "Welcome to the Campground",
  "quest.475548531B556A4C.quest_desc": [
    "Talk to the &dCamp Boss Guh&r at the reception (the little house with the pointed roof). He gives you a &6tent bag&r.",
  ],
  "quest.4755487D9A03545D.title": "Flomp, a Tent!",
  "quest.4755487D9A03545D.quest_desc": [
    "Click a green &6VRIJ&r (vacant) sign with the tent bag (on the yellow grass by the gate) and then hammer in the four &6stakes&r of your tent: click the iron pegs. A tent on every spot already? They pop back into the bag by themselves after a few minutes.",
  ],
  "quest.4755483754CC0EEB.title": "Chop! Chop!",
  "quest.4755483754CC0EEB.quest_desc": [
    "Ask the &dLumberjack Guh&r by the woodshed for firewood and click a &6chopping block&r six times. You get a bundle of firewood.",
  ],
  "quest.475548744A9DAC98.title": "The Campfire Party",
  "quest.475548744A9DAC98.quest_desc": [
    "Toss the bundle of firewood onto the &6big campfire&r in the middle of the campground. The camper guhs come sit around it and start dancing!",
  ],
  "quest.47554871269AD3BD.title": "Golden Brown!",
  "quest.47554871269AD3BD.quest_desc": [
    "Pick up the &6Roasting Stick&r from the Camp Boss Guh. Hold right-click on the burning campfire and let go when the marshmallow is &6golden brown&r (too early is cold, too late is black: then you just try again). Three golden brown ones, and go tell him: you get the &dcamping outfit&r and the &6Plantation Box recipe card&r.",
  ],
  "quest.475548830DB65386.title": "Meet the Neighbors",
  "quest.475548830DB65386.quest_desc": [
    "Five camper guhs live at the campground. Click one for a little chat. (They belong to the campground: you can't tame them.)",
  ],
  "quest.475548EBFD90C5FB.title": "Marshmallows Forever",
  "quest.475548EBFD90C5FB.quest_desc": [
    "The Roasting Stick works over &6any&r burning campfire, at home and in the daytime too. Roast one golden brown! (You need marshmallow nibbles: stick + sugar + cheese nibble.)",
  ],
  "quest.47554886E3C2B859.title": "A Tent for Home",
  "quest.47554886E3C2B859.quest_desc": [
    "From &6tent canvas&r (wool + string) you build your own tent: the sloped pieces are the roof. Make eight sloped pieces in a color of your choice.",
  ],
  "quest.47554829C3FC0A32.title": "Stalls in the Dark",
  "quest.47554829C3FC0A32.quest_desc": [
    "Striped stalls around a big tent with a scale: the &6Nether Mika Barter Market&r. The Super Compass (Barbecue > Nether Mika Barter Market) points the way.",
  ],
  "quest.475548FED4908288.title": "The Market Master",
  "quest.475548FED4908288.quest_desc": [
    "Talk to the &dMarket Master Mika&r on his podium in front of the Weigh House.",
  ],
  "quest.4755485F8DEDBBCC.title": "Learn to Haggle",
  "quest.4755485F8DEDBBCC.quest_desc": [
    "Talk to him again and haggle him down from 30 to 10 nibbles. Read carefully what he says: if he &6brags&r, give a compliment; if he &6sighs&r, offer low; if he &6growls&r about his final offer, pretend to walk away. Three mistakes and he sends you off (then you just start over).",
  ],
  "quest.4755489C183EC7F4.title": "The Fake Chonk",
  "quest.4755489C183EC7F4.quest_desc": [
    "In the Weigh House lie five stacks of chonk. One is &6fake&r, and fake chonk is lighter. Click two stacks to weigh them; then click the fake one with the &6Seal of Approval&r. (Which one is fake is different for everyone. Stamped the wrong one? Then the trickster swaps them around.)",
  ],
  "quest.47554892433E2AF3.title": "Busted!",
  "quest.47554892433E2AF3.quest_desc": [
    "Go tell the Market Master Mika. You get the &6scale&r, and from now on a little extra with every trade with a Nether Mika.",
  ],
  "quest.4755486E4AF37D45.title": "Chonk In, Surprise Out",
  "quest.4755486E4AF37D45.quest_desc": [
    "The &dStall Mikas&r of the market trade right away: give one an ingot of &6wahoog chonk&r and you get your surprise. No sniffing around, and they leave you be.",
  ],
  "quest.47554860AF9FEAAE.title": "A Little Extra, Meow",
  "quest.47554860AF9FEAAE.quest_desc": [
    "After the questline, trade with a Nether Mika (at the market or in the wild, by putting the ingot in his paw): you get a second little present on top.",
  ],
  "quest.47554811611D6829.title": "The Deal of the Day",
  "quest.47554811611D6829.quest_desc": [
    "Every day you can haggle with the Market Master Mika again. If you win, you get the deal of the day.",
  ],
  "quest.475548E0CAEC8653.title": "The Smoke Guh Lighthouse",
  "quest.475548E0CAEC8653.quest_desc": [
    "Somewhere in the smoke stands a red-and-white tower with two pink guh ears on its roof. That's where the &6Lighthouse Keeper Guh&r lives. His lamp is out... Your &dSuper Compass&r points the way (Barbecue tab).",
  ],
  "quest.475548459D7EF34A.title": "Ahoy, Nyeg!",
  "quest.475548459D7EF34A.quest_desc": [
    "Talk to the &6Lighthouse Keeper Guh&r. Without a light the Smoke Guhs can't find their way home anymore.",
  ],
  "quest.47554874772C9D68.title": "Embers for the Lamp",
  "quest.47554874772C9D68.quest_desc": [
    "Bring him four &6glowcoal dust&r (break glowcoal to bits). He presses it into a &6Lamp Ember&r, and you may borrow his &6Signal Lantern&r.",
  ],
  "quest.47554865D8FA61CF.title": "Fwoop!",
  "quest.47554865D8FA61CF.quest_desc": [
    "Climb the spiral stairs, all the way up into the glass lamp room, and put the Lamp Ember in the lamp. TOOOOT!",
  ],
  "quest.4755481C0068C4ED.title": "Three Lost Smoke Guhs",
  "quest.4755481C0068C4ED.quest_desc": [
    "Around the tower float three skinny &6Lost Smoke Guhs&r, just for you (with a little star above them). Walk up to them with the Signal Lantern in your paw: they float along behind you until they see the light. Feeding them six cheese nibbles works too.",
  ],
  "quest.475548A4A9C5A600.title": "Lamplighter",
  "quest.475548A4A9C5A600.quest_desc": [
    "Go back to the Lighthouse Keeper Guh. You get a &6Delivery Guhling Whistle&r and a &6lighthouse keeper's coat&r for your guh.",
  ],
  "quest.4755484E71378B5C.title": "Fweet-fwee!",
  "quest.4755484E71378B5C.quest_desc": [
    "The &6Delivery Guhling Whistle&r calls the Delivery Guhling of your own Scooter Station over to you. Sneak and whistle to send them all home. Lost it? The Lighthouse Keeper Guh carves a new one every day.",
  ],
  "quest.47554831BDB3CF5D.title": "Lighthouse Keeper's Coat",
  "quest.47554831BDB3CF5D.quest_desc": [
    "A dark blue coat with golden buttons and a red-and-white collar. Hold it (hold right-click) to unlock it, then put it on your guh in the wardrobe!",
  ],
  "quest.4755483C7EF60BB8.title": "A Lamp for Home",
  "quest.4755483C7EF60BB8.quest_desc": [
    "Make your own &6Lighthouse Lamp&r (grill iron bars, glass and glowcoal). It fwoops on as soon as someone nearby has lit the real lighthouse. That's you.",
  ],
  "quest.475548175E26304F.title": "The Pepper Garden",
  "quest.475548175E26304F.quest_desc": [
    "A glass greenhouse in the middle of the Guhbarbecuether, with a garden full of peppers beside it and a guh scarecrow. That's where the &6Pepper Grower Guh&r lives. Your &dSuper Compass&r points the way (Barbecue tab).",
  ],
  "quest.4755485060A6E631.title": "One Little Plant, Three Peppers",
  "quest.4755485060A6E631.quest_desc": [
    "Talk to the &6Pepper Grower Guh&r. He gives you three &6pepper seeds&r.",
  ],
  "quest.475548FFB1E0BB02.title": "Green, Red and Pink",
  "quest.475548FFB1E0BB02.quest_desc": [
    "In the greenhouse there are three &6grow boxes&r. Plant a seed in each box, wait until your little plant is ripe and pick it. Your plants are yours alone.",
  ],
  "quest.475548AF0726536F.title": "Fire in Your Tummy",
  "quest.475548AF0726536F.quest_desc": [
    "Brew your first &6pepper potion&r in the Guh Brewing Cauldron at the back of the greenhouse: powder, cheese sauce, stir in a red or pink pepper and fill a bottle. The Pepper Grower Guh gives you everything you need.",
  ],
  "quest.475548A2928EF4A3.title": "Pepper Brewer",
  "quest.475548A2928EF4A3.quest_desc": [
    "Let the Pepper Grower Guh have a taste. You get &6seeds&r for home, the &6other potion&r and a &6pepper garland&r for your guh.",
  ],
  "quest.4755489938277C57.title": "Picking Garden",
  "quest.4755489938277C57.quest_desc": [
    "You pick a ripe pepper plant with a &6right-click&r: the plant stays where it is and simply keeps growing. Try it in the display beds of the greenhouse.",
  ],
  "quest.4755487C205DEA29.title": "Your Own Pepper Garden",
  "quest.4755487C205DEA29.quest_desc": [
    "Plant pepper seeds on &6Ash Dirt&r (green Nyeg Pepper), &6Glowcoal&r (red Wahoog Pepper) and &6Peanut Sauce Nylium&r (pink Candy Pepper). Put &bglass&r above them: then they grow three times as fast. You get seeds when you dig up a ripe plant.",
  ],
  "quest.47554841003C845A.title": "Pepperfire Potion",
  "quest.47554841003C845A.quest_desc": [
    "Cheese broth with a &cWahoog Pepper&r. For three minutes you chop and dig like wildfire, with little flames from your snoot (&6Pepper Breath&r: you'll never be cold again).",
  ],
  "quest.475548AD89F3548F.title": "Peppersweet Potion",
  "quest.475548AD89F3548F.quest_desc": [
    "Cheese broth with a &dCandy Pepper&r. A warm, sweet feeling: you heal a little and get two extra hearts.",
  ],
  "quest.4755480036673571.title": "Hot! Hot! Hot!",
  "quest.4755480036673571.quest_desc": [
    "Eat a &craw Wahoog Pepper&r. It makes you run wahoog for ten seconds, with smoke coming out of your ears. Nobody said it was smart, nyeg.",
  ],
  "quest.475548A5C33735FD.title": "Pepper Garland",
  "quest.475548A5C33735FD.quest_desc": [
    "A garland of red, green and pink peppers. Hold it (hold right-click) to unlock it, then hang it around your guh in the wardrobe!",
  ],
}
