{
  "chapter.4755488AC3632FEB.title": "&aCritters of the Guhmension",
  "chapter.4755488AC3632FEB.chapter_subtitle": [
    "11. Finches, ducklings, hedgehogs and... Shuckly?",
  ],
  "quest.4755482B9953E643.title": "How Do You Get Here?",
  "quest.4755482B9953E643.quest_desc": [
    "This chapter comes after &dWelcome to the Guhmension!&r in &dThe Guhmension&r.",
    "",
    "The Guhmension is full of sweet critters: birdies in the trees and above the sea, guhxolotls and ducklings in the ponds, butterflies and glowguhs above the flowers, and hedgehogs, bunnies and squirrels in the grass. Not guhs, but very guh-ish! And somewhere, very slowly... Shuckly.",
    "",
    "Get close to add them to your &dGuhdex&r: they all count towards &6everything collected&r. Some of them you can even tame and pick up. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it before. The headings show what logically comes next. Tick this off and get chonking!",
  ],
  "quest.4755486000F0FB50.title": "Fluff Finches",
  "quest.4755486000F0FB50.quest_desc": [
    "In the &dGuh Fields&r, the &dPink Puffs&r and the Guh Meadows, little flocks of &dFluff Finches&r flutter around the guh blossom trees. Creep closer (&7sneak&r!), or the whole flock flies off. Add one to your Guhdex.",
  ],
  "quest.47554864A6B3F545.title": "Soft as a Little Cloud",
  "quest.47554864A6B3F545.quest_desc": [
    "Fluff Finches sometimes drop a &dfluff feather&r, especially when you give them &eseeds&r. The Cloud Shepherd of the Cloud Chapel is looking for one!",
  ],
  "quest.4755480637E945D3.title": "Cheese Chickadees",
  "quest.4755480637E945D3.quest_desc": [
    "In the &2Chonkwood Forest&r and the &eCheese Flats&r live &eCheese Chickadees&r: yellow, with a cheese stripe on their tummy. Add one to your Guhdex.",
  ],
  "quest.47554845D02AC532.title": "Upside Down!",
  "quest.47554845D02AC532.quest_desc": [
    "Cheese Chickadees love hanging &eupside down&r under the leaves. Take a look up in the forest!",
  ],
  "quest.4755482EE8C9B393.title": "Guh Owlets",
  "quest.4755482EE8C9B393.quest_desc": [
    "During the day the &6Guh Owlet&r sleeps on a branch in the &7Guh Peaks&r or the &2Chonkwood Forest&r. At night its little eyes start to glow. Add one to your Guhdex.",
  ],
  "quest.475548AD759E8B46.title": "Hoo-hoo... Nyeg!",
  "quest.475548AD759E8B46.quest_desc": [
    "Head out at night and listen: can you hear a &6Guh Owlet&r calling? Its little head turns all the way around to look at you!",
  ],
  "quest.47554876EC3E8068.title": "Seagulls",
  "quest.47554876EC3E8068.quest_desc": [
    "Along the &bGuh Sea&r, the &9Deep Guh Sea&r and on &dGuhwai'i&r, &fSeagulls&r sit on the beach or bob on the waves. Add one to your Guhdex.",
  ],
  "quest.4755489273EDF5BF.title": "Mine! Mine!",
  "quest.4755489273EDF5BF.quest_desc": [
    "Hold a &bfish&r (or bread) near the seagulls. What do they shout then? Give one of them a fish and it's the happiest gull of the Guh Sea.",
  ],
  "quest.475548C2D4E2B345.title": "Dig In!",
  "quest.475548C2D4E2B345.quest_desc": [
    "Make a &dbird feeder&r and put seeds on it (right-click). All the birdies nearby come to feast, and fluff finches sometimes leave a fluff feather behind!",
  ],
  "quest.475548301A2D31BB.title": "Shh, Easy Now...",
  "quest.475548301A2D31BB.quest_desc": [
    "Birdies get startled when you come stomping over. &7Sneak&r right up to a sitting birdie without it flying away.",
  ],
  "quest.475548AA4AEB5BBD.title": "Birdwatcher",
  "quest.475548AA4AEB5BBD.quest_desc": [
    "Add &dall four&r birdies of the Guhmension to your Guhdex: the fluff finch, the cheese chickadee, the guh owlet and the seagull. Tweet-nyeg!",
  ],
  "quest.475548D84BDD1ABF.title": "Blub-Nyeg!",
  "quest.475548D84BDD1ABF.quest_desc": [
    "In the shallow water of the &bGuh Sea&r and the &eCheese Swamp&r swim &dguhxolotls&r: guhs that are axolotls, with fluffy little gills. Swim up close for your Guhdex!",
  ],
  "quest.4755480064D05D7B.title": "My Very Own Blubby",
  "quest.4755480064D05D7B.quest_desc": [
    "Give a guhxolotl a &6little guhfish&r (1 in 3 chance). Once tamed it follows you through water and over land, and clicking it opens its little menu.",
  ],
  "quest.4755481EBC6249B3.title": "A Bucketful of Love",
  "quest.4755481EBC6249B3.quest_desc": [
    "Scoop up a guhxolotl with a &bwater bucket&r (or sneak-click your own guhxolotl with an empty hand). Put it down wherever you like: splash! It can live in a guh house too, where it never dries out.",
  ],
  "quest.475548BC9E8C34E5.title": "Bubblies!",
  "quest.475548BC9E8C34E5.quest_desc": [
    "Press &bBubblies!&r in your guhxolotl's little menu: it blows a cloud of bubbles around you and you can breathe underwater for two minutes.",
  ],
  "quest.475548895F3664A4.title": "Worth Its Weight in Gold",
  "quest.475548895F3664A4.quest_desc": [
    "Every once in a while a guhxolotl is &6GOLD&r, with sparkly speckles. See one up close (or breed one: babies are sometimes gold!).",
  ],
  "quest.4755480D2FDB1691.title": "All the Blub Colors",
  "quest.4755480D2FDB1691.quest_desc": [
    "Tame a &dpink&r, a &amint&r, a &6choco&r, a &fwhite&r and a &egolden&r guhxolotl. What a WAHOOG collection!",
  ],
  "quest.47554817120B5DC8.title": "Quack-Nyeg!",
  "quest.47554817120B5DC8.quest_desc": [
    "On ponds and along the Guh Sea, &fGuh Ducklings&r paddle around. Get close for your Guhdex!",
  ],
  "quest.475548515437EC81.title": "All in a Row",
  "quest.475548515437EC81.quest_desc": [
    "A mama duck has a little row of &efluffy chicks&r trailing behind her: each chick follows the one in front. Spot one with at least three chicks!",
  ],
  "quest.47554860BE2ED71E.title": "Flitter-Flutter",
  "quest.47554860BE2ED71E.quest_desc": [
    "During the day &enibble butterflies&r flutter from flower to flower. Walk up to them gently (no running!) for your Guhdex.",
  ],
  "quest.4755487220926D12.title": "Little Lights in the Night",
  "quest.4755487220926D12.quest_desc": [
    "When it's dark, &aglowguhs&r float above the Cheese Swamp and the Guh Meadows: teeny-tiny guhs with a little light in their tummy.",
  ],
  "quest.47554859A4CE6A13.title": "Spots with Ears",
  "quest.47554859A4CE6A13.quest_desc": [
    "A &cladybug&r with little guh heads for spots! You'll find them near flowers and by your guh gardens.",
  ],
  "quest.4755488D03CD09AE.title": "Sweet Little Helpers",
  "quest.4755488D03CD09AE.quest_desc": [
    "Got a guh garden with something growing in it? Then sometimes a ladybug lands on it, and then it grows a &atiny bit faster&r. Watch it happen!",
  ],
  "quest.4755488377F25CF2.title": "Fluffhogs",
  "quest.4755488377F25CF2.quest_desc": [
    "In the &2Chonkwood Forest&r, &dfluffhogs&r potter about: hedgehogs with soft cuddle spines. Don't walk straight at them, or they'll roll up into a ball! Sneak closer (within 3 blocks) so it goes into your Guhdex.",
  ],
  "quest.475548CF6678C210.title": "Cuddle Spines",
  "quest.475548CF6678C210.quest_desc": [
    "Sneak up to a fluffhog and give it &csweet berries&r. Sometimes it eats from your hand and it's yours! Once tamed: right-click with an empty hand for its little menu, and try &dRoll Up!&r.",
  ],
  "quest.475548B8B562CFAB.title": "Guh Bunnies",
  "quest.475548B8B562CFAB.quest_desc": [
    "In the &aGuh Meadows&r, &dguh bunnies&r with long floppy ears hop around: pink, white, choco and gray (and in the Snowguh Tundra they're all white!). Get close for your Guhdex.",
  ],
  "quest.4755489DF6BE86B7.title": "Hop Hop!",
  "quest.4755489DF6BE86B7.quest_desc": [
    "Tame a guh bunny with a &6carrot&r (or a cheese nibble). Once tamed it can do a happy &dbinky&r: then you get a few bunny hops too!",
  ],
  "quest.475548EFC02D2539.title": "Fluff Squirrels",
  "quest.475548EFC02D2539.quest_desc": [
    "In the &dguh blossom trees&r and the &2Chonkwood Forest&r live &6fluff squirrels&r with an enormous curly tail. They climb up tree trunks! Get close for your Guhdex.",
  ],
  "quest.4755486F6952FBD8.title": "Nibble Buddy",
  "quest.4755486F6952FBD8.quest_desc": [
    "Tame a fluff squirrel with &6cheese nibbles&r. Whatever it had stuffed in its cheeks, you get as a gift!",
  ],
  "quest.475548611E66F011.title": "On My Shoulder!",
  "quest.475548611E66F011.quest_desc": [
    "Pick &dOn my shoulder!&r in your squirrel's little menu (or pick it up and right-click into the air with it): it sits on your shoulder! Sneak + right-click a block with an empty hand, and it hops off.",
  ],
  "quest.475548C0DE88AF15.title": "A Secret Stash",
  "quest.475548C0DE88AF15.quest_desc": [
    "Squirrels hide cheese nibbles in &6little dirt mounds&r (with a nibble peeking out). Find one and right-click to dig it up. A tame squirrel digs one up for you every now and then!",
  ],
  "quest.47554839B7E6CC4B.title": "Shuckly?!",
  "quest.47554839B7E6CC4B.quest_desc": [
    "Not a guh! A &cred shell with cheese holes&r and a &eyellow little head&r. Shuckly lives around the rocks of &dClone Island&r in the Guh Sea, and once in a blue moon deep in the &6Holey Cheese Caves&r. He's very shy: sneak!",
  ],
  "quest.47554820A8DACCCA.title": "Friends, Very, Very Slowly",
  "quest.47554820A8DACCCA.quest_desc": [
    "Sneak up to Shuckly (or he'll crawl into his shell) and give him &csweet berries&r. It takes a while... he's just very slow. Once tamed he follows you, at his own pace.",
  ],
  "quest.475548C36E32D5EC.title": "Shuckly Berry Juice",
  "quest.475548C36E32D5EC.quest_desc": [
    "Give your tame Shuckly sweet berries: he keeps them in his shell. With 3 berries he turns them into &dberry juice&r all by himself (or pick &dBerry Juice!&r in his little menu). Cheers, nyeg!",
  ],
  "quest.47554841F37BCBF6.title": "Polishing Stones",
  "quest.47554841F37BCBF6.quest_desc": [
    "Let your Shuckly live in a &dguh house&r and put &7cobblestone&r in the chest next to it. His chore: very patiently polishing stones into &fsmooth stone&r and shiny &dguh pebbles&r (four of those make a guh pebble path).",
  ],
  "quest.47554815372DBB2C.title": "A House for Them Too!",
  "quest.47554815372DBB2C.quest_desc": [
    "Hedgehogs, bunnies, squirrels and Shuckly can also live in a &dguh house&r: use your picked-up critter on the house, or pick it in the house screen.",
  ],
  "quest.47554864F89787A7.title": "A House Full of Critters",
  "quest.47554864F89787A7.quest_desc": [
    "Tame them all: a fluffhog, a guh bunny, a fluff squirrel and a Shuckly. WAHOOG!",
  ],
}
