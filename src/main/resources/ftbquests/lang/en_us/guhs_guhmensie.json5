{
  "chapter.4755480DD3825511.title": "&dThe Guhmension",
  "chapter.4755480DD3825511.chapter_subtitle": [
    "2. Pink wool, cheese sauce and lots and lots of guhs",
  ],
  "quest.475548DABAF1DB32.title": "How Do You Get Here?",
  "quest.475548DABAF1DB32.quest_desc": [
    "This chapter comes after &dGuh!&r in &dGuhs \\& Basics&r: as soon as you have cheese nibbles, turn them into a &6Block of Cheese Nibbles&r.",
    "",
    "Build a portal frame out of those (like a Nether portal) and step through: welcome to the &dGuhmension&r, the pink world where almost every other chapter begins.",
    "",
    "After that, the &6Guhmension Super Compass&r shows you the way to (almost) everything. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work!",
  ],
  "quest.475548F8514D5D28.title": "Block of Cheese Nibbles",
  "quest.475548F8514D5D28.quest_desc": [
    "Nine cheese nibbles in one block. Build a portal frame out of them (like a Nether portal).",
  ],
  "quest.4755486E9E523698.title": "Welcome to the Guhmension!",
  "quest.4755486E9E523698.quest_desc": [
    "Step through your guh portal: a world of pink wool, cheese sauce and lots and lots of guhs.",
  ],
  "quest.475548132D52436A.title": "Pink Moon",
  "quest.475548132D52436A.quest_desc": [
    "Stay in the Guhmension for a night and look up: a pink moon and pink stars!",
  ],
  "quest.4755485753677BE6.title": "The Super Compass",
  "quest.4755485753677BE6.quest_desc": [
    "Craft (or buy from the Chonk Tamer) a &eGuhmension Super Compass&r. Right-click: pick what you're looking for, by category. It points to the nearest one.",
  ],
  "quest.475548DBEA8ADA4D.title": "Toot Toot!",
  "quest.475548DBEA8ADA4D.quest_desc": [
    "At every guh portal in the Guhmension (and at the Guh Castle) there's a blue &bTravel Guh&r. The big places have one too: Guhwarden on the Eleven Guhtowns Tour, Snuggledale town, the Guh Fair, Guhland, the Balloon Festival and the Guh Circuit. Discover 3 by right-clicking them; after that you travel between your discovered Travel Guhs in one click. With a Travel Guh Whistle you can place one yourself.",
  ],
  "quest.475548E6EA3EFB18.title": "The Biomes Tab",
  "quest.475548E6EA3EFB18.quest_desc": [
    "Your &6Super Compass&r has a new tab: &dBiomes&r. For each world there is a row with all its biomes. A row with a little lock opens as soon as you have been to that world. Unfold the Guhmension, pick a biome and hold the compass: it points to the nearest spot.",
  ],
  "quest.475548C985D45C26.title": "There It Is!",
  "quest.475548C985D45C26.quest_desc": [
    "Walk with your Super Compass to the biome you picked, until you are right in the middle of it. Every biome you have already been to gets a check mark in the tab. Nyeg, so many places!",
  ],
  "quest.4755482918A79BBA.title": "Guh Fields",
  "quest.4755482918A79BBA.quest_desc": [
    "Visit the &dGuh Fields&r biome in the Guhmension.",
  ],
  "quest.475548D61D2F74E7.title": "Nibble Crumbs",
  "quest.475548D61D2F74E7.quest_desc": [
    "Visit the &dNibble Crumbs&r biome in the Guhmension.",
  ],
  "quest.4755489DA9081B1A.title": "Pink Puffs",
  "quest.4755489DA9081B1A.quest_desc": [
    "Visit the &dPink Puffs&r biome in the Guhmension.",
  ],
  "quest.47554854E2907878.title": "Cheese Flats",
  "quest.47554854E2907878.quest_desc": [
    "Visit the &dCheese Flats&r biome in the Guhmension.",
  ],
  "quest.47554834F9DC065F.title": "Guh Meadows",
  "quest.47554834F9DC065F.quest_desc": [
    "Visit the &dGuh Meadows&r biome in the Guhmension.",
  ],
  "quest.4755484949D11944.title": "Guh Peaks",
  "quest.4755484949D11944.quest_desc": [
    "Visit the &dGuh Peaks&r biome in the Guhmension.",
  ],
  "quest.47554880179E6958.title": "Chonk Cliffs",
  "quest.47554880179E6958.quest_desc": [
    "Visit the &dChonk Cliffs&r biome in the Guhmension.",
  ],
  "quest.475548DDEBA9D7D2.title": "Mika's Biome",
  "quest.475548DDEBA9D7D2.quest_desc": [
    "Visit the &dMika's Biome&r biome in the Guhmension.",
  ],
  "quest.4755482D1EF04BEA.title": "Guh Sea",
  "quest.4755482D1EF04BEA.quest_desc": [
    "Visit the &dGuh Sea&r biome in the Guhmension.",
  ],
  "quest.475548482533F5E2.title": "Guh Crystal Mine",
  "quest.475548482533F5E2.quest_desc": [
    "Visit the &dGuh Crystal Mine&r biome in the Guhmension.",
  ],
  "quest.475548A960531D47.title": "Palewood",
  "quest.475548A960531D47.quest_desc": [
    "Visit the &dPalewood&r biome in the Guhmension.",
  ],
  "quest.4755487D942DE60F.title": "Holey Cheese Caves",
  "quest.4755487D942DE60F.quest_desc": [
    "Visit the &dHoley Cheese Caves&r biome in the Guhmension.",
  ],
  "quest.475548216DA3DE65.title": "Cheese Swamp",
  "quest.475548216DA3DE65.quest_desc": [
    "Visit the &dCheese Swamp&r biome in the Guhmension.",
  ],
  "quest.475548FCCF76966A.title": "Chonkwood Forest",
  "quest.475548FCCF76966A.quest_desc": [
    "Visit the &dChonkwood Forest&r biome in the Guhmension.",
  ],
  "quest.4755483F486040C4.title": "Deep Guh Sea",
  "quest.4755483F486040C4.quest_desc": [
    "Visit the &dDeep Guh Sea&r biome in the Guhmension.",
  ],
  "quest.475548B8326769D5.title": "Snuggledale",
  "quest.475548B8326769D5.quest_desc": [
    "Visit the &dSnuggledale&r biome in the Guhmension.",
  ],
  "quest.475548D803B1E716.title": "Guh Polder",
  "quest.475548D803B1E716.quest_desc": [
    "Visit the &dGuh Polder&r biome in the Guhmension.",
  ],
  "quest.47554800E11C9827.title": "Snowguh Tundra",
  "quest.47554800E11C9827.quest_desc": [
    "Visit the &dSnowguh Tundra&r biome in the Guhmension.",
  ],
  "quest.4755488E61CB72B7.title": "Guhwai'i",
  "quest.4755488E61CB72B7.quest_desc": [
    "Visit the &dGuhwai'i&r biome in the Guhmension.",
  ],
  "quest.4755481991CCAFCA.title": "Blossom Lake",
  "quest.4755481991CCAFCA.quest_desc": [
    "Visit the &dBlossom Lake&r biome in the Guhmension.",
  ],
  "quest.4755481E722B4CC5.title": "Babbledale",
  "quest.4755481E722B4CC5.quest_desc": [
    "Visit the &dBabbledale&r biome in the Guhmension.",
  ],
  "quest.475548B1AB7E4D6E.title": "Cloud Meadow",
  "quest.475548B1AB7E4D6E.quest_desc": [
    "Visit the &dCloud Meadow&r biome in the Guhmension.",
  ],
  "quest.4755489DFD70FDF1.title": "Buzz Buzz Guh",
  "quest.4755489DFD70FDF1.quest_desc": [
    "Find a &dGuh Bee&r (Guhmension or a flowery Overworld). They never get angry!",
  ],
  "quest.475548AD1F58DE5A.title": "Nibble Hive",
  "quest.475548AD1F58DE5A.quest_desc": [
    "Craft a Nibble Hive. Is it full? Shears = cheese nibbles, glass bottle = Cheese Honey.",
  ],
  "quest.475548F79F052803.title": "Wobbleguh",
  "quest.475548F79F052803.quest_desc": [
    "Find a pink &dGuh Slime&r. They don't hurt anybody.",
  ],
  "quest.475548922FB8ACFA.title": "Sticky Chonk",
  "quest.475548922FB8ACFA.quest_desc": [
    "Nine guh slimeballs make a pink guh slime block: bouncy and sticky.",
  ],
  "quest.47554883E4A96AED.title": "Guhfish",
  "quest.47554883E4A96AED.quest_desc": [
    "Catch a Guhfish in the Guh Sea (bucket or fishing rod) and cook it.",
  ],
  "quest.47554807AF613EEA.title": "NYEG!",
  "quest.47554807AF613EEA.quest_desc": [
    "Run into a &cMika&r: the grumpy guh. It shoves you away, but it doesn't hurt.",
  ],
  "quest.4755488C315625E3.title": "Mika Whacker",
  "quest.4755488C315625E3.quest_desc": [
    "Buy the Mika Whacker from the Mika Hunter: five times as strong against Mikas, and it never breaks.",
  ],
  "quest.475548BF9CE78C33.title": "The Bigger the Mika...",
  "quest.475548BF9CE78C33.quest_desc": [
    "Defeat &cBig Mika&r in a challenging guh cave.",
  ],
  "quest.4755486C24F617CB.title": "Hot Mika",
  "quest.4755486C24F617CB.quest_desc": [
    "Find a &cNether Mika&r in the Nether: totally fireproof.",
  ],
  "quest.4755482D2E52EC6D.title": "Long Live the King!",
  "quest.4755482D2E52EC6D.quest_desc": [
    "The legendary &dGuh Castle&r: 256x256, with a guh head on the tower. The &5Guhmension Super Compass&r (pick: Wonders > Guh Castle) shows the way; it can be really far!",
  ],
  "quest.475548359E460DC9.title": "Your Wahoog Majesty",
  "quest.475548359E460DC9.quest_desc": [
    "Tame the King Guh on his throne with cheese nibbles and get his royal outfit (crown, cape, medallion). After one day a new king shows up, so everyone can tame one!",
  ],
  "quest.4755485B4889FC1E.title": "The Treasure Room",
  "quest.4755485B4889FC1E.quest_desc": [
    "Find the treasure room behind the throne (through the gallery) and take the &6Royal Guh Throne&r home with you.",
  ],
  "quest.4755483DF8204894.title": "Guh Friend",
  "quest.4755483DF8204894.quest_desc": [
    "The gatekeepers of the Guh Castle only let guh friends in. Prove it: have a nice chonky sit on the bench, or say the secret guh word in chat...",
  ],
  "quest.475548D4C3375F86.title": "The Sled Hut",
  "quest.475548D4C3375F86.quest_desc": [
    "On the Guh Peaks there's a snowy little hut with Guh Blossom trees. The Sled Guh is sad...",
  ],
  "quest.475548DA47804556.title": "The Broken Sled",
  "quest.475548DA47804556.quest_desc": [
    "Bring the Sled Guh a Sled Runner (guh caves), a guh bell (guh villages) and a pink ribbon (tailor).",
  ],
  "quest.475548D4F4C1FC17.title": "WHEEE!",
  "quest.475548D4F4C1FC17.quest_desc": [
    "Build a track and ride your Guh Sled (four guhs pull it!).",
  ],
  "quest.4755488BA428ACEF.title": "Your Own Roller Coaster",
  "quest.4755488BA428ACEF.quest_desc": [
    "Craft a Chonk Drop, a Guh Corkscrew and a Wahoog Ramp (Sled Builder's Book) and build your very own roller coaster.",
  ],
  "quest.475548D3ABFE8C6B.title": "Hamster House",
  "quest.475548D3ABFE8C6B.quest_desc": [
    "Find a &dHamster House&r.",
  ],
  "quest.475548E2F8FA8F68.title": "Big Hamster House",
  "quest.475548E2F8FA8F68.quest_desc": [
    "Find a &dBig Hamster House&r.",
  ],
  "quest.475548EF04CC1EBD.title": "Hamster Town",
  "quest.475548EF04CC1EBD.quest_desc": [
    "Find a &dHamster Town&r.",
  ],
  "quest.475548DCE127369D.title": "Guhland",
  "quest.475548DCE127369D.quest_desc": [
    "Find a &dGuhland&r. Very, very rare!",
  ],
  "quest.475548779BF1A06C.title": "Evil Mika's House",
  "quest.475548779BF1A06C.quest_desc": [
    "Find an &dEvil Mika's House&r.",
  ],
  "quest.4755481E51297E29.title": "Guh Picnic",
  "quest.4755481E51297E29.quest_desc": [
    "Find a &dGuh Picnic&r.",
  ],
  "quest.475548E9ED1AA679.title": "Guh Caves",
  "quest.475548E9ED1AA679.quest_desc": [
    "Find some &dGuh Caves&r.",
  ],
  "quest.47554899502B5F30.title": "Challenging Guh Caves",
  "quest.47554899502B5F30.quest_desc": [
    "Find some &dChallenging Guh Caves&r.",
  ],
  "quest.475548D8795F5628.title": "Cheese Fountain",
  "quest.475548D8795F5628.quest_desc": [
    "Find a &dCheese Fountain&r.",
  ],
  "quest.4755481D4D724C91.title": "Grand Cheese Fountain",
  "quest.4755481D4D724C91.quest_desc": [
    "Find a &dGrand Cheese Fountain&r.",
  ],
  "quest.475548CD47FA3027.title": "Guh Statue",
  "quest.475548CD47FA3027.quest_desc": [
    "Find a &dGuh Statue&r.",
  ],
  "quest.4755480C12D9D96D.title": "Guhramid",
  "quest.4755480C12D9D96D.quest_desc": [
    "Find a &dGuhramid&r. Very, very rare!",
  ],
  "quest.475548D43C9136FA.title": "Guh Village",
  "quest.475548D43C9136FA.quest_desc": [
    "Find a &dGuh Village&r.",
  ],
  "quest.475548E06B99DA2B.title": "Giant Cake",
  "quest.475548E06B99DA2B.quest_desc": [
    "Find a &dGiant Cake&r.",
  ],
  "quest.47554854FE4F85E2.title": "Giant Cheese Nibble",
  "quest.47554854FE4F85E2.quest_desc": [
    "Find a &dGiant Cheese Nibble&r.",
  ],
  "quest.47554866CE92303E.title": "Cheese Nibble Arch",
  "quest.47554866CE92303E.quest_desc": [
    "Find a &dCheese Nibble Arch&r.",
  ],
  "quest.4755480643426E17.title": "Guh Fossil",
  "quest.4755480643426E17.quest_desc": [
    "Find a &dGuh Fossil&r.",
  ],
  "quest.47554828786E7283.title": "Block Guh",
  "quest.47554828786E7283.quest_desc": [
    "Find a &dBlock Guh&r.",
  ],
  "quest.475548A1510F2135.title": "Mini Picnic",
  "quest.475548A1510F2135.quest_desc": [
    "Find a &dMini Picnic&r.",
  ],
  "quest.475548EFA8C8A840.title": "Quartz Statuette",
  "quest.475548EFA8C8A840.quest_desc": [
    "Find a &dQuartz Statuette&r.",
  ],
  "quest.475548BD5AF1F610.title": "The Hungry Guh",
  "quest.475548BD5AF1F610.quest_desc": [
    "At a &dguh picnic&r in the Guhmension sits the &dHungry Guh&r. Feed him 10 &efried cheese nibbles&r (from the Guh Frying Pan with Mika's Grease) and you get his buddy the &dBank Guh&r. Every player gets one, and this is the only way to get a Bank Guh: you can't craft it. So take good care of it!",
  ],
  "quest.4755483D64D9C5D3.title": "Your Very Own Bank Guh",
  "quest.4755483D64D9C5D3.quest_desc": [
    "Put your &dBank Guh&r down and click it: endless stuff fits in its tummy. You can search, sort and filter, and it has a crafting grid (with JEI, the &e+&r fills the grid from the bank first). Is it in the chore area of a Guh House? Then the residents sort everything they collect into it. Break it and it takes everything along.",
  ],
  "quest.475548AFC2EB45F3.title": "Nibble Farmer",
  "quest.475548AFC2EB45F3.quest_desc": [
    "Place a Chonk Seed Box in a guh village and plant Cheese Nibble Seeds on farmland.",
  ],
  "quest.4755482C74ECD09C.title": "Guh Blossom",
  "quest.4755482C74ECD09C.quest_desc": [
    "Find a Guh Blossom tree and grab a sapling.",
  ],
  "quest.475548259EFECEFD.title": "They Hang On My Chonk",
  "quest.475548259EFECEFD.quest_desc": [
    "At the Guh Picnic a jukebox is playing a guh record. Take it with you (right-click the jukebox)!",
  ],
  "quest.475548CC989606B5.title": "Guh Crystal",
  "quest.475548CC989606B5.quest_desc": [
    "Dig around the Guhmension for a crystal mine (y30-60).",
  ],
  "quest.4755480A5D79F565.title": "Guh Crystal Spyglass",
  "quest.4755480A5D79F565.quest_desc": [
    "Makes rare guhs light up, even through walls.",
  ],
  "quest.475548CE50F2A3F6.title": "Super Wahoog!",
  "quest.475548CE50F2A3F6.quest_desc": [
    "Mine Compressed Super Wahoog Chonk (iron pickaxe) and smelt it.",
  ],
  "quest.4755482E95A250B4.title": "Chonk Paxel",
  "quest.4755482E95A250B4.quest_desc": [
    "Pickaxe, axe and shovel in one, and it never breaks.",
  ],
  "quest.4755483224CCDE40.title": "Chonk Shears",
  "quest.4755483224CCDE40.quest_desc": [
    "Two Wahoog Chonk diagonally above each other, just like ordinary shears. They cut everything shears cut, and they never break.",
  ],
  "quest.47554832E4478C3B.title": "Something's Going On!",
  "quest.47554832E4478C3B.quest_desc": [
    "Sometimes something happens in the Guhmension, right outside where you are (about once every 2 or 3 days): a &6Cheese Shower&r, the &dChonk Parade&r or, at night, a &bStar Shower&r. You'll see it in chat and on the bar at the top.",
  ],
  "quest.475548A0D2BDA039.title": "Cloudy with a Chance of Cheese",
  "quest.475548A0D2BDA039.quest_desc": [
    "Catch 20 cheese nibbles in a Cheese Shower. Just walk into them, but be quicker than the wild guhs!",
  ],
  "quest.4755489987A6924E.title": "Gold from the Sky",
  "quest.4755489987A6924E.quest_desc": [
    "Catch a &6Golden Cheese Nibble&r in a Cheese Shower. Give it to a wild guh: instantly tame!",
  ],
  "quest.475548A5029A1872.title": "Join the Parade!",
  "quest.475548A5029A1872.quest_desc": [
    "Walk along with the &dChonk Parade&r, behind the Drummer Guh, all the way to the end. Confetti!",
  ],
  "quest.475548C88413AA21.title": "Drum Major",
  "quest.475548C88413AA21.quest_desc": [
    "Collect the whole parade outfit for your guh: the parade shako, the parade jacket and the little parade drum. You get one per parade, and only at the parade!",
  ],
  "quest.475548A469CFEC7F.title": "Make a Wish",
  "quest.475548A469CFEC7F.quest_desc": [
    "Tame a Star Guh that landed with a falling star. Be quick: after a minute it goes back to the stars!",
  ],
  "quest.475548056E6FFE61.title": "Party Animal",
  "quest.475548056E6FFE61.quest_desc": [
    "Experience all three events: the Cheese Shower, the Chonk Parade and the Star Shower.",
  ],
  "quest.475548F6592CF67D.title": "The Boathouse",
  "quest.475548F6592CF67D.quest_desc": [
    "On the shore of a &dBlossom Lake&r stands a little boathouse with a jetty. The &6Super Compass&r shows the way (Cozy tab).",
  ],
  "quest.475548C3FDDAA2AA.title": "The Fisher Guh",
  "quest.475548C3FDDAA2AA.quest_desc": [
    "On the jetty sits the &dFisher Guh&r with his fishing rod. He never catches anything and he is fine with that. Talk to him.",
  ],
  "quest.475548382145125B.title": "A Handful of Koi Food",
  "quest.475548382145125B.quest_desc": [
    "The Fisher Guh gives you a handful of &6koi food&r every day. Just ask.",
  ],
  "quest.4755480A11D65D01.title": "Chomp!",
  "quest.4755480A11D65D01.quest_desc": [
    "Hold koi food near the water: the &dkoi&r come swimming up to you. Right-click the water to scatter a handful, or give it to one koi. There are red-and-white, tricolor, pink, blue and golden ones.",
  ],
  "quest.4755487D01DD271D.title": "A Koi for Home",
  "quest.4755487D01DD271D.quest_desc": [
    "Scoop up a koi with a bucket of water. At home in your own pond it stays yours, in its own color.",
  ],
  "quest.4755488C3E0C6A3E.title": "A Little Row",
  "quest.4755488C3E0C6A3E.quest_desc": [
    "By the jetty lies a &6rowboat&r. Hop in and row a lap around the lake. The boat stays with its lake.",
  ],
  "quest.475548A761F5D489.title": "Getting to Know the Lake",
  "quest.475548A761F5D489.quest_desc": [
    "The Fisher Guh wants to teach you all about his lake: the koi, the blossom petals, the island. Four little lessons, at your own pace. At the end you get things for your own little spot by the water.",
  ],
  "quest.475548EF4C775304.title": "Hanami!",
  "quest.475548EF4C775304.quest_desc": [
    "Very rarely, on an island in the lake, a picnic blanket lies under the biggest blossom tree: the &dPicnic Island&r (Super Compass: Cozy).",
  ],
  "quest.475548D10AD68AF8.title": "Treats from the Basket",
  "quest.475548D10AD68AF8.quest_desc": [
    "On the blanket stands a &6picnic basket&r. It holds one treat for everyone, once. Have a look.",
  ],
  "quest.4755480E29355438.title": "Blossom Watching",
  "quest.4755480E29355438.quest_desc": [
    "The guhs on the island are celebrating &dhanami&r: blossom watching. By day they party, in the evening they sleep by the water. Talk to one of them.",
  ],
  "quest.475548D7275EA689.title": "The Blossom Guh",
  "quest.475548D7275EA689.quest_desc": [
    "At Blossom Lake, &dBlossom Guhs&r are sometimes born: blossom-white, with pink petals in their fur. Get close to one for your Guhdex.",
  ],
  "quest.47554834DA9810FA.title": "Ribbit on a Leaf",
  "quest.47554834DA9810FA.quest_desc": [
    "By the lake, &dfrogguhs&r sit on the lilies and the blossom petals. Come too close and they plop away. So sneak: spot one sitting on its leaf.",
  ],
  "quest.4755480F7972E966.title": "Blossom on the Water",
  "quest.4755480F7972E966.quest_desc": [
    "Pink &6blossom petals&r float on the lake. Take a few along: at home you can lay them on your own pond, just like a lily pad.",
  ],
  "quest.4755481E908833FB.title": "Through the Gate",
  "quest.4755481E908833FB.quest_desc": [
    "In &dBabbledale&r stand pink gates with guh ears on the top beam: &dtorii&r. Find one and walk under it.",
  ],
  "quest.4755485AA2C1B81C.title": "The Tanuki Guh",
  "quest.4755485AA2C1B81C.quest_desc": [
    "In Babbledale, &dTanuki Guhs&r are sometimes born: gray-brown, with a little mask, a ringed bushy tail and a leaf on their head. Get close to one for your Guhdex.",
  ],
  "quest.47554858561B261C.title": "Tea by the Waterfall",
  "quest.47554858561B261C.quest_desc": [
    "On a rock next to a tall waterfall stands an open &dtea house&r. Sit there for a while and listen to the babbling.",
  ],
  "quest.475548D992C46650.title": "Your Own Torii",
  "quest.475548D992C46650.quest_desc": [
    "Build a gate of &6pink lacquerwood&r at home: two posts four &6beams&r high, on top a crossbeam of five beams and five &6slabs&r as a little roof. You make pink lacquerwood planks from maple logs, or by lacquering eight planks pink with pink dye.",
  ],
  "quest.475548ED1743A674.title": "A Roof with a Curl",
  "quest.475548ED1743A674.quest_desc": [
    "Lay a roof of &6guh roof tiles&r (pink, white or soft gray): stairs for the sloping sides and a &6roof curl&r on every corner, so the roof edge curls up.",
  ],
  "quest.475548401CF6A813.title": "Slide It Open",
  "quest.475548401CF6A813.quest_desc": [
    "Make a little room with &6shoji&r for walls (right-click: they really slide open and let light through) and a floor of &6tatami&r.",
  ],
  "quest.4755482FE5FB7721.title": "A Zen Corner",
  "quest.4755482FE5FB7721.quest_desc": [
    "Lay a patch of &6raked sand&r with one spot with &6rings&r, put three smooth snugglestones on it and a &6stone guh lantern&r beside it. It lights up by itself when it gets dark.",
  ],
  "quest.475548FDE46126BB.title": "The Weeb House",
  "quest.475548FDE46126BB.quest_desc": [
    "In a Babbledale there sometimes stands one guh-Japanese little house with a hot-air balloon beside it: the &dWeeb House&r (Super Compass: Cozy). Shoes off!",
  ],
  "quest.4755485393451706.title": "Ohayo, guh-chan!",
  "quest.4755485393451706.quest_desc": [
    "Talk to &dEvichonk&r and &dNielschonk&r. Their little house is full of figurines. Don't touch: that's a limited edition.",
  ],
  "quest.475548A3A820B1A1.title": "Ittekimasu!",
  "quest.475548A3A820B1A1.quest_desc": [
    "Talk to them again. Wait... it's cherry blossom season. In Japan. Wave them off when their balloon leaves: they are gone for a guh day, with a note on the door.",
  ],
  "quest.475548CC0468DB8F.title": "Tadaima!",
  "quest.475548CC0468DB8F.quest_desc": [
    "Come back a day later: they are home again, with stories and a &6present&r for everyone who waved them off. You can do this as often as you like.",
  ],
  "quest.47554884FCC8E485.title": "Itadakimasu!",
  "quest.47554884FCC8E485.quest_desc": [
    "Sometimes they bring food: &6guh sushi&r, &6ramen&r, &6mochi&r or &6onigiri&r. Yummy for you and for your guhs. Taste one.",
  ],
  "quest.47554856BADC510C.title": "Kawaii!",
  "quest.47554856BADC510C.quest_desc": [
    "Four outfits for your guh come from Japan: the &6kimono&r, the &6hachimaki&r, the &6cat ears&r and the &6bow&r. Collect all four.",
  ],
  "quest.47554847FC4939CB.title": "The Whole Collection",
  "quest.47554847FC4939CB.quest_desc": [
    "The &dJapan Collection&r has twelve pieces, from the waving lucky guh to the maneki nibble. Swap a double with Evichonk and Nielschonk for one you miss. Once you have been given all twelve, you are a true &dWeeb&r: you may wear that title. Your collection is in the Guhdex.",
  ],
  "quest.475548AA08AFC393.title": "The Big Island",
  "quest.475548AA08AFC393.quest_desc": [
    "Very rarely, a big island floats above a &dCloud Meadow&r, with a hill, a little lake and a waterfall over the edge. There stands the hut of the &dcloud shepherd&r (Super Compass: Cozy).",
  ],
  "quest.475548FDA3D957D0.title": "Fluff!",
  "quest.475548FDA3D957D0.quest_desc": [
    "&dCloud Lambs&r float a hand's width above the grass. Snip one with shears: you get &6cloud fluff&r and after a while it is just as fluffy again.",
  ],
  "quest.47554859FD804A3E.title": "Cloud Maker",
  "quest.47554859FD804A3E.quest_desc": [
    "The cloud shepherd teaches you how to turn cloud fluff into &6cloud blocks&r: soft, you sink in a little and you never land hard on them. Follow his lesson to the end.",
  ],
  "quest.475548953E200B90.title": "A Lamb for Home",
  "quest.475548953E200B90.quest_desc": [
    "Whoever finishes his lesson may take one cloud lamb home. It stays with you, if you take good care of it.",
  ],
  "quest.47554890FE8DA130.title": "Cloud Guhs in the Wild",
  "quest.47554890FE8DA130.quest_desc": [
    "The &dCloud Guh&r used to live only on the Floating Guh Islets. In the Cloud Meadow he now simply walks around in the wild too. Get close to one.",
  ],
  "quest.4755480A8674A8EF.title": "The Harbor in the Sky",
  "quest.4755480A8674A8EF.quest_desc": [
    "On the edge of an island lies a jetty with hot-air balloons: the &dBalloon Harbor&r (Super Compass: Cozy). The balloonist guh is waiting for passengers.",
  ],
  "quest.47554816C24C7628.title": "Gently Down",
  "quest.47554816C24C7628.quest_desc": [
    "Once a day the balloonist guh takes you along in his balloon: in a big arc over the edge and gently down to the meadow below. Hop in and enjoy until you have landed.",
  ],
  "quest.475548B86E2B7E00.title": "The Sleeping Stargazer",
  "quest.475548B86E2B7E00.quest_desc": [
    "On a high island stands an old &dobservatory&r, half collapsed (Super Compass: Wonders). The stargazer guh there sleeps during the day.",
  ],
  "quest.475548EE1382BD3A.title": "Stardust",
  "quest.475548EE1382BD3A.quest_desc": [
    "Come back to the ruin at night: more stars fall there than anywhere else and the stargazer is awake. Look through the telescope: every night you get a little &6stardust&r.",
  ],
  "quest.475548D268916CD9.title": "Sitting on a Cloud",
  "quest.475548D268916CD9.quest_desc": [
    "Put a &6cloud bench&r down at home (make it from cloud blocks and cloud fluff, or trade for it with the Smith Guh) and sit on it. A cloud bed and a cloud lamp go nicely with it.",
  ],
  "quest.4755480D22408464.title": "The End of the Rainbow",
  "quest.4755480D22408464.quest_desc": [
    "Very rare: a real &drainbow&r as a bridge between two islands (Super Compass: Wonders). You can walk across it.",
  ],
  "quest.4755480A4103CE16.title": "The Pot at the End",
  "quest.4755480A4103CE16.quest_desc": [
    "At the end of the rainbow there is no pot of gold, but a pot of &6cheese nibbles&r. It is full again every day.",
  ],
  "quest.475548E35CC2C15A.title": "Your Own Rainbow",
  "quest.475548E35CC2C15A.quest_desc": [
    "&6Rainbow blocks&r are soft and a little see-through. You make them from cloud fluff with red, yellow and blue dye. Build an arch with them at home: blocks for the legs and stairs for the bend.",
  ],
  "quest.47554846099FBA38.title": "The Smith in the Thundercloud",
  "quest.47554846099FBA38.quest_desc": [
    "A dark little cloud that rumbles softly: the &dLightning Forge&r (Super Compass: Wonders). No fright: flash is sweet.",
  ],
  "quest.47554881412D5A6E.title": "Tap. Tap.",
  "quest.47554881412D5A6E.quest_desc": [
    "The &dSmith Guh&r presses clouds into blocks. Bring him cloud fluff and trade it for a cloud bench, a cloud bed or a cloud lamp.",
  ],
  "quest.4755486115A8145E.title": "The Castle on the Highest Cloud",
  "quest.4755486115A8145E.quest_desc": [
    "On the highest cloud stands a half-collapsed &dCloud Castle&r (Super Compass: Wonders). Inside, something very big is snoring.",
  ],
  "quest.4755482AE701033F.title": "Shhhh",
  "quest.4755482AE701033F.quest_desc": [
    "In the castle a &dGiant Guh&r sleeps on his hoard. Sneak past, no running and no jumping, and take one golden crumb. If he wakes up, he only sneezes you gently out of the castle.",
  ],
  "quest.475548A32E043DE5.title": "Head in the Clouds",
  "quest.475548A32E043DE5.quest_desc": [
    "Above the meadow hang stacks of islets, higher and higher. Climb, jump and ride the lift to the &dvery highest islet&r of such a stack and look down. Whoever has stood there may wear the title &bHead in the Clouds&r.",
  ],
}
