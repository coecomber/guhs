{
  "chapter.4755480DD3825511.title": "&dThe Guhmension",
  "chapter.4755480DD3825511.chapter_subtitle": [
    "2. Pink wool, cheese sauce and lots and lots of guhs",
  ],
  "quest.475548DABAF1DB32.title": "How Do You Get Here?",
  "quest.475548DABAF1DB32.quest_desc": [
    "This chapter comes after &dGuh!&r in &dGuhs \\& Basics&r: as soon as you have cheese nibbles, turn them into a &6Block of Cheese Nibbles&r.",
    "",
    "Build a portal frame out of those (like a Nether portal) and step through: welcome to the &dGuhmension&r, the pink world where almost every other chapter begins.",
    "",
    "After that, the &6Guhmension Super Compass&r shows you the way to (almost) everything. Nothing is locked: every quest ticks itself off as soon as you've done it, even if you did it earlier. The headings show what logically comes after what. Tick this off and get chonky to work!",
  ],
  "quest.475548F8514D5D28.title": "Block of Cheese Nibbles",
  "quest.475548F8514D5D28.quest_desc": [
    "Nine cheese nibbles in one block. Build a portal frame out of them (like a Nether portal).",
  ],
  "quest.4755486E9E523698.title": "Welcome to the Guhmension!",
  "quest.4755486E9E523698.quest_desc": [
    "Step through your guh portal: a world of pink wool, cheese sauce and lots and lots of guhs.",
  ],
  "quest.475548132D52436A.title": "Pink Moon",
  "quest.475548132D52436A.quest_desc": [
    "Stay in the Guhmension for a night and look up: a pink moon and pink stars!",
  ],
  "quest.4755485753677BE6.title": "The Super Compass",
  "quest.4755485753677BE6.quest_desc": [
    "Craft (or buy from the Chonk Tamer) a &eGuhmension Super Compass&r. Right-click: pick what you're looking for, by category. It points to the nearest one.",
  ],
  "quest.475548DBEA8ADA4D.title": "Toot Toot!",
  "quest.475548DBEA8ADA4D.quest_desc": [
    "At every guh portal in the Guhmension (and at the Guh Castle) there's a blue &bTravel Guh&r. The big places have one too: Guhwarden on the Eleven Guhtowns Tour, Snuggledale town, the Guh Fair, Guhland, the Balloon Festival and the Guh Circuit. Discover 3 by right-clicking them; after that you travel between your discovered Travel Guhs in one click. With a Travel Guh Whistle you can place one yourself.",
  ],
  "quest.4755482918A79BBA.title": "Guh Fields",
  "quest.4755482918A79BBA.quest_desc": [
    "Visit the &dGuh Fields&r biome in the Guhmension.",
  ],
  "quest.475548D61D2F74E7.title": "Nibble Crumbs",
  "quest.475548D61D2F74E7.quest_desc": [
    "Visit the &dNibble Crumbs&r biome in the Guhmension.",
  ],
  "quest.4755489DA9081B1A.title": "Pink Puffs",
  "quest.4755489DA9081B1A.quest_desc": [
    "Visit the &dPink Puffs&r biome in the Guhmension.",
  ],
  "quest.47554854E2907878.title": "Cheese Flats",
  "quest.47554854E2907878.quest_desc": [
    "Visit the &dCheese Flats&r biome in the Guhmension.",
  ],
  "quest.47554834F9DC065F.title": "Guh Meadows",
  "quest.47554834F9DC065F.quest_desc": [
    "Visit the &dGuh Meadows&r biome in the Guhmension.",
  ],
  "quest.4755484949D11944.title": "Guh Peaks",
  "quest.4755484949D11944.quest_desc": [
    "Visit the &dGuh Peaks&r biome in the Guhmension.",
  ],
  "quest.47554880179E6958.title": "Chonk Cliffs",
  "quest.47554880179E6958.quest_desc": [
    "Visit the &dChonk Cliffs&r biome in the Guhmension.",
  ],
  "quest.475548DDEBA9D7D2.title": "Mika's Biome",
  "quest.475548DDEBA9D7D2.quest_desc": [
    "Visit the &dMika's Biome&r biome in the Guhmension.",
  ],
  "quest.4755482D1EF04BEA.title": "Guh Sea",
  "quest.4755482D1EF04BEA.quest_desc": [
    "Visit the &dGuh Sea&r biome in the Guhmension.",
  ],
  "quest.475548482533F5E2.title": "Guh Crystal Mine",
  "quest.475548482533F5E2.quest_desc": [
    "Visit the &dGuh Crystal Mine&r biome in the Guhmension.",
  ],
  "quest.4755489DFD70FDF1.title": "Buzz Buzz Guh",
  "quest.4755489DFD70FDF1.quest_desc": [
    "Find a &dGuh Bee&r (Guhmension or a flowery Overworld). They never get angry!",
  ],
  "quest.475548AD1F58DE5A.title": "Nibble Hive",
  "quest.475548AD1F58DE5A.quest_desc": [
    "Craft a Nibble Hive. Is it full? Shears = cheese nibbles, glass bottle = Cheese Honey.",
  ],
  "quest.475548F79F052803.title": "Wobbleguh",
  "quest.475548F79F052803.quest_desc": [
    "Find a pink &dGuh Slime&r. They don't hurt anybody.",
  ],
  "quest.475548922FB8ACFA.title": "Sticky Chonk",
  "quest.475548922FB8ACFA.quest_desc": [
    "Nine guh slimeballs make a pink guh slime block: bouncy and sticky.",
  ],
  "quest.47554883E4A96AED.title": "Guhfish",
  "quest.47554883E4A96AED.quest_desc": [
    "Catch a Guhfish in the Guh Sea (bucket or fishing rod) and cook it.",
  ],
  "quest.47554807AF613EEA.title": "NYEG!",
  "quest.47554807AF613EEA.quest_desc": [
    "Run into a &cMika&r: the grumpy guh. It shoves you away, but it doesn't hurt.",
  ],
  "quest.4755488C315625E3.title": "Mika Whacker",
  "quest.4755488C315625E3.quest_desc": [
    "Buy the Mika Whacker from the Mika Hunter: five times as strong against Mikas, and it never breaks.",
  ],
  "quest.475548BF9CE78C33.title": "The Bigger the Mika...",
  "quest.475548BF9CE78C33.quest_desc": [
    "Defeat &cBig Mika&r in a challenging guh cave.",
  ],
  "quest.4755486C24F617CB.title": "Hot Mika",
  "quest.4755486C24F617CB.quest_desc": [
    "Find a &cNether Mika&r in the Nether: totally fireproof.",
  ],
  "quest.4755482D2E52EC6D.title": "Long Live the King!",
  "quest.4755482D2E52EC6D.quest_desc": [
    "The legendary &dGuh Castle&r: 256x256, with a guh head on the tower. The &5Guhmension Super Compass&r (pick: Wonders > Guh Castle) shows the way; it can be really far!",
  ],
  "quest.475548359E460DC9.title": "Your Wahoog Majesty",
  "quest.475548359E460DC9.quest_desc": [
    "Tame the King Guh on his throne with cheese nibbles and take his royal outfit with you (crown, cape, medallion). After a few days a new king shows up!",
  ],
  "quest.4755485B4889FC1E.title": "The Treasure Room",
  "quest.4755485B4889FC1E.quest_desc": [
    "Find the treasure room behind the throne (through the gallery) and take the &6Royal Guh Throne&r home with you.",
  ],
  "quest.4755483DF8204894.title": "Guh Friend",
  "quest.4755483DF8204894.quest_desc": [
    "The gatekeepers of the Guh Castle only let guh friends in. Prove it: have a nice chonky sit on the bench, or say the secret guh word in chat...",
  ],
  "quest.475548D4C3375F86.title": "The Sled Hut",
  "quest.475548D4C3375F86.quest_desc": [
    "On the Guh Peaks there's a snowy little hut with Guh Blossom trees. The Sled Guh is sad...",
  ],
  "quest.475548DA47804556.title": "The Broken Sled",
  "quest.475548DA47804556.quest_desc": [
    "Bring the Sled Guh a Sled Runner (guh caves), a guh bell (guh villages) and a pink ribbon (tailor).",
  ],
  "quest.475548D4F4C1FC17.title": "WHEEE!",
  "quest.475548D4F4C1FC17.quest_desc": [
    "Build a track and ride your Guh Sled (four guhs pull it!).",
  ],
  "quest.4755488BA428ACEF.title": "Your Own Roller Coaster",
  "quest.4755488BA428ACEF.quest_desc": [
    "Craft a Chonk Drop, a Guh Corkscrew and a Wahoog Ramp (Sled Builder's Book) and build your very own roller coaster.",
  ],
  "quest.475548D3ABFE8C6B.title": "Hamster House",
  "quest.475548D3ABFE8C6B.quest_desc": [
    "Find a &dHamster House&r.",
  ],
  "quest.475548E2F8FA8F68.title": "Big Hamster House",
  "quest.475548E2F8FA8F68.quest_desc": [
    "Find a &dBig Hamster House&r.",
  ],
  "quest.475548EF04CC1EBD.title": "Hamster Town",
  "quest.475548EF04CC1EBD.quest_desc": [
    "Find a &dHamster Town&r.",
  ],
  "quest.475548DCE127369D.title": "Guhland",
  "quest.475548DCE127369D.quest_desc": [
    "Find a &dGuhland&r. Very, very rare!",
  ],
  "quest.475548779BF1A06C.title": "Evil Mika's House",
  "quest.475548779BF1A06C.quest_desc": [
    "Find an &dEvil Mika's House&r.",
  ],
  "quest.4755481E51297E29.title": "Guh Picnic",
  "quest.4755481E51297E29.quest_desc": [
    "Find a &dGuh Picnic&r.",
  ],
  "quest.475548E9ED1AA679.title": "Guh Caves",
  "quest.475548E9ED1AA679.quest_desc": [
    "Find some &dGuh Caves&r.",
  ],
  "quest.47554899502B5F30.title": "Challenging Guh Caves",
  "quest.47554899502B5F30.quest_desc": [
    "Find some &dChallenging Guh Caves&r.",
  ],
  "quest.475548D8795F5628.title": "Cheese Fountain",
  "quest.475548D8795F5628.quest_desc": [
    "Find a &dCheese Fountain&r.",
  ],
  "quest.4755481D4D724C91.title": "Grand Cheese Fountain",
  "quest.4755481D4D724C91.quest_desc": [
    "Find a &dGrand Cheese Fountain&r.",
  ],
  "quest.475548CD47FA3027.title": "Guh Statue",
  "quest.475548CD47FA3027.quest_desc": [
    "Find a &dGuh Statue&r.",
  ],
  "quest.4755480C12D9D96D.title": "Guhramid",
  "quest.4755480C12D9D96D.quest_desc": [
    "Find a &dGuhramid&r. Very, very rare!",
  ],
  "quest.475548D43C9136FA.title": "Guh Village",
  "quest.475548D43C9136FA.quest_desc": [
    "Find a &dGuh Village&r.",
  ],
  "quest.475548E06B99DA2B.title": "Giant Cake",
  "quest.475548E06B99DA2B.quest_desc": [
    "Find a &dGiant Cake&r.",
  ],
  "quest.47554854FE4F85E2.title": "Giant Cheese Nibble",
  "quest.47554854FE4F85E2.quest_desc": [
    "Find a &dGiant Cheese Nibble&r.",
  ],
  "quest.47554866CE92303E.title": "Cheese Nibble Arch",
  "quest.47554866CE92303E.quest_desc": [
    "Find a &dCheese Nibble Arch&r.",
  ],
  "quest.4755480643426E17.title": "Guh Fossil",
  "quest.4755480643426E17.quest_desc": [
    "Find a &dGuh Fossil&r.",
  ],
  "quest.47554828786E7283.title": "Block Guh",
  "quest.47554828786E7283.quest_desc": [
    "Find a &dBlock Guh&r.",
  ],
  "quest.475548A1510F2135.title": "Mini Picnic",
  "quest.475548A1510F2135.quest_desc": [
    "Find a &dMini Picnic&r.",
  ],
  "quest.475548EFA8C8A840.title": "Quartz Statuette",
  "quest.475548EFA8C8A840.quest_desc": [
    "Find a &dQuartz Statuette&r.",
  ],
  "quest.475548AFC2EB45F3.title": "Nibble Farmer",
  "quest.475548AFC2EB45F3.quest_desc": [
    "Place a Chonk Seed Box in a guh village and plant Cheese Nibble Seeds on farmland.",
  ],
  "quest.4755482C74ECD09C.title": "Guh Blossom",
  "quest.4755482C74ECD09C.quest_desc": [
    "Find a Guh Blossom tree and grab a sapling.",
  ],
  "quest.475548259EFECEFD.title": "They Hang On My Chonk",
  "quest.475548259EFECEFD.quest_desc": [
    "At the Guh Picnic a jukebox is playing a guh record. Take it with you (right-click the jukebox)!",
  ],
  "quest.475548CC989606B5.title": "Guh Crystal",
  "quest.475548CC989606B5.quest_desc": [
    "Dig around the Guhmension for a crystal mine (y30-60).",
  ],
  "quest.4755480A5D79F565.title": "Guh Crystal Spyglass",
  "quest.4755480A5D79F565.quest_desc": [
    "Makes rare guhs light up, even through walls.",
  ],
  "quest.475548CE50F2A3F6.title": "Super Wahoog!",
  "quest.475548CE50F2A3F6.quest_desc": [
    "Mine Compressed Super Wahoog Chonk (iron pickaxe) and smelt it.",
  ],
  "quest.4755482E95A250B4.title": "Chonk Paxel",
  "quest.4755482E95A250B4.quest_desc": [
    "Pickaxe, axe and shovel in one, and it never breaks.",
  ],
  "quest.475548BD5AF1F610.title": "Bank Guh",
  "quest.475548BD5AF1F610.quest_desc": [
    "Feed the Hungry Guh 10 fried cheese nibbles.",
  ],
  "quest.47554832E4478C3B.title": "Something's Going On!",
  "quest.47554832E4478C3B.quest_desc": [
    "Sometimes something happens in the Guhmension, right outside where you are (about once every 2 or 3 days): a &6Cheese Shower&r, the &dChonk Parade&r or, at night, a &bStar Shower&r. You'll see it in chat and on the bar at the top.",
  ],
  "quest.475548A0D2BDA039.title": "Cloudy with a Chance of Cheese",
  "quest.475548A0D2BDA039.quest_desc": [
    "Catch 20 cheese nibbles in a Cheese Shower. Just walk into them, but be quicker than the wild guhs!",
  ],
  "quest.4755489987A6924E.title": "Gold from the Sky",
  "quest.4755489987A6924E.quest_desc": [
    "Catch a &6Golden Cheese Nibble&r in a Cheese Shower. Give it to a wild guh: instantly tame!",
  ],
  "quest.475548A5029A1872.title": "Join the Parade!",
  "quest.475548A5029A1872.quest_desc": [
    "Walk along with the &dChonk Parade&r, behind the Drummer Guh, all the way to the end. Confetti!",
  ],
  "quest.475548C88413AA21.title": "Drum Major",
  "quest.475548C88413AA21.quest_desc": [
    "Collect the whole parade outfit for your guh: the parade shako, the parade jacket and the little parade drum. You get one per parade, and only at the parade!",
  ],
  "quest.475548A469CFEC7F.title": "Make a Wish",
  "quest.475548A469CFEC7F.quest_desc": [
    "Tame a Star Guh that landed with a falling star. Be quick: after a minute it goes back to the stars!",
  ],
  "quest.475548056E6FFE61.title": "Party Animal",
  "quest.475548056E6FFE61.quest_desc": [
    "Experience all three events: the Cheese Shower, the Chonk Parade and the Star Shower.",
  ],
}
