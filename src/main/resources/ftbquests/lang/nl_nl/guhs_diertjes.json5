{
  "chapter.4755488AC3632FEB.title": "&aDiertjes van de Guhmensie",
  "chapter.4755488AC3632FEB.chapter_subtitle": [
    "11. Vinkjes, eendjes, egeltjes en... Sjokkel?",
  ],
  "quest.4755482B9953E643.title": "Hoe kom je hier?",
  "quest.4755482B9953E643.quest_desc": [
    "Dit hoofdstuk komt na &dWelkom in de Guhmensie!&r in &dDe Guhmensie&r.",
    "",
    "De Guhmensie zit vol lieve diertjes: vogeltjes in de bomen en boven de zee, guhxolotls en eendjes in de vijvers, vlindertjes en glimguhtjes boven de bloemen, en egeltjes, konijntjes en eekhoorntjes in het gras. Geen guhs, maar wel heel guh-achtig! En ergens, heel traag... Sjokkel.",
    "",
    "Kom dichtbij om ze in je &dGuhdex&r te zetten: ze tellen allemaal mee voor &6alles verzameld&r. Sommige kun je zelfs temmen en oppakken. Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.4755486000F0FB50.title": "Pluisvinkjes",
  "quest.4755486000F0FB50.quest_desc": [
    "In de &dGuhvelden&r, de &dRoze pluisjes&r en de Guhweides fladderen groepjes &dPluisvinkjes&r rond de guhbloesembomen. Sluip dichterbij (&7sneaken&r!), anders vliegt het hele groepje op. Zet er een in je Guhdex.",
  ],
  "quest.47554864A6B3F545.title": "Zo zacht als een wolkje",
  "quest.47554864A6B3F545.quest_desc": [
    "Pluisvinkjes laten soms een &dpluisveertje&r vallen, vooral als je ze &ezaadjes&r geeft. De Wolkenhoeder van het Hemelkapelletje zoekt er een!",
  ],
  "quest.4755480637E945D3.title": "Kaasmeesjes",
  "quest.4755480637E945D3.quest_desc": [
    "In het &2Vadswoud&r en de &eKaasvlakte&r wonen &eKaasmeesjes&r: geel, met een kaasstreep op hun buik. Zet er een in je Guhdex.",
  ],
  "quest.47554845D02AC532.title": "Ondersteboven!",
  "quest.47554845D02AC532.quest_desc": [
    "Kaasmeesjes hangen graag &eondersteboven&r onder de blaadjes. Kijk maar eens omhoog in het bos!",
  ],
  "quest.4755482EE8C9B393.title": "Guh-uiltjes",
  "quest.4755482EE8C9B393.quest_desc": [
    "Overdag slaapt het &6Guh-uiltje&r op een takje in de &7Guhpieken&r of het &2Vadswoud&r. 's Nachts gaan zijn oogjes gloeien. Zet er een in je Guhdex.",
  ],
  "quest.475548AD759E8B46.title": "Oehoe... njeg!",
  "quest.475548AD759E8B46.quest_desc": [
    "Ga 's nachts op pad en luister: hoor je een &6Guh-uiltje&r roepen? Zijn kopje draait helemaal rond om jou te zien!",
  ],
  "quest.47554876EC3E8068.title": "Zeemeeuwtjes",
  "quest.47554876EC3E8068.quest_desc": [
    "Langs de &bGuhzee&r, de &9Diepe Guhzee&r en op &dGuhwai'i&r zitten &fZeemeeuwtjes&r op het strand of dobberen ze op de golfjes. Zet er een in je Guhdex.",
  ],
  "quest.4755489273EDF5BF.title": "Mijn! Mijn!",
  "quest.4755489273EDF5BF.quest_desc": [
    "Hou een &bvisje&r (of brood) vast bij de zeemeeuwtjes. Wat roepen ze dan? Geef er eentje een visje, dan is hij de blijste meeuw van de Guhzee.",
  ],
  "quest.475548C2D4E2B345.title": "Smullen maar!",
  "quest.475548C2D4E2B345.quest_desc": [
    "Maak een &dvogelvoerhuisje&r en leg er zaadjes op (rechtsklik). Alle vogeltjes in de buurt komen smullen, en pluisvinkjes laten er soms een pluisveertje achter!",
  ],
  "quest.475548301A2D31BB.title": "Stil maar...",
  "quest.475548301A2D31BB.quest_desc": [
    "Vogeltjes schrikken als je aan komt stampen. &7Sneak&r tot vlak bij een vogeltje dat zit, zonder dat het wegvliegt.",
  ],
  "quest.475548AA4AEB5BBD.title": "Vogelkijker",
  "quest.475548AA4AEB5BBD.quest_desc": [
    "Zet &dalle vier&r de vogeltjes van de Guhmensie in je Guhdex: het pluisvinkje, het kaasmeesje, het guh-uiltje en het zeemeeuwtje. Tjiep-njeg!",
  ],
  "quest.475548D84BDD1ABF.title": "Blub-njeg!",
  "quest.475548D84BDD1ABF.quest_desc": [
    "In het ondiepe water van de &bGuhzee&r en het &eKaasmoeras&r zwemmen &dguhxolotls&r: guhs die axolotls zijn, met pluizige kieuwtjes. Zwem er dichtbij voor je Guhdex!",
  ],
  "quest.4755480064D05D7B.title": "Mijn eigen blubje",
  "quest.4755480064D05D7B.quest_desc": [
    "Geef een guhxolotl een &6guhvisje&r (1 op 3 kans). Getemd volgt hij je door water en over land, en klik je hem aan voor zijn menuutje.",
  ],
  "quest.4755481EBC6249B3.title": "Een emmertje vol liefde",
  "quest.4755481EBC6249B3.quest_desc": [
    "Schep een guhxolotl op met een &bemmer water&r (of sluip-klik je eigen guhxolotl met een lege hand). Zet hem neer waar je wilt: plons! Hij kan ook in een guhhuisje wonen, daar droogt hij nooit uit.",
  ],
  "quest.475548BC9E8C34E5.title": "Blubbeltjes!",
  "quest.475548BC9E8C34E5.quest_desc": [
    "Druk in het menuutje van je guhxolotl op &bBlubbeltjes!&r: hij blaast een wolk bubbels om je heen en je kunt twee minuten onder water ademen.",
  ],
  "quest.475548895F3664A4.title": "Goud waard",
  "quest.475548895F3664A4.quest_desc": [
    "Heel af en toe is een guhxolotl &6GOUD&r, met glinsterende stipjes. Zie er een van dichtbij (of fok er een: kleintjes zijn soms goud!).",
  ],
  "quest.4755480D2FDB1691.title": "Alle blubkleurtjes",
  "quest.4755480D2FDB1691.quest_desc": [
    "Tem een &droze&r, een &amint&r, een &6choco&r, een &fwitte&r én een &egouden&r guhxolotl. Wat een VAHOEGE verzameling!",
  ],
  "quest.47554817120B5DC8.title": "Kwak-njeg!",
  "quest.47554817120B5DC8.quest_desc": [
    "Op vijvers en langs de Guhzee peddelen &fguh-eendjes&r. Kom dichtbij voor je Guhdex!",
  ],
  "quest.475548515437EC81.title": "Allemaal in een rijtje",
  "quest.475548515437EC81.quest_desc": [
    "Een mama-eendje heeft een rijtje &epluizige kuikentjes&r achter zich aan: elk kuikentje volgt het kuikentje voor zich. Zie er een met minstens drie kuikentjes!",
  ],
  "quest.47554860BE2ED71E.title": "Fladder-de-fladder",
  "quest.47554860BE2ED71E.quest_desc": [
    "Overdag fladderen &eknabbelvlindertjes&r van bloem naar bloem. Loop er zachtjes naartoe (niet rennen!) voor je Guhdex.",
  ],
  "quest.4755487220926D12.title": "Lichtjes in de nacht",
  "quest.4755487220926D12.quest_desc": [
    "Als het donker is, zweven er &aglimguhtjes&r boven het Kaasmoeras en de Guhweides: piepkleine guhtjes met een lampje in hun buik.",
  ],
  "quest.47554859A4CE6A13.title": "Stipjes met oortjes",
  "quest.47554859A4CE6A13.quest_desc": [
    "Een &clieveheersbeestje&r met guhkopjes als stipjes! Je vindt ze bij bloemen en bij je guhtuintjes.",
  ],
  "quest.4755488D03CD09AE.title": "Lieve helpertjes",
  "quest.4755488D03CD09AE.quest_desc": [
    "Heb je een guhtuintje met iets erin dat groeit? Dan komt er soms een lieveheersbeestje op zitten, en dan groeit het een &atikje sneller&r. Zie het gebeuren!",
  ],
  "quest.4755488377F25CF2.title": "Pluisegeltjes",
  "quest.4755488377F25CF2.quest_desc": [
    "In het &2Vadswoud&r scharrelen &dpluisegeltjes&r: egeltjes met zachte knuffelstekeltjes. Loop er niet op af, want dan rollen ze zich op! Sluip dichterbij (binnen 3 blokjes) zodat het in je Guhdex komt.",
  ],
  "quest.475548CF6678C210.title": "Knuffelstekeltjes",
  "quest.475548CF6678C210.quest_desc": [
    "Sluip naar een pluisegeltje en geef het &czoete bessen&r. Soms eet het uit je hand en is het van jou! Getemd: rechtsklik met een lege hand voor zijn menuutje, en probeer &dRol eens!&r.",
  ],
  "quest.475548B8B562CFAB.title": "Guh-konijntjes",
  "quest.475548B8B562CFAB.quest_desc": [
    "In de &aGuhweides&r huppelen &dguh-konijntjes&r met lange hangoortjes: roze, wit, choco en grijs (en in de Sneeuwguhtoendra allemaal wit!). Kom er dichtbij voor je Guhdex.",
  ],
  "quest.4755489DF6BE86B7.title": "Hophop!",
  "quest.4755489DF6BE86B7.quest_desc": [
    "Tem een guh-konijntje met een &6wortel&r (of een kaasknabbel). Getemd kan het een blije &dbinky&r doen: dan krijg jij ook even konijnensprongetjes!",
  ],
  "quest.475548EFC02D2539.title": "Pluiseekhoorntjes",
  "quest.475548EFC02D2539.quest_desc": [
    "In de &dguhbloesembomen&r en het &2Vadswoud&r wonen &6pluiseekhoorntjes&r met een reusachtige krulstaart. Ze klimmen tegen boomstammen op! Kom er dichtbij voor je Guhdex.",
  ],
  "quest.4755486F6952FBD8.title": "Knabbelvriendje",
  "quest.4755486F6952FBD8.quest_desc": [
    "Tem een pluiseekhoorntje met &6kaasknabbels&r. Wat het in zijn wangetjes had, krijg jij cadeau!",
  ],
  "quest.475548611E66F011.title": "Op mijn schouder!",
  "quest.475548611E66F011.quest_desc": [
    "Kies &dOp mijn schouder!&r in het menuutje van je eekhoorntje (of pak het op en rechtsklik ermee in de lucht): het zit op je schouder! Sluip + rechtsklik op een blok met een lege hand, en het springt eraf.",
  ],
  "quest.475548C0DE88AF15.title": "Een geheim voorraadje",
  "quest.475548C0DE88AF15.quest_desc": [
    "Eekhoorntjes verstoppen kaasknabbels in &6hoopjes aarde&r (met een knabbel die eruit piept). Vind er een en rechtsklik om hem op te graven. Een tam eekhoorntje graaft er af en toe zelf een voor je op!",
  ],
  "quest.47554839B7E6CC4B.title": "Sjokkel?!",
  "quest.47554839B7E6CC4B.quest_desc": [
    "Geen guh! Een &crode schelp met kaasgaatjes&r en een &egeel kopje&r. Sjokkel woont rond de rotsen van het &dkloon-eiland&r in de Guhzee, en heel af en toe diep in de &6Gatenkaasgrotten&r. Hij is heel verlegen: sluip!",
  ],
  "quest.47554820A8DACCCA.title": "Heel, heel langzaam vriendjes",
  "quest.47554820A8DACCCA.quest_desc": [
    "Sluip naar Sjokkel (anders kruipt hij in zijn schelp) en geef hem &czoete bessen&r. Het duurt even... hij is nu eenmaal heel traag. Getemd volgt hij je, op zijn eigen tempo.",
  ],
  "quest.475548C36E32D5EC.title": "Sjokkel-bessensapje",
  "quest.475548C36E32D5EC.quest_desc": [
    "Geef je tamme Sjokkel zoete bessen: hij bewaart ze in zijn schelp. Met 3 bessen maakt hij er vanzelf een &dbessensapje&r van (of kies &dBessensapje!&r in zijn menuutje). Proost, njeg!",
  ],
  "quest.47554841F37BCBF6.title": "Stenen polijsten",
  "quest.47554841F37BCBF6.quest_desc": [
    "Laat je Sjokkel in een &dguhhuisje&r wonen en leg &7keien&r in de kist ernaast. Zijn klusje: heel geduldig stenen poetsen tot &fgladde steen&r en glimmende &dguhsteentjes&r (vier daarvan maken een guhsteentjespad).",
  ],
  "quest.47554815372DBB2C.title": "Ook een huisje!",
  "quest.47554815372DBB2C.quest_desc": [
    "Egeltjes, konijntjes, eekhoorntjes en Sjokkel kunnen ook in een &dguhhuisje&r wonen: gebruik je opgepakte diertje op het huisje, of kies het in het huisjesscherm.",
  ],
  "quest.47554864F89787A7.title": "Een huis vol diertjes",
  "quest.47554864F89787A7.quest_desc": [
    "Tem ze allemaal: een pluisegeltje, een guh-konijntje, een pluiseekhoorntje en een Sjokkel. VAHOEG!",
  ],
}
