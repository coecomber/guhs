{
  "chapter.4755484752399400.title": "&eSponsguh",
  "chapter.4755484752399400.chapter_subtitle": [
    "3.3. Diep onder de leegte: Bikinibodem en Schelpenstad",
  ],
  "quest.475548A98B4F231A.title": "Hoe kom je hier?",
  "quest.475548A98B4F231A.quest_desc": [
    "Dit hoofdstuk hoort bij &5Verhalen van het Guheinde&r en komt na &dDoor de Knabbelpoort&r: diep onder de buiteneilanden, op de bodem van de leegte, ligt &eBikinibodem&r.",
    "",
    "Hier staat alles van &eSponsguh Kaasbroek&r en zijn vriendjes, en de plekken in en rond Bikinibodem. Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.475548B9CAAAD17A.title": "De bubbelbrief",
  "quest.475548B9CAAAD17A.quest_desc": [
    "Wie het Guhvatar-verhaal heeft uitgespeeld, krijgt in het Guheinde post: een &bzeepbel&r met een briefje erin zweeft op je af. Klik erop!",
  ],
  "quest.475548591008C816.title": "Naar Bikinibodem",
  "quest.475548591008C816.quest_desc": [
    "Fluit &dAppa&r en vlieg naar &bBikinibodem&r. Land op het eilandje bovenop de grote zeepbel.",
  ],
  "quest.475548416FE9C723.title": "De bubbelstroom",
  "quest.475548416FE9C723.quest_desc": [
    "Stap in de &bbubbelstroom&r: hij zet je zachtjes af op het plein van Bikinibodem, waar iemand heel vierkants op je wacht.",
  ],
  "quest.475548A64F91417D.title": "Een baantje",
  "quest.475548A64F91417D.quest_desc": [
    "Solliciteer bij &6Meneer Krabguh&r in &6De Krokante Knabbel&r. Neem geen geld mee: dat houdt hij.",
  ],
  "quest.47554893B0F6518C.title": "Knabbelburgers bakken",
  "quest.47554893B0F6518C.quest_desc": [
    "Sponsguh leert je het vak. Bak &6vijf Knabbelburgers&r in de volgorde van het bonnetje. Niemand haast je.",
  ],
  "quest.475548AEB55150D9.title": "Kwallen vangen",
  "quest.475548AEB55150D9.quest_desc": [
    "Patguh weet alles van kwallen. Bijna alles. Help hem acht &dkruimelkwallen&r te vangen voor de kwallenjam van De Krokante Knabbel.",
  ],
  "quest.475548B519B8E134.title": "Het bootrijexamen",
  "quest.475548B519B8E134.quest_desc": [
    "Sponsguh doet zijn bootrijexamen. Voor de achtendertigste keer. Jij bent zijn &drij-maatje&r: stuur het lesbootje van juf Pufguh over het pylonenparcours.",
  ],
  "quest.475548B2F33AB9DC.title": "Plan Z",
  "quest.475548B2F33AB9DC.quest_desc": [
    "De alarmbel van &6De Krokante Knabbel&r gaat! Ren naar het kantoor van &dMeneer Krabguh&r, achter in het restaurant. Er is iets met zijn kluis...",
  ],
  "quest.47554834560B5CC9.title": "Inbreken in De Vetemmer",
  "quest.47554834560B5CC9.quest_desc": [
    "&dPlankmika&r heeft het geheime recept! Sluip door zijn lab in &6De Vetemmer&r, langs de camera's en lasers van &dKaren&r. Gezien worden zet je alleen terug bij het laatste rustpunt.",
  ],
  "quest.4755480098D1FEC8.title": "Het recept terug",
  "quest.4755480098D1FEC8.quest_desc": [
    "Breng het geheime recept terug naar &dMeneer Krabguh&r. Het geheime ingrediënt verklappen we niet. (Het is een kaasknabbel.)",
  ],
  "quest.47554867FA4451C9.title": "Zoete Knabbelzege",
  "quest.47554867FA4451C9.quest_desc": [
    "Feest in de &6Bellenkom&r! &dOcto&r moet optreden tegen Octoliam en heeft geen band. Jij pakt de trommel, de hele stad zingt mee.",
  ],
  "quest.47554869C384F7D1.title": "De nieuwe manager",
  "quest.47554869C384F7D1.quest_desc": [
    "Meneer Krabguh opent een tweede restaurant en zoekt een manager. Sponsguh weet het zeker: dat wordt hij. Toch?",
  ],
  "quest.4755480760ED0A5D.title": "Een ijsje in de Guhfy Guhber",
  "quest.4755480760ED0A5D.quest_desc": [
    "Patguh weet wat helpt tegen verdriet: de grootste ijscoupe van de hele zeepbel. Al mist er wel iets...",
  ],
  "quest.475548156E8CE6EE.title": "De kroon is weg!",
  "quest.475548156E8CE6EE.quest_desc": [
    "Koning Neptuguh is woedend: zijn kroon is gestolen, en Meneer Krabguh krijgt de schuld. Brrr.",
  ],
  "quest.475548F726BC6227.title": "De Knabbelburgermobiel",
  "quest.475548F726BC6227.quest_desc": [
    "Rij met Sponsguh en Patguh de stadspoort uit, over de weg naar De Ruige Kroeg. Jij zit achter het stuur!",
  ],
  "quest.475548DF620FD5F0.title": "De Ruige Kroeg",
  "quest.475548DF620FD5F0.quest_desc": [
    "Een stoere Mika heeft je sleuteltje. Sluip erheen, en sta stil zodra de Mika's opkijken. Wie was het baby'tje?",
  ],
  "quest.4755487F7B812C94.title": "Mannen met een snor",
  "quest.4755487F7B812C94.quest_desc": [
    "De Knabbelburgermobiel kan niet over de loopgraaf. Loop met Sponsguh en Patguh naar de westrand: daar wacht prinses Mindy-guh met iets harigs.",
  ],
  "quest.475548683662C1B1.title": "De monsters van de loopgraaf",
  "quest.475548683662C1B1.quest_desc": [
    "Omlaag, de donkere bodem over en weer omhoog. Brullen de monsters? Of... zingen ze?",
  ],
  "quest.475548BF5B675EDC.title": "Dennis en de snor",
  "quest.475548BF5B675EDC.quest_desc": [
    "Dennis-Mika zoekt een vierkant en een ster. Gelukkig zijn jullie twee keurige heren met een snor. Toch?",
  ],
  "quest.47554804282E51F2.title": "De Cycloop",
  "quest.47554804282E51F2.quest_desc": [
    "In de souvenirwinkel van Schelpenstad ligt de kroon van koning Neptuguh. En de drooglamp staat al aan...",
  ],
  "quest.4755485F1E8DE6D9.title": "Een lift naar huis",
  "quest.4755485F1E8DE6D9.quest_desc": [
    "De kroon is terug, maar de zeepbelzon gaat bijna onder! Prinses Mindy-guh roept een heel grote vriend op de pier van Schelpenstad.",
  ],
  "quest.47554811D49FC409.title": "Plankmika's emmerhelmen",
  "quest.47554811D49FC409.quest_desc": [
    "Heel Bikinibodem loopt met een emmer op zijn hoofd. Blaas ze eraf met je bellenblazer en loop met je stoet naar de Bellenkom.",
  ],
  "quest.475548CBC1ACC4D9.title": "Ik ben een Guhfy Guhber",
  "quest.475548CBC1ACC4D9.quest_desc": [
    "Klim op het podium van de Bellenkom en rock zo hard dat elke emmer eraf vliegt. Koning Neptuguh krijgt zijn kroon, Meneer Krabguh ontdooit, en Sponsguh... wordt manager!",
  ],
  "quest.4755489DD367E445.title": "Op bezoek bij Sandy-guh",
  "quest.4755489DD367E445.quest_desc": [
    "Ga naar de glazen boomkoepel in het oosten van de stad (zuid van het rusthuis), stap door de luchtsluis aan de westkant naar binnen en loop naar Sandy-guh.",
  ],
  "quest.47554889D996207A.title": "Karate op de mat",
  "quest.47554889D996207A.quest_desc": [
    "Stap op de karatemat in de koepel. Sandy-guh duwt: roept ze HAI, stap dan opzij of spring. Ontwijk haar tien keer. Word je geduwd, dan telt die keer gewoon niet mee.",
  ],
  "quest.4755483E3A63CE60.title": "Drie raketonderdelen",
  "quest.4755483E3A63CE60.quest_desc": [
    "Bij de laatste BOEM vlogen drie onderdelen van Sandy's raket de stad in: de neuskegel (bij het Kwallenveld in het noordoosten), de straalpijp (achter de huisjes aan de Westring) en de antenne (tussen de huizen van de Schelpstraat). Loop eroverheen om ze op te rapen.",
  ],
  "quest.47554893212F0CC8.title": "De raket",
  "quest.47554893212F0CC8.quest_desc": [
    "Breng de drie onderdelen naar Sandy's kapotte raket, in de boomkoepel naast de boom.",
  ],
  "quest.47554849CCF3BD71.title": "Wachten op het spookschip",
  "quest.47554849CCF3BD71.quest_desc": [
    "Ga naar de aanlegplaats van De Vliegende Guhlander: de ring van stenen met het bordje, oost van de rots van Patguh aan de Schelpstraat. Blijf op de stenen staan tot het schip komt: tien tellen, ze staan boven je werkbalk.",
  ],
  "quest.475548AF8F540F3F.title": "Aan boord",
  "quest.475548AF8F540F3F.quest_desc": [
    "Stap in de bubbelstroom bij de aanlegplaats: hij brengt je omhoog naar het dek. Loop daar naar de spookkapitein.",
  ],
  "quest.475548E202833828.title": "Drie spooklantaarns",
  "quest.475548E202833828.quest_desc": [
    "De drie lantaarns van de kapitein zijn weggewaaid: één tussen de Kruimelkwallen in het veld oost van de aanlegplaats, één achter De Vetemmer (noord van de aanlegplaats) en één bij de knabbelkoorvrucht van Sponsguh, in het westen. Loop eroverheen.",
  ],
  "quest.4755485229766082.title": "Terug aan boord",
  "quest.4755485229766082.quest_desc": [
    "Ga terug naar de aanlegplaats. Het schip komt weer (vijf tellen): neem de bubbelstroom omhoog en breng de kapitein zijn lantaarns.",
  ],
  "quest.475548E30AD037B2.title": "De oude helden",
  "quest.475548E30AD037B2.quest_desc": [
    "Ga naar het rusthuis in het oosten (noord van de boomkoepel; de deur zit aan de westkant) en loop naar Zeemeerman en Mosselguh.",
  ],
  "quest.475548262E102DBF.title": "De verloren riem",
  "quest.475548262E102DBF.quest_desc": [
    "De riem van Zeemeerman ligt in de onzichtbare bootmobiel, op de parkeerplaats aan de zuidkant van het rusthuis. Zoek tussen niets naar iets en raap de riem op.",
  ],
  "quest.4755480A7F185FD1.title": "De riem terug",
  "quest.4755480A7F185FD1.quest_desc": [
    "Breng de riem terug naar Zeemeerman, binnen in het rusthuis.",
  ],
  "quest.4755482FCA3FD97B.title": "Een heldendaad",
  "quest.4755482FCA3FD97B.quest_desc": [
    "Rijd met de onzichtbare bootmobiel naar de voordeur van De Krokante Knabbel (west van het rusthuis, aan de Hoofdstraat) en haal de heldenlunch op.",
  ],
  "quest.475548DCC194C801.title": "Bikinibodem onder de leegte",
  "quest.475548DCC194C801.quest_desc": [
    "Diep tussen de buiteneilanden van het Guheinde ligt een schotel van kaaskorst onder een reusachtige &dzeepbel&r: &6Bikinibodem&r. Het Superkompas (tabblad einde) wijst de weg. Land op het eilandje erboven en stap in de &bbubbelstroom&r: die zet je netjes op het plein. De paarse mist is geen water, dus adem maar gewoon door. Wie wonen er? Dat merk je vanzelf. Iemand lacht er heel hard, njeg.",
  ],
  "quest.475548B44B8692E1.title": "De weg naar Schelpenstad",
  "quest.475548B44B8692E1.quest_desc": [
    "Uit de poort van &dBikinibodem&r loopt een weg de leegte in. Volg hem: langs &6De Ruige Kroeg&r (een sleepboot vol stoere Mika's, en waag het niet om er bellen te blazen), dwars door &8de loopgraaf&r (diep, donker, vol monsters, veel plezier) en dan de heuvel af naar &bSchelpenstad&r aan de Leegtezee. Daar staat de souvenirwinkel van de Cycloop. Alles is er gedroogd, njeg.",
  ],
}
