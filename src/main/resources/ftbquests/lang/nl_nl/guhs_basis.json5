{
  "chapter_group.475548DB0F6F37EB.title": "&dGuhs",
  "chapter.475548D4D6AC1372.title": "&dGuhs \\& basis",
  "chapter.475548D4D6AC1372.chapter_subtitle": [
    "1. Tem, kleed en knuffel je guh. VAHOEG!",
  ],
  "quest.475548077F9CDE38.title": "Hoe kom je hier?",
  "quest.475548077F9CDE38.quest_desc": [
    "Je bent er al! Dit is het allereerste hoofdstuk: hier begint elk guh-avontuur, met een handje &6kaasknabbels&r.",
    "",
    "Lees de hoofdstukken van boven naar beneden: &dGuhs \\& basis&r > &dDe Guhmensie&r > &6Minigames \\& bijzondere plekken&r > &9Onderwater&r > &cDe Guhmaag&r > &6De Guhbarbecuether&r > &eGrotten, moeras \\& woud&r > &dKnuffeldal&r > &dPiep!&r > &dLieve vadsjes&r > &aDiertjes&r > &dGuhpixel&r > &bGuh-technologie&r. De grote verhalen staan helemaal onderaan bij elkaar, in de groep &6Het Guhpad&r: &dVerhalen van de Guhmensie&r > &6Verhalen van de Guhbarbecuether&r > &5Verhalen van het Guheinde&r > &7Het echte Guheinde&r.",
    "",
    "Bovenaan elk hoofdstuk staat zo'n &dHoe kom je hier?&r-quest, met een linkje naar de quest in een ander hoofdstuk waar het begint.",
    "",
    "Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag! (Alleen de maaggroottes in De Guhmaag komen echt na elkaar, en in &6Het Guhpad&r openen de grote verhalen de werelden: elk hoofdstuk begint daar met een slotquest.)",
  ],
  "quest.4755481164F1D771.title": "Frituurvads",
  "quest.4755481164F1D771.quest_desc": [
    "Vul de guh-koekenpan met Mika's vet en frituur kaasknabbels. Gefrituurde kaasknabbels maken een tamme guh meteen helemaal beter.",
  ],
  "quest.475548EA2B2676C2.title": "Guh!",
  "quest.475548EA2B2676C2.quest_desc": [
    "Welkom bij de &dGuhs&r! Mollige roze knuffelmuisjes die overal rondlopen. Alles begint met &6kaasknabbels&r: daarmee tem, genees en fok je guhs.",
  ],
  "quest.475548789D9A06CA.title": "Een vadsig vriendje",
  "quest.475548789D9A06CA.quest_desc": [
    "Voer een wilde guh kaasknabbels tot hij tam is (1 op 3 kans per knabbel). Een tamme guh krijgt 1000 levens! Tik hem kort aan met rechtsklik om hem te &daaien&r; houd rechtsklik ingedrukt voor zijn menu (zitten, emotes, kleding en meer).",
  ],
  "quest.475548E1C8AC3399.title": "Aankleden!",
  "quest.475548E1C8AC3399.quest_desc": [
    "Kleding is nu een &dontgrendeling&r: houd een kledingstuk rechtsklik ingedrukt en al je guhs kunnen het aan. Rechtsklik je tamme guh en kies &dKledingkast&r: pas alles wat je hebt, draai je guh rond en klik &6Aantrekken!&r. Een guh heeft ook een pantservakje en (met de guhrugzak, zelf te maken) 18 extra vakjes.",
  ],
  "quest.475548059763450F.title": "Hop hop, guh!",
  "quest.475548059763450F.quest_desc": [
    "Een grote guh (minstens ~1,7 blok) met een zadel kun je berijden.",
  ],
  "quest.475548E655785894.title": "VAHOEG, lanceren!",
  "quest.475548E655785894.quest_desc": [
    "Rijd op je eigen guh met een lege hand en rechtsklik: hij zuigt lucht naar binnen en... schiet weg! Rechtsklik nog eens om de afstand vast te zetten.",
  ],
  "quest.475548E81EBD2AE5.title": "Gewone guh",
  "quest.475548E81EBD2AE5.quest_desc": [
    "Kom dichtbij een &dGewone guh&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.47554885C5DA9678.title": "Muntguh",
  "quest.47554885C5DA9678.quest_desc": [
    "Kom dichtbij een &dMuntguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.475548B26992642F.title": "Chocoguh",
  "quest.475548B26992642F.quest_desc": [
    "Kom dichtbij een &dChocoguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.475548D5686D7169.title": "Sneeuwguh",
  "quest.475548D5686D7169.quest_desc": [
    "Kom dichtbij een &dSneeuwguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.475548780D32D11B.title": "Brontosaurusguh",
  "quest.475548780D32D11B.quest_desc": [
    "Kom dichtbij een &dBrontosaurusguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.4755484D7AC1CC31.title": "Teckelguh",
  "quest.4755484D7AC1CC31.quest_desc": [
    "Kom dichtbij een &dTeckelguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.475548449E1F51A4.title": "Spookguh",
  "quest.475548449E1F51A4.quest_desc": [
    "Kom dichtbij een &dSpookguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt. Alleen 's nachts!",
  ],
  "quest.4755483728B39997.title": "Sterrenguh",
  "quest.4755483728B39997.quest_desc": [
    "Kom dichtbij een &dSterrenguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt. Komt alleen met een sterrenregen!",
  ],
  "quest.475548C626196F38.title": "Regenboogguh",
  "quest.475548C626196F38.quest_desc": [
    "Kom dichtbij een &dRegenboogguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt. Heel zeldzaam!",
  ],
  "quest.4755487B05630BA3.title": "Koningguh",
  "quest.4755487B05630BA3.quest_desc": [
    "Kom dichtbij een &dKoningguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt. Zit op zijn troon in het legendarische guhkasteel.",
  ],
  "quest.47554802FBC05DBB.title": "Gouden Guh",
  "quest.47554802FBC05DBB.quest_desc": [
    "Kom dichtbij een &dGouden Guh&r (binnen 3 blokjes) zodat hij in je Guhdex komt. Heel zeldzaam!",
  ],
  "quest.475548A9A60F432E.title": "Brococolief",
  "quest.475548A9A60F432E.quest_desc": [
    "Kom dichtbij een &dBrococolief&r (binnen 3 blokjes) zodat hij in je Guhdex komt. Een geheimzinnige guh met een briefje...",
  ],
  "quest.475548B724855F37.title": "Reisguh",
  "quest.475548B724855F37.quest_desc": [
    "Kom dichtbij een &dReisguh&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.4755480BC93832DB.title": "Poortwachter",
  "quest.4755480BC93832DB.quest_desc": [
    "Kom dichtbij een &dPoortwachter&r (binnen 3 blokjes) zodat hij in je Guhdex komt.",
  ],
  "quest.475548814D674562.title": "Guhdex vol!",
  "quest.475548814D674562.quest_desc": [
    "Alle guhsoorten gezien. Echte vahoege guhkenner!",
  ],
  "quest.475548426B645689.title": "Guhtaart",
  "quest.475548426B645689.quest_desc": [
    "Een roze taart met guhogen, 7 happen.",
  ],
  "quest.4755482C6BBCCFA2.title": "Guhcarons",
  "quest.4755482C6BBCCFA2.quest_desc": [
    "Alle vier de guhcarons!",
  ],
  "quest.47554898254AE1BC.title": "Kaasfondguh",
  "quest.47554898254AE1BC.quest_desc": [
    "Een warme kom kaasfondguh.",
  ],
  "quest.4755485FFC7D46CF.title": "Vahoege kaasknabbelshake",
  "quest.4755485FFC7D46CF.quest_desc": [
    "Haalt al je effecten weg, net als melk.",
  ],
  "quest.475548FD87F5969E.title": "Guhmeubels",
  "quest.475548FD87F5969E.quest_desc": [
    "Een guhstoel en een vadszetel: ga lekker zitten.",
  ],
  "quest.475548286E402328.title": "Vadszak",
  "quest.475548286E402328.quest_desc": [
    "Een vadszak in je lievelingskleur.",
  ],
  "quest.475548F986391308.title": "Lampgion",
  "quest.475548F986391308.quest_desc": [
    "Licht in de guhtuin.",
  ],
  "quest.4755485EDA0EA987.title": "Guhrad",
  "quest.4755485EDA0EA987.quest_desc": [
    "Zet je tamme guh in een &dGuhrad&r: hij rent &dvadskracht&r bij elkaar voor je guhmachines, en moe wordt hij nooit. Een blij guhtje rent extra hard! &dGuhdraad&r brengt de vadskracht naar je machines. Kijk naar het rad of de draad en je leest hoeveel vadskracht je opstelling gebruikt. Njeg!",
  ],
  "quest.4755485299AA59F1.title": "Bakken op vadskracht",
  "quest.4755485299AA59F1.quest_desc": [
    "Een &dGuhoven&r (8 keisteen om een kaasknabbel) heeft geen kolen nodig: hij bakt op &dvadskracht&r! Zet hem naast een &dGuhrad&r waar een guh in rent, of sluit hem aan met &dGuhdraad&r. Kijk naar de oven en je leest hoeveel vadskracht je opstelling gebruikt: vraagt die meer dan je guhs bij elkaar rennen, dan staat alles stil. Gewone redstone vindt hij niks. Het guhtje rent, de oven bakt. Njeg!",
  ],
  "quest.47554803591FB2A0.title": "Kijk eens wat ik kan!",
  "quest.47554803591FB2A0.quest_desc": [
    "Houd rechtsklik op je tamme guh, kies &dEmotes&r en laat hem iets doen: zwaaien, dansen, slapen, een &6VAHOEG&r-sprong, rollen, smakken of verlegen doen.",
  ],
  "quest.475548AC4FE25CAA.title": "Zijn lievelingsemote",
  "quest.475548AC4FE25CAA.quest_desc": [
    "Geef je guh een &dlievelingsemote&r (het sterretje in het Emotes-menu). Die doet hij voortaan af en toe helemaal uit zichzelf.",
  ],
  "quest.4755489FD1CAF372.title": "Guh met talent",
  "quest.4755489FD1CAF372.quest_desc": [
    "Laat je guhs alle emotes een keer doen (ook gapen, zingen, knuffelen en het verdrietje). De hartjes-emotes tellen niet mee: die ontgrendel je met hartjes. Hij kan meer dan alleen vadsig zijn!",
  ],
  "quest.475548C7B2AFF898.title": "Guhdisco",
  "quest.475548C7B2AFF898.quest_desc": [
    "Zet een jukebox aan met muziek erin. Guhs in de buurt kunnen het niet laten: ze gaan &ddansen&r! (Wacht er even bij, tamme of wilde.)",
  ],
  "quest.4755486B4BBD3C64.title": "Hoi hoi!",
  "quest.4755486B4BBD3C64.quest_desc": [
    "Loop naar een &dwilde&r guh toe. Met een beetje geluk zwaait hij naar je! (Verlegen guhs doen liever verlegen.)",
  ],
  "quest.475548F8EC553ED3.title": "Ontgrendeld!",
  "quest.475548F8EC553ED3.quest_desc": [
    "Koop een kledingstuk (bij de &dguh-kleermaker&r in een guhdorp, of in een van de minigames) en &dhoud rechtsklik ingedrukt&r. Plop! Nu kunnen al je tamme guhs het aan, zo vaak als je wil.",
  ],
  "quest.475548A791E693C6.title": "Oren op steeltjes",
  "quest.475548A791E693C6.quest_desc": [
    "Guhs hebben nu een plekje voor de &doren&r! De kleermaker verkoopt roze, mint en gele oorstrikjes. Ontgrendel er een en zet hem op in de kledingkast.",
  ],
  "quest.47554820558D9EA6.title": "Mijn lievelingsoutfit",
  "quest.47554820558D9EA6.quest_desc": [
    "Maak in de kledingkast een mooie outfit (of klik &eDobbel!&r) en &eshift-klik&r op een nummertje: zo bewaar je hem als favoriet. Een klik op het nummertje en je guh past hem weer.",
  ],
  "quest.475548C45FC7C462.title": "Van top tot teen",
  "quest.475548C45FC7C462.quest_desc": [
    "Ontgrendel alle stukken van een setje: alles van de kleermaker, of het hele pakje van een minigame. In de Guhdex (tabblad Kleding) zie je per plek wat je nog mist.",
  ],
  "quest.47554815132E332B.title": "Een vadsige kledingkast",
  "quest.47554815132E332B.quest_desc": [
    "Ontgrendel &e25 kledingstukken&r. Elke minigame heeft zijn eigen pakje, en in schatkisten liggen er nog veel meer!",
  ],
  "quest.475548EC8DC6CA2E.title": "De chicste guh van de Guhmensie",
  "quest.475548EC8DC6CA2E.quest_desc": [
    "Ontgrendel &660 kledingstukken&r. Zo veel kleertjes, je guhs weten niet meer wat ze aan moeten. VAHOEG!",
  ],
}
