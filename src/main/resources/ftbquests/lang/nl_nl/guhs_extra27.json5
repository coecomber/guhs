{
  "chapter.47554886C6FA7C81.title": "&eGrotten, moeras \\& woud",
  "chapter.47554886C6FA7C81.chapter_subtitle": [
    "7. Gatenkaas, moeras, woud en guhfamilies",
  ],
  "quest.4755486B4E6BCAF7.title": "Hoe kom je hier?",
  "quest.4755486B4E6BCAF7.quest_desc": [
    "Dit hoofdstuk komt na &dWelkom in de Guhmensie!&r in &dDe Guhmensie&r.",
    "",
    "Diep onder de Guhmensie liggen de &eGatenkaasgrotten&r. Ergens anders hangt gele mist boven het &eKaasmoeras&r, en mintgroene mist in het &aVadswoud&r, waar de guhfamilies wonen.",
    "",
    "Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.47554882C7FA8DDE.title": "Vol gaten!",
  "quest.47554882C7FA8DDE.quest_desc": [
    "Diep onder de Guhmensie (onder y 40) is de grond op sommige plekken één grote &6gatenkaas&r: ronde holen, kaasstalactieten, druppelende kaassaus en gloeiend kaasmos. Graaf naar beneden en vind de &eGatenkaasgrotten&r!",
  ],
  "quest.475548BDB1268F37.title": "Gloeiend kaasmos",
  "quest.475548BDB1268F37.quest_desc": [
    "Het kaasmos in de grotten gloeit zacht. Verzamel wat kaasmos: handig als lampje, en om &dstille knabbels&r te maken.",
  ],
  "quest.4755486C27EED7D7.title": "Knapperig!",
  "quest.4755486C27EED7D7.quest_desc": [
    "In de gatenkaas zit hier en daar &fkaaskorrelerts&r: knapperige kaaskristallen, net als in oude kaas. Hak er een paar uit.",
  ],
  "quest.475548D16B0420F9.title": "Knabbelen zonder kraken",
  "quest.475548D16B0420F9.quest_desc": [
    "Maak een &dstille knabbel&r (kaaskorrel + kaasknabbels + kaasmos) en eet hem op. Anderhalve minuut lang ben je &7Stil&r: niemand hoort je stappen, hakken of kauwen. Ook de Vadswaker niet!",
  ],
  "quest.47554833A41E871D.title": "Schacht 7: dicht!",
  "quest.47554833A41E871D.quest_desc": [
    "Ergens in de gatenkaas ligt een &everlaten kaasmijnschacht&r, met een karretje vol buit. Het superkompas (Ondergrond) weet de weg.",
  ],
  "quest.475548B1A1335FC5.title": "Sssst... niet knabbelen!",
  "quest.475548B1A1335FC5.quest_desc": [
    "Diep in de Gatenkaasgrotten verstoppen de Mika's al hun gestolen kaasknabbels: de &cStille Voorraadkelder&r. Pas op: &eknabbelsensoren&r horen je lopen, eten en hakken, en &eknabbelschreeuwers&r roepen dan NJEEEG! &6Sluipen&r is veilig.",
  ],
  "quest.475548DA54F61F26.title": "Het geheim van de kelder",
  "quest.475548DA54F61F26.quest_desc": [
    "In het midden van de kelder staat de Mika-voorraadschuur: een reuzenmikahoofd vol gestolen knabbels. Daarin ligt het &ddagboek van de Voorraadmika&r. Neem het mee (ook voor de bibliotheek!).",
  ],
  "quest.475548EBCF21ED38.title": "Wie knabbelt daar?",
  "quest.475548EBCF21ED38.quest_desc": [
    "Drie keer NJEEEG... en de &cVadswaker&r kruipt uit de kaas: een reuzenmika met een slaapmasker. Hij is blind, maar hij hoort je &6kauwen&r. Kom een keer in de buurt (van een veilige afstand!) voor je Guhdex. Wegrennen of sluipen, VAHOEG!",
  ],
  "quest.4755483017D15B15.title": "Vadswaker? Vadsslaper!",
  "quest.4755483017D15B15.quest_desc": [
    "Durf je het? Versla de Vadswaker. Hij is heel sterk, dus dit is echt niet verplicht. Een echte guh sluipt gewoon weg.",
  ],
  "quest.475548BB714ECD15.title": "Het Kaasmoeras",
  "quest.475548BB714ECD15.quest_desc": [
    "Ergens in de Guhmensie hangt een gele mist boven een drassig moeras vol borrelende kaassaus: het &eKaasmoeras&r. Stap erin (laarzen aan!).",
  ],
  "quest.475548087C391F07.title": "Boing, njeg!",
  "quest.475548087C391F07.quest_desc": [
    "Stap op &6borrelende kaassaus&r en je stuitert omhoog! Sluip om er rustig doorheen te waden. Vallen doet er nooit pijn.",
  ],
  "quest.47554862A9A9F35D.title": "Ahoy, knabbels!",
  "quest.47554862A9A9F35D.quest_desc": [
    "Op grote moerasplassen dobbert soms een &eknabbelvlotje&r met een roze vlaggetje. Klim erop en open de ton!",
  ],
  "quest.4755484301565311.title": "Kwaak-guh!",
  "quest.4755484301565311.quest_desc": [
    "Sta vlak naast een &akikkerguh&r voor je Guhdex. Ze zijn er in roze, mint en geel!",
  ],
  "quest.475548CAAA7670FD.title": "Mika-motjes",
  "quest.475548CAAA7670FD.quest_desc": [
    "'s Avonds fladderen &dkaasmotten&r rond kaas en lampjes, en ze pikken kaasknabbels die op de grond liggen. Zoek er een op voor je Guhdex.",
  ],
  "quest.475548774374C1E6.title": "Hap, slik, licht!",
  "quest.475548774374C1E6.quest_desc": [
    "Een kikkerguh hapt kaasmotten weg met zijn lange tong en spuugt dan een gloeiende &emotknabbel&r uit, in zijn eigen kleur.",
  ],
  "quest.4755488288C45FFD.title": "Alle kikkerkleurtjes",
  "quest.4755488288C45FFD.quest_desc": [
    "Heb een roze, een mint en een gele motknabbel tegelijk op zak.",
  ],
  "quest.47554884A4D88DE4.title": "Modderguhtje",
  "quest.47554884A4D88DE4.quest_desc": [
    "Wilde guhs in het Kaasmoeras zijn vaak groen-geel gevlekt: de &aKaasmoerasguh&r! Zoek er een en tem hem met kaasknabbels.",
  ],
  "quest.4755480BF232E809.title": "Een hut op pootjes",
  "quest.4755480BF232E809.quest_desc": [
    "Midden in het moeras staat een paalhut met een reuzenheksenhoed: het hoofd van de &5Moerasheks-Mika&r zelf! Het superkompas (Avontuur) wijst de weg.",
  ],
  "quest.47554874776259C0.title": "Bleh, onvahoeg",
  "quest.47554874776259C0.quest_desc": [
    "De Moerasheks-Mika gooit &2vadsverdrijvende drankjes&r. Word er eens door geraakt (het is maar even, njeg).",
  ],
  "quest.4755483E4F64A315.title": "Weg met die heks!",
  "quest.4755483E4F64A315.quest_desc": [
    "Versla de Moerasheks-Mika. Ze knabbelt haar eigen moeraskaas als ze pijn heeft, dus wees snel!",
  ],
  "quest.4755489E35B813D9.title": "Stinkend lekker",
  "quest.4755489E35B813D9.quest_desc": [
    "Verzamel &emoeraskaas&r van de Moerasheks-Mika (of uit haar kist). Goed voor de guhbrouwketel!",
  ],
  "quest.4755487322B1BF6E.title": "Heksenpagina",
  "quest.4755487322B1BF6E.quest_desc": [
    "Sta vlak naast de Moerasheks-Mika (durf je?) voor haar Guhdex-pagina.",
  ],
  "quest.4755482EDC0E46F3.title": "Het Vadswoud",
  "quest.4755482EDC0E46F3.quest_desc": [
    "Ergens in de Guhmensie staat een mistig, mintgroen woud vol &areuzenguhbomen&r: het &dVadswoud&r. Loop er eens doorheen en kijk goed naar de schors... zie je de guhgezichtjes?",
  ],
  "quest.4755482A2FA8AAF9.title": "Hoog in de bomen",
  "quest.4755482A2FA8AAF9.quest_desc": [
    "In het Vadswoud woont een dorp guhs in &aboomhutten&r, hoog in de reuzenguhbomen. Klim de wenteltrap op en loop over de touwbruggen! Het superkompas (Wonen) wijst de weg.",
  ],
  "quest.47554850E161BDC9.title": "De Boswachterguh",
  "quest.47554850E161BDC9.quest_desc": [
    "In de boswachterspost, hoog in de Moederboom, zit de &2Boswachterguh&r. Hij weet alles over guhfamilies en verkoopt vadshout, zaailingen en guhnestjes.",
  ],
  "quest.47554899AB0F03C8.title": "De Knabbelplukker",
  "quest.47554899AB0F03C8.quest_desc": [
    "Naast de bessentuin in het boomhutdorp woont de &6Knabbelplukker&r. Ze ruilt knabbelbessen tegen taartjes, nestjes en haar plukpakje.",
  ],
  "quest.4755489CC8161A33.title": "Knabbelbessen plukken",
  "quest.4755489CC8161A33.quest_desc": [
    "Knabbelbessenstruiken prikken niet! Rechtsklik op een struik met gele bessen om ze te plukken. Verzamel er 32.",
  ],
  "quest.475548A69A6C5ACC.title": "Vadsig taartje",
  "quest.475548A69A6C5ACC.quest_desc": [
    "Drie knabbelbessen, suiker en een kaasknabbel: bak een &6knabbelbessentaartje&r.",
  ],
  "quest.4755483AF996ED33.title": "Vadshout",
  "quest.4755483AF996ED33.quest_desc": [
    "Hak een reuzenguhboom om (of koop hout bij de Boswachterguh) en maak vadshoutplanken, een vadshoutdeur en een vadshouthek.",
  ],
  "quest.475548DD60221923.title": "Een boom van een guh",
  "quest.475548DD60221923.quest_desc": [
    "Plant vier vadshoutzaailingen in een vierkant en geef ze wat tijd (of beendermeel). Dan groeit er een echte &areuzenguhboom&r!",
  ],
  "quest.47554801DE28443D.title": "Guhfamilie",
  "quest.47554801DE28443D.quest_desc": [
    "Wilde guhs leven in gezinnetjes: een of twee ouders met babyguhs die in een rijtje achter hen aan lopen. Zoek een guhfamilie en loop met ze mee.",
  ],
  "quest.475548362DCDB875.title": "Klein maar vads",
  "quest.475548362DCDB875.quest_desc": [
    "Babyguhs zijn veel makkelijker te temmen dan grote guhs. Geef een wilde babyguh &eknabbelbessen&r of kaasknabbels.",
  ],
  "quest.4755489F338F2956.title": "Een eigen guhnestje",
  "quest.4755489F338F2956.quest_desc": [
    "Maak een &6guhnestje&r (stokjes, wol en een kaasknabbel) of koop er een bij de Boswachterguh.",
  ],
  "quest.475548B416E3723B.title": "Welterusten, guh",
  "quest.475548B416E3723B.quest_desc": [
    "Zet je guhnestje neer bij je tamme guhs. Als het nacht wordt, kruipen ze erin om te slapen. Zzz... VAHOEG!",
  ],
  "quest.47554823813278AE.title": "Boswachter in spe",
  "quest.47554823813278AE.quest_desc": [
    "Koop de &2boswachtershoed&r en de &2boswachtersjas&r bij de Boswachterguh en trek ze je guh aan.",
  ],
  "quest.47554892B8E217FF.title": "Plukker van het jaar",
  "quest.47554892B8E217FF.quest_desc": [
    "Ruil de &6plukmuts&r en het &6plukmandje&r bij de Knabbelplukker. Met het mandje op zijn rug ziet je guh er echt vads uit!",
  ],
  "quest.4755483626C731A2.title": "Het Bleekwoud",
  "quest.4755483626C731A2.quest_desc": [
    "Heel zeldzaam, ergens ver weg in de Guhmensie, ligt een bos waar al het roze uit is weggelopen: het &7Bleekwoud&r. Witte stammen, grijs mos, en het is er muisstil: er woont geen enkele guh. Zoek het op!",
  ],
  "quest.47554824FD22EF7C.title": "Bleekhout",
  "quest.47554824FD22EF7C.quest_desc": [
    "Hak een bleke boom om en maak &7bleekhoutplanken&r, een bleekhoutdeur en een bleekhoutbord. Eén zaailing wordt een klein boompje, vier in een vierkant een dikke boom.",
  ],
  "quest.4755489AFD61169A.title": "Oogje open",
  "quest.4755489AFD61169A.quest_desc": [
    "Overdag slapen de &7oogbloempjes&r. 's Nachts doen ze een voor een hun oogje open en worden ze &6oranje&r. Pluk er een terwijl hij open is!",
  ],
  "quest.4755484AA57EEFE3.title": "Krak... krak...",
  "quest.4755484AA57EEFE3.quest_desc": [
    "In sommige bomen zit een &6Krakend Guhhartje&r. 's Nachts wordt het wakker en roept het zijn &7Kraakguh&r: een guh van hout. Hij beweegt alleen als je NIET kijkt. Zoek er een op (binnen 8 blokjes) voor je Guhdex.",
  ],
  "quest.4755487A66D41494.title": "Een houten knuffel",
  "quest.4755487A66D41494.quest_desc": [
    "De Kraakguh is een guh, dus hij is lief: hij wil je alleen maar knuffelen. Draai je om, wacht even... &6Krak!&r Je wordt er een paar tellen traag van, meer niet.",
  ],
  "quest.475548063551719C.title": "Kaashars",
  "quest.475548063551719C.quest_desc": [
    "Geef een Kraakguh een tikje: hij voelt er niks van, maar uit de stam rond zijn hartje druipt &6kaashars&r. Schraap het van de boom. Negen maken een blok, en gesmolten wordt het een &6harssteen&r.",
  ],
  "quest.47554860713665DF.title": "Harsstenen",
  "quest.47554860713665DF.quest_desc": [
    "Smelt kaashars in een oven tot harsstenen en bouw er &6harsstenen&r mee: warm kaasgeel, met trappen, platen en muurtjes.",
  ],
  "quest.4755483D4C727EE1.title": "Hartje gebroken",
  "quest.4755483D4C727EE1.quest_desc": [
    "Wil je van een Kraakguh af? Zoek de boom waar het sprankelspoor naartoe gaat en hak het &6Krakend Guhhartje&r eruit. Met Zijden aanraking kun je het hartje meenemen en thuis tussen twee bleekhoutstammen zetten.",
  ],
  "quest.475548A7B0D47F51.title": "De Bleke Open Plek",
  "quest.475548A7B0D47F51.quest_desc": [
    "Midden in het Bleekwoud ligt een ronde open plek vol oogbloempjes, met een oeroude boom. Hoog in zijn stam klopt een hartje... Het superkompas (Avontuur) wijst de weg.",
  ],
  "quest.47554847F98AB392.title": "Het Houthakkershutje",
  "quest.47554847F98AB392.quest_desc": [
    "Iemand heeft hier gewoond: de &7Houthakkerguh&r. Zijn bijl zit nog in de stronk. Waar is hij gebleven? Het superkompas (Avontuur) wijst de weg.",
  ],
  "quest.475548025CB77A47.title": "Het dagboek",
  "quest.475548025CB77A47.quest_desc": [
    "Op de lessenaar in het hutje ligt het &ddagboek van de Houthakkerguh&r. Klik op de lessenaar: iedereen krijgt een eigen exemplaar.",
  ],
  "quest.475548CB5AF13CE7.title": "Zuur hartje, zure Mika",
  "quest.475548CB5AF13CE7.quest_desc": [
    "Een op de vijf hartjes is &averzuurd&r (geelgroen). Daar komt geen Kraakguh uit, maar een &cKraak-Mika&r: die komt je duwen als je niet kijkt. NJEG! Na een paar meppen kruipt hij terug in zijn boom.",
  ],
}
