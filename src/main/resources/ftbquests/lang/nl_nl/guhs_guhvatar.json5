{
  "chapter.475548BDEF1269EC.title": "&5De Guhvatar",
  "chapter.475548BDEF1269EC.chapter_subtitle": [
    "3.1. De Legende van Guh: lucht, water, aarde en vuur",
  ],
  "quest.4755489ACAE0D18E.title": "Hoe kom je hier?",
  "quest.4755489ACAE0D18E.quest_desc": [
    "Dit hoofdstuk hoort bij &5Verhalen van het Guheinde&r en komt na &dOPPER-GEVADST!&r: heb je Opper-Mika verslagen, dan wacht er een gloeiende &6kaasbol&r op je in het Guheinde.",
    "",
    "Hieronder staat het grote verhaal van de &5Guhvatar&r, van boven naar beneden: lucht, water, aarde, vuur en de komeet. Deze quests komen &cecht na elkaar&r.",
    "",
    "Alles wat je ernaast en daarna kunt doen (de Geestenwereld, de Witte Lotus, de zijpaden, Appa en de walvis) staat in &5Guhvatar: zijpaden&r.",
  ],
  "quest.475548C7558482E0.title": "De kaasbol",
  "quest.475548C7558482E0.quest_desc": [
    "Wie Opper-Mika heeft verslagen, ziet bij de Knabbelberg een &6gloeiende kaasbol&r aanspoelen. Tik hem open en kijk wie erin zat.",
  ],
  "quest.475548A9701734ED.title": "Jip jip!",
  "quest.475548A9701734ED.quest_desc": [
    "Vlieg op &dAppa-guh&r naar de &bZuidelijke Luchttempel&r. Je hoeft niet te zoeken: hij weet de weg.",
  ],
  "quest.4755481AEA21FDF5.title": "De Hal van de Guhvatars",
  "quest.4755481AEA21FDF5.quest_desc": [
    "In de hal staan de beelden van alle Guhvatars vóór jou. Twee van hen hebben je iets te vertellen.",
  ],
  "quest.47554839AA2D25C8.title": "Luchtbal",
  "quest.47554839AA2D25C8.quest_desc": [
    "Speel luchtbal tegen &dAang-guh&r op de palen. Guhatso is scheidsrechter. Eerst tot drie!",
  ],
  "quest.4755482D09C7C42F.title": "De luchtscooter-baan",
  "quest.4755482D09C7C42F.quest_desc": [
    "Stap op de streep onder de startboog en race op een luchtscooter de hele baan rond voordat de tijd om is. Zoeeef!",
  ],
  "quest.475548BD32FFB82C.title": "Zweven",
  "quest.475548BD32FFB82C.quest_desc": [
    "Spring van het zuidbalkon boven in de grote toren en zweef door de zes ringen. Eentje missen mag.",
  ],
  "quest.47554888BF921F00.title": "Achter Momo aan",
  "quest.47554888BF921F00.quest_desc": [
    "Een gloeiend lemurguhtje grist je knabbel. Volg hem en zijn spoor van wolkjes door de tempel, de torens op en over de bruggen.",
  ],
  "quest.475548BCD2AA528A.title": "Appa's stal",
  "quest.475548BCD2AA528A.quest_desc": [
    "Pak het zadel in Appa's stal, leg het op Appa en voer hem drie appels. Een blije Appa is een vliegende Appa.",
  ],
  "quest.4755480446808BF8.title": "Nog niet af",
  "quest.4755480446808BF8.quest_desc": [
    "Achter een dichte deur knutselt iemand. Wie? Dat hoor je wel. Of eigenlijk: dat hoor je nog niet.",
  ],
  "quest.475548B7ECBA1C3E.title": "Eindelijk, de Guhvatar",
  "quest.475548B7ECBA1C3E.quest_desc": [
    "Een Vuurnatie-schip ramt de steiger. Ontsnap op Appa en leer luchtsturen: het eerste van de vier elementen!",
  ],
  "quest.47554818784F7192.title": "De Noordelijke Waterstam",
  "quest.47554818784F7192.quest_desc": [
    "Vlieg met &dAppa&r naar de &6Noordelijke Waterstam&r: een stad van ijs en grachten achter een reusachtige ijsmuur. De poortwachter-guh is streng, maar heel vriendelijk als je je poten veegt.",
  ],
  "quest.47554882EDE700F2.title": "Een snor, alstublieft",
  "quest.47554882EDE700F2.quest_desc": [
    "Praat met &dMeester Pakguh&r op het trainingsplein. Hij leert het alleen aan guhs met een snor. Gelukkig is &dKatara-guh&r er ook.",
  ],
  "quest.475548053FBAF427.title": "De waterzweep",
  "quest.475548053FBAF427.quest_desc": [
    "Raak de &6vijf doelen&r op het trainingsplein met je kracht &bWaterzweep&r (de krachtentoets).",
  ],
  "quest.475548C3DDB96B7A.title": "Golven, geen gespetter",
  "quest.475548C3DDB96B7A.quest_desc": [
    "Maak &6drie golven&r in het golfbassin naast het plein met &bWatergolf&r.",
  ],
  "quest.475548352E8F0A9E.title": "De ijsbrug",
  "quest.475548352E8F0A9E.quest_desc": [
    "Ga op het eind van de steiger staan, kijk naar het eilandje en bevries een brug met &bIJsbrug&r. Loop dan naar de overkant.",
  ],
  "quest.475548377CF07D17.title": "Otter-surfen",
  "quest.475548377CF07D17.quest_desc": [
    "Klim op de ijsmuur west van de poort. Stap met een lege poot op de &dotter-pinguinguh&r bij de Glijkansel en glijd naar beneden.",
  ],
  "quest.4755484FD8C1D113.title": "De gondel",
  "quest.4755484FD8C1D113.quest_desc": [
    "Vanavond is het &6Maanfeest&r. Stap in de gondel in het bekken onder de grote trap en breng met &bWaterstroom&r de maanlantaarns naar de &6drie haltes&r.",
  ],
  "quest.475548CD0DCFB668.title": "Prinses Yue-guh",
  "quest.475548CD0DCFB668.quest_desc": [
    "Breng een bezoek aan &dprinses Yue-guh&r in het paleis. &dSokka-guh&r gaat mee. Toevallig.",
  ],
  "quest.47554876D9117935.title": "Rook boven de zee",
  "quest.47554876D9117935.quest_desc": [
    "Hoofdman Arnook-guh stuurt je naar de haven: kijk wat &cZhao-Mika&r met zijn schip van plan is. Kijk uit voor netten.",
  ],
  "quest.47554858C3983DE7.title": "De Blauwe Geest",
  "quest.47554858C3983DE7.quest_desc": [
    "Iemand met een blauw masker heeft je cel opengedaan. Sluip van het schip af. Blijf uit het licht van de wachters.",
  ],
  "quest.47554834E0FDC094.title": "De maanvis",
  "quest.47554834E0FDC094.quest_desc": [
    "Ga naar de &6geestenoase&r achter het paleis, door het deurtje in het ijs.",
  ],
  "quest.47554877FCB1E593.title": "Mediteren",
  "quest.47554877FCB1E593.quest_desc": [
    "Ga bij de vijver zitten (sluipen) en mediteer met &dAang-guh&r. Pas op voor verkeerde dimensies.",
  ],
  "quest.475548C4C3942FDD.title": "Toon geen emotie",
  "quest.475548C4C3942FDD.quest_desc": [
    "Zoek &dKoh de Gezichtenrover&r in de Geestenwereld: het pad zonder roze nevel leidt naar hem. Als hij je aankijkt: niet bewegen, niet springen, nergens op klikken.",
  ],
  "quest.4755481C5436C7EC.title": "De Hemelvijver",
  "quest.4755481C5436C7EC.quest_desc": [
    "Ga naar de &6Hemelvijver&r, waar Tui en La horen te zwemmen. Er zwemt er maar een.",
  ],
  "quest.475548A06C4A2DF3.title": "Tui terughalen",
  "quest.475548A06C4A2DF3.quest_desc": [
    "&6Tui, de maanvis&r, zit in een kooi aan boord van het schip van &cZhao-Mika&r. Sluip aan boord en steel hem terug.",
  ],
  "quest.47554824937D9A6D.title": "De maan",
  "quest.47554824937D9A6D.quest_desc": [
    "Breng de maanvis terug naar de vijver in de oase. &dYue-guh&r wacht daar.",
  ],
  "quest.475548284C705674.title": "De grote golf",
  "quest.475548284C705674.quest_desc": [
    "Klim naar de &6Golfkansel&r boven de poort. De oceaan wacht. Zachtjes, he.",
  ],
  "quest.475548C02FD04BE1.title": "De sneeuwstorm",
  "quest.475548C02FD04BE1.quest_desc": [
    "Volg het lichtje door de storm. Luister naar &dAppa&r. Hoofdstuk 2 is dan klaar: &dKatara-guh&r en &dSokka-guh&r reizen met je mee.",
  ],
  "quest.47554889B2CF7719.title": "Ba Sing Guh",
  "quest.47554889B2CF7719.quest_desc": [
    "Na de Waterstam vliegt Appa-guh je naar het Aarderijk. Land op de landingslob voor de reusachtige buitenmuur van &6Ba Sing Guh&r. Het verhaal begint vanzelf.",
  ],
  "quest.475548705EE469FC.title": "Paspoort, alstublieft",
  "quest.475548705EE469FC.quest_desc": [
    "Niemand komt binnen zonder stempel. Praat met de &dstrenge loketguh&r in het poortgebouw en beantwoord zijn vragen. Elk antwoord is goed. Echt.",
  ],
  "quest.4755480E121C1882.title": "De Aardrommel",
  "quest.4755480E121C1882.quest_desc": [
    "In de onderring wordt gevochten. Niemand raakt gewond, alleen een beetje gekiezeld. Ga naar de arena in het zuidwesten.",
  ],
  "quest.475548551324C288.title": "Zien met je voeten",
  "quest.475548551324C288.quest_desc": [
    "&dToph-guh&r, De Blinde Bandiet, leert je aardesturen: met je ogen dicht. Vind in haar oefenbaan de zes aardemunten. Bukken is stampen.",
  ],
  "quest.475548C1090ADAB6.title": "De monorail",
  "quest.475548C1090ADAB6.quest_desc": [
    "Neem de monorail van de buitenmuur naar de middenring. Elke sprong is een duw met aardesturen.",
  ],
  "quest.475548312D6883B4.title": "De Jasmijn Draak",
  "quest.475548312D6883B4.quest_desc": [
    "Ergens in de middenring ruikt het naar jasmijn. Zoek het theehuis van &dOom Miroh&r. De ober is... chagrijnig.",
  ],
  "quest.4755486207C044D9.title": "Geduld in een kopje",
  "quest.4755486207C044D9.quest_desc": [
    "Zet thee bij de grote ketel: water, blaadjes, schenken. Telkens precies op tijd klikken.",
  ],
  "quest.475548BA2CF7E327.title": "Een potje Pai Sho",
  "quest.475548BA2CF7E327.quest_desc": [
    "Om de beurt een tegel. Wie eerst een lotus legt, wint. Of je wint of niet: Oom Miroh heeft iets te zeggen.",
  ],
  "quest.47554869E62D4E81.title": "Geen knabbeltekort",
  "quest.47554869E62D4E81.quest_desc": [
    "&dJoo Dee-guh&r laat je de stad zien. Ze glimlacht heel veel.",
  ],
  "quest.475548A1AFBC1C26.title": "Appa's verloren dagen",
  "quest.475548A1AFBC1C26.quest_desc": [
    "Ga terug naar het kamp. Iets klopt er niet.",
  ],
  "quest.475548E5D95592E9.title": "De Aardekoning",
  "quest.475548E5D95592E9.quest_desc": [
    "Misschien weet de &dAardekoning-guh&r iets. Of zijn beer Bosco.",
  ],
  "quest.47554821B209F985.title": "Meer Laogai",
  "quest.47554821B209F985.quest_desc": [
    "Sluip de basis onder het meer binnen. Gezien worden = terug naar de hal, verder niets. Bukken helpt.",
  ],
  "quest.475548725E4BDD62.title": "Een lied voor Lu Ten",
  "quest.475548725E4BDD62.quest_desc": [
    "Oom Miroh is in gevaar. Waarschuw hem: hij is naar de heuvel met de kersenboom.",
  ],
  "quest.475548CF40A57A51.title": "De val van Ba Sing Guh",
  "quest.475548CF40A57A51.quest_desc": [
    "De Dai Li hebben Katara-guh en Zuka meegenomen naar de kristalcatacomben onder het paleis.",
  ],
  "quest.4755489691C7FA24.title": "De ontsnapping",
  "quest.4755489691C7FA24.quest_desc": [
    "Ba Sing Guh valt. Op Appa's rug vlucht je weg... en bij het kamp springt er nog iemand op. Daarna: op naar de Vuurnatie.",
  ],
  "quest.475548835D6D9A9D.title": "Vermomd in de Vuurnatie",
  "quest.475548835D6D9A9D.quest_desc": [
    "Appa-guh brengt het team naar de Vuurnatie-hoofdstad. Rode kleren aan, oortjes onder een hoofdband: niemand mag weten wie je bent.",
  ],
  "quest.4755482FC8904FAA.title": "Het schooltje",
  "quest.4755482FC8904FAA.quest_desc": [
    "Schuif aan in de klas van de Vuurnatie. Wie is de beste Vuurheer? Je weet het antwoord al, njeg.",
  ],
  "quest.475548D68D3B9409.title": "Het geheime dansfeest",
  "quest.475548D68D3B9409.quest_desc": [
    "Dansen is verboden in de Vuurnatie. In de grot achter het schooltje doen ze het toch. Sta op het oplichtende vak!",
  ],
  "quest.475548371940A5C5.title": "De schildpad-eendguhs",
  "quest.475548371940A5C5.quest_desc": [
    "Voer de schildpad-eendguhs in de paleisvijver. Ze bijten zachtjes. Uit liefde.",
  ],
  "quest.475548F643FFE2C0.title": "De Dag van de Zwarte Zon",
  "quest.475548F643FFE2C0.quest_desc": [
    "Acht minuten zonder vuur. De troonzaal is leeg, en diep onder het paleis zegt Zuka eindelijk wat hij vindt.",
  ],
  "quest.475548C1114AC00C.title": "De cel onder het paleis",
  "quest.475548C1114AC00C.quest_desc": [
    "Volg Zuka naar zijn oom. Miroh zegt niets. Maar hij doet wel opdrukjes.",
  ],
  "quest.4755481DEF87598E.title": "Een gast in het kamp",
  "quest.4755481DEF87598E.quest_desc": [
    "Zuka staat aan de rand van het kampvuur. Niemand vertrouwt hem. Toph-guh al helemaal niet.",
  ],
  "quest.475548A4E9C6BA06.title": "Goedmaken",
  "quest.475548A4E9C6BA06.quest_desc": [
    "Help Zuka de goede woorden te vinden, voor Toph-guh en voor Katara-guh.",
  ],
  "quest.475548FB6DD13D31.title": "Het Kokend Rotsblok",
  "quest.475548FB6DD13D31.quest_desc": [
    "Met Sokka-guh en Zuka naar de gevangenis in het kokende meer. Sluip langs de bewakers en bevrijd Suki-guh.",
  ],
  "quest.4755489278ED0186.title": "De Drakendans",
  "quest.4755489278ED0186.quest_desc": [
    "Dans voor de draakguhs van de Zonnekrijgers, stap voor stap. Dan leer je wat vuur echt is.",
  ],
  "quest.475548398C88BE7E.title": "De jongen in de kaasbol",
  "quest.475548398C88BE7E.quest_desc": [
    "Een toneelstuk over jullie avontuur. Het klopt van geen kant. Kijk het toch.",
  ],
  "quest.4755481FA42DC90A.title": "De tent van de Witte Lotus",
  "quest.4755481FA42DC90A.quest_desc": [
    "Zuka en Oom Miroh. Een tent, een pot thee, en een zin waar iedereen op heeft gewacht.",
  ],
  "quest.4755483042E6095D.title": "De Top der Voorgangers",
  "quest.4755483042E6095D.quest_desc": [
    "Fang vliegt je door de Geestenwereld naar de vorige Guhvatars. Ze hebben raad. En een paar grapjes.",
  ],
  "quest.475548A9BBA4973D.title": "De Leeuwschildpad-guh",
  "quest.475548A9BBA4973D.quest_desc": [
    "Je wordt 's nachts wakker op de rug van een eiland. Dat eiland heeft oortjes.",
  ],
  "quest.4755485759E156A0.title": "De luchtvloot",
  "quest.4755485759E156A0.quest_desc": [
    "Vlieg op Appa-guh door de brandende luchtschepen van Mikai. Het team haalt ze neer, jij stuurt.",
  ],
  "quest.475548BFADB59513.title": "Agni Kai",
  "quest.475548BFADB59513.quest_desc": [
    "Zuka en Azula-Mika op het voorplein van het paleis. Blauw vuur tegen rood.",
  ],
  "quest.47554894CE5BF026.title": "Het duel",
  "quest.47554894CE5BF026.quest_desc": [
    "Vier rondes op de rotspilaren, één voor elk element. En dan raakt de rots je oude litteken...",
  ],
  "quest.475548756C242427.title": "De kroning",
  "quest.475548756C242427.quest_desc": [
    "Een nieuwe Vuurheer. Vuurwerk. Thee.",
  ],
  "quest.47554851C0E1AD79.title": "De Guhvatar",
  "quest.47554851C0E1AD79.quest_desc": [
    "Het verhaal is verteld. Je krijgt je eigen standbeeld, met gloeiende ogen.",
  ],
}
