{
  "chapter.475548DCF11AE724.title": "&dBouwhulp",
  "chapter.475548DCF11AE724.chapter_subtitle": [
    "15. De Bouwkeet, de vormstaf, kwasten, blauwdrukken en dieren die bouwen",
  ],
  "quest.475548CAEC5BABFB.title": "Hoe kom je hier?",
  "quest.475548CAEC5BABFB.quest_desc": [
    "Dit hoofdstuk kan meteen: een Bouwkeet maak je met wol, een werkbank, stammen en kaasknabbels.",
    "",
    "Alles wat je bouwt staat eerst als &dspook&r neer. De &dBouwkeet&r bouwt het voor je, met materiaal uit je zakken, je Bank Guh of je kisten. Met &evadskracht&r groeit hij van Handwerk tot Gloeikeet.",
    "",
    "Daarna: de vormstaf, kwasten, blauwdrukken, en dieren uit het safaripark die voor je bouwen. Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.475548B7CA93DF77.title": "Een eigen Bouwkeet",
  "quest.475548B7CA93DF77.quest_desc": [
    "Maak een &dBouwkeet&r (gele en roze wol, een werkbank, stammen en kaasknabbels) en zet hem neer: een keetje van 3 bij 3 bij 3 met een kraantje op het dak. Klik erop voor het menu met tabbladen. Hier begint het bouwen!",
  ],
  "quest.47554803F0210A48.title": "De vormstaf",
  "quest.47554803F0210A48.quest_desc": [
    "Maak een &dvormstaf&r (twee stokjes en een amethistscherf). Klik ermee op een blok en je vorm staat er als &dspook&r: doorzichtig, nog niet echt. Houd linker &eAlt&r in voor het ronde menu met alle vormen en daken.",
  ],
  "quest.47554887FA9719A0.title": "Spookje wordt echt",
  "quest.47554887FA9719A0.quest_desc": [
    "Zet een spook neer (met de vormstaf of in de Bouwkeet), schuif hem op zijn plek en druk op &eBouw!&r. De blokken komen uit je zakken, je Bank Guh of je kisten. Als het af is, is er een feestje!",
  ],
  "quest.4755485A78C6D2FB.title": "Guhrad-keet",
  "quest.4755485A78C6D2FB.quest_desc": [
    "Maak een &dGuhrad-tandwieltje&r en klik ermee op je Bouwkeet. Met &evadskracht&r (10 VK) helpen je eigen guhs als &dbouwguhs&r, en pakt de keet materiaal uit alle kisten op zijn vadsnet.",
  ],
  "quest.475548795A6913F0.title": "Zoutkeet",
  "quest.475548795A6913F0.quest_desc": [
    "De &dZoutkristal-waterpas&r maakt een Zoutkeet (30 VK): natuurvormen, bloktekst en de &degaliseerder&r.",
  ],
  "quest.47554823FA08751A.title": "Sauskeet",
  "quest.47554823FA08751A.quest_desc": [
    "Het &dSaus-kraanhaakje&r maakt een Sauskeet (80 VK): de &dverfmachine&r, de &dtunnelboor&r en publiceren in de bibliotheek van de server.",
  ],
  "quest.4755488D81A05C01.title": "Gloeikeet... POF!",
  "quest.4755488D81A05C01.quest_desc": [
    "De &dGloei-bouwlamp&r maakt een Gloeikeet (200 VK): vormen en blauwdrukken tot 64 groot. En is al het materiaal er? Dan bouwt hij alles in één keer: &dPOF!&r",
  ],
  "quest.4755481AB4C606FF.title": "Verven maar",
  "quest.4755481AB4C606FF.quest_desc": [
    "Maak een &dvervangkwast&r: sluip-klik op een blok om het te kiezen, en elke klik verft een bolletje blokken om, in dezelfde vorm. Er zijn ook een meng-, een patroon- en een verweerkwast. Dierpatronen gaan open met je Safari-dex.",
  ],
  "quest.47554844EA7B71A6.title": "Op papier",
  "quest.47554844EA7B71A6.quest_desc": [
    "Kies &evastleggen&r in het menu van de vormstaf en klik twee hoeken van iets moois aan (of sluip-klik één keer op een gebouw). Zo wordt het een eigen &dblauwdruk&r.",
  ],
  "quest.4755486530927C16.title": "Het Ontwerpbureau",
  "quest.4755486530927C16.quest_desc": [
    "Maak een &dOntwerpbureau&r. Daar blader je door je eigen blauwdrukken, de catalogus met 25 ontwerpen en de bibliotheek van de server.",
  ],
  "quest.4755481D845812DE.title": "Een blauwdruk in je hand",
  "quest.4755481D845812DE.quest_desc": [
    "Druk aan het Ontwerpbureau een blauwdruk af (een vel papier). Klik ermee op een blok en het ontwerp staat er als spook. Hij raakt nooit op!",
  ],
  "quest.475548E77DB35A62.title": "Pastelbakstenen",
  "quest.475548E77DB35A62.quest_desc": [
    "In het creatieve tabblad &dGuhs: Bouwen&r staan meer dan 400 nieuwe bouwblokken. Maak een paar &droze pastelbakstenen&r: acht bakstenen rond een roze kleurstof.",
  ],
  "quest.475548700A6997D3.title": "Op werkuitje",
  "quest.475548700A6997D3.quest_desc": [
    "Klik op het &dverblijfsbord&r van een helperdier (bijvoorbeeld een bever, pinguïn of orang-oetan) en open de tab &eBouwopdracht&r. Kies een klus, zoek een plek en bevestig: de familie gaat op werkuitje en bouwt het voor je.",
  ],
  "quest.47554863AF850026.title": "Beverbaas",
  "quest.47554863AF850026.quest_desc": [
    "Laat je bevers &evijf beverdammen&r bouwen. Achter elke dam stijgt het water en ontstaat een beverpoel. Je krijgt de titel &6Beverbaas&r.",
  ],
  "quest.475548C98F32D883.title": "De Beverbeek",
  "quest.475548C98F32D883.quest_desc": [
    "Ergens in de Guhmensie ligt een zeldzaam beekjesbos van wilgen, elzen en berken, met wilde beverdammen. Vind de &dBeverbeek&r!",
  ],
  "quest.475548D6A9C71935.title": "Spaander",
  "quest.475548D6A9C71935.quest_desc": [
    "Heel soms staat er in de Beverbeek een &drangerpost&r. Daar woont Spaander, een bever die je niet kunt meenemen, maar wel lief kunt aaien. Aai hem!",
  ],
}
