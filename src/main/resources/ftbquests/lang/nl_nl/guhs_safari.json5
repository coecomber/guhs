{
  "chapter.4755486A3E24121B.title": "&6Op Safari!",
  "chapter.4755486A3E24121B.chapter_subtitle": [
    "14. Safaripark Vadse Bergen: spotten, fotograferen en speuren",
  ],
  "quest.475548780A582533.title": "Hoe kom je hier?",
  "quest.475548780A582533.quest_desc": [
    "Dit hoofdstuk komt na &dWelkom in de Guhmensie!&r in &dDe Guhmensie&r.",
    "",
    "Ergens in de Guhmensie staat een safari-busstation. Stap in de &6Guh-safaribus&r en hij brengt je naar &6Safaripark Vadse Bergen&r: een groot park vol lieve dieren in acht zones, plus Het Kriebelhuis.",
    "",
    "Spot ze, zet ze op de foto voor je &dSafari-dex&r, zoek de geheimpjes en help de rangers. Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.475548BB24B5BA99.title": "Klik!",
  "quest.475548BB24B5BA99.quest_desc": [
    "Maak in Safaripark Vadse Bergen je eerste foto van een dier. Hij komt meteen in je Safari-dex.",
  ],
  "quest.475548174D26C1D7.title": "Drie sterren!",
  "quest.475548174D26C1D7.quest_desc": [
    "Maak een foto van drie sterren: dichtbij, mooi in het midden, en het liefst terwijl het dier iets grappigs doet (slapen, eten, spelen...).",
  ],
  "quest.4755481DCDDF52C9.title": "Tien dieren",
  "quest.4755481DCDDF52C9.quest_desc": [
    "Zet tien verschillende dieren op de foto.",
  ],
  "quest.475548D28F06B055.title": "Vijfentwintig dieren",
  "quest.475548D28F06B055.quest_desc": [
    "Zet vijfentwintig verschillende dieren op de foto. Je bent al een halve ranger!",
  ],
  "quest.475548246548F7DC.title": "Een hele zone",
  "quest.475548246548F7DC.quest_desc": [
    "Fotografeer alle dieren van één zone. Haal daarna je zonebadge op bij de expert-guh in het expertenpaviljoen.",
  ],
  "quest.475548B2A168B47B.title": "Spoorzoeker",
  "quest.475548B2A168B47B.quest_desc": [
    "Sommige dieren verstoppen zich heel goed. Volg de pootafdrukjes (door een verrekijker lichten ze op) en fotografeer een verstopper, zoals de okapi, de das of de bever.",
  ],
  "quest.475548B969EAD2F7.title": "Safarikoning",
  "quest.475548B969EAD2F7.quest_desc": [
    "Zet elk dier in het park op de foto, ook die van het Kriebelhuis! Je krijgt de gouden safaricamera, het gouden dierenbeeld en de bon voor het verblijfsbord van de Gouden dikdik.",
  ],
  "quest.4755481736717BEB.title": "Psst, een geheimpje",
  "quest.4755481736717BEB.quest_desc": [
    "In elke zone van het park ligt een geheimpje verstopt. Vind er eentje!",
  ],
  "quest.475548FD3C08F646.title": "Speurneus",
  "quest.475548FD3C08F646.quest_desc": [
    "Vind alle acht de geheimpjes. Dan krijg je de geheimpjestrofee en de titel Speurneus.",
  ],
  "quest.475548D4CE0B5125.title": "Een zebra met oortjes?",
  "quest.475548D4CE0B5125.quest_desc": [
    "Volgens de hoofdranger loopt er een guh in een zelfgemaakt zebrapakje door het park. Vind hem, drie keer! Hij gaat daarna met je mee naar huis.",
  ],
  "quest.4755488A3766AA63.title": "De te vahe olifant",
  "quest.4755488A3766AA63.quest_desc": [
    "Dikkie de olifant past niet meer door zijn poortje. Help hem met een gezond dieetje en een rondje op de olifantenloopband.",
  ],
  "quest.475548692580E122.title": "Aaien maar!",
  "quest.475548692580E122.quest_desc": [
    "Doe een klusje in de aaihoek van het entreedorp: voeren, borstelen of de alpaca uitlaten.",
  ],
  "quest.475548BC7EBD016C.title": "Dieren thuis",
  "quest.475548BC7EBD016C.quest_desc": [
    "Staat een dier in je Safari-dex? Dan koop je in de giftshop een &dverblijfsbord&r. Zet hem neer en er komt een familie bij je wonen: een mannetje, een vrouwtje en twee kleintjes. Aaien, voeren en een speeltje maken ze blij!",
  ],
  "quest.4755488C65F21DF6.title": "Professor Kriebelguh",
  "quest.4755488C65F21DF6.quest_desc": [
    "In het entreedorp staat &dHet Kriebelhuis&r, vol kleine diertjes: een terrarium, de Kriebelzaal, de Nachtzaal en een roze tunnel onder de vijver. Fotografeer ze allemaal en haal je badge op bij Professor Kriebelguh in het expertenpaviljoen.",
  ],
}
