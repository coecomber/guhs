{
  "chapter.475548F3FBADFB6E.title": "&6De Guhbarbecuether",
  "chapter.475548F3FBADFB6E.chapter_subtitle": [
    "7. Heet, heter, njeg! Help de Grillguh",
  ],
  "quest.475548E99A05234B.title": "Hoe kom je hier?",
  "quest.475548E99A05234B.quest_desc": [
    "Dit hoofdstuk komt na &dWelkom in de Guhmensie!&r in &dDe Guhmensie&r.",
    "",
    "Daar liggen kapotte barbecues: de &6barbecueputten&r (superkompas: Barbecue > Barbecueput). In de grote put zit de &dGrillguh&r: de Mika's hebben zijn Aanmaakblokjes gejat!",
    "",
    "Maak zijn barbecue weer heel, steek dan zelf een grillkoolframe aan en stap de &6Guhbarbecuether&r in. Daar staan de Spiesburchten. Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.475548903D2CC46B.title": "Wie heeft hier gebarbecued?",
  "quest.475548903D2CC46B.quest_desc": [
    "Ergens in de Guhmensie liggen kapotte barbecues met een half grillkoolframe: de &6barbecueputten&r. Het superkompas (Barbecue > Barbecueput) wijst de weg.",
  ],
  "quest.475548109CF14ED4.title": "NJEG, mijn barbecue!",
  "quest.475548109CF14ED4.quest_desc": [
    "In de grote barbecueput zit de &dGrillguh&r. De Mika's hebben zijn Aanmaakblokjes gejat! Praat met hem.",
  ],
  "quest.475548617D7DEE71.title": "Zwart als houtskool",
  "quest.475548617D7DEE71.quest_desc": [
    "Laat &6kaassaus&r over een &8blok steenkool&r stromen: sssss... &8grillkool&r! Maak er een paar.",
  ],
  "quest.4755486661FEB05F.title": "Het frame weer heel",
  "quest.4755486661FEB05F.quest_desc": [
    "Zet grillkool in de gaten van het frame van de Grillguh (de gebarsten stenen moeten eruit) en vertel het hem.",
  ],
  "quest.475548D75B55D4F7.title": "Gejatte Aanmaakblokjes",
  "quest.475548D75B55D4F7.quest_desc": [
    "Ga naar een &cMika-kamp&r. Zolang je de Grillguh helpt, laat elke Mika die je daar verslaat een Aanmaakblokje vallen. Breng er een terug!",
  ],
  "quest.475548854F353678.title": "VAHOEG, hij brandt weer!",
  "quest.475548854F353678.quest_desc": [
    "Klik met een Aanmaakblokje in het grillkoolframe van de Grillguh. Zijn barbecue brandt weer, en je krijgt zijn geheime grillrecept!",
  ],
  "quest.4755489650471B98.title": "Chef Guh",
  "quest.4755489650471B98.quest_desc": [
    "Koop de Grillguh-koksmuts, het barbecueschort en het koksdoekje bij de Grillguh en trek ze je guh aan.",
  ],
  "quest.47554878051705A4.title": "Grillguh in de Guhdex",
  "quest.47554878051705A4.quest_desc": [
    "Ga vlak naast de Grillguh staan: dan komt hij in je Guhdex.",
  ],
  "quest.475548DC058D6F1D.title": "Het is hier heet, njeg!",
  "quest.475548DC058D6F1D.quest_desc": [
    "Steek een grillkoolframe (4x5 tot 23x23) in de Guhmensie aan met een Aanmaakblokje en stap de &6Guhbarbecuether&r in. Eén stap daar is acht stappen in de Guhmensie!",
  ],
  "quest.475548252EBF83A7.title": "Houtskoolvlakte",
  "quest.475548252EBF83A7.quest_desc": [
    "Bezoek het bioom &6Houtskoolvlakte&r in de Guhbarbecuether.",
  ],
  "quest.475548C0D817235B.title": "Satébos",
  "quest.475548C0D817235B.quest_desc": [
    "Bezoek het bioom &6Satébos&r in de Guhbarbecuether.",
  ],
  "quest.47554844A84A0EAC.title": "Worstenwoud",
  "quest.47554844A84A0EAC.quest_desc": [
    "Bezoek het bioom &6Worstenwoud&r in de Guhbarbecuether.",
  ],
  "quest.475548D57BAAA244.title": "Asdal",
  "quest.475548D57BAAA244.quest_desc": [
    "Bezoek het bioom &6Asdal&r in de Guhbarbecuether.",
  ],
  "quest.475548C208FE09FF.title": "Rookdelta",
  "quest.475548C208FE09FF.quest_desc": [
    "Bezoek het bioom &6Rookdelta&r in de Guhbarbecuether.",
  ],
  "quest.475548A0B5993233.title": "Frituurvads in een emmer",
  "quest.475548A0B5993233.quest_desc": [
    "Schep een emmer &6kaasfrituursaus&r uit een saus-zee. Heet!",
  ],
  "quest.475548E8E057443F.title": "Lekker warm licht",
  "quest.475548E8E057443F.quest_desc": [
    "Hak &6gloeikool&r van het plafond van de Barbecuether (met zijdezacht, of verzamel 4 gloeikoolgruis).",
  ],
  "quest.4755482B1A2684B8.title": "Te warm om te slapen",
  "quest.4755482B1A2684B8.quest_desc": [
    "Probeer in de Barbecuether in bed te gaan. Wat zegt je guh?",
  ],
  "quest.4755482C2809F860.title": "Barbecue-bouwer",
  "quest.4755482C2809F860.quest_desc": [
    "Maak houtskoolsteen stenen, roosterijzer tralies en een rookgat: bouw je eigen barbecue!",
  ],
  "quest.4755480991155DDC.title": "Een burcht vol spiesen",
  "quest.4755480991155DDC.quest_desc": [
    "Diep in de Barbecuether staan &6Spiesburchten&r: burchten van houtskoolsteen met lange bruggen. Het superkompas (Barbecue > Spiesburcht) weet er een.",
  ],
  "quest.4755483F45BF1559.title": "Van de grill gegrist",
  "quest.4755483F45BF1559.quest_desc": [
    "Versla een &6Vonk-Mika&r (bij zijn spawner in de Spiesburcht) en pak zijn &6grillspies&r.",
  ],
  "quest.4755482BC240D32B.title": "Knekel-Mika's",
  "quest.4755482BC240D32B.quest_desc": [
    "Versla 5 &8Knekel-Mika's&r. Ze wonen in de Spiesburcht en in het Asdal.",
  ],
  "quest.475548270CB71A9A.title": "De Guhbrouwketel",
  "quest.475548270CB71A9A.quest_desc": [
    "Maak een &6Guhbrouwketel&r (ijzer, roosterijzer tralies en een grillspies) en stook hem op met grillspiespoeder.",
  ],
  "quest.475548C0720DC8CC.title": "Guh-alchemist",
  "quest.475548C0720DC8CC.quest_desc": [
    "Kaassaus in de pan, een ingrediënt erdoor (knabbels, gloeikoolgruis, moeraskaas of Mika's vet, guhslijm) en vullen maar: brouw een Guhdrankje.",
  ],
  "quest.4755485659A76DFD.title": "Alle Guhdrankjes",
  "quest.4755485659A76DFD.quest_desc": [
    "Brouw ze allemaal: Vahoegheid, Rookloop, Sluipknabbel en Guhsprong.",
  ],
  "quest.4755480ED23B2480.title": "Hoofdzaak",
  "quest.4755480ED23B2480.quest_desc": [
    "Knekel-Mika's laten heel soms een &8verkoolde mikakop&r vallen. Verzamel er drie.",
  ],
  "quest.4755480E84F66AAD.title": "Doorgebakken!",
  "quest.4755480E84F66AAD.quest_desc": [
    "Zet 4 asblokken in een T en drie verkoolde mikakoppen erop: de &cAangebrande Mika&r wordt wakker! Versla hem voor de &6gloeister&r.",
  ],
  "quest.47554814EA49F152.title": "Een baken van knabbels",
  "quest.47554814EA49F152.quest_desc": [
    "Maak een &6Knabbelbaken&r (glas, de gloeister, grillkool), zet het op een piramide van knabbel- of vadsblokken en kies een guh-effect. Ook je guhs krijgen het!",
  ],
  "quest.47554893F38A1AE3.title": "Vahoeg naar huis",
  "quest.47554893F38A1AE3.quest_desc": [
    "Een zielige &7Rookguh&r zweeft rond in de Rookdelta. Voer hem kaasknabbels (of gooi ze naar hem) tot hij vahoeg naar huis zweeft.",
  ],
  "quest.475548624E51A122.title": "Rookguh-redder",
  "quest.475548624E51A122.quest_desc": [
    "Red 10 Rookguhs. Je Guhdex houdt bij hoeveel het er al zijn.",
  ],
  "quest.47554804C59A212D.title": "Wie heeft onze knabbels?",
  "quest.47554804C59A212D.quest_desc": [
    "Vind het &cMika-grillpaleis&r: een paleis van roosterijzer boven de kaasfrituursaus, vol gestolen kaasknabbels.",
  ],
  "quest.47554896CDEC0CA4.title": "Vads tegen buit",
  "quest.47554896CDEC0CA4.quest_desc": [
    "Draag iets van vahoege vads, dan laten de Nether-Mika's je met rust. Geef er een een vahoege vads-staaf: hij gooit je iets terug!",
  ],
  "quest.475548FF71E8F8E7.title": "Gloeiende wangetjes",
  "quest.475548FF71E8F8E7.quest_desc": [
    "In het Asdal woont de &7Asguh&r: grijs en roetig, met gloeiende wangetjes. Vuur doet hem niks. Tem er een!",
  ],
  "quest.475548A195F9CEA0.title": "De Barbecuether in de Guhdex",
  "quest.475548A195F9CEA0.quest_desc": [
    "Ga vlak naast een Rookguh, een Vonk-Mika, een Knekel-Mika en een Asguh staan.",
  ],
  "quest.475548D9FEBA099D.title": "Asguh-knuffel",
  "quest.475548D9FEBA099D.quest_desc": [
    "Geef een Asguh een kaasknabbel en zie hem gloeien van blijdschap.",
  ],
  "quest.475548D585541FDC.title": "Zo stil als een knabbel",
  "quest.475548D585541FDC.quest_desc": [
    "Drink een Guhdrankje. Probeer de Sluipknabbel eens: dan hoort niemand je meer.",
  ],
  "quest.475548E29569B020.title": "Bij de Mika's thuis",
  "quest.475548E29569B020.quest_desc": [
    "Ergens in de Guhbarbecuether staan de &6Mika-woonblokken&r: flats van roosterijzer met galerijen, waslijnen en een rokend ketelhuis. Het superkompas (Barbecue > Mika-woonblokken) wijst de weg. Er spawnen geen monsters.",
  ],
  "quest.4755480E981B93E9.title": "Mika-oma",
  "quest.4755480E981B93E9.quest_desc": [
    "Op de &dbovenste galerij&r van de hoge flat woont &6Mika-oma&r. Zij jat geen knabbels: ze breit en kookt worstsoep. Neem de trap in de westelijke toren en zeg eens hallo.",
  ],
  "quest.47554848F6F3F5A6.title": "Soep voor de mopperaars",
  "quest.47554848F6F3F5A6.quest_desc": [
    "Breng een kommetje soep naar &cBrom-Mika&r (westflat, begane grond), &cZeur-Mika&r (oostflat, tweede verdieping) en &cSnurk-Mika&r (hoge flat, tweede verdieping). Rechtsklik ze met de soep.",
  ],
  "quest.4755489D05449468.title": "Weggewaaid!",
  "quest.4755489D05449468.quest_desc": [
    "Het breiwerk van Mika-oma is van de galerij gewaaid. Het ligt op de &ddaktuin&r van de lage oostflat: neem de trap in de oostelijke toren. Rechtsklik het breimandje.",
  ],
  "quest.47554842CE2D8485.title": "Soep van oma",
  "quest.47554842CE2D8485.quest_desc": [
    "Breng het breiwerk terug naar Mika-oma. Ze breit er meteen een muts van, en de Nether-Mika's geven je voortaan &6korting&r: elke derde ruil krijg je je staaf terug.",
  ],
  "quest.475548754EA6DF87.title": "Gebreide Mika-muts",
  "quest.475548754EA6DF87.quest_desc": [
    "Een donkerrode muts met een crèmekleurig randje en twee gebreide hoorntjes. Houd hem vast (rechtsklik ingedrukt) om hem te ontgrendelen en trek hem je guh aan in de kledingkast!",
  ],
  "quest.475548D610A39960.title": "Dat hoort oma!",
  "quest.475548D610A39960.quest_desc": [
    "Ruil na de soep van Mika-oma drie keer met een &cNether-Mika&r (een vahoege-vadsstaaf geven): de derde keer gooit hij je staaf terug.",
  ],
  "quest.47554848A3BC41B1.title": "Knor!",
  "quest.47554848A3BC41B1.quest_desc": [
    "De &6Mika-stal&r: een rode schuur met een modderige wei, waar de Mika's hun &dWorstzwijntjes&r houden. Het superkompas (Barbecue > Mika-stal) weet er een.",
  ],
  "quest.4755485C5A893339.title": "De Stalknecht-guh",
  "quest.4755485C5A893339.quest_desc": [
    "Voor de grote staldeur staat de &6Stalknecht-guh&r. Een guh, bij de Mika's! Praat met hem.",
  ],
  "quest.4755483581F2EC9C.title": "Rustig maar, njeg",
  "quest.4755483581F2EC9C.quest_desc": [
    "De Worstzwijntjes stuiteren van de zenuwen. &dAai&r er drie kalm: rechtsklik met een lege hand, drie aaitjes per zwijntje.",
  ],
  "quest.47554840E6F01578.title": "Smakken maar!",
  "quest.47554840E6F01578.quest_desc": [
    "Schep de zak &6zwijnenvoer&r van de Stalknecht-guh leeg in de voerbak, achter in het gangpad van de stal.",
  ],
  "quest.475548CA389C1BAC.title": "Knorretje is zoek!",
  "quest.475548CA389C1BAC.quest_desc": [
    "Knorretje is ontsnapt. Zoek hem bij de wei (achter de hooibalen, bij de kar of op de hooizolder), &dsluip&r naar hem toe en til hem op. Breng hem naar de Stalknecht-guh: je krijgt twee Worstzwijntjes in een mandje!",
  ],
  "quest.475548ACDA684EE8.title": "Het Worstzwijntje in de Guhdex",
  "quest.475548ACDA684EE8.quest_desc": [
    "Ga vlak naast een &dWorstzwijntje&r staan: een braadworstje op pootjes met een streep mosterd over zijn rug. Het komt in je Guhdex.",
  ],
  "quest.475548114698B411.title": "Twee nieuwe huisgenoten",
  "quest.475548114698B411.quest_desc": [
    "Zet de mandjes thuis neer: je Worstzwijntjes zijn boerderijdiertjes. Aaien, borstelen (guhborstel) en voeren (knabbelvoer of een gevulde voerbak) maakt ze blij. Met knabbelvoer krijgen ze kleintjes.",
  ],
  "quest.475548ED05E89A3B.title": "Snuf snuf",
  "quest.475548ED05E89A3B.quest_desc": [
    "Een &dblij&r Worstzwijntje (twee soorten zorg op één dag) snuffelt elke dag iets voor je op: knabbels, zwammetjes, soms zelfs iets zeldzaams uit de Barbecuether.",
  ],
  "quest.475548C2A7837F36.title": "Door de bek van de Mika",
  "quest.475548C2A7837F36.quest_desc": [
    "Het &6Mika-brugpaleis&r is een lange tolbrug hoog boven de saus. Je loopt er binnen door de open bek van een reusachtige Mika. Het superkompas (Barbecue > Mika-brugpaleis) wijst de weg.",
  ],
  "quest.47554806AFF8F02D.title": "HALT! Tol!",
  "quest.47554806AFF8F02D.quest_desc": [
    "In de bek zit de &cTolwachter-Mika&r. Praat met hem.",
  ],
  "quest.47554857146896BE.title": "Knabbels of raadsels",
  "quest.47554857146896BE.quest_desc": [
    "Betaal &68 kaasknabbels&r tol, of raad &ddrie raadsels&r goed. Fout geraden? Dan krijg je gewoon een ander raadsel.",
  ],
  "quest.47554829770D6716.title": "Mika-kwaliteit",
  "quest.47554829770D6716.quest_desc": [
    "De brug is kapot (alweer). Leg de vijf planken van de Tolwachter in het gat: rechtsklik met een plank, vlak bij het gat. Erin gevallen? Onder het gat hangt een steiger met een ladder.",
  ],
  "quest.4755482D35B8984C.title": "DONG!",
  "quest.4755482D35B8984C.quest_desc": [
    "Loop over de gemaakte brug naar de klokkentoren en luid de &6tolbel&r. Schiet op: na een minuutje vallen de planken er weer uit.",
  ],
  "quest.475548302ECD859C.title": "Tolvrij!",
  "quest.475548302ECD859C.quest_desc": [
    "Ga terug naar de Tolwachter-Mika. Je mag voortaan altijd gratis door, en je krijgt de &6bouwtekening&r van de brug met planken en touwleuning.",
  ],
  "quest.47554836074C3471.title": "Raadselkoning",
  "quest.47554836074C3471.quest_desc": [
    "Raad drie raadsels van de Tolwachter-Mika goed (in plaats van tol te betalen). Njeg njeg njeg!",
  ],
  "quest.47554835793D89AE.title": "Je eigen Mika-brug",
  "quest.47554835793D89AE.quest_desc": [
    "Met de &6bouwtekening&r in je werkbank maak je &dMika-brugplanken&r (planken en touw) en &dtouwleuning&r (stokjes en touw). De tekening blijft gewoon liggen.",
  ],
  "quest.475548E113A26CC7.title": "De Wachter-guh",
  "quest.475548E113A26CC7.quest_desc": [
    "In de hal van elke &6Spiesburcht&r staat naast het beeld een wachthokje. Daarin staat de &6Wachter-guh&r: helm op, spies in de poot. Zeg eens hallo (hij schrikt een beetje).",
  ],
  "quest.47554844AE89E0DE.title": "Vier brugvuren",
  "quest.47554844AE89E0DE.quest_desc": [
    "De Vonk-Mika's hebben de brugvuren uitgeblazen! Op elke brug staat een vuurkorf op een sokkel. Rechtsklik ze alle vier met de &6aansteekspies&r van de Wachter-guh. Jouw vuren blijven voor jou branden.",
  ],
  "quest.475548C5396CF11A.title": "Melden bij de wachter",
  "quest.475548C5396CF11A.quest_desc": [
    "Alle vier de vuren branden. Ga het de Wachter-guh vertellen: hij heeft nog een klusje.",
  ],
  "quest.4755481E36D9CF22.title": "Mikakruid wieden",
  "quest.4755481E36D9CF22.quest_desc": [
    "Het &dpindasaus-tuintje&r (één trap omhoog, midden in de burcht) staat vol paars, prikkerig &5Mikakruid&r. Klik op elke pol om hem eruit te trekken.",
  ],
  "quest.47554839B8470EF2.title": "Ere-wachter",
  "quest.47554839B8470EF2.quest_desc": [
    "Vuren aan, tuintje netjes. Haal bij de Wachter-guh je beloning: het &blantaarnrecept&r, twee Zielige lantaarntjes en het wachterspak voor je guh.",
  ],
  "quest.475548259C13240D.title": "Zielig lantaarntje",
  "quest.475548259C13240D.quest_desc": [
    "Met het &blantaarnrecept&r in je werkbank (het blijft liggen): 6 ijzerklompjes, gloeikoolgruis en lichtblauwe verf. Het lantaarntje kijkt zielig, tot je het aait (rechtsklik).",
  ],
  "quest.4755489119B72063.title": "Het wachterspak",
  "quest.4755489119B72063.quest_desc": [
    "Een ijzeren helm met een satépluim en een roetzwarte mantel met een gloeiende zoom. Houd ze vast (rechtsklik ingedrukt) om ze te ontgrendelen voor de kledingkast.",
  ],
  "quest.47554864BA1D32C2.title": "De gevangen Knuffelmaker-guh",
  "quest.47554864BA1D32C2.quest_desc": [
    "Op de eerste verdieping van elk &cMika-grillpaleis&r, naast de kooien met gestolen knuffelguhs, zit de &dKnuffelmaker-guh&r in zijn naaihoek. Hij moet Mika-sokken stoppen. Praat met hem (zachtjes).",
  ],
  "quest.4755482872EF2618.title": "Drie knuffels bevrijden",
  "quest.4755482872EF2618.quest_desc": [
    "Open de drie kooien. Het losgeld is &6één vahoege vads&r per knuffel (rechtsklik de kooi ermee). Of &7sluip&r (bukken) en peuter het slot los als geen Nether-Mika kijkt: drie keer klikken. Betrapt? Dan krijg je alleen een duw. Een Sluipknabbeldrankje helpt!",
  ],
  "quest.47554888DF61782F.title": "Draad voor de naadjes",
  "quest.47554888DF61782F.quest_desc": [
    "De Mika's hebben aan de knuffels getrokken. Breng de Knuffelmaker-guh &f4 draad&r: je krijgt drie knuffels en zijn &dknuffelpatroon&r.",
  ],
  "quest.4755486D305224B5.title": "Een bed vol knuffels",
  "quest.4755486D305224B5.quest_desc": [
    "Met het &dknuffelpatroon&r in je werkbank naai je ze zelf: 5 wol (roze, zwart of lichtgrijs) en een draad. Verzamel de Knuffelguh, de Knuffel-Mika en de Knuffel-Rookguh. Knijp er maar in!",
  ],
  "quest.4755488BA52C1D52.title": "Op kousenvoetjes",
  "quest.4755488BA52C1D52.quest_desc": [
    "Peuter een knuffelkooi open &7zonder te betalen&r en zonder dat een Nether-Mika je ziet.",
  ],
  "quest.475548FE7F1B4205.title": "Botten in de as",
  "quest.475548FE7F1B4205.quest_desc": [
    "Ergens in de Guhbarbecuether graaft de &dArcheoloog-guh&r het skelet van een reuzenguh op: de &6Fossiel-opgraving&r. Het superkompas (Barbecue > Fossiel-opgraving) wijst de weg.",
  ],
  "quest.47554801C0717267.title": "De vondst van de eeuw",
  "quest.47554801C0717267.quest_desc": [
    "Praat met de &dArcheoloog-guh&r bij zijn tent. Je krijgt een &6Guhkwastje&r van hem.",
  ],
  "quest.47554885828EBD37.title": "Kwasten maar!",
  "quest.47554885828EBD37.quest_desc": [
    "Houd met het Guhkwastje rechtsklik ingedrukt op het &6bottenzand&r in de put (daar steekt een puntje bot uit de as). Elk plekje geeft jou één bot; vijf botten heb je nodig. Iedereen vindt zijn eigen botten, ook als er al iemand kwastte.",
  ],
  "quest.47554833DED29961.title": "Bot voor bot",
  "quest.47554833DED29961.quest_desc": [
    "Klik met de botten op het &6rek&r onder het afdakje. Alleen jij ziet jouw skelet groeien.",
  ],
  "quest.4755486A24815FA9.title": "Tyrannoguhrus Njex",
  "quest.4755486A24815FA9.quest_desc": [
    "Vertel de Archeoloog-guh dat hij staat! Je krijgt een &6Tyrannoguhrus-beeldje&r en mag het kwastje houden.",
  ],
  "quest.475548D733D0BB61.title": "Elke dag een botje",
  "quest.475548D733D0BB61.quest_desc": [
    "Na het skelet ligt er in elk plekje bottenzand elke dag weer iets voor jou: een botje, wat knabbels, soms een zoutkristal. Kwast er eentje los!",
  ],
  "quest.475548F85974C742.title": "Njex op de kast",
  "quest.475548F85974C742.quest_desc": [
    "Zet je Tyrannoguhrus-beeldje ergens neer waar iedereen het ziet.",
  ],
  "quest.4755486B3D981C48.title": "Een berg van zout",
  "quest.4755486B3D981C48.quest_desc": [
    "Een witte berg vol kristallen op de bodem van een grot: de &6Zoutkristalmijn&r. Het superkompas (Barbecue > Zoutkristalmijn) wijst de weg.",
  ],
  "quest.475548BC4D60E9A3.title": "Wat een puinhoop",
  "quest.475548BC4D60E9A3.quest_desc": [
    "Praat met de &dMijnwerker-guh&r bij zijn schuurtje voor de mijn.",
  ],
  "quest.4755484C252239FB.title": "Het spoor vrij",
  "quest.4755484C252239FB.quest_desc": [
    "Hak vijf brokken &6puin&r van het karrenspoor in de gangen. (Het puin valt na een minuutje weer terug voor de volgende speler: jouw vijf tellen gewoon.)",
  ],
  "quest.475548C65C9CFFDD.title": "De kristalader",
  "quest.475548C65C9CFFDD.quest_desc": [
    "Volg het spoor tot in de grot en hak met een houweel in de roze &6kristalader&r.",
  ],
  "quest.475548E47950336A.title": "Zout op de boterham",
  "quest.475548E47950336A.quest_desc": [
    "Breng drie zoutkristallen naar de Mijnwerker-guh. Je krijgt zijn &6Zoutkristalhouweel&r: daarmee geeft de ader twee keer zoveel.",
  ],
  "quest.4755485ABE20F56A.title": "Een zak zout",
  "quest.4755485ABE20F56A.quest_desc": [
    "De kristalader is van iedereen een beetje: elke speler heeft er een eigen voorraad in, die vanzelf weer aangroeit. Verzamel 16 &6zoutkristallen&r: daarmee begint de Guh-technologie met zout.",
  ],
  "quest.475548A25A7F35A4.title": "Zoute bouwstenen",
  "quest.475548A25A7F35A4.quest_desc": [
    "Vier zoutkristallen maken een &6zoutkristalblok&r: het geeft zacht licht. Maak er een paar.",
  ],
  "quest.475548E775826A98.title": "De Sausloper-stal",
  "quest.475548E775826A98.quest_desc": [
    "Ergens langs de frituursauszee staat een stal met een koperen dak en twee roze guh-oren. Daar woont de &6Verzorger-guh&r met zijn &6Sauslopers&r. Je &dSuperkompas&r wijst de weg (tab Barbecue).",
  ],
  "quest.4755482B76DE0A2D.title": "Pindasaus aan een stok",
  "quest.4755482B76DE0A2D.quest_desc": [
    "Praat met de &6Verzorger-guh&r. Hij geeft je &6pindasaus aan een stok&r: daar loopt elke Sausloper vahoeg achteraan.",
  ],
  "quest.475548B992D25437.title": "Kom maar, langpoot!",
  "quest.475548B992D25437.quest_desc": [
    "Houd de stok vast en lok een Sausloper uit de sausbak naar de Verzorger-guh. Zie je hem bibberen op het droge? Koude pootjes, njeg.",
  ],
  "quest.4755482084D701C7.title": "Vriendschap gaat door de maag",
  "quest.4755482084D701C7.quest_desc": [
    "Voer een Sausloper van de stal drie &6pindascheutjes&r. De Verzorger-guh geeft je de eerste drie. Daarna vertrouwt hij je.",
  ],
  "quest.4755482D8D8CD6BC.title": "Het proefrondje",
  "quest.4755482D8D8CD6BC.quest_desc": [
    "Vraag om je proefrit. Er komt een gezadelde Sausloper naar de steiger, speciaal voor jou. Stap op, houd de stok vast en rijd door de vier poortjes. Hij loopt waar jij heen kijkt.",
  ],
  "quest.4755487B0C1FBF6F.title": "Sausloper-vriend",
  "quest.4755487B0C1FBF6F.quest_desc": [
    "Haal je &6zadel&r op bij de Verzorger-guh. Vanaf nu durven de wilde Sauslopers op de sauszee ook naar je toe.",
  ],
  "quest.4755487431B4A064.title": "Lange poten, klein hartje",
  "quest.4755487431B4A064.quest_desc": [
    "Zoek een wilde &6Sausloper&r op de frituursauszee en voer hem pindascheutjes tot hij hartjes geeft. Zadel erop, stok in je hand: nu steek je de sauszee zo over. Sluip en klik om hem te laten wachten.",
  ],
  "quest.47554897AEE84717.title": "Wie stapt daar door de saus?",
  "quest.47554897AEE84717.quest_desc": [
    "Kijk een &6Sausloper&r van dichtbij aan: dan staat hij in je &dGuhdex&r.",
  ],
  "quest.47554827284D9EF9.title": "Sausracer",
  "quest.47554827284D9EF9.quest_desc": [
    "Na de les klokt de Verzorger-guh elk rondje. Haal de finish in &6dertig seconden&r of minder. Tip: rechtsklik met de stok voor een sprintje.",
  ],
  "quest.4755487AF7CC9383.title": "Blub?",
  "quest.4755487AF7CC9383.quest_desc": [
    "In de Guhbarbecuether stuiteren &6Sausblubjes&r rond: blubjes saus met een korstje en een snoet. Kijk er een van dichtbij aan voor je &dGuhdex&r. Ze doen niks, ze blubben alleen.",
  ],
  "quest.475548FE8754A46C.title": "Een knuffel te veel",
  "quest.475548FE8754A46C.quest_desc": [
    "Geef een groot Sausblubje een knuffel (rechtsklik met een lege hand) of een kaasknabbel. Het splitst van blijdschap in twee kleinere blubjes.",
  ],
  "quest.4755486F7A2C9E25.title": "Blubroom",
  "quest.4755486F7A2C9E25.quest_desc": [
    "Elke keer dat een Sausblubje splitst blijft er een klodder &6blubroom&r liggen. Een klein blubje groeit van drie knabbels weer een maatje, dus een hokje blubjes blijft blubben.",
  ],
  "quest.475548C9E8FC5632.title": "Blubje to go",
  "quest.475548C9E8FC5632.quest_desc": [
    "Een &6klein&r Sausblubje past precies in een glazen flesje (rechtsklik). Zo neem je het mee naar huis. De uitvinder-guh weet er vast ook raad mee...",
  ],
  "quest.475548A2793D82AC.title": "Boing!",
  "quest.475548A2793D82AC.quest_desc": [
    "Roer blubroom door een pan kaasbouillon in de &6Guhbrouwketel&r en tap een &6Stuiterdrankje&r. Drie minuten lang val je niet meer: je stuitert. Sluipen is landen.",
  ],
  "quest.47554884D886C06F.title": "Tentjes in de as",
  "quest.47554884D886C06F.quest_desc": [
    "Ergens in de Guhbarbecuether staat een heel dorp van tentjes rond een groot kampvuur: de &6Grillcamping&r. Het superkompas (Barbecue > Grillcamping) wijst de weg.",
  ],
  "quest.475548531B556A4C.title": "Welkom op de camping",
  "quest.475548531B556A4C.quest_desc": [
    "Praat met de &dKampbaas-guh&r in de receptie (het huisje met het puntdak). Je krijgt een &6tentzak&r van hem.",
  ],
  "quest.4755487D9A03545D.title": "Plof, een tent!",
  "quest.4755487D9A03545D.quest_desc": [
    "Klik met de tentzak op een bordje &6VRIJ&r (op het gele gras bij de poort) en sla daarna de vier &6haringen&r van je tent vast: klik op de ijzeren pennen. Staat er overal al een tent? Die gaan na een paar minuten vanzelf weer de zak in.",
  ],
  "quest.4755483754CC0EEB.title": "Tjak! Tjak!",
  "quest.4755483754CC0EEB.quest_desc": [
    "Vraag de &dHouthakker-guh&r bij de houtschuur om brandhout en klik zes keer op een &6hakblok&r. Je krijgt een bos brandhout.",
  ],
  "quest.475548744A9DAC98.title": "Het kampvuurfeest",
  "quest.475548744A9DAC98.quest_desc": [
    "Gooi de bos brandhout op het &6grote kampvuur&r midden op de camping. De kampeerguhs komen erbij zitten en gaan dansen!",
  ],
  "quest.47554871269AD3BD.title": "Goudbruin!",
  "quest.47554871269AD3BD.quest_desc": [
    "Haal de &6Roosterstok&r bij de Kampbaas-guh. Houd rechtsklik ingedrukt op het brandende kampvuur en laat los als de marshmallow &6goudbruin&r is (te vroeg is koud, te laat is zwart: dan probeer je het gewoon opnieuw). Drie goudbruine, en vertel het hem: je krijgt het &dkampeerpakje&r en de &6receptkaart van de Plantagebak&r.",
  ],
  "quest.475548830DB65386.title": "Kennismaken met de buren",
  "quest.475548830DB65386.quest_desc": [
    "Op de camping wonen vijf kampeerguhs. Klik er eentje aan voor een praatje. (Ze horen bij de camping: temmen kan niet.)",
  ],
  "quest.475548EBFD90C5FB.title": "Marshmallows voor altijd",
  "quest.475548EBFD90C5FB.quest_desc": [
    "De Roosterstok werkt boven &6elk&r brandend kampvuur, ook thuis en ook overdag. Rooster er een goudbruin! (Je hebt marshmallowknabbels nodig: stokje + suiker + kaasknabbel.)",
  ],
  "quest.47554886E3C2B859.title": "Een tent voor thuis",
  "quest.47554886E3C2B859.quest_desc": [
    "Van &6tentdoek&r (wol + draad) bouw je je eigen tent: de schuine stukken zijn het dak. Maak acht schuine stukken in een kleur naar keuze.",
  ],
  "quest.47554829C3FC0A32.title": "Kraampjes in het donker",
  "quest.47554829C3FC0A32.quest_desc": [
    "Gestreepte kraampjes rond een grote tent met een weegschaal: de &6Nether-Mika-ruilmarkt&r. Het superkompas (Barbecue > Nether-Mika-ruilmarkt) wijst de weg.",
  ],
  "quest.475548FED4908288.title": "De Marktmeester",
  "quest.475548FED4908288.quest_desc": [
    "Praat met de &dMarktmeester-Mika&r op zijn spreekgestoelte voor de Waag.",
  ],
  "quest.4755485F8DEDBBCC.title": "Leer afdingen",
  "quest.4755485F8DEDBBCC.quest_desc": [
    "Praat nog eens met hem en ding af van 30 naar 10 knabbels. Lees goed wat hij zegt: &6schept hij op&r, geef dan een compliment; &6zucht hij&r, bied dan laag; &6gromt hij&r over zijn laatste bod, doe dan alsof je wegloopt. Drie keer fout en hij stuurt je weg (dan begin je gewoon opnieuw).",
  ],
  "quest.4755489C183EC7F4.title": "De nepvads",
  "quest.4755489C183EC7F4.quest_desc": [
    "In de Waag liggen vijf stapels vads. Eén is &6nep&r en nepvads is lichter. Klik op twee stapels om ze te wegen; klik daarna met de &6Keurstempel&r op de neppe. (Welke nep is, is voor iedereen anders. Fout gestempeld? Dan wisselt de oplichter ze om.)",
  ],
  "quest.47554892433E2AF3.title": "Ontmaskerd!",
  "quest.47554892433E2AF3.quest_desc": [
    "Vertel het de Marktmeester-Mika. Je krijgt de &6weegschaal&r en voortaan een extraatje bij elke ruil met een Nether-Mika.",
  ],
  "quest.4755486E4AF37D45.title": "Vads erin, verrassing eruit",
  "quest.4755486E4AF37D45.quest_desc": [
    "De &dkraam-Mika's&r van de markt ruilen meteen: geef er een een staaf &6vahoege vads&r en je krijgt je verrassing. Geen gesnuffel, en ze doen je niks.",
  ],
  "quest.47554860AF9FEAAE.title": "Een extraatje, mjauw",
  "quest.47554860AF9FEAAE.quest_desc": [
    "Ruil na de questlijn met een Nether-Mika (op de markt of in het wild, door de staaf in zijn poot te geven): je krijgt er een tweede cadeautje bij.",
  ],
  "quest.47554811611D6829.title": "Het koopje van de dag",
  "quest.47554811611D6829.quest_desc": [
    "Elke dag kun je bij de Marktmeester-Mika opnieuw afdingen. Win je, dan krijg je het koopje van de dag.",
  ],
  "quest.475548E0CAEC8653.title": "De Rookguh-vuurtoren",
  "quest.475548E0CAEC8653.quest_desc": [
    "Ergens in de rook staat een rood-witte toren met twee roze guh-oren op zijn dak. Daar woont de &6Torenwachter-guh&r. Zijn lamp is uit... Je &dSuperkompas&r wijst de weg (tab Barbecue).",
  ],
  "quest.475548459D7EF34A.title": "Ahoi, njeg!",
  "quest.475548459D7EF34A.quest_desc": [
    "Praat met de &6Torenwachter-guh&r. Zonder licht vinden de Rookguhs de weg naar huis niet meer.",
  ],
  "quest.47554874772C9D68.title": "Kooltjes voor de lamp",
  "quest.47554874772C9D68.quest_desc": [
    "Breng hem vier &6gloeikoolgruis&r (hak gloeikool stuk). Hij perst er een &6lampkooltje&r van, en je mag zijn &6seinlantaarn&r lenen.",
  ],
  "quest.47554865D8FA61CF.title": "Floep!",
  "quest.47554865D8FA61CF.quest_desc": [
    "Klim de wenteltrap op, helemaal tot in het glazen lampenhuis, en leg het lampkooltje in de lamp. TOEEET!",
  ],
  "quest.4755481C0068C4ED.title": "Drie verdwaalde Rookguhs",
  "quest.4755481C0068C4ED.quest_desc": [
    "Rond de toren zweven drie magere &6verdwaalde Rookguhs&r, speciaal van jou (met een sterretje erboven). Loop ernaartoe met de seinlantaarn in je poot: ze zweven achter je aan tot ze het licht zien. Zes kaasknabbels voeren mag ook.",
  ],
  "quest.475548A4A9C5A600.title": "Lampaansteker",
  "quest.475548A4A9C5A600.quest_desc": [
    "Ga terug naar de Torenwachter-guh. Je krijgt een &6Bezorgguhtje-fluitje&r en een &6wachtersjas&r voor je guh.",
  ],
  "quest.4755484E71378B5C.title": "Fiet-fiew!",
  "quest.4755484E71378B5C.quest_desc": [
    "Het &6Bezorgguhtje-fluitje&r roept het Bezorgguhtje van je eigen Stepstation naar je toe. Sluipen en fluiten stuurt ze allemaal naar huis. Kwijt? De Torenwachter-guh snijdt elke dag een nieuwe.",
  ],
  "quest.47554831BDB3CF5D.title": "Wachtersjas",
  "quest.47554831BDB3CF5D.quest_desc": [
    "Een donkerblauwe jas met gouden knopen en een rood-witte kraag. Houd hem vast (rechtsklik ingedrukt) om hem te ontgrendelen en trek hem je guh aan in de kledingkast!",
  ],
  "quest.4755483C7EF60BB8.title": "Een lamp voor thuis",
  "quest.4755483C7EF60BB8.quest_desc": [
    "Maak je eigen &6vuurtorenlamp&r (roosterijzer tralies, glas en gloeikool). Hij floept aan zodra er iemand in de buurt is die de echte vuurtoren heeft aangestoken. Jij dus.",
  ],
  "quest.475548175E26304F.title": "De Pepertuin",
  "quest.475548175E26304F.quest_desc": [
    "Een glazen kas midden in de Guhbarbecuether, met een tuin vol pepers ernaast en een guh-vogelverschrikker. Daar woont de &6Peperteler-guh&r. Je &dSuperkompas&r wijst de weg (tab Barbecue).",
  ],
  "quest.4755485060A6E631.title": "Eén plantje, drie pepers",
  "quest.4755485060A6E631.quest_desc": [
    "Praat met de &6Peperteler-guh&r. Hij geeft je drie &6peperzaadjes&r.",
  ],
  "quest.475548FFB1E0BB02.title": "Groen, rood en roze",
  "quest.475548FFB1E0BB02.quest_desc": [
    "In de kas staan drie &6kweekbakken&r. Plant in elke bak een zaadje, wacht tot je plantje rijp is en pluk het. Jouw plantjes zijn alleen van jou.",
  ],
  "quest.475548AF0726536F.title": "Vuur in je buik",
  "quest.475548AF0726536F.quest_desc": [
    "Brouw je eerste &6peperdrankje&r in de Guhbrouwketel achter in de kas: poeder, kaassaus, een rode of roze peper erdoor en een flesje vullen. De Peperteler-guh geeft je alles wat je nodig hebt.",
  ],
  "quest.475548A2928EF4A3.title": "Peperbrouwer",
  "quest.475548A2928EF4A3.quest_desc": [
    "Laat de Peperteler-guh proeven. Je krijgt &6zaadjes&r voor thuis, het &6andere drankje&r en een &6peperslinger&r voor je guh.",
  ],
  "quest.4755489938277C57.title": "Pluktuin",
  "quest.4755489938277C57.quest_desc": [
    "Een rijpe peperplant pluk je met een &6rechtsklik&r: de plant blijft staan en groeit gewoon door. Probeer het in de kijkbedden van de kas.",
  ],
  "quest.4755487C205DEA29.title": "Je eigen pepertuin",
  "quest.4755487C205DEA29.quest_desc": [
    "Plant peperzaadjes op &6as-aarde&r (groene Njegpeper), &6gloeikool&r (rode Vahoegpeper) en &6pindasaus-nylium&r (roze Snoeppeper). Zet er &bglas&r boven: dan groeien ze drie keer zo snel. Zaadjes krijg je als je een rijpe plant uitgraaft.",
  ],
  "quest.47554841003C845A.title": "Pepervuurdrankje",
  "quest.47554841003C845A.quest_desc": [
    "Kaasbouillon met een &cVahoegpeper&r. Drie minuten lang hak en graaf je als een vuurtje, met vlammetjes uit je snoet (&6Peperadem&r: je hebt het nooit meer koud).",
  ],
  "quest.475548AD89F3548F.title": "Peperzoetdrankje",
  "quest.475548AD89F3548F.quest_desc": [
    "Kaasbouillon met een &dSnoeppeper&r. Een warm, zoet gevoel: je geneest een beetje en krijgt twee hartjes erbij.",
  ],
  "quest.4755480036673571.title": "Heet! Heet! Heet!",
  "quest.4755480036673571.quest_desc": [
    "Eet een &crauwe Vahoegpeper&r. Je rent er tien seconden vahoeg van, met rook uit je oren. Niemand zei dat het slim was, njeg.",
  ],
  "quest.475548A5C33735FD.title": "Peperslinger",
  "quest.475548A5C33735FD.quest_desc": [
    "Een slinger van rode, groene en roze pepers. Houd hem vast (rechtsklik ingedrukt) om hem te ontgrendelen en hang hem je guh om in de kledingkast!",
  ],
}
