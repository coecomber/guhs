{
  "chapter.475548F3FBADFB6E.title": "&6De Guhbarbecuether",
  "chapter.475548F3FBADFB6E.chapter_subtitle": [
    "7. Heet, heter, njeg! Help de Grillguh",
  ],
  "quest.475548E99A05234B.title": "Hoe kom je hier?",
  "quest.475548E99A05234B.quest_desc": [
    "Dit hoofdstuk komt na &dWelkom in de Guhmensie!&r in &dDe Guhmensie&r.",
    "",
    "Daar liggen kapotte barbecues: de &6barbecueputten&r (superkompas: Barbecue > Barbecueput). In de grote put zit de &dGrillguh&r: de Mika's hebben zijn Aanmaakblokjes gejat!",
    "",
    "Maak zijn barbecue weer heel, steek dan zelf een grillkoolframe aan en stap de &6Guhbarbecuether&r in. Daar staan de Spiesburchten. Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.475548903D2CC46B.title": "Wie heeft hier gebarbecued?",
  "quest.475548903D2CC46B.quest_desc": [
    "Ergens in de Guhmensie liggen kapotte barbecues met een half grillkoolframe: de &6barbecueputten&r. Het superkompas (Barbecue > Barbecueput) wijst de weg.",
  ],
  "quest.475548109CF14ED4.title": "NJEG, mijn barbecue!",
  "quest.475548109CF14ED4.quest_desc": [
    "In de grote barbecueput zit de &dGrillguh&r. De Mika's hebben zijn Aanmaakblokjes gejat! Praat met hem.",
  ],
  "quest.475548617D7DEE71.title": "Zwart als houtskool",
  "quest.475548617D7DEE71.quest_desc": [
    "Laat &6kaassaus&r over een &8blok steenkool&r stromen: sssss... &8grillkool&r! Maak er een paar.",
  ],
  "quest.4755486661FEB05F.title": "Het frame weer heel",
  "quest.4755486661FEB05F.quest_desc": [
    "Zet grillkool in de gaten van het frame van de Grillguh (de gebarsten stenen moeten eruit) en vertel het hem.",
  ],
  "quest.475548D75B55D4F7.title": "Gejatte Aanmaakblokjes",
  "quest.475548D75B55D4F7.quest_desc": [
    "Ga naar een &cMika-kamp&r. Zolang je de Grillguh helpt, laat elke Mika die je daar verslaat een Aanmaakblokje vallen. Breng er een terug!",
  ],
  "quest.475548854F353678.title": "VAHOEG, hij brandt weer!",
  "quest.475548854F353678.quest_desc": [
    "Klik met een Aanmaakblokje in het grillkoolframe van de Grillguh. Zijn barbecue brandt weer, en je krijgt zijn geheime grillrecept!",
  ],
  "quest.4755489650471B98.title": "Chef Guh",
  "quest.4755489650471B98.quest_desc": [
    "Koop de Grillguh-koksmuts, het barbecueschort en het koksdoekje bij de Grillguh en trek ze je guh aan.",
  ],
  "quest.47554878051705A4.title": "Grillguh in de Guhdex",
  "quest.47554878051705A4.quest_desc": [
    "Ga vlak naast de Grillguh staan: dan komt hij in je Guhdex.",
  ],
  "quest.475548DC058D6F1D.title": "Het is hier heet, njeg!",
  "quest.475548DC058D6F1D.quest_desc": [
    "Steek een grillkoolframe (4x5 tot 23x23) in de Guhmensie aan met een Aanmaakblokje en stap de &6Guhbarbecuether&r in. Eén stap daar is acht stappen in de Guhmensie!",
  ],
  "quest.475548252EBF83A7.title": "Houtskoolvlakte",
  "quest.475548252EBF83A7.quest_desc": [
    "Bezoek het bioom &6Houtskoolvlakte&r in de Guhbarbecuether.",
  ],
  "quest.475548C0D817235B.title": "Satébos",
  "quest.475548C0D817235B.quest_desc": [
    "Bezoek het bioom &6Satébos&r in de Guhbarbecuether.",
  ],
  "quest.47554844A84A0EAC.title": "Worstenwoud",
  "quest.47554844A84A0EAC.quest_desc": [
    "Bezoek het bioom &6Worstenwoud&r in de Guhbarbecuether.",
  ],
  "quest.475548D57BAAA244.title": "Asdal",
  "quest.475548D57BAAA244.quest_desc": [
    "Bezoek het bioom &6Asdal&r in de Guhbarbecuether.",
  ],
  "quest.475548C208FE09FF.title": "Rookdelta",
  "quest.475548C208FE09FF.quest_desc": [
    "Bezoek het bioom &6Rookdelta&r in de Guhbarbecuether.",
  ],
  "quest.475548A0B5993233.title": "Frituurvads in een emmer",
  "quest.475548A0B5993233.quest_desc": [
    "Schep een emmer &6kaasfrituursaus&r uit een saus-zee. Heet!",
  ],
  "quest.475548E8E057443F.title": "Lekker warm licht",
  "quest.475548E8E057443F.quest_desc": [
    "Hak &6gloeikool&r van het plafond van de Barbecuether (met zijdezacht, of verzamel 4 gloeikoolgruis).",
  ],
  "quest.4755482B1A2684B8.title": "Te warm om te slapen",
  "quest.4755482B1A2684B8.quest_desc": [
    "Probeer in de Barbecuether in bed te gaan. Wat zegt je guh?",
  ],
  "quest.4755482C2809F860.title": "Barbecue-bouwer",
  "quest.4755482C2809F860.quest_desc": [
    "Maak houtskoolsteen stenen, roosterijzer tralies en een rookgat: bouw je eigen barbecue!",
  ],
  "quest.4755480991155DDC.title": "Een burcht vol spiesen",
  "quest.4755480991155DDC.quest_desc": [
    "Diep in de Barbecuether staan &6Spiesburchten&r: burchten van houtskoolsteen met lange bruggen. Het superkompas (Barbecue > Spiesburcht) weet er een.",
  ],
  "quest.4755483F45BF1559.title": "Van de grill gegrist",
  "quest.4755483F45BF1559.quest_desc": [
    "Versla een &6Vonk-Mika&r (bij zijn spawner in de Spiesburcht) en pak zijn &6grillspies&r.",
  ],
  "quest.4755482BC240D32B.title": "Knekel-Mika's",
  "quest.4755482BC240D32B.quest_desc": [
    "Versla 5 &8Knekel-Mika's&r. Ze wonen in de Spiesburcht en in het Asdal.",
  ],
  "quest.475548270CB71A9A.title": "De Guhbrouwketel",
  "quest.475548270CB71A9A.quest_desc": [
    "Maak een &6Guhbrouwketel&r (ijzer, roosterijzer tralies en een grillspies) en stook hem op met grillspiespoeder.",
  ],
  "quest.475548C0720DC8CC.title": "Guh-alchemist",
  "quest.475548C0720DC8CC.quest_desc": [
    "Kaassaus in de pan, een ingrediënt erdoor (knabbels, gloeikoolgruis, moeraskaas of Mika's vet, guhslijm) en vullen maar: brouw een Guhdrankje.",
  ],
  "quest.4755485659A76DFD.title": "Alle Guhdrankjes",
  "quest.4755485659A76DFD.quest_desc": [
    "Brouw ze allemaal: Vahoegheid, Rookloop, Sluipknabbel en Guhsprong.",
  ],
  "quest.4755480ED23B2480.title": "Hoofdzaak",
  "quest.4755480ED23B2480.quest_desc": [
    "Knekel-Mika's laten heel soms een &8verkoolde mikakop&r vallen. Verzamel er drie.",
  ],
  "quest.4755480E84F66AAD.title": "Doorgebakken!",
  "quest.4755480E84F66AAD.quest_desc": [
    "Zet 4 asblokken in een T en drie verkoolde mikakoppen erop: de &cAangebrande Mika&r wordt wakker! Versla hem voor de &6gloeister&r.",
  ],
  "quest.47554814EA49F152.title": "Een baken van knabbels",
  "quest.47554814EA49F152.quest_desc": [
    "Maak een &6Knabbelbaken&r (glas, de gloeister, grillkool), zet het op een piramide van knabbel- of vadsblokken en kies een guh-effect. Ook je guhs krijgen het!",
  ],
  "quest.47554893F38A1AE3.title": "Vahoeg naar huis",
  "quest.47554893F38A1AE3.quest_desc": [
    "Een zielige &7Rookguh&r zweeft rond in de Rookdelta. Voer hem kaasknabbels (of gooi ze naar hem) tot hij vahoeg naar huis zweeft.",
  ],
  "quest.475548624E51A122.title": "Rookguh-redder",
  "quest.475548624E51A122.quest_desc": [
    "Red 10 Rookguhs. Je Guhdex houdt bij hoeveel het er al zijn.",
  ],
  "quest.47554804C59A212D.title": "Wie heeft onze knabbels?",
  "quest.47554804C59A212D.quest_desc": [
    "Vind het &cMika-grillpaleis&r: een paleis van roosterijzer boven de kaasfrituursaus, vol gestolen kaasknabbels.",
  ],
  "quest.47554896CDEC0CA4.title": "Vads tegen buit",
  "quest.47554896CDEC0CA4.quest_desc": [
    "Draag iets van vahoege vads, dan laten de Nether-Mika's je met rust. Geef er een een vahoege vads-staaf: hij gooit je iets terug!",
  ],
  "quest.475548FF71E8F8E7.title": "Gloeiende wangetjes",
  "quest.475548FF71E8F8E7.quest_desc": [
    "In het Asdal woont de &7Asguh&r: grijs en roetig, met gloeiende wangetjes. Vuur doet hem niks. Tem er een!",
  ],
  "quest.475548A195F9CEA0.title": "De Barbecuether in de Guhdex",
  "quest.475548A195F9CEA0.quest_desc": [
    "Ga vlak naast een Rookguh, een Vonk-Mika, een Knekel-Mika en een Asguh staan.",
  ],
  "quest.475548D9FEBA099D.title": "Asguh-knuffel",
  "quest.475548D9FEBA099D.quest_desc": [
    "Geef een Asguh een kaasknabbel en zie hem gloeien van blijdschap.",
  ],
  "quest.475548D585541FDC.title": "Zo stil als een knabbel",
  "quest.475548D585541FDC.quest_desc": [
    "Drink een Guhdrankje. Probeer de Sluipknabbel eens: dan hoort niemand je meer.",
  ],
  "quest.475548E0CAEC8653.title": "De Rookguh-vuurtoren",
  "quest.475548E0CAEC8653.quest_desc": [
    "Ergens in de rook staat een rood-witte toren met twee roze guh-oren op zijn dak. Daar woont de &6Torenwachter-guh&r. Zijn lamp is uit... Je &dSuperkompas&r wijst de weg (tab Barbecue).",
  ],
  "quest.475548459D7EF34A.title": "Ahoi, njeg!",
  "quest.475548459D7EF34A.quest_desc": [
    "Praat met de &6Torenwachter-guh&r. Zonder licht vinden de Rookguhs de weg naar huis niet meer.",
  ],
  "quest.47554874772C9D68.title": "Kooltjes voor de lamp",
  "quest.47554874772C9D68.quest_desc": [
    "Breng hem vier &6gloeikoolgruis&r (hak gloeikool stuk). Hij perst er een &6lampkooltje&r van, en je mag zijn &6seinlantaarn&r lenen.",
  ],
  "quest.47554865D8FA61CF.title": "Floep!",
  "quest.47554865D8FA61CF.quest_desc": [
    "Klim de wenteltrap op, helemaal tot in het glazen lampenhuis, en leg het lampkooltje in de lamp. TOEEET!",
  ],
  "quest.4755481C0068C4ED.title": "Drie verdwaalde Rookguhs",
  "quest.4755481C0068C4ED.quest_desc": [
    "Rond de toren zweven drie magere &6verdwaalde Rookguhs&r, speciaal van jou (met een sterretje erboven). Loop ernaartoe met de seinlantaarn in je poot: ze zweven achter je aan tot ze het licht zien. Zes kaasknabbels voeren mag ook.",
  ],
  "quest.475548A4A9C5A600.title": "Lampaansteker",
  "quest.475548A4A9C5A600.quest_desc": [
    "Ga terug naar de Torenwachter-guh. Je krijgt een &6Bezorgguhtje-fluitje&r en een &6wachtersjas&r voor je guh.",
  ],
  "quest.4755484E71378B5C.title": "Fiet-fiew!",
  "quest.4755484E71378B5C.quest_desc": [
    "Het &6Bezorgguhtje-fluitje&r roept het Bezorgguhtje van je eigen Stepstation naar je toe. Sluipen en fluiten stuurt ze allemaal naar huis. Kwijt? De Torenwachter-guh snijdt elke dag een nieuwe.",
  ],
  "quest.47554831BDB3CF5D.title": "Wachtersjas",
  "quest.47554831BDB3CF5D.quest_desc": [
    "Een donkerblauwe jas met gouden knopen en een rood-witte kraag. Houd hem vast (rechtsklik ingedrukt) om hem te ontgrendelen en trek hem je guh aan in de kledingkast!",
  ],
  "quest.4755483C7EF60BB8.title": "Een lamp voor thuis",
  "quest.4755483C7EF60BB8.quest_desc": [
    "Maak je eigen &6vuurtorenlamp&r (roosterijzer tralies, glas en gloeikool). Hij floept aan zodra er iemand in de buurt is die de echte vuurtoren heeft aangestoken. Jij dus.",
  ],
  "quest.475548175E26304F.title": "De Pepertuin",
  "quest.475548175E26304F.quest_desc": [
    "Een glazen kas midden in de Guhbarbecuether, met een tuin vol pepers ernaast en een guh-vogelverschrikker. Daar woont de &6Peperteler-guh&r. Je &dSuperkompas&r wijst de weg (tab Barbecue).",
  ],
  "quest.4755485060A6E631.title": "Eén plantje, drie pepers",
  "quest.4755485060A6E631.quest_desc": [
    "Praat met de &6Peperteler-guh&r. Hij geeft je drie &6peperzaadjes&r.",
  ],
  "quest.475548FFB1E0BB02.title": "Groen, rood en roze",
  "quest.475548FFB1E0BB02.quest_desc": [
    "In de kas staan drie &6kweekbakken&r. Plant in elke bak een zaadje, wacht tot je plantje rijp is en pluk het. Jouw plantjes zijn alleen van jou.",
  ],
  "quest.475548AF0726536F.title": "Vuur in je buik",
  "quest.475548AF0726536F.quest_desc": [
    "Brouw je eerste &6peperdrankje&r in de Guhbrouwketel achter in de kas: poeder, kaassaus, een rode of roze peper erdoor en een flesje vullen. De Peperteler-guh geeft je alles wat je nodig hebt.",
  ],
  "quest.475548A2928EF4A3.title": "Peperbrouwer",
  "quest.475548A2928EF4A3.quest_desc": [
    "Laat de Peperteler-guh proeven. Je krijgt &6zaadjes&r voor thuis, het &6andere drankje&r en een &6peperslinger&r voor je guh.",
  ],
  "quest.4755489938277C57.title": "Pluktuin",
  "quest.4755489938277C57.quest_desc": [
    "Een rijpe peperplant pluk je met een &6rechtsklik&r: de plant blijft staan en groeit gewoon door. Probeer het in de kijkbedden van de kas.",
  ],
  "quest.4755487C205DEA29.title": "Je eigen pepertuin",
  "quest.4755487C205DEA29.quest_desc": [
    "Plant peperzaadjes op &6as-aarde&r (groene Njegpeper), &6gloeikool&r (rode Vahoegpeper) en &6pindasaus-nylium&r (roze Snoeppeper). Zet er &bglas&r boven: dan groeien ze drie keer zo snel. Zaadjes krijg je als je een rijpe plant uitgraaft.",
  ],
  "quest.47554841003C845A.title": "Pepervuurdrankje",
  "quest.47554841003C845A.quest_desc": [
    "Kaasbouillon met een &cVahoegpeper&r. Drie minuten lang hak en graaf je als een vuurtje, met vlammetjes uit je snoet (&6Peperadem&r: je hebt het nooit meer koud).",
  ],
  "quest.475548AD89F3548F.title": "Peperzoetdrankje",
  "quest.475548AD89F3548F.quest_desc": [
    "Kaasbouillon met een &dSnoeppeper&r. Een warm, zoet gevoel: je geneest een beetje en krijgt twee hartjes erbij.",
  ],
  "quest.4755480036673571.title": "Heet! Heet! Heet!",
  "quest.4755480036673571.quest_desc": [
    "Eet een &crauwe Vahoegpeper&r. Je rent er tien seconden vahoeg van, met rook uit je oren. Niemand zei dat het slim was, njeg.",
  ],
  "quest.475548A5C33735FD.title": "Peperslinger",
  "quest.475548A5C33735FD.quest_desc": [
    "Een slinger van rode, groene en roze pepers. Houd hem vast (rechtsklik ingedrukt) om hem te ontgrendelen en hang hem je guh om in de kledingkast!",
  ],
}
