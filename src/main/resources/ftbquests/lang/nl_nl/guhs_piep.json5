{
  "chapter.4755482B3333A144.title": "&dPiep!",
  "chapter.4755482B3333A144.chapter_subtitle": [
    "9. Pieppiepmuisjes en zielige knabbels",
  ],
  "quest.47554856CE8506B3.title": "Hoe kom je hier?",
  "quest.47554856CE8506B3.quest_desc": [
    "Dit hoofdstuk komt na &6Het superkompas&r in &dDe Guhmensie&r.",
    "",
    "In de lieve guhhuizen van de Guhmensie wonen piepkleine &5pieppiepmuisjes&r, en ergens staat een kaaskorstheuvel vol &6boze kaasknabbels&r (superkompas: Avontuur). &2Schilly&r en &2Poepschilly&r vind je bij &9Onderwater&r!",
    "",
    "Piep piep! Niks zit op slot: elke quest vinkt zichzelf af zodra je hem gedaan hebt, ook als je dat al eerder deed. De kopjes laten zien wat logisch na elkaar komt. Vink dit af en ga lekker vadsig aan de slag!",
  ],
  "quest.4755481E85BC9590.title": "Piep piep!",
  "quest.4755481E85BC9590.quest_desc": [
    "Er wonen piepkleine &5pieppiepmuisjes&r in de lieve guhhuizen van de Guhmensie. Ga naar een guhhuis, zoek een muisje (luister naar het gepiep!) en aai het met een lege hand.",
  ],
  "quest.475548F32F32432C.title": "Een eigen muisje",
  "quest.475548F32F32432C.quest_desc": [
    "Geef een muisje een &6kaasknabbel&r. Soms eet het meteen uit je hand en is het van jou. Een muisje rent trouwens ook naar knabbels die op de grond liggen!",
  ],
  "quest.475548D485787C2E.title": "Muisje mee",
  "quest.475548D485787C2E.quest_desc": [
    "Sluip en rechtsklik je eigen muisje (of kies &dOppakken&r in zijn menuutje): je pakt het op, met naam en al. Rechtsklik ermee in de lucht en het zit op je schouder! Sluip + rechtsklik op een blok (lege hand) en het hopt eraf.",
  ],
  "quest.475548D218D36E4A.title": "Verstoppertje",
  "quest.475548D218D36E4A.quest_desc": [
    "Je muisje verstopt zich soms in een bloempot, een mandje of een ton in de buurt, en piept tot je het vindt. Rechtsklik op de plek waar het piept! Vind het &d3 keer&r.",
  ],
  "quest.47554801C0A788AA.title": "Het kaasknabbel-nest",
  "quest.47554801C0A788AA.quest_desc": [
    "Ergens in de Guhmensie staat een kaaskorstheuvel vol gaten: het &6kaasknabbel-nest&r. Het superkompas (categorie Avontuur) wijst de weg.",
  ],
  "quest.47554824513BDCD6.title": "Boze knabbels",
  "quest.47554824513BDCD6.quest_desc": [
    "Versla 10 boze kaasknabbels. Ze zijn eigenlijk... zieli.",
  ],
  "quest.4755488913C61428.title": "Hij was gewoon zieli",
  "quest.4755488913C61428.quest_desc": [
    "Stap op de gouden kern in het nest, versla drie golven boze kaasknabbels en daarna de &cBoze Oppernabbel&r. Pas op voor zijn stamp: spring!",
  ],
  "quest.475548D44BDF23C4.title": "Het geheime recept",
  "quest.475548D44BDF23C4.quest_desc": [
    "In de schatkist van het nest ligt het recept van de Roze Guh Koek. Rechtsklik het om het te leren; daarna bak je hem in de Knabbeloven (zoetdeeg, plaatje, glazuur).",
  ],
  "quest.4755483F66D29F94.title": "Lief kijken",
  "quest.4755483F66D29F94.quest_desc": [
    "Eet een &dRoze Guh Koek&r (of zet een bakje neer: er passen er zes in!). Wie er een opeet, kijkt zo lief dat de guhs er hartjes van krijgen.",
  ],
}
